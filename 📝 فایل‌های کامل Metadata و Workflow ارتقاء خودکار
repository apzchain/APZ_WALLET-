6️⃣ .github/workflows/android-auto-promote.yml

Workflow زمان‌بندی‌شده که به‌صورت خودکار internal → beta → production را ارتقاء می‌دهد.

```yaml
name: Android Auto-Promote (Scheduled)

on:
  schedule:
    # ─────────────────────────────────────────
    # Internal → Beta: هر روز ساعت 04:00 UTC
    # ─────────────────────────────────────────
    - cron: '0 4 * * *'
    # ─────────────────────────────────────────
    # Beta → Production: هر جمعه ساعت 06:00 UTC
    # ─────────────────────────────────────────
    - cron: '0 6 * * 5'
  workflow_dispatch:
    inputs:
      from_track:
        description: 'Source track'
        required: true
        type: choice
        options: [ internal, alpha, beta ]
      to_track:
        description: 'Target track'
        required: true
        type: choice
        options: [ alpha, beta, production ]
      rollout_fraction:
        description: 'Rollout fraction for production (0.0 - 1.0)'
        required: false
        default: '0.1'
        type: string

permissions:
  contents: read
  issues: write

env:
  RUBY_VERSION: '3.2'
  JAVA_VERSION: '17'

jobs:
  # ─────────────────────────────────────────────
  # Job 1: Determine Promotion Strategy
  # ─────────────────────────────────────────────
  determine-promotion:
    name: Determine Promotion Strategy
    runs-on: ubuntu-latest
    outputs:
      from_track: ${{ steps.strategy.outputs.from_track }}
      to_track: ${{ steps.strategy.outputs.to_track }}
      rollout_fraction: ${{ steps.strategy.outputs.rollout_fraction }}
      should_promote: ${{ steps.strategy.outputs.should_promote }}
    steps:
      - name: Determine strategy
        id: strategy
        run: |
          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            FROM="${{ inputs.from_track }}"
            TO="${{ inputs.to_track }}"
            FRACTION="${{ inputs.rollout_fraction }}"
          elif [[ "${{ github.event.schedule }}" == "0 4 * * *" ]]; then
            # Cron صبح: Internal → Beta
            FROM="internal"
            TO="beta"
            FRACTION="1.0"
          elif [[ "${{ github.event.schedule }}" == "0 6 * * 5" ]]; then
            # Cron جمعه: Beta → Production (تدریجی)
            FROM="beta"
            TO="production"
            FRACTION="0.1"
          else
            echo "should_promote=false" >> $GITHUB_OUTPUT
            exit 0
          fi

          echo "from_track=${FROM}" >> $GITHUB_OUTPUT
          echo "to_track=${TO}" >> $GITHUB_OUTPUT
          echo "rollout_fraction=${FRACTION}" >> $GITHUB_OUTPUT
          echo "should_promote=true" >> $GITHUB_OUTPUT

          echo "📋 Promotion: ${FROM} → ${TO} (rollout: ${FRACTION})"

  # ─────────────────────────────────────────────
  # Job 2: Pre-Promotion Health Check
  # ─────────────────────────────────────────────
  health-check:
    name: Pre-Promotion Health Check
    runs-on: ubuntu-latest
    needs: determine-promotion
    if: needs.determine-promotion.outputs.should_promote == 'true'
    outputs:
      healthy: ${{ steps.check.outputs.healthy }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check CI Status
        id: check
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # بررسی وضعیت آخرین اجرای CI روی main
          LAST_CI=$(gh run list \
            --workflow=android-ci.yml \
            --branch=main \
            --status=success \
            --limit=1 \
            --json conclusion \
            --jq '.[0].conclusion // "none"')

          if [[ "$LAST_CI" == "success" ]]; then
            echo "healthy=true" >> $GITHUB_OUTPUT
            echo "✅ CI health check passed"
          else
            echo "healthy=false" >> $GITHUB_OUTPUT
            echo "❌ Last CI run failed or not found: $LAST_CI"
            exit 1
          fi

      - name: Check Open Critical Issues
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          CRITICAL=$(gh issue list \
            --label="critical,blocker" \
            --state=open \
            --json number \
            --jq 'length')

          if [[ "$CRITICAL" -gt 0 ]]; then
            echo "❌ Found $CRITICAL critical/blocker issues"
            exit 1
          fi
          echo "✅ No blocking issues"

  # ─────────────────────────────────────────────
  # Job 3: Execute Promotion via Fastlane
  # ─────────────────────────────────────────────
  promote:
    name: "Promote ${{ needs.determine-promotion.outputs.from_track }} → ${{ needs.determine-promotion.outputs.to_track }}"
    runs-on: ubuntu-latest
    needs: [ determine-promotion, health-check ]
    if: needs.health-check.outputs.healthy == 'true'
    timeout-minutes: 30
    defaults:
      run:
        working-directory: android
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: ${{ env.RUBY_VERSION }}
          bundler-cache: true
          working-directory: android

      - name: Decode Play Store Credentials
        env:
          PLAY_STORE_JSON: ${{ secrets.PLAY_STORE_SERVICE_ACCOUNT_JSON }}
        run: |
          mkdir -p fastlane
          echo "$PLAY_STORE_JSON" > fastlane/play-store-credentials.json

      - name: Execute Promotion
        id: promote
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
          LC_ALL: en_US.UTF-8
          LANG: en_US.UTF-8
        run: |
          FROM="${{ needs.determine-promotion.outputs.from_track }}"
          TO="${{ needs.determine-promotion.outputs.to_track }}"
          FRACTION="${{ needs.determine-promotion.outputs.rollout_fraction }}"

          echo "🚀 Promoting ${FROM} → ${TO} (${FRACTION})"

          # اگر به production می‌رویم، از rollout fraction استفاده کن
          if [[ "$TO" == "production" ]]; then
            bundle exec fastlane android promote_to_production \
              rollout:"${FRACTION}"
          else
            bundle exec fastlane android promote \
              from:"${FROM}" \
              to:"${TO}"
          fi

      - name: Cleanup
        if: always()
        run: rm -f fastlane/play-store-credentials.json

      - name: Post to Slack (Success)
        if: success() && secrets.SLACK_WEBHOOK_URL != ''
        uses: slackapi/slack-github-action@v1
        with:
          payload: |
            {
              "text": "✅ APZ Wallet promoted: ${{ needs.determine-promotion.outputs.from_track }} → ${{ needs.determine-promotion.outputs.to_track }}",
              "blocks": [
                {
                  "type": "section",
                  "text": {
                    "type": "mrkdwn",
                    "text": "✅ *APZ Wallet Promotion Success*\n*From:* ${{ needs.determine-promotion.outputs.from_track }}\n*To:* ${{ needs.determine-promotion.outputs.to_track }}\n*Rollout:* ${{ needs.determine-promotion.outputs.rollout_fraction }}\n*Run:* <${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}|#${{ github.run_number }}>"
                  }
                }
              ]
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          SLACK_WEBHOOK_TYPE: INCOMING_WEBHOOK

      - name: Post to Slack (Failure)
        if: failure() && secrets.SLACK_WEBHOOK_URL != ''
        uses: slackapi/slack-github-action@v1
        with:
          payload: |
            {
              "text": "❌ APZ Wallet promotion FAILED: ${{ needs.determine-promotion.outputs.from_track }} → ${{ needs.determine-promotion.outputs.to_track }}"
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          SLACK_WEBHOOK_TYPE: INCOMING_WEBHOOK

  # ─────────────────────────────────────────────
  # Job 4: Post-Promotion Monitoring
  # ─────────────────────────────────────────────
  post-monitoring:
    name: Post-Promotion Monitoring
    runs-on: ubuntu-latest
    needs: [ determine-promotion, promote ]
    if: needs.determine-promotion.outputs.to_track == 'production'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: ${{ env.RUBY_VERSION }}
          bundler-cache: true
          working-directory: android

      - name: Decode Play Store Credentials
        env:
          PLAY_STORE_JSON: ${{ secrets.PLAY_STORE_SERVICE_ACCOUNT_JSON }}
        run: |
          mkdir -p fastlane
          echo "$PLAY_STORE_JSON" > fastlane/play-store-credentials.json

      - name: Wait for Metrics to Settle
        run: sleep 300  # 5 دقیقه

      - name: Check Crash Rate & ANRs
        id: metrics
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
        run: |
          # در اینجا می‌توانید با Google Play Developer Reporting API چک کنید
          # یا از Firebase Crashlytics استفاده کنید
          echo "metrics_ok=true" >> $GITHUB_OUTPUT

      - name: Trigger Rollback on Failure
        if: steps.metrics.outputs.metrics_ok != 'true'
        run: |
          echo "🚨 Metrics degraded — triggering rollback"
          bundle exec fastlane android halt_rollout

      - name: Cleanup
        if: always()
        run: rm -f fastlane/play-store-credentials.json
```

