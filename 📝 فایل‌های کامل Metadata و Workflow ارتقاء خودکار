1️⃣2️⃣ 🔄 استراتژی Rollout تدریجی Production

Workflow زیر به‌صورت خودکار rollout را افزایش می‌دهد اگر crash rate پایین باشد:

```yaml
name: Android Production Rollout Increment

on:
  schedule:
    # هر ۶ ساعت بررسی کن
    - cron: '0 */6 * * *'
  workflow_dispatch:

jobs:
  increment-rollout:
    name: Increment Production Rollout
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: android
    steps:
      - uses: actions/checkout@v4

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.2'
          bundler-cache: true
          working-directory: android

      - name: Decode Credentials
        env:
          PLAY_STORE_JSON: ${{ secrets.PLAY_STORE_SERVICE_ACCOUNT_JSON }}
        run: |
          mkdir -p fastlane
          echo "$PLAY_STORE_JSON" > fastlane/play-store-credentials.json

      - name: Check Crash Rate
        id: crash
        run: |
          # در عمل از Firebase Crashlytics یا Play Developer Reporting API استفاده کنید
          CRASH_RATE="0.5"  # 0.5%
          if (( $(echo "$CRASH_RATE < 1.0" | bc -l) )); then
            echo "safe=true" >> $GITHUB_OUTPUT
          else
            echo "safe=false" >> $GITHUB_OUTPUT
          fi

      - name: Increment Rollout
        if: steps.crash.outputs.safe == 'true'
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
        run: |
          # افزایش تدریجی: 10% → 25% → 50% → 100%
          bundle exec fastlane android promote_to_production rollout:"0.25"

      - name: Halt on High Crash Rate
        if: steps.crash.outputs.safe != 'true'
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
        run: |
          bundle exec fastlane android halt_rollout

      - name: Cleanup
        if: always()
        run: rm -f fastlane/play-store-credentials.json
