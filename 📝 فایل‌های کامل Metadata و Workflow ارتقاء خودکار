      - name: Promote
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
        run: |
          bundle exec fastlane android promote \
            from:"beta" \
            to:"${{ inputs.to_track }}"

      - name: Cleanup
        if: always()
        run: rm -f fastlane/play-store-credentials.json

  # ─────────────────────────────────────────────
  # Environment: production (نیاز به approval دستی)
  # ─────────────────────────────────────────────
  promote-production:
    name: "Promote to Production (Approval Required)"
    runs-on: ubuntu-latest
    needs: prepare
    if: inputs.to_track == 'production'
    environment:
      name: production
      url: https://play.google.com/console
    defaults:
      run:
        working-directory: android
    steps:
      - uses: actions/checkout@v4

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.2'
          bundler-cache: true
