9️⃣ 🔧 به‌روزرسانی Fastfile با Laneهای Promote

این Laneها را به android/fastlane/Fastfile اضافه کنید:

```ruby
  # ═══════════════════════════════════════════
  # Lane: Generic Promote
  # ═══════════════════════════════════════════
  desc "Promote from one track to another"
  lane :promote do |options|
    from = options[:from] || "internal"
    to = options[:to] || "beta"

    UI.message("🚀 Promoting APZ Wallet: #{from} → #{to}")

    upload_to_play_store(
      track: from,
      track_promote_to: to,
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      skip_upload_aab: true
    )

    UI.success("✅ Promoted #{from} → #{to}")
  end

  # ═══════════════════════════════════════════
  # Lane: Promote to Production with Rollout
  # ═══════════════════════════════════════════
  desc "Promote to Production with staged rollout"
  lane :promote_to_production do |options|
    rollout = (options[:rollout] || "0.1").to_f

    UI.message("🚀 Promoting to Production (rollout: #{(rollout * 100).round}%)")

    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      rollout: rollout,
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      skip_upload_aab: true
    )

    UI.success("✅ Production rollout started at #{(rollout * 100).round}%")
  end

  # ═══════════════════════════════════════════
  # Lane: Halt Rollout (Emergency)
  # ═══════════════════════════════════════════
  desc "Halt the current production rollout"
  lane :halt_rollout do
    UI.important("🛑 Halting production rollout...")

    # تنظیم rollout به 0.0 باعث توقف می‌شود
    upload_to_play_store(
      track: "production",
      rollout: 0.0,
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      skip_upload_aab: true
    )

    UI.success("✅ Production rollout halted")
  end

  # ═══════════════════════════════════════════
  # Lane: Rollback to Lower Track
  # ═══════════════════════════════════════════
  desc "Rollback production to a lower track"
  lane :rollback do |options|
    target = options[:to] || "beta"

    UI.important("⚠️  Rolling back production to #{target}")

    # ابتدا rollout را متوقف کن
    upload_to_play_store(
      track: "production",
      rollout: 0.0,
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      skip_upload_aab: true
    )

    UI.success("✅ Rolled back production → #{target}")
  end
