Workflow اضطراری برای توقف rollout یا rollback.

```yaml
name: Android Emergency Rollback

on:
  workflow_dispatch:
    inputs:
      action:
        description: 'Action to perform'
        required: true
        type: choice
        options:
          - halt-rollout
          - rollback-to-beta
          - rollback-to-internal
      reason:
        description: 'Reason for rollback (required)'
        required: true
        type: string

permissions:
  contents: read
  issues: write

jobs:
  emergency-action:
    name: "Emergency: ${{ inputs.action }}"
    runs-on: ubuntu-latest
    environment: production
    defaults:
      run:
        working-directory: android
    steps:
      - uses: actions/checkout@v4

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.2'
          bundler-cache: true
          working-directory: android

      - name: Decode Credentials
        env:
          PLAY_STORE_JSON: ${{ secrets.PLAY_STORE_SERVICE_ACCOUNT_JSON }}
        run: |
          mkdir -p fastlane
          echo "$PLAY_STORE_JSON" > fastlane/play-store-credentials.json

      - name: Execute Emergency Action
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
        run: |
          case "${{ inputs.action }}" in
            halt-rollout)
              bundle exec fastlane android halt_rollout
              ;;
            rollback-to-beta)
              bundle exec fastlane android rollback to:beta
              ;;
            rollback-to-internal)
              bundle exec fastlane android rollback to:internal
              ;;
          esac

      - name: Create Rollback Issue
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `🚨 Emergency Rollback: ${context.payload.inputs.action}`,
              body: [
                '## Emergency Rollback Executed',
                '',
                `**Action:** \`${context.payload.inputs.action}\``,
                `**Reason:** ${context.payload.inputs.reason}`,
                `**Triggered by:** @${context.actor}`,
                `**Run:** ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`,
                '',
                '### Follow-up Actions',
                '- [ ] Investigate root cause',
                '- [ ] Fix the issue',
                '- [ ] Re-release to internal testing',
                '- [ ] Post-mortem document'
              ].join('\n'),
              labels: ['emergency', 'rollback', 'critical']
            });

      - name: Notify Slack
        if: secrets.SLACK_WEBHOOK_URL != ''
        uses: slackapi/slack-github-action@v1
        with:
          payload: |
            {
              "text": "🚨 EMERGENCY ROLLBACK: ${{ inputs.action }}\nReason: ${{ inputs.reason }}"
            }
        env:
          SLACK_WEBHOOK_URL: ${{ secrets.SLACK_WEBHOOK_URL }}
          SLACK_WEBHOOK_TYPE: INCOMING_WEBHOOK

      - name: Cleanup
        if: always()
        run: rm -f fastlane/play-store-credentials.json
