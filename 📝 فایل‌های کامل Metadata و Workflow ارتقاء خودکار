          echo "Version Code: ${{ inputs.version_code }}"
          echo "Rollout: ${{ inputs.rollout_fraction }}"

      - name: Promote to Production (Staged Rollout)
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-credentials.json
        run: |
          bundle exec fastlane android promote_to_production \
