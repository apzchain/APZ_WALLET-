متد login رو این‌طور تغییر بده:

```typescript
import { totpService } from './totp.service.js';
import jwt from 'jsonwebtoken';

// داخل کلاس AuthService:

async login(params: {
  email: string;
  password: string;
  userAgent?: string;
  ipAddress?: string;
  totpCode?: string;   // ← جدید
}) {
  const user = userModel.findByEmail(params.email);
  if (!user || !user.is_active) {
    throw Object.assign(new Error('Invalid credentials'), { status: 401 });
  }

  const ok = await this.verifyPassword(user.password_hash, params.password);
  if (!ok) throw Object.assign(new Error('Invalid credentials'), { status: 401 });

  // ───── چک 2FA ─────
  if (totpService.isEnabled(user.id)) {
    if (!params.totpCode) {
      // توکن موقت برای مرحله بعد
      const mfaToken = jwt.sign(
        { sub: user.id, purpose: 'mfa' },
        AUTH_CONFIG.accessTokenSecret,
        { expiresIn: '5m' }
      );
      throw Object.assign(
        new Error('2FA required'),
        { status: 401, code: 'MFA_REQUIRED', mfaToken }
      );
    }

    if (!totpService.verifyCode(user.id, params.totpCode)) {
      throw Object.assign(
        new Error('Invalid 2FA code'),
        { status: 401, code: 'MFA_INVALID' }
      );
    }
  }

  userModel.updateLastLogin(user.id);
  const tokens = await this.issueTokens(user, params.userAgent, params.ipAddress);

  return { user: this.sanitize(user), ...tokens };
}
```

و در server/middleware/errorHandler.ts این رو اضافه کن:

```typescript
export function errorHandler(err: any, _req: Request, res: Response, _next: NextFunction) {
  console.error('[Error]', err);

  // مخصوص خطاهای 2FA
  if (err.code === 'MFA_REQUIRED') {
    return res.status(401).json({
      success: false,
      code: 'MFA_REQUIRED',
      mfaToken: err.mfaToken,
      error: err.message
    });
  }
  if (err.code === 'MFA_INVALID') {
    return res.status(401).json({
      success: false,
      code: 'MFA_INVALID',
      error: err.message
    });
  }

  res.status(err.status || 500).json({
    success: false,
    error: err.message || 'Internal Server Error'
  });
}
