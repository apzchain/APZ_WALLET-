import { Router } from 'express';
import { z } from 'zod';
import jwt from 'jsonwebtoken';
import { requireAuth } from '../middleware/auth.middleware.js';
import { totpService } from '../services/totp.service.js';
import { authService } from '../services/auth.service.js';
import { userModel } from '../models/User.model.js';
import { AUTH_CONFIG } from '../config/auth.config.js';

const router = Router();

const codeSchema = z.object({ code: z.string().min(6).max(16) });

// ───── POST /api/2fa/setup (requires auth) ─────
router.post('/setup', requireAuth, async (req, res, next) => {
  try {
    const user = userModel.findById(req.user!.sub);
    if (!user) throw Object.assign(new Error('User not found'), { status: 404 });
    const result = await totpService.setup(user.id, user.email);
    res.json({ success: true, data: result });
  } catch (err) { next(err); }
});

// ───── POST /api/2fa/verify (requires auth) ─────
router.post('/verify', requireAuth, async (req, res, next) => {
  try {
    const { code } = codeSchema.parse(req.body);
    const result = await totpService.verifyAndEnable(req.user!.sub, code);
    res.json({ success: true, data: result });
  } catch (err) { next(err); }
});

// ───── POST /api/2fa/disable (requires auth) ─────
router.post('/disable', requireAuth, async (req, res, next) => {
  try {
    const { code } = codeSchema.parse(req.body);
    await totpService.disable(req.user!.sub, code);
    res.json({ success: true });
  } catch (err) { next(err); }
});

// ───── GET /api/2fa/status ─────
router.get('/status', requireAuth, (req, res) => {
  const enabled = totpService.isEnabled(req.user!.sub);
  res.json({ success: true, data: { enabled } });
});

// ───── POST /api/2fa/challenge (بدون auth، با mfa_token) ─────
// این روت برای وقتیه که کاربر با OAuth لاگین کرده و 2FA فعال داره
router.post('/challenge', async (req, res, next) => {
  try {
    const schema = z.object({
      mfaToken: z.string(),
      code: z.string().min(6).max(16)
    });
    const { mfaToken, code } = schema.parse(req.body);

    // verify mfa_token
    let payload: any;
    try {
      payload = jwt.verify(mfaToken, AUTH_CONFIG.accessTokenSecret);
    } catch {
      throw Object.assign(new Error('Invalid or expired MFA token'), { status: 401 });
    }
    if (payload.purpose !== 'mfa') {
      throw Object.assign(new Error('Invalid token purpose'), { status: 401 });
    }

    const user = userModel.findById(payload.sub);
    if (!user) throw Object.assign(new Error('User not found'), { status: 404 });

    if (!totpService.verifyCode(user.id, code)) {
      throw Object.assign(new Error('Invalid 2FA code'), { status: 401 });
    }

    const { accessToken, refreshToken } = await authService.issueTokens(user);
    res.cookie('refreshToken', refreshToken, AUTH_CONFIG.cookieOptions);
    res.json({ success: true, data: { accessToken } });
  } catch (err) { next(err); }
});

export default router;
