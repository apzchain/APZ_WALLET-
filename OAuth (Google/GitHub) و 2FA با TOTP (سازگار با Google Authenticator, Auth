import { Router, Request, Response, NextFunction } from 'express';
import passport from 'passport';
import { OAUTH_CONFIG } from '../config/oauth.config.js';
import { oauthService } from '../services/oauth.service.js';
import { totpService } from '../services/totp.service.js';
import { AUTH_CONFIG } from '../config/auth.config.js';
import jwt from 'jsonwebtoken';

const router = Router();

/**
 * بعد از موفقیت passport، این handler اجرا می‌شه.
 * - اگر کاربر 2FA داره → یک mfa_token کوتاه‌عمر صادر می‌کنیم
 * - وگرنه توکن کامل
 */
async function oauthCallbackHandler(req: Request, res: Response, next: NextFunction) {
  try {
    const user = req.user as any;
    if (!user) throw new Error('OAuth failed');

    const clientUrl = OAUTH_CONFIG.clientUrl;

    // ───── اگر 2FA فعاله ─────
    if (totpService.isEnabled(user.id)) {
      const mfaToken = jwt.sign(
        { sub: user.id, purpose: 'mfa' },
        AUTH_CONFIG.accessTokenSecret,
        { expiresIn: '5m' }
      );
      return res.redirect(`${clientUrl}/auth/mfa?token=${mfaToken}`);
    }

    // ───── صدور توکن کامل ─────
    const { accessToken, refreshToken } = await oauthService.issueTokensForUser(user);

    res.cookie('refreshToken', refreshToken, AUTH_CONFIG.cookieOptions);

    // توکن رو از طریق fragment به فرانت بفرست (امن‌تر از query)
    return res.redirect(
      `${clientUrl}/auth/callback#access_token=${accessToken}`
    );
  } catch (err) {
    next(err);
  }
}

// ───── Google ─────
router.get('/google',
  passport.authenticate('google', { session: false, scope: ['profile', 'email'] })
);

router.get('/google/callback',
  passport.authenticate('google', { session: false, failureRedirect: `${OAUTH_CONFIG.clientUrl}/auth/error` }),
  oauthCallbackHandler
);

// ───── GitHub ─────
router.get('/github',
  passport.authenticate('github', { session: false, scope: ['user:email'] })
);

router.get('/github/callback',
  passport.authenticate('github', { session: false, failureRedirect: `${OAUTH_CONFIG.clientUrl}/auth/error` }),
  oauthCallbackHandler
);

export default router;
```

