export interface OAuthAccountRow {
  id: string;
  user_id: string;
  provider: string;
  provider_user_id: string;
  email: string | null;
  display_name: string | null;
  avatar_url: string | null;
  access_token: string | null;
  refresh_token: string | null;
  created_at: number;
}

export interface TwoFARow {
  user_id: string;
  secret_encrypted: string;
  enabled: number;
  backup_codes: string | null;
  verified_at: number | null;
  created_at: number;
}

export const userModel = {
  // ... توابع قبلی ...

  // ───── OAuth ─────
  findOAuthAccount(provider: string, providerUserId: string): OAuthAccountRow | undefined {
    return db.prepare('SELECT * FROM oauth_accounts WHERE provider = ? AND provider_user_id = ?')
      .get(provider, providerUserId) as OAuthAccountRow | undefined;
  },

  linkOAuthAccount(row: OAuthAccountRow): void {
    db.prepare(`
      INSERT INTO oauth_accounts 
        (id, user_id, provider, provider_user_id, email, display_name, avatar_url, access_token, refresh_token, created_at)
      VALUES 
        (@id, @user_id, @provider, @provider_user_id, @email, @display_name, @avatar_url, @access_token, @refresh_token, @created_at)
    `).run(row);
  },

  getOAuthAccountsByUser(userId: string): OAuthAccountRow[] {
    return db.prepare('SELECT * FROM oauth_accounts WHERE user_id = ?').all(userId) as OAuthAccountRow[];
  },

  updateUserAvatar(userId: string, avatarUrl: string): void {
    db.prepare('UPDATE users SET avatar_url = ? WHERE id = ?').run(avatarUrl, userId);
  },

  updateOAuthProvider(userId: string, provider: string): void {
    db.prepare('UPDATE users SET oauth_provider = ? WHERE id = ?').run(provider, userId);
  },

  // ───── 2FA ─────
  get2FA(userId: string): TwoFARow | undefined {
    return db.prepare('SELECT * FROM user_2fa WHERE user_id = ?').get(userId) as TwoFARow | undefined;
  },

  upsert2FA(row: TwoFARow): void {
    db.prepare(`
      INSERT INTO user_2fa (user_id, secret_encrypted, enabled, backup_codes, verified_at, created_at)
      VALUES (@user_id, @secret_encrypted, @enabled, @backup_codes, @verified_at, @created_at)
      ON CONFLICT(user_id) DO UPDATE SET
        secret_encrypted = excluded.secret_encrypted,
        enabled = excluded.enabled,
        backup_codes = excluded.backup_codes,
        verified_at = excluded.verified_at
    `).run(row);
  },

  enable2FA(userId: string, backupCodes: string): void {
    db.prepare(`
      UPDATE user_2fa 
      SET enabled = 1, backup_codes = ?, verified_at = ?
      WHERE user_id = ?
    `).run(backupCodes, Date.now(), userId);

    db.prepare('UPDATE users SET two_factor_enabled = 1 WHERE id = ?').run(userId);
  },

  disable2FA(userId: string): void {
    db.prepare('DELETE FROM user_2fa WHERE user_id = ?').run(userId);
    db.prepare('UPDATE users SET two_factor_enabled = 0 WHERE id = ?').run(userId);
  },

  updateBackupCodes(userId: string, codes: string): void {
    db.prepare('UPDATE user_2fa SET backup_codes = ? WHERE user_id = ?').run(codes, userId);
  }
};
