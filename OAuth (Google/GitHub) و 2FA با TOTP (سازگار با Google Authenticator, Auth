import crypto from 'crypto';
import { userModel, UserRow } from '../models/User.model.js';
import { authService } from './auth.service.js';

export interface OAuthProfile {
  provider: 'google' | 'github';
  providerUserId: string;
  email: string;
  displayName?: string;
  avatarUrl?: string;
  accessToken?: string;
  refreshToken?: string;
}

export class OAuthService {
  /**
   * پیدا کردن یا ساختن کاربر بر اساس پروفایل OAuth
   */
  async findOrCreateUser(profile: OAuthProfile): Promise<UserRow> {
    // 1. آیا این OAuth account قبلاً لینک شده؟
    const existingLink = userModel.findOAuthAccount(profile.provider, profile.providerUserId);
    if (existingLink) {
      const user = userModel.findById(existingLink.user_id);
      if (user) {
        userModel.updateLastLogin(user.id);
        return user;
      }
    }

    // 2. آیا کاربری با این ایمیل وجود داره؟
    let user = userModel.findByEmail(profile.email);

    // 3. اگر نیست، بساز
    if (!user) {
      const id = crypto.randomUUID();
      userModel.create({
        id,
        email: profile.email,
        password_hash: 'OAUTH_NO_PASSWORD', // امکان ورود با رمز نداره
        display_name: profile.displayName,
        role: 'user'
      });
      user = userModel.findById(id)!;
    }

    // 4. آواتار
    if (profile.avatarUrl && !user.avatar_url) {
      userModel.updateUserAvatar(user.id, profile.avatarUrl);
      user = userModel.findById(user.id)!;
    }

    // 5. لینک کردن OAuth account
    userModel.linkOAuthAccount({
      id: crypto.randomUUID(),
      user_id: user.id,
      provider: profile.provider,
      provider_user_id: profile.providerUserId,
      email: profile.email,
      display_name: profile.displayName || null,
      avatar_url: profile.avatarUrl || null,
      access_token: profile.accessToken || null,
      refresh_token: profile.refreshToken || null,
      created_at: Date.now()
    });

    return user;
  }

  /**
   * صدور توکن برای کاربر و برگرداندن redirect URL فرانت
   */
  async issueTokensForUser(user: UserRow) {
    const tokens = await authService.issueTokens(user);
    return tokens;
  }
}

export const oauthService = new OAuthService();
