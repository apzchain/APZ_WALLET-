# 3. ورود با 2FA
curl -X POST http://localhost:3001/api/auth/login \
  -H "Content-Type: application/json" \
  -d '{"email":"ali@apz.io","password":"supersecret123"}'
# → پاسخ MFA_REQUIRED + mfaToken

curl -X POST http://localhost:3001/api/2fa/challenge \
  -H "Content-Type: application/json" \
  -d '{"mfaToken":"<MFA_TOKEN>","code":"123456"}'
# → accessToken نهایی
