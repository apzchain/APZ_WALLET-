  setBusy(true);
  try {
    await login(email.trim().toLowerCase(), password);
  } catch (err: any) {
    if (err.mfaRequired) {
      setNeedMfa(true);   // نمایش فرم TwoFactorVerify
    } else {
      setError(err.message || 'Login failed');
    }
  } finally {
    setBusy(false);
  }
};

if (needMfa) {
  return <TwoFactorVerify onSubmit={completeMfaLogin} onCancel={() => setNeedMfa(false)} />;
}
