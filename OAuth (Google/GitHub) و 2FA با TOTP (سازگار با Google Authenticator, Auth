```typescript
import { authenticator } from 'otplib';
import QRCode from 'qrcode';
import crypto from 'crypto';
import { TOTP_CONFIG } from '../config/oauth.config.js';
import { userModel } from '../models/User.model.js';

// تنظیمات TOTP
authenticator.options = {
  digits: TOTP_CONFIG.digits,
  step: TOTP_CONFIG.period,
  window: TOTP_CONFIG.window
};

const ENCRYPTION_KEY = crypto
  .createHash('sha256')
  .update(process.env.JWT_ACCESS_SECRET || 'default-key')
  .digest();

/**
 * رمزنگاری secret با AES-256-GCM
 */
function encrypt(text: string): string {
  const iv = crypto.randomBytes(12);
  const cipher = crypto.createCipheriv('aes-256-gcm', ENCRYPTION_KEY, iv);
  const enc = Buffer.concat([cipher.update(text, 'utf8'), cipher.final()]);
  const tag = cipher.getAuthTag();
  return `${iv.toString('hex')}:${tag.toString('hex')}:${enc.toString('hex')}`;
}

function decrypt(payload: string): string {
  const [ivHex, tagHex, encHex] = payload.split(':');
  const iv = Buffer.from(ivHex, 'hex');
  const tag = Buffer.from(tagHex, 'hex');
  const enc = Buffer.from(encHex, 'hex');
  const decipher = crypto.createDecipheriv('aes-256-gcm', ENCRYPTION_KEY, iv);
  decipher.setAuthTag(tag);
  return Buffer.concat([decipher.update(enc), decipher.final()]).toString('utf8');
}

export class TotpService {
  /**
   * راه‌اندازی اولیه: تولید secret + QR code
   * (هنوز enabled نیست تا کاربر اولین کد رو تأیید کنه)
   */
  async setup(userId: string, email: string) {
    const existing = userModel.get2FA(userId);
    if (existing?.enabled) {
      throw Object.assign(new Error('2FA already enabled'), { status: 409 });
    }

    const secret = authenticator.generateSecret();
    const otpauthUrl = authenticator.keyuri(email, TOTP_CONFIG.issuer, secret);
    const qrDataUrl = await QRCode.toDataURL(otpauthUrl);

    userModel.upsert2FA({
      user_id: userId,
      secret_encrypted: encrypt(secret),
      enabled: 0,
      backup_codes: null,
      verified_at: null,
      created_at: Date.now()
    });

    return { secret, otpauthUrl, qrDataUrl };
  }

  /**
   * تأیید اولین کد و فعال‌سازی نهایی + تولید backup codes
   */
  async verifyAndEnable(userId: string, code: string) {
    const row = userModel.get2FA(userId);
    if (!row) throw Object.assign(new Error('2FA not initialized'), { status: 400 });
    if (row.enabled) throw Object.assign(new Error('2FA already enabled'), { status: 409 });

    const secret = decrypt(row.secret_encrypted);
    if (!authenticator.check(code, secret)) {
      throw Object.assign(new Error('Invalid code'), { status: 400 });
    }

    // تولید ۱۰ backup code
    const rawBackupCodes = Array.from({ length: 10 }, () =>
      crypto.randomBytes(5).toString('hex').toUpperCase()
    );
    const hashedCodes = rawBackupCodes.map(c =>
      crypto.createHash('sha256').update(c).digest('hex')
    );

    userModel.enable2FA(userId, JSON.stringify(hashedCodes));

    return { backupCodes: rawBackupCodes };
  }

  /**
   * چک کردن کد TOTP هنگام ورود
   */
  verifyCode(userId: string, code: string): boolean {
    const row = userModel.get2FA(userId);
    if (!row?.enabled) return false;

    const secret = decrypt(row.secret_encrypted);

    // اول به‌عنوان TOTP چک کن
    if (authenticator.check(code, secret)) return true;

    // بعد به‌عنوان backup code
    return this.consumeBackupCode(userId, code);
  }

  /**
   * مصرف backup code (یک‌بار‌مصرف)
   */
  private consumeBackupCode(userId: string, code: string): boolean {
    const row = userModel.get2FA(userId);
    if (!row?.backup_codes) return false;

    const hash = crypto.createHash('sha256').update(code.toUpperCase()).digest('hex');
    const codes: string[] = JSON.parse(row.backup_codes);
    const idx = codes.indexOf(hash);

    if (idx === -1) return false;

    codes.splice(idx, 1); // حذف code مصرف‌شده
    userModel.updateBackupCodes(userId, JSON.stringify(codes));
    return true;
  }

  /**
   * غیرفعال‌سازی 2FA (نیاز به رمز عبور یا کد معتبر)
   */
  async disable(userId: string, code: string) {
    const row = userModel.get2FA(userId);
    if (!row?.enabled) throw Object.assign(new Error('2FA not enabled'), { status: 400 });

    const secret = decrypt(row.secret_encrypted);
    const valid = authenticator.check(code, secret) || this.consumeBackupCode(userId, code);
    if (!valid) throw Object.assign(new Error('Invalid code'), { status: 400 });

    userModel.disable2FA(userId);
  }

  isEnabled(userId: string): boolean {
    return userModel.get2FA(userId)?.enabled === 1;
  }
}

export const totpService = new TotpService();
