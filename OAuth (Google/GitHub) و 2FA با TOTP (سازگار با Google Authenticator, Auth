import React, { useState } from 'react';
import { apiClient } from '../api/client';

export const TwoFactorSetup: React.FC<{ onDone: () => void }> = ({ onDone }) => {
  const [step, setStep] = useState<'intro' | 'scan' | 'verify' | 'backup'>('intro');
  const [qrDataUrl, setQrDataUrl] = useState('');
  const [secret, setSecret] = useState('');
  const [code, setCode] = useState('');
  const [backupCodes, setBackupCodes] = useState<string[]>([]);
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  const startSetup = async () => {
    setBusy(true);
    setError(null);
    try {
      const res = await apiClient.twoFactorSetup();
      setQrDataUrl(res.qrDataUrl);
      setSecret(res.secret);
      setStep('scan');
    } catch (e: any) {
      setError(e.message);
    } finally { setBusy(false); }
  };

  const verify = async () => {
    setBusy(true);
    setError(null);
    try {
      const res = await apiClient.twoFactorVerify(code);
      setBackupCodes(res.backupCodes);
      setStep('backup');
    } catch (e: any) {
      setError(e.message);
    } finally { setBusy(false); }
  };

  const copyBackupCodes = () => {
    navigator.clipboard.writeText(backupCodes.join('\n'));
    alert('کدهای پشتیبان کپی شدند ✅');
  };

  return (
    <div className="twofa-card">
      <h3>🔒 فعال‌سازی احراز هویت دو مرحله‌ای</h3>

      {step === 'intro' && (
        <>
          <p>با فعال‌سازی 2FA، هنگام ورود علاوه بر رمز عبور به یک کد ۶ رقمی از اپ Authenticator نیاز داری.</p>
          <button className="btn-primary" onClick={startSetup} disabled={busy}>
            شروع تنظیم
          </button>
        </>
      )}

      {step === 'scan' && (
        <>
          <p>با اپ Google Authenticator یا Authy این QR رو اسکن کن:</p>
          <img src={qrDataUrl} alt="QR" className="qr-img" />
          <details>
            <summary>نمایش کد دستی</summary>
            <code className="secret-code">{secret}</code>
          </details>
          <button className="btn-primary" onClick={() => setStep('verify')}>
            بعدی
          </button>
        </>
      )}

      {step === 'verify' && (
        <>
          <p>کد ۶ رقمی نمایش داده‌شده در اپ رو وارد کن:</p>
          <input
            className="totp-input"
            value={code}
            onChange={e => setCode(e.target.value.replace(/\D/g, '').slice(0, 6))}
            placeholder="000000"
            inputMode="numeric"
            dir="ltr"
          />
          {error && <div className="auth-error">⚠️ {error}</div>}
          <button className="btn-primary" onClick={verify} disabled={busy || code.length !== 6}>
            تأیید و فعال‌سازی
          </button>
        </>
      )}

      {step === 'backup' && (
        <>
          <h4>✅ 2FA فعال شد!</h4>
          <p>این کدهای پشتیبان رو در جای امنی ذخیره کن — اگر گوشیت گم شد فقط با این‌ها می‌تونی وارد شی.</p>
