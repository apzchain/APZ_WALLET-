    const mfaToken = (err as any).mfaToken || (err as any).data?.mfaToken;
    if (mfaToken) {
      setPendingMfaToken(mfaToken);
      throw Object.assign(new Error('MFA required'), { mfaRequired: true });
    }
    throw err;
  }
