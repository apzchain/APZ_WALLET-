const API_BASE = import.meta.env.VITE_API_URL || 'http://localhost:3001/api';

let accessToken: string | null = null;
let refreshPromise: Promise<string> | null = null;

export function setAccessToken(token: string | null) {
  accessToken = token;
}

async function doRefresh(): Promise<string> {
  if (refreshPromise) return refreshPromise;
  refreshPromise = (async () => {
    const res = await fetch(`${API_BASE}/auth/refresh`, {
      method: 'POST',
      credentials: 'include'
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error('Refresh failed');
    accessToken = data.data.accessToken;
    return accessToken!;
  })().finally(() => { refreshPromise = null; });
  return refreshPromise;
}

async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
  const doFetch = async (): Promise<Response> =>
    fetch(`${API_BASE}${path}`, {
      ...options,
      credentials: 'include',
      headers: {
        'Content-Type': 'application/json',
        ...(accessToken ? { Authorization: `Bearer ${accessToken}` } : {}),
        ...options.headers
      }
    });

  let res = await doFetch();

  // اگر توکن منقضی شد، یکبار refresh کن
  if (res.status === 401 && accessToken) {
    try {
      await doRefresh();
      res = await doFetch();
    } catch { /* ignore */ }
  }

  const data = await res.json();
  if (!res.ok || !data.success) throw new Error(data.error || 'API error');
  return data.data as T;
}

export const apiClient = {
  // ───── Auth ─────
  register: (payload: { email: string; password: string; displayName?: string }) =>
    request<{ user: any; accessToken: string }>('/auth/register', {
      method: 'POST',
      body: JSON.stringify(payload)
    }),

  login: (payload: { email: string; password: string }) =>
    request<{ user: any; accessToken: string }>('/auth/login', {
      method: 'POST',
      body: JSON.stringify(payload)
    }),

  logout: () =>
    request<{}>('/auth/logout', { method: 'POST' }),

  me: () =>
    request<{ user: any }>('/auth/me'),

  logoutAll: () =>
    request<{}>('/auth/logout-all', { method: 'POST' }),

  // ───── Wallet (همه محافظت‌شده) ─────
  createWallet: (label?: string) =>
    request<{ id: string; address: string; mnemonic?: string }>('/wallet/create', {
      method: 'POST',
      body: JSON.stringify({ label })
    }),

  listWallets: () =>
    request<Array<{ id: string; address: string; label?: string }>>('/wallet/list'),

  getBalance: (address: string) =>
    request<{ address: string; balance: string; currency: string }>(
      `/wallet/${address}/balance`
    ),

  getNetworkInfo: () =>
    request<{ chainId: number; name: string; blockNumber: number }>('/wallet/network/info'),

  // ───── Transactions ─────
  sendTransaction: (params: { walletId: string; to: string; amount: string }) =>
    request<{ id: string; hash: string; explorerUrl: string }>('/tx/send', {
      method: 'POST',
      body: JSON.stringify(params)
    }),

  getHistory: (walletId: string) =>
    request<any[]>(`/tx/${walletId}/history`),

  getTxStatus: (hash: string) =>
    request<any>(`/tx/status/${hash}`)
};
