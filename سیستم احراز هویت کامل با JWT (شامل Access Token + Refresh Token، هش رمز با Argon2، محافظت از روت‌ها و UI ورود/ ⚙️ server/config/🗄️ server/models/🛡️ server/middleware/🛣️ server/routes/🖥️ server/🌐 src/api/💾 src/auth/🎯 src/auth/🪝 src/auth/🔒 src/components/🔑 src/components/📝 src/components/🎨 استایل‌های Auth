```css
.auth-card {
  max-width: 420px;
  margin: 60px auto;
  padding: 32px;
  background: #14161c;
  border-radius: 16px;
  border: 1px solid #232733;
  color: #e7e9ee;
  direction: rtl;
  font-family: 'Vazirmatn', sans-serif;
}
.auth-card h2 { margin-bottom: 24px; font-size: 1.4rem; }
.auth-card label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
  font-size: 0.9rem;
  color: #a4acbd;
}
.auth-card input {
  padding: 10px 12px;
  border-radius: 8px;
  background: #0d0f14;
  border: 1px solid #2a2f3d;
  color: #fff;
  outline: none;
  transition: border 0.2s;
}
.auth-card input:focus { border-color: #6c7cff; }
.btn-primary {
  width: 100%;
  padding: 12px;
  margin-top: 8px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #6c7cff, #8a5cff);
  color: #fff;
  font-weight: 600;
  cursor: pointer;
}
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.auth-error {
  background: #3a1a1a;
  color: #ff8b8b;
  padding: 10px;
  border-radius: 8px;
  margin: 8px 0;
  font-size: 0.88rem;
}
.auth-switch { text-align: center; margin-top: 18px; color: #8a91a3; }
.link-btn {
  background: none;
  border: none;
  color: #6c7cff;
  cursor: pointer;
  font-weight: 600;
}
.loading-screen {
  display: grid;
  place-items: center;
  min-height: 100vh;
  color: #a4acbd;
}
```
