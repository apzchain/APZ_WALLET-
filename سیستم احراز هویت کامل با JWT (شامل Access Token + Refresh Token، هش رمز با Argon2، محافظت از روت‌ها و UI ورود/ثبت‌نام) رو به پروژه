🔐 server/services/auth.service.ts

```typescript
import argon2 from 'argon2';
import jwt from 'jsonwebtoken';
import crypto from 'crypto';
import { AUTH_CONFIG } from '../config/auth.config.js';
import { userModel, UserRow } from '../models/User.model.js';

export interface TokenPayload {
  sub: string;      // user id
  email: string;
  role: string;
  type: 'access' | 'refresh';
  jti?: string;
}

export class AuthService {
  // ───── Password ─────
  async hashPassword(password: string): Promise<string> {
    return argon2.hash(password, AUTH_CONFIG.argon2Options);
  }

  async verifyPassword(hash: string, password: string): Promise<boolean> {
    try {
      return await argon2.verify(hash, password);
    } catch {
      return false;
    }
  }

  // ───── Register ─────
  async register(params: {
    email: string;
    password: string;
    displayName?: string;
  }): Promise<{ user: Omit<UserRow, 'password_hash'>; accessToken: string; refreshToken: string }> {
    const existing = userModel.findByEmail(params.email);
    if (existing) throw Object.assign(new Error('Email already registered'), { status: 409 });

    const id = crypto.randomUUID();
    const password_hash = await this.hashPassword(params.password);

    userModel.create({
      id,
      email: params.email,
      password_hash,
      display_name: params.displayName
    });

    const user = userModel.findById(id)!;
    const tokens = await this.issueTokens(user);

    return {
      user: this.sanitize(user),
      ...tokens
    };
  }

  // ───── Login ─────
  async login(params: {
    email: string;
    password: string;
    userAgent?: string;
    ipAddress?: string;
  }): Promise<{ user: Omit<UserRow, 'password_hash'>; accessToken: string; refreshToken: string }> {
    const user = userModel.findByEmail(params.email);
    if (!user || !user.is_active) {
      throw Object.assign(new Error('Invalid credentials'), { status: 401 });
    }

    const ok = await this.verifyPassword(user.password_hash, params.password);
    if (!ok) throw Object.assign(new Error('Invalid credentials'), { status: 401 });

    userModel.updateLastLogin(user.id);
    const tokens = await this.issueTokens(user, params.userAgent, params.ipAddress);

    return { user: this.sanitize(user), ...tokens };
  }

  // ───── Token Generation ─────
  async issueTokens(
    user: UserRow,
    userAgent?: string,
    ipAddress?: string
  ): Promise<{ accessToken: string; refreshToken: string }> {
    const accessToken = jwt.sign(
      { sub: user.id, email: user.email, role: user.role, type: 'access' } as TokenPayload,
      AUTH_CONFIG.accessTokenSecret,
      { expiresIn: AUTH_CONFIG.accessTokenTTL, issuer: 'apz-wallet' }
    );

    const jti = crypto.randomUUID();
    const refreshToken = jwt.sign(
      { sub: user.id, email: user.email, role: user.role, type: 'refresh', jti } as TokenPayload,
      AUTH_CONFIG.refreshTokenSecret,
      { expiresIn: AUTH_CONFIG.refreshTokenTTL, issuer: 'apz-wallet' }
    );

    // ذخیره hash رفرش توکن (نه خود توکن)
    const tokenHash = crypto.createHash('sha256').update(refreshToken).digest('hex');
    const decoded = jwt.decode(refreshToken) as { exp: number };

    userModel.saveRefreshToken({
      id: jti,
      user_id: user.id,
      token_hash: tokenHash,
      expires_at: decoded.exp * 1000,
      revoked: 0,
      created_at: Date.now(),
      user_agent: userAgent || null,
      ip_address: ipAddress || null
    });

    return { accessToken, refreshToken };
  }

  // ───── Refresh ─────
  async refresh(refreshToken: string): Promise<{ accessToken: string }> {
    let payload: TokenPayload;
    try {
      payload = jwt.verify(refreshToken, AUTH_CONFIG.refreshTokenSecret) as TokenPayload;
    } catch {
      throw Object.assign(new Error('Invalid refresh token'), { status: 401 });
    }

    if (payload.type !== 'refresh') {
      throw Object.assign(new Error('Wrong token type'), { status: 401 });
    }

    const tokenHash = crypto.createHash('sha256').update(refreshToken).digest('hex');
    const stored = userModel.findRefreshToken(tokenHash);
    if (!stored || stored.expires_at < Date.now()) {
      throw Object.assign(new Error('Refresh token revoked or expired'), { status: 401 });
    }

    const user = userModel.findById(payload.sub);
    if (!user || !user.is_active) {
      throw Object.assign(new Error('User not found'), { status: 401 });
    }

    const accessToken = jwt.sign(
      { sub: user.id, email: user.email, role: user.role, type: 'access' } as TokenPayload,
      AUTH_CONFIG.accessTokenSecret,
      { expiresIn: AUTH_CONFIG.accessTokenTTL, issuer: 'apz-wallet' }
    );

    return { accessToken };
  }

  // ───── Logout ─────
  async logout(refreshToken: string): Promise<void> {
    const tokenHash = crypto.createHash('sha256').update(refreshToken).digest('hex');
    userModel.revokeRefreshToken(tokenHash);
  }

  async logoutAll(userId: string): Promise<void> {
    userModel.revokeAllUserTokens(userId);
  }

  // ───── Verify Access Token ─────
  verifyAccessToken(token: string): TokenPayload {
    try {
      const payload = jwt.verify(token, AUTH_CONFIG.accessTokenSecret) as TokenPayload;
      if (payload.type !== 'access') throw new Error('Wrong token type');
      return payload;
    } catch (err: any) {
      throw Object.assign(new Error('Invalid or expired token'), { status: 401 });
    }
  }

  private sanitize(user: UserRow) {
    const { password_hash, ...rest } = user;
    return rest;
  }
}

export const authService = new AuthService();
```

