import db from '../services/db.service.js';
import { RL_CONFIG } from '../config/rl.config.js';
import crypto from 'crypto';

export class RewardTracker {
  /**
   * ثبت رویداد + برنامهریزی برای محاسبه reward بعداً
   */
  recordEvent(params: {
    userId?: string;
    sessionId?: string;
    ipAddress: string;
    path: string;
    context: number[];
    action: string;
    policyAction: string;
    executedAction: string;
    isExploration: boolean;
    qValues?: Record<string, number>;
    confidence?: number;
    modelVersion?: number;
  }): string {
    const id = crypto.randomUUID();
    const contextHash = crypto
      .createHash('md5')
      .update(params.context.map(v => Math.floor(v * 10)).join(','))
      .digest('hex');

    db.prepare(`
      INSERT INTO rl_events 
        (id, user_id, session_id, ip_address, path, context_vector, context_hash,
         action, policy_action, executed_action, exploration, q_values, confidence,
         model_version, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      id,
      params.userId || null,
      params.sessionId || null,
      params.ipAddress,
      params.path,
      JSON.stringify(params.context),
      contextHash,
      params.action,
      params.policyAction,
      params.executedAction,
      params.isExploration ? 1 : 0,
      params.qValues ? JSON.stringify(params.qValues) : null,
      params.confidence ?? 0,
      params.modelVersion ?? 0,
      Date.now()
    );

    return id;
  }

  /**
   * ثبت reward برای یک event
   */
  recordReward(
    eventId: string,
    reward: number,
    source: string
  ) {
    db.prepare(`
      UPDATE rl_events SET
        reward = ?, reward_source = ?, reward_at = ?
      WHERE id = ?
    `).run(reward, source, Date.now(), eventId);
  }

  /**
   * محاسبه خودکار reward بر اساس نتیجه
   * 
   * این تابع بعد از یه بازه (مثلاً 60 ثانیه) صدا زده میشه
   * و نتیجه واقعی رو بررسی میکنه
   */
  async computeAutoReward(eventId: string) {
    const event = db.prepare('SELECT * FROM rl_events WHERE id = ?')
      .get(eventId) as any;

    if (!event || event.reward !== null) return;

    // نتیجه را از جدولهای دیگر بگیر
    const userId = event.user_id;
    const since = event.created_at;
    const within = since + RL_CONFIG.rewardDelayMs;

    // ───── نشانههای مثبت ─────
    // 1. اگر کاربر بعدش موفق شد
    const successAfter = db.prepare(`
      SELECT COUNT(*) as c FROM threat_intel_events 
      WHERE user_id = ? AND created_at > ? AND created_at < ? AND action = 'allowed'
    `).get(userId, since, within) as { c: number };

    // 2. اگر حمله بلاک شد
    const attackBlocked = db.prepare(`
      SELECT COUNT(*) as c FROM threat_intel_events 
      WHERE user_id = ? AND created_at > ? AND created_at < ? AND action = 'blocked'
    `).get(userId, since, within) as { c: number };

    // ───── محاسبه reward ─────
    const R = RL_CONFIG.rewards;
    let reward = 0;

    if (event.executed_action === 'allow') {
      if (successAfter.c > 0) reward += R.legitAllow;
      if (attackBlocked.c > 0) reward += R.attackAllow; // اشتباه بود
    } else if (event.executed_action === 'block') {
      if (attackBlocked.c > 0) reward += R.attackBlock;
      if (successAfter.c > 0) reward += R.legitBlock; // کاربر مشروع رو بلاک کردی
    } else if (event.executed_action === 'challenge' || event.executed_action === 'step_up') {
      if (successAfter.c > 0) reward += R.stepUpSuccess;
      // اگر چالش رو abandon کرد
      const abandoned = db.prepare(`
        SELECT COUNT(*) as c FROM step_up_challenges 
        WHERE user_id = ? AND created_at > ? AND created_at < ? AND solved_at IS NULL
      `).get(userId, since, within) as { c: number };
      if (abandoned.c > 0) reward += R.stepUpAbandon;
      if (attackBlocked.c > 0) reward += R.falseChallenge * -1;
    }

    this.recordReward(eventId, reward, 'auto');
    return reward;
  }

  /**
   * Batch compute rewards برای event های pending
   */
  computeAllPending() {
    const pending = db.prepare(`
      SELECT id FROM rl_events 
      WHERE reward IS NULL 
        AND created_at < ?
      LIMIT 500
    `).all(Date.now() - RL_CONFIG.rewardDelayMs) as { id: string }[];

    let count = 0;
    for (const { id } of pending) {
      this.computeAutoReward(id);
      count++;
    }
    return count;
  }

  getStats() {
    const total = db.prepare('SELECT COUNT(*) as c FROM rl_events')
      .get() as { c: number };
    const rewarded = db.prepare('SELECT COUNT(*) as c FROM rl_events WHERE reward IS NOT NULL')
      .get() as { c: number };
    const avgReward = db.prepare('SELECT AVG(reward) as avg FROM rl_events WHERE reward IS NOT NULL')
      .get() as { avg: number | null };

    const byAction = db.prepare(`
      SELECT action, COUNT(*) as count, AVG(reward) as avg_reward
      FROM rl_events 
      WHERE reward IS NOT NULL
      GROUP BY action
    `).all();

    return {
      totalEvents: total.c,
      rewardedEvents: rewarded.c,
      avgReward: avgReward.avg || 0,
      byAction
    };
  }
}

