```typescript
import crypto from 'crypto';
import { FL_CONFIG } from '../config/federated.config.js';

/**
 * Shamir Secret Sharing برای Secure Aggregation
 * 
 * ایده: هر کلاینت مقدار خودش رو به n سهم تقسیم میکنه
 * و هر سهم رو با کلید عمومی سرور رمزنگاری میکنه.
 * سرور فقط وقتی میتونه بازسازی کنه که حداقل t سهم رو داشته باشه.
 */

// ───── Modular arithmetic بر روی عدد اول بزرگ ─────
const PRIME = BigInt('170141183460469231731687303715884105727'); // 2^127 - 1

function modPow(base: bigint, exp: bigint, mod: bigint): bigint {
  let result = 1n;
  base = base % mod;
  while (exp > 0n) {
    if (exp % 2n === 1n) result = (result * base) % mod;
    exp = exp / 2n;
    base = (base * base) % mod;
  }
  return result;
}

function modInverse(a: bigint, m: bigint): bigint {
  return modPow(a, m - 2n, m); // Fermat's little theorem (m prime)
}

/**
 * تقسیم یک secret به n سهم با آستانه t
 */
export function splitSecret(
  secret: number,
  numShares: number,
  threshold: number
): { x: number; y: string }[] {
  // تبدیل secret به bigint (مثبت)
  const secretBig = BigInt(Math.round(secret * 1e8)); // precision

  // ساخت چندجملهای درجه t-1
  const coefficients: bigint[] = [secretBig];
  for (let i = 1; i < threshold; i++) {
    const buf = crypto.randomBytes(16);
    coefficients.push(BigInt('0x' + buf.toString('hex')) % PRIME);
  }

  const shares: { x: number; y: string }[] = [];
  for (let x = 1; x <= numShares; x++) {
    let y = 0n;
    const xBig = BigInt(x);

    for (let i = coefficients.length - 1; i >= 0; i--) {
      y = (y * xBig + coefficients[i]) % PRIME;
    }

    shares.push({ x, y: y.toString() });
  }

  return shares;
}

/**
 * بازسازی secret از t سهم
 */
export function reconstructSecret(shares: { x: number; y: string }[]): number {
  let secret = 0n;

  for (let i = 0; i < shares.length; i++) {
    const { x: xi, y: yi } = shares[i];
    const yiBig = BigInt(yi);

    let num = 1n;
    let den = 1n;

    for (let j = 0; j < shares.length; j++) {
      if (i === j) continue;
      const xj = BigInt(shares[j].x);
      num = (num * (-xj)) % PRIME;
      den = (den * (BigInt(xi) - xj)) % PRIME;
    }

    const lagrange = (num * modInverse((den + PRIME) % PRIME, PRIME)) % PRIME;
    secret = (secret + yiBig * lagrange) % PRIME;
  }

  // تبدیل به float
  return Number(secret) / 1e8;
}

/**
 * رمزنگاری یک سهم با کلید سرور
 */
export function encryptShare(share: string, serverPublicKey: string): string {
  // پیادهسازی ساده: AES-256-GCM با کلید مشتقشده از public key
  // (در production از libsodium یا tweetnacl استفاده کن)
  const key = crypto.createHash('sha256').update(serverPublicKey).digest();
  const iv = crypto.randomBytes(12);

  const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);
  const enc = Buffer.concat([cipher.update(share, 'utf8'), cipher.final()]);
  const tag = cipher.getAuthTag();

  return `${iv.toString('hex')}:${tag.toString('hex')}:${enc.toString('hex')}`;
}

/**
 * رمزگشایی سهم
 */
export function decryptShare(encrypted: string, serverPrivateKey: string): string {
  const [ivHex, tagHex, encHex] = encrypted.split(':');
  const key = crypto.createHash('sha256').update(serverPrivateKey).digest();

  const decipher = crypto.createDecipheriv(
    'aes-256-gcm',
    key,
    Buffer.from(ivHex, 'hex')
  );
  decipher.setAuthTag(Buffer.from(tagHex, 'hex'));

  const dec = Buffer.concat([
    decipher.update(Buffer.from(encHex, 'hex')),
    decipher.final()
  ]);

  return dec.toString('utf8');
}
