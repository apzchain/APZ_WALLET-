import crypto from 'crypto';
import { FL_CONFIG } from '../config/federated.config.js';
import { aggregate, ClientUpdate } from '../fl/fedAvg.js';
import { applyDp } from '../fl/differentialPrivacy.js';
import db from './db.service.js';

export interface ClientWeightPayload {
  clientId: string;
  samples: number;
  weights: number[][];
  loss?: number;
  localEpochs: number;
}

export class FederatedLearningService {
  private currentRound: string | null = null;
  private roundNumber = 0;

  /**
   * ایجاد round جدید
   */
  startRound(): { roundId: string; roundNumber: number; targetClients: number } {
    // ───── 1. انتخاب کلاینتها ─────
    const activeClients = db.prepare(`
      SELECT id FROM fl_clients 
      WHERE is_active = 1 AND total_samples >= ?
      ORDER BY RANDOM()
      LIMIT ?
    `).all(FL_CONFIG.minLocalSamples, FL_CONFIG.maxClients) as { id: string }[];

    if (activeClients.length < FL_CONFIG.minClients) {
      throw new Error(`Not enough clients: ${activeClients.length} < ${FL_CONFIG.minClients}`);
    }

    // نمونهگیری نسبی
    const fraction = Math.max(
      FL_CONFIG.minClients,
      Math.floor(activeClients.length * FL_CONFIG.clientFraction)
    );

    this.roundNumber++;

    // ───── 2. ثبت round ─────
    const roundId = crypto.randomUUID();
    const lastModel = db.prepare(`
      SELECT version FROM fl_global_models ORDER BY version DESC LIMIT 1
    `).get() as { version: number } | undefined;

    db.prepare(`
      INSERT INTO fl_rounds 
        (id, round_number, status, target_clients, aggregation_algorithm,
         global_model_version, started_at)
      VALUES (?, ?, 'collecting', ?, ?, ?, ?)
    `).run(
      roundId,
      this.roundNumber,
      fraction,
      FL_CONFIG.aggregation,
      lastModel?.version || 0,
      Date.now()
    );

    this.currentRound = roundId;

    return {
      roundId,
      roundNumber: this.roundNumber,
      targetClients: fraction
    };
  }

  /**
   * دریافت update از کلاینت
   */
  receiveUpdate(roundId: string, payload: ClientWeightPayload): { accepted: boolean; reason?: string } {
    const round = db.prepare('SELECT * FROM fl_rounds WHERE id = ?')
      .get(roundId) as any;
    if (!round) return { accepted: false, reason: 'round_not_found' };
    if (round.status !== 'collecting') return { accepted: false, reason: 'round_closed' };

    // ───── 1. اعمال DP ─────
    const { weights: dpWeights, noiseApplied } = applyDp(payload.weights);

    // ───── 2. هش برای deduplication ─────
    const hash = crypto
      .createHash('sha256')
      .update(JSON.stringify(dpWeights))
      .digest('hex');

    const existing = db.prepare(
      'SELECT id FROM fl_client_updates WHERE round_id = ? AND weights_hash = ?'
    ).get(roundId, hash);
    if (existing) return { accepted: false, reason: 'duplicate' };

    // ───── 3. ذخیره ─────
    try {
      db.prepare(`
        INSERT INTO fl_client_updates 
          (id, round_id, client_id, samples_count, weights_blob, weights_hash,
           loss, local_epochs, noise_added, received_at)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `).run(
        crypto.randomUUID(),
        roundId,
        payload.clientId,
        payload.samples,
        JSON.stringify(dpWeights),
        hash,
        payload.loss ?? null,
        payload.localEpochs,
        noiseApplied ? 1 : 0,
        Date.now()
      );

      // بهروزرسانی آمار کلاینت
      db.prepare(`
        UPDATE fl_clients SET
          total_rounds = total_rounds + 1,
          total_samples = total_samples + ?,
          last_seen_at = ?
        WHERE id = ?
      `).run(payload.samples, Date.now(), payload.clientId);

      // بهروزرسانی تعداد join شده
      db.prepare('UPDATE fl_rounds SET joined_clients = joined_clients + 1 WHERE id = ?')
        .run(roundId);

      return { accepted: true };
    } catch (err: any) {
      return { accepted: false, reason: err.message };
    }
  }

  /**
   * تجمیع round و تولید مدل جدید
   */
  async aggregateRound(roundId: string): Promise<{ newVersion: number; participants: number }> {
    const round = db.prepare('SELECT * FROM fl_rounds WHERE id = ?')
      .get(roundId) as any;
    if (!round) throw new Error('Round not found');

    db.prepare('UPDATE fl_rounds SET status = ? WHERE id = ?')
      .run('aggregating', roundId);

    try {
      const updates = db.prepare(`
        SELECT * FROM fl_client_updates WHERE round_id = ?
      `).all(roundId) as any[];

      if (updates.length < FL_CONFIG.minClients) {
        throw new Error(`Not enough updates: ${updates.length}`);
      }

      // ───── 1. آمادهسازی ─────
      const clientUpdates: ClientUpdate[] = updates.map(u => ({
        clientId: u.client_id,
        samples: u.samples_count,
        weights: JSON.parse(u.weights_blob)
      }));

      // ───── 2. تجمیع ─────
      const aggregatedWeights = aggregate(clientUpdates, FL_CONFIG.aggregation);

      // ───── 3. ذخیره مدل جدید ─────
      const totalSamples = clientUpdates.reduce((s, u) => s + u.samples, 0);
      const avgLoss = updates.reduce((s, u) => s + (u.loss || 0), 0) / updates.length;

      const result = db.prepare(`
        INSERT INTO fl_global_models 
          (round_id, weights_blob, total_samples, participants, loss, created_at)
        VALUES (?, ?, ?, ?, ?, ?)
      `).run(
        roundId,
        JSON.stringify(aggregatedWeights),
        totalSamples,
        updates.length,
        avgLoss,
        Date.now()
      );

      const newVersion = Number(result.lastInsertRowid);

      // ───── 4. بهروزرسانی round ─────
      db.prepare(`
        UPDATE fl_rounds SET
          status = 'completed',
          completed_at = ?,
          duration_ms = ? - started_at,
          new_model_version = ?
        WHERE id = ?
      `).run(Date.now(), Date.now(), newVersion, roundId);

      this.currentRound = null;

      return {
        newVersion,
        participants: updates.length
      };
    } catch (err: any) {
      db.prepare(`
        UPDATE fl_rounds SET status = 'failed', error = ?, completed_at = ?
        WHERE id = ?
      `).run(err.message, Date.now(), roundId);
      throw err;
    }
  }

  /**
   * ثبتنام کلاینت
   */
  registerClient(params: {
    userId?: string;
    fingerprint: string;
  }): { clientId: string } {
    const existing = db.prepare('SELECT id FROM fl_clients WHERE device_fingerprint = ?')
      .get(params.fingerprint) as { id: string } | undefined;

    if (existing) {
      db.prepare(`
        UPDATE fl_clients SET
          is_active = 1,
          last_seen_at = ?,
          opted_out_at = NULL
        WHERE id = ?
      `).run(Date.now(), existing.id);
      return { clientId: existing.id };
    }

    const id = crypto.randomUUID();
    db.prepare(`
      INSERT INTO fl_clients 
        (id, user_id, device_fingerprint, first_seen_at, last_seen_at, opted_in_at)
      VALUES (?, ?, ?, ?, ?, ?)
    `).run(
      id,
      params.userId || null,
      params.fingerprint,
      Date.now(),
      Date.now(),
      Date.now()
    );

    return { clientId: id };
  }

  /**
   * خروج کلاینت
   */
  optOut(clientId: string) {
    db.prepare(`
      UPDATE fl_clients SET is_active = 0, opted_out_at = ? WHERE id = ?
    `).run(Date.now(), clientId);
  }

  /**
   * دریافت مدل جهانی برای کلاینت
   */
  getGlobalModel(): { version: number; weights: number[][] } | null {
    const row = db.prepare(`
      SELECT * FROM fl_global_models ORDER BY version DESC LIMIT 1
    `).get() as any;

    if (!row) return null;
    return {
      version: row.version,
      weights: JSON.parse(row.weights_blob)
    };
  }

  getStats() {
    const totalClients = db.prepare('SELECT COUNT(*) as c FROM fl_clients WHERE is_active = 1')
      .get() as { c: number };
    const totalRounds = db.prepare('SELECT COUNT(*) as c FROM fl_rounds')
      .get() as { c: number };
    const globalModel = db.prepare('SELECT * FROM fl_global_models ORDER BY version DESC LIMIT 1')
      .get() as any;

    const recentRounds = db.prepare(`
      SELECT * FROM fl_rounds ORDER BY started_at DESC LIMIT 20
    `).all();

    return {
      enabled: FL_CONFIG.enabled,
      aggregation: FL_CONFIG.aggregation,
      dpEnabled: FL_CONFIG.dp.enabled,
      activeClients: totalClients.c,
      minClients: FL_CONFIG.minClients,
      totalRounds: totalRounds.c,
      globalModel: globalModel ? {
        version: globalModel.version,
        participants: globalModel.participants,
        totalSamples: globalModel.total_samples,
        loss: globalModel.loss,
        createdAt: globalModel.created_at
      } : null,
      recentRounds
    };
  }
}

export const flService = new FederatedLearningService();
