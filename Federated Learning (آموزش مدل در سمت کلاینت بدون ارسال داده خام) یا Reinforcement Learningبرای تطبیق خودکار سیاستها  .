🧠 server/fl/fedAvg.ts — الگوریتم FedAvg

```typescript
import { FL_CONFIG } from '../config/federated.config.js';

export interface ClientUpdate {
  clientId: string;
  samples: number;
  weights: number[][];   // layers × values
}

/**
 * Federated Averaging (McMahan et al., 2017)
 * 
 * W_global = Σ (n_k / n_total) × W_k
 * 
 */
export function federatedAveraging(updates: ClientUpdate[]): number[][] {
  if (updates.length === 0) throw new Error('No updates to aggregate');

  const totalSamples = updates.reduce((sum, u) => sum + u.samples, 0);
  if (totalSamples === 0) throw new Error('Total samples is 0');

  const numLayers = updates[0].weights.length;
  const aggregated: number[][] = [];

  for (let layerIdx = 0; layerIdx < numLayers; layerIdx++) {
    const layerSize = updates[0].weights[layerIdx].length;
    const layerWeights = new Array(layerSize).fill(0);

    for (const update of updates) {
      const weight = update.samples / totalSamples;
      const layer = update.weights[layerIdx];

      for (let i = 0; i < layerSize; i++) {
        layerWeights[i] += layer[i] * weight;
      }
    }

    aggregated.push(layerWeights);
  }

  return aggregated;
}

/**
 * FedProx — مقاوم به ناهمگونی داده
 * نسخه ساده: با proximal term که در آموزش محلی اعمال میشه
 * اینجا فقط aggregation رو یکم متفاوت میکنیم
 */
export function fedProxAggregate(updates: ClientUpdate[]): number[][] {
  // در پیادهسازی ساده، همون FedAvg
  // تفاوت اصلی در local training هست (proximal term اضافه میشه)
  return federatedAveraging(updates);
}

/**
 * Coordinate-wise Median — مقاوم به Byzantine attacks
 * 
 */
export function medianAggregate(updates: ClientUpdate[]): number[][] {
  const numLayers = updates[0].weights.length;
  const result: number[][] = [];

  for (let layerIdx = 0; layerIdx < numLayers; layerIdx++) {
    const layerSize = updates[0].weights[layerIdx].length;
    const layerMedian: number[] = [];

    for (let i = 0; i < layerSize; i++) {
      const values = updates.map(u => u.weights[layerIdx][i]);
      values.sort((a, b) => a - b);

      const mid = Math.floor(values.length / 2);
      const median = values.length % 2 === 0
        ? (values[mid - 1] + values[mid]) / 2
        : values[mid];

      layerMedian.push(median);
    }

    result.push(layerMedian);
  }

  return result;
}

export function aggregate(updates: ClientUpdate[], algorithm: string): number[][] {
  switch (algorithm) {
    case 'median': return medianAggregate(updates);
    case 'fedprox': return fedProxAggregate(updates);
    case 'fedavg':
    default: return federatedAveraging(updates);
  }
}
