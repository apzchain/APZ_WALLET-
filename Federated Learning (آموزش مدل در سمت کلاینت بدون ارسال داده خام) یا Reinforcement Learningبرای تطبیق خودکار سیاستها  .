import { Request, Response, NextFunction } from 'express';
import { rlPolicyService } from '../services/rlPolicy.service.js';
import { RL_CONFIG } from '../config/rl.config.js';

declare global {
  namespace Express {
    interface Request {
      rl?: any;
    }
  }
}

export function rlPolicyGuard(req: Request, res: Response, next: NextFunction) {
  if (!RL_CONFIG.enabled) return next();

  const user = (req as any).user;
  if (!user) return next();

  const ip = req.ip || 'unknown';
  const trust = (req as any).zt?.trust;
  const vpn = (req as any).vpnDetection;
  const bot = (req as any).botDetection;
  const threat = (req as any).threatIntel;
  const ml = (req as any).mlAnomaly;

  // path sensitivity
  const sensitive = /admin|wallet\/create|tx\/send|2fa\/disable/.test(req.path);
  const pathSensitivity = sensitive ? 1 : 0.3;

  try {
    const decision = rlPolicyService.decide({
      userId: user.sub,
      sessionId: user.jti || user.sessionId,
      ipAddress: ip,
      path: req.path,
      trustScore: trust?.score ?? 50,
      vpnRisk: vpn?.riskScore ?? 0,
      botRisk: bot?.riskScore ?? 0,
      threatRisk: threat?.riskScore ?? 0,
      mlAnomalyScore: ml?.score ?? 0,
      sessionAgeMs: Date.now() - (trust?.components ? Date.now() : Date.now()),
      isNewDevice: (req as any).zt?.device?.is_trusted === 0,
      role: user.role || 'user',
      pathSensitivity,
      recentFailures: 0,
      geoRisk: 0
    });

    req.rl = decision;

    // ───── اجرا ─────
    switch (decision.action) {
      case 'block':
        return res.status(403).json({
          success: false,
          code: 'RL_BLOCKED',
          error: 'Access denied by adaptive policy',
          confidence: decision.confidence
        });

      case 'step_up':
        return res.status(403).json({
          success: false,
          code: 'RL_STEP_UP',
          error: 'Additional verification required',
          confidence: decision.confidence,
          eventId: decision.eventId
        });

      case 'challenge':
        return res.status(403).json({
          success: false,
          code: 'RL_CHALLENGE',
          error: 'Challenge required',
          confidence: decision.confidence,
          eventId: decision.eventId
        });

      case 'allow':
      default:
        return next();
    }
  } catch (err) {
    console.error('[RL] error:', err);
    next();
  }
}
