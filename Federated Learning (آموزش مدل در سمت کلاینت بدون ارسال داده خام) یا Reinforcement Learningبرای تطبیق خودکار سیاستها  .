```typescript
import crypto from 'crypto';
import { FL_CONFIG } from '../config/federated.config.js';

/**
 * Clip کردن گرادیان/وزن به norm مشخص
 * این جلوی تأثیر زیاد یک کلاینت رو میگیره
 */
export function clipWeights(weights: number[][], clipNorm: number): number[][] {
  // محاسبه L2 norm کل
  let totalNorm = 0;
  for (const layer of weights) {
    for (const w of layer) {
      totalNorm += w * w;
    }
  }
  totalNorm = Math.sqrt(totalNorm);

  if (totalNorm <= clipNorm) return weights;

  const scale = clipNorm / totalNorm;
  return weights.map(layer => layer.map(w => w * scale));
}

/**
 * اضافه کردن نویز گاوسی (Gaussian Mechanism)
 * noise ~ N(0, σ²) که σ = noiseMultiplier × clipNorm
 */
export function addGaussianNoise(
  weights: number[][],
  clipNorm: number,
  noiseMultiplier: number
): number[][] {
  const sigma = noiseMultiplier * clipNorm;

  return weights.map(layer =>
    layer.map(w => {
      const noise = gaussianRandom(0, sigma);
      return w + noise;
    })
  );
}

/**
 * Box-Muller transform برای نویز گاوسی
 * (چون crypto.randomBytes یکنواخت میده)
 */
function gaussianRandom(mean: number, std: number): number {
  const buf = crypto.randomBytes(16);
  const u1 = buf.readUInt32BE(0) / 0xFFFFFFFF;
  const u2 = buf.readUInt32BE(4) / 0xFFFFFFFF;

  const z = Math.sqrt(-2 * Math.log(u1 || 1e-10)) * Math.cos(2 * Math.PI * u2);
  return mean + z * std;
}

/**
 * محاسبه epsilon مصرفشده با moment accountant (تقریبی)
 * برای DP-SGD ساده، epsilon تقریبی حساب میشه
 */
export function computeEpsilon(
  steps: number,
  sampleRate: number,
  noiseMultiplier: number,
  delta: number
): number {
  // فرمول ساده از Abadi et al. 2016
  const q = sampleRate;
  const sigma = noiseMultiplier;

  // ε ≈ q × sqrt(2 × steps × ln(1/δ)) / σ
  const epsilon = (q * Math.sqrt(2 * steps * Math.log(1 / delta))) / sigma;
  return epsilon;
}

/**
 * اعمال کامل DP (clip + noise)
 */
export function applyDp(weights: number[][]): {
  weights: number[][];
  noiseApplied: boolean;
} {
  if (!FL_CONFIG.dp.enabled) {
    return { weights, noiseApplied: false };
  }

  const clipped = clipWeights(weights, FL_CONFIG.dp.clipNorm);
  const noisy = addGaussianNoise(clipped, FL_CONFIG.dp.clipNorm, FL_CONFIG.dp.noiseMultiplier);

  return { weights: noisy, noiseApplied: true };
}
