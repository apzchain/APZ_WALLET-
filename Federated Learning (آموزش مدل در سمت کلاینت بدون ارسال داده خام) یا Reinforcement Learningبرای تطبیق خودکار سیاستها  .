import * as tf from '@tensorflow/tfjs';

/**
 * کلاینت Federated Learning
 * 
 * آموزش مدل محلی روی دادههایی که هرگز از مرورگر خارج نمیشن
 * فقط weights نهایی آپلود میشه
 */

const LOCAL_DB_NAME = 'apz_fl_local';
const LOCAL_DB_VERSION = 1;
const STORE_NAME = 'feature_vectors';

export interface LocalFeatureVector {
  features: number[];
  timestamp: number;
}

export class LocalTrainer {
  private db: IDBDatabase | null = null;
  private model: tf.LayersModel | null = null;
  private inputDim = 20;
  private hiddenDim = 16;
  private latentDim = 8;

  /**
   * راهاندازی IndexedDB برای ذخیره داده محلی
   */
  async init(): Promise<void> {
    this.db = await this.openDb();
  }

  private openDb(): Promise<IDBDatabase> {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(LOCAL_DB_NAME, LOCAL_DB_VERSION);

      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
        }
      };

      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  /**
   * ذخیره یک feature vector محلی
   */
  async store(vector: number[]): Promise<void> {
    if (!this.db) await this.init();

    return new Promise((resolve, reject) => {
      const tx = this.db!.transaction(STORE_NAME, 'readwrite');
      const store = tx.objectStore(STORE_NAME);

      store.add({
        features: vector,
        timestamp: Date.now()
      });

      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  /**
   * خواندن همه دادههای محلی
   */
  async loadAll(): Promise<number[][]> {
    if (!this.db) await this.init();

    return new Promise((resolve, reject) => {
      const tx = this.db!.transaction(STORE_NAME, 'readonly');
      const store = tx.objectStore(STORE_NAME);

      const req = store.getAll();
      req.onsuccess = () => {
        const rows = req.result as LocalFeatureVector[];
        resolve(rows.map(r => r.features));
      };
      req.onerror = () => reject(req.error);
    });
  }

  async count(): Promise<number> {
    if (!this.db) await this.init();

    return new Promise((resolve, reject) => {
      const tx = this.db!.transaction(STORE_NAME, 'readonly');
      const req = tx.objectStore(STORE_NAME).count();
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  /**
   * ساخت مدل محلی از روی مدل جهانی
   */
  buildModel(): tf.LayersModel {
    const model = tf.sequential();

    model.add(tf.layers.dense({
      inputShape: [this.inputDim],
      units: this.hiddenDim,
      activation: 'relu'
    }));
    model.add(tf.layers.dense({
      units: this.latentDim,
      activation: 'relu'
    }));
    model.add(tf.layers.dense({
      units: this.hiddenDim,
      activation: 'relu'
    }));
    model.add(tf.layers.dense({
      units: this.inputDim,
      activation: 'sigmoid'
    }));

    model.compile({
      optimizer: tf.train.adam(0.01),
      loss: 'meanSquaredError'
    });

    this.model = model;
    return model;
  }

  /**
   * بارگذاری weights جهانی روی مدل محلی
   */
  async loadGlobalWeights(weights: number[][]): Promise<void> {
    if (!this.model) this.buildModel();
    await this.model!.setWeights(weights.map(w => tf.tensor(w)));
  }

  /**
   * استخراج weights از مدل (برای آپلود)
   */
  extractWeights(): number[][] {
    if (!this.model) throw new Error('Model not built');
    const weights = this.model.getWeights();
    return weights.map(w => Array.from(w.dataSync()));
  }

  /**
   * آموزش محلی روی دادهها
   */
  async trainLocal(epochs = 3, batchSize = 16): Promise<{
    samples: number;
    loss: number;
    weights: number[][];
  }> {
    const data = await this.loadAll();
    if (data.length < 20) {
      throw new Error(`Not enough local data: ${data.length}`);
    }

    if (!this.model) this.buildModel();

    const tensor = tf.tensor2d(data);

    const history = await this.model!.fit(tensor, tensor, {
      epochs,
      batchSize: Math.min(batchSize, data.length),
      shuffle: true,
      verbose: 0
    });

    const finalLoss = history.history.loss[history.history.loss.length - 1] as number;
    const weights = this.extractWeights();

    tensor.dispose();

    return {
      samples: data.length,
      loss: finalLoss,
      weights
    };
  }

  /**
   * پاک کردن دادههای قدیمی
   */
  async prune(olderThanMs = 30 * 24 * 3600 * 1000): Promise<number> {
    if (!this.db) await this.init();

    const cutoff = Date.now() - olderThanMs;

    return new Promise((resolve, reject) => {
      const tx = this.db!.transaction(STORE_NAME, 'readwrite');
      const store = tx.objectStore(STORE_NAME);
      const req = store.openCursor();
      let deleted = 0;

      req.onsuccess = () => {
        const cursor = req.result;
        if (!cursor) return;
        const value = cursor.value as LocalFeatureVector;
        if (value.timestamp < cutoff) {
          cursor.delete();
          deleted++;
        }
        cursor.continue();
      };

      tx.oncomplete = () => resolve(deleted);
      tx.onerror = () => reject(tx.error);
    });
  }
}

export const localTrainer = new LocalTrainer();
