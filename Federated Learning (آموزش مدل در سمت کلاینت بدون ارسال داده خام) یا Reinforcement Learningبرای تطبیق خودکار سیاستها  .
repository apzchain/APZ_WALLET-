import crypto from 'crypto';
import db from '../services/db.service.js';
import { RL_CONFIG, RlAction } from '../config/rl.config.js';

/**
 * Tabular Q-Learning با discretization بُعد بالا
 * State = hash شده از context vector (bucketized)
 */

function discretizeContext(context: number[]): string {
  // هر feature به 5 bucket تقسیم میشه
  const buckets = context.map(v => Math.min(4, Math.floor(v * 5)));
  return crypto.createHash('md5').update(buckets.join(',')).digest('hex').slice(0, 16);
}

export class QLearning {
  /**
   * انتخاب action با epsilon-greedy
   */
  selectAction(context: number[]): { action: RlAction; qValues: Record<string, number>; isExploration: boolean } {
    const stateHash = discretizeContext(context);
    const qValues = this.getQValues(stateHash);

    // epsilon-greedy
    const isExploration = Math.random() < RL_CONFIG.epsilon;

    if (isExploration) {
      const randomAction = RL_CONFIG.actions[
        Math.floor(Math.random() * RL_CONFIG.actions.length)
      ];
      return { action: randomAction, qValues, isExploration: true };
    }

    // انتخاب بهترین
    let bestAction: RlAction = 'allow';
    let bestQ = -Infinity;

    for (const action of RL_CONFIG.actions) {
      const q = qValues[action] ?? 0;
      if (q > bestQ) {
        bestQ = q;
        bestAction = action;
      }
    }

    return { action: bestAction, qValues, isExploration: false };
  }

  /**
   * بهروزرسانی Q-value با Bellman equation
   * 
   * Q(s,a) ← Q(s,a) + α × (r + γ × max_a' Q(s',a') - Q(s,a))
   */
  update(
    stateHash: string,
    action: RlAction,
    reward: number,
    nextStateHash: string
  ) {
    const currentRow = db.prepare(
      'SELECT q_value, visits FROM rl_q_table WHERE state_hash = ? AND action = ?'
    ).get(stateHash, action) as { q_value: number; visits: number } | undefined;

    const currentQ = currentRow?.q_value ?? 0;

    // max_a' Q(s',a')
    const nextMaxRow = db.prepare(
      'SELECT MAX(q_value) as max_q FROM rl_q_table WHERE state_hash = ?'
    ).get(nextStateHash) as { max_q: number | null };

    const maxNextQ = nextMaxRow?.max_q ?? 0;

    // Bellman
    const newQ = currentQ + RL_CONFIG.learningRate * (
      reward + RL_CONFIG.discountFactor * maxNextQ - currentQ
    );

    // upsert
    db.prepare(`
      INSERT INTO rl_q_table (state_hash, action, q_value, visits, last_updated_at)
      VALUES (?, ?, ?, 1, ?)
      ON CONFLICT(state_hash, action) DO UPDATE SET
        q_value = ?,
        visits = visits + 1,
        last_updated_at = ?
    `).run(
      stateHash, action, newQ, Date.now(),
      newQ, Date.now()
    );
  }

  private getQValues(stateHash: string): Record<string, number> {
    const rows = db.prepare(
      'SELECT action, q_value FROM rl_q_table WHERE state_hash = ?'
    ).all(stateHash) as { action: string; q_value: number }[];

    const qValues: Record<string, number> = {};
    for (const action of RL_CONFIG.actions) qValues[action] = 0;

    for (const row of rows) qValues[row.action] = row.q_value;

    return qValues;
  }

  getStats() {
    const total = db.prepare('SELECT COUNT(*) as c FROM rl_q_table')
      .get() as { c: number };
    const avgQ = db.prepare('SELECT AVG(q_value) as avg FROM rl_q_table')
      .get() as { avg: number | null };

    return {
      statesLearned: total.c,
      avgQValue: avgQ.avg || 0
    };
  }
}

export const qLearning = new QLearning();
