import { useEffect, useRef, useState } from 'react';
import { localTrainer } from './localTrainer';

const OPT_IN_KEY = 'apz_fl_opted_in';
const CLIENT_ID_KEY = 'apz_fl_client_id';

interface FederatedState {
  optedIn: boolean;
  localSamples: number;
  lastRoundAt: number | null;
  isTraining: boolean;
  lastError: string | null;
}

export function useFederatedClient(apiCall: (path: string, opts?: any) => Promise<any>) {
  const [state, setState] = useState<FederatedState>({
    optedIn: localStorage.getItem(OPT_IN_KEY) === 'true',
    localSamples: 0,
    lastRoundAt: null,
    isTraining: false,
    lastError: null
  });

  const timerRef = useRef<number | null>(null);

  // ───── راهاندازی ─────
  useEffect(() => {
    localTrainer.init().then(async () => {
      const count = await localTrainer.count();
      setState(s => ({ ...s, localSamples: count }));
    });
  }, []);

  // ───── شرکت در rounds ─────
  useEffect(() => {
    if (!state.optedIn) return;

    const run = async () => {
      try {
        // 1. چک round فعال
        const { data: round } = await apiCall('/fl/current-round');
        if (!round) return;

        // 2. بارگذاری مدل جهانی
        const { data: globalModel } = await apiCall('/fl/global-model');
        if (globalModel) {
          await localTrainer.loadGlobalWeights(globalModel.weights);
        }

        // 3. آموزش محلی
        setState(s => ({ ...s, isTraining: true }));
        const result = await localTrainer.trainLocal(3, 16);

        // 4. ارسال فقط weights (نه داده خام)
        const clientId = localStorage.getItem(CLIENT_ID_KEY);
        await apiCall(`/fl/update/${round.id}`, {
          method: 'POST',
          body: JSON.stringify({
            clientId,
            samples: result.samples,
            weights: result.weights,
            loss: result.loss,
            localEpochs: 3
          })
        });

        setState(s => ({
          ...s,
          isTraining: false,
          lastRoundAt: Date.now(),
          lastError: null
        }));
      } catch (err: any) {
        setState(s => ({ ...s, isTraining: false, lastError: err.message }));
      }
    };

    // هر 5 دقیقه چک کن
    timerRef.current = window.setInterval(run, 5 * 60 * 1000);
    run();

    return () => {
      if (timerRef.current) clearInterval(timerRef.current);
    };
  }, [state.optedIn]);

  const optIn = async (fingerprint: string) => {
    const { data } = await apiCall('/fl/register', {
      method: 'POST',
      body: JSON.stringify({ fingerprint })
    });

    localStorage.setItem(OPT_IN_KEY, 'true');
    localStorage.setItem(CLIENT_ID_KEY, data.clientId);
    setState(s => ({ ...s, optedIn: true }));
  };

  const optOut = async () => {
    const clientId = localStorage.getItem(CLIENT_ID_KEY);
    if (clientId) {
      await apiCall('/fl/opt-out', {
        method: 'POST',
        body: JSON.stringify({ clientId })
      });
    }

    localStorage.setItem(OPT_IN_KEY, 'false');
    setState(s => ({ ...s, optedIn: false }));
  };

  const recordLocalSample = (vector: number[]) => {
    if (!state.optedIn) return;
    localTrainer.store(vector).then(async () => {
      const count = await localTrainer.count();
      setState(s => ({ ...s, localSamples: count }));
    });
  };

  return {
    ...state,
    optIn,
    optOut,
    recordLocalSample
  };
}
