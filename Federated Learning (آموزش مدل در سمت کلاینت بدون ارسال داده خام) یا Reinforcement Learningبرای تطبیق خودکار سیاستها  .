import db from '../services/db.service.js';
import { RL_CONFIG, RlAction } from '../config/rl.config.js';

/**
 * LinUCB (Linear Upper Confidence Bound)
 * 
 * برای هر action:
 *   - A_a: ماتریس (d × d)
 *   - b_a: بردار (d)
 *   - θ_a = A_a^-1 × b_a
 *   - UCB_a = θ_a^T × x + α × sqrt(x^T × A_a^-1 × x)
 * 
 * انتخاب action با بالاترین UCB
 */
export class LinUCB {
  private alpha = 0.5; // exploration parameter

  /**
   * انتخاب action
   */
  selectAction(context: number[]): {
    action: RlAction;
    ucbScores: Record<string, number>;
    isExploration: boolean;
  } {
    const d = context.length;
    const ucbScores: Record<string, number> = {};

    for (const action of RL_CONFIG.actions) {
      const params = this.loadParams(action, d);
      const theta = this.computeTheta(params.A, params.b);
      const p = this.computeUCB(context, params.A, theta, this.alpha);

      ucbScores[action] = p;
    }

    // انتخاب بالاترین
    let bestAction: RlAction = 'allow';
    let bestScore = -Infinity;

    for (const [action, score] of Object.entries(ucbScores)) {
      if (score > bestScore) {
        bestScore = score;
        bestAction = action as RlAction;
      }
    }

    // exploration flag: اگر UCB بالا به دلیل uncertainty باشه
    const isExploration = Math.random() < RL_CONFIG.epsilon;

    return {
      action: isExploration
        ? RL_CONFIG.actions[Math.floor(Math.random() * RL_CONFIG.actions.length)]
        : bestAction,
      ucbScores,
      isExploration
    };
  }

  /**
   * بهروزرسانی بعد از مشاهده reward
   * A_a ← A_a + x × x^T
   * b_a ← b_a + r × x
   */
  update(action: RlAction, context: number[], reward: number) {
    const d = context.length;
    const params = this.loadParams(action, d);

    // A += x × x^T
    const newA = params.A.map((row, i) =>
      row.map((val, j) => val + context[i] * context[j])
    );

    // b += r × x
    const newB = params.b.map((val, i) => val + reward * context[i]);

    this.saveParams(action, newA, newB, 1, reward);
  }

  // ───── Linear Algebra Helpers ─────

  private computeTheta(A: number[][], b: number[]): number[] {
    const invA = this.invertMatrix(A);
    return this.matVec(invA, b);
  }

  private computeUCB(
    context: number[],
    A: number[][],
    theta: number[],
    alpha: number
  ): number {
    const exploitation = this.dot(theta, context);
    const invA = this.invertMatrix(A);
    const quadForm = this.quadraticForm(context, invA);
    const exploration = alpha * Math.sqrt(Math.max(0, quadForm));
    return exploitation + exploration;
  }

  private dot(a: number[], b: number[]): number {
    return a.reduce((sum, ai, i) => sum + ai * b[i], 0);
  }

  private matVec(m: number[][], v: number[]): number[] {
    return m.map(row => this.dot(row, v));
  }

  private quadraticForm(x: number[], m: number[][]): number {
    const mx = this.matVec(m, x);
    return this.dot(x, mx);
  }

  /**
   * ماتریس معکوس با Gauss-Jordan
   */
  private invertMatrix(matrix: number[][]): number[][] {
    const n = matrix.length;
    // augmented [A | I]
    const aug: number[][] = matrix.map((row, i) => [
      ...row,
      ...Array(n).fill(0).map((_, j) => (i === j ? 1 : 0))
    ]);

    // Forward elimination
    for (let i = 0; i < n; i++) {
      // pivot
      let maxRow = i;
      for (let k = i + 1; k < n; k++) {
        if (Math.abs(aug[k][i]) > Math.abs(aug[maxRow][i])) maxRow = k;
      }
      [aug[i], aug[maxRow]] = [aug[maxRow], aug[i]];

      // در صورت نزدیک به صفر، regularization اضافه کن
      if (Math.abs(aug[i][i]) < 1e-10) aug[i][i] = 1e-10;

      // normalize
      const pivot = aug[i][i];
      for (let j = 0; j < 2 * n; j++) aug[i][j] /= pivot;

      // eliminate
      for (let k = 0; k < n; k++) {
        if (k === i) continue;
        const factor = aug[k][i];
        for (let j = 0; j < 2 * n; j++) {
          aug[k][j] -= factor * aug[i][j];
        }
      }
    }

    return aug.map(row => row.slice(n));
  }

  // ───── DB ─────

  private loadParams(action: RlAction, d: number) {
    const row = db.prepare('SELECT * FROM rl_linucb WHERE action = ?')
      .get(action) as any;

    if (!row) {
      return {
        A: Array(d).fill(0).map((_, i) =>
          Array(d).fill(0).map((_, j) => (i === j ? 1 : 0))  // identity
        ),
        b: Array(d).fill(0)
      };
    }

    return {
      A: JSON.parse(row.a_matrix),
      b: JSON.parse(row.b_vector)
    };
  }

  private saveParams(
    action: RlAction,
    A: number[][],
    b: number[],
    pullsDelta: number,
    rewardDelta: number
  ) {
    db.prepare(`
      INSERT INTO rl_linucb (action, a_matrix, b_vector, pulls, total_reward, last_updated_at)
      VALUES (?, ?, ?, ?, ?, ?)
      ON CONFLICT(action) DO UPDATE SET
        a_matrix = ?,
        b_vector = ?,
        pulls = pulls + ?,
        total_reward = total_reward + ?,
        last_updated_at = ?
    `).run(
      action,
      JSON.stringify(A),
      JSON.stringify(b),
      pullsDelta,
      rewardDelta,
      Date.now(),
      JSON.stringify(A),
      JSON.stringify(b),
      pullsDelta,
      rewardDelta,
      Date.now()
    );
  }

  getStats() {
    const rows = db.prepare('SELECT * FROM rl_linucb').all() as any[];
    return rows.map(r => ({
      action: r.action,
      pulls: r.pulls,
      avgReward: r.pulls > 0 ? r.total_reward / r.pulls : 0
    }));
  }
}

export const linUCB = new LinUCB();
