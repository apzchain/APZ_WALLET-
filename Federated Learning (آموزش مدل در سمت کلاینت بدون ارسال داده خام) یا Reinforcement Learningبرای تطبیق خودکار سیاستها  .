import crypto from 'crypto';
import db from './db.service.js';
import { RL_CONFIG, RlAction } from '../config/rl.config.js';
import { qLearning } from '../rl/qLearning.js';
import { linUCB } from '../rl/contextualBandit.js';
import { rewardTracker } from '../rl/rewardTracker.js';

export interface RlDecision {
  action: RlAction;
  policyAction: RlAction;
  confidence: number;
  context: number[];
  isExploration: boolean;
  qValues?: Record<string, number>;
  ucbScores?: Record<string, number>;
  shadowMode: boolean;
  eventId: string;
}

export class RlPolicyService {
  private eventsSeen = 0;
  private modelVersion = 1;

  /**
   * تصمیمگیری با RL
   */
  decide(params: {
    userId?: string;
    sessionId?: string;
    ipAddress: string;
    path: string;
    // context raw inputs
    trustScore: number;           // 0-100
    vpnRisk: number;              // 0-100
    botRisk: number;              // 0-100
    threatRisk: number;           // 0-100
    mlAnomalyScore: number;       // 0-1
    sessionAgeMs: number;
    isNewDevice: boolean;
    role: string;
    pathSensitivity: number;      // 0-1
    recentFailures: number;
    geoRisk: number;              // 0-1
  }): RlDecision {
    // ───── 1. ساخت context vector (12 بُعد نرمالیزه) ─────
    const context = this.buildContext(params);

    // ───── 2. انتخاب action ─────
    let decision: { action: RlAction; qValues?: any; ucbScores?: any; isExploration: boolean };

    if (RL_CONFIG.algorithm === 'linucb') {
      decision = linUCB.selectAction(context);
    } else {
      decision = qLearning.selectAction(context);
    }

    const policyAction = decision.action;

    // ───── 3. Shadow mode ─────
    const shadowMode = RL_CONFIG.shadowMode || this.eventsSeen < RL_CONFIG.minEventsBeforeActive;
    const executedAction = shadowMode
      ? this.getHeuristicAction(params)
      : policyAction;

    // ───── 4. ثبت رویداد ─────
    const eventId = rewardTracker.recordEvent({
      userId: params.userId,
      sessionId: params.sessionId,
      ipAddress: params.ipAddress,
      path: params.path,
      context,
      action: policyAction,
      policyAction,
      executedAction,
      isExploration: decision.isExploration,
      qValues: decision.qValues,
      modelVersion: this.modelVersion
    });

    this.eventsSeen++;

    return {
      action: executedAction,
      policyAction,
      confidence: this.computeConfidence(decision),
      context,
      isExploration: decision.isExploration,
      qValues: decision.qValues,
      ucbScores: decision.ucbScores,
      shadowMode,
      eventId
    };
  }

  /**
   * ثبت reward + بهروزرسانی مدل
   */
  learn(params: {
    eventId: string;
    reward: number;
    nextContext?: number[];
  }) {
    // ثبت پاداش
    rewardTracker.recordReward(params.eventId, params.reward, 'manual');

    // پیدا کردن event
    const event = db.prepare('SELECT * FROM rl_events WHERE id = ?')
      .get(params.eventId) as any;
    if (!event) return;

    const context = JSON.parse(event.context_vector);
    const nextContext = params.nextContext || context;
    const action = event.action as RlAction;

    // بهروزرسانی مدل
    if (RL_CONFIG.algorithm === 'linucb') {
      linUCB.update(action, context, params.reward);
    } else {
      const stateHash = crypto
        .createHash('md5')
        .update(context.map((v: number) => Math.min(4, Math.floor(v * 5))).join(','))
        .digest('hex').slice(0, 16);

      const nextStateHash = crypto
        .createHash('md5')
        .update(nextContext.map((v: number) => Math.min(4, Math.floor(v * 5))).join(','))
        .digest('hex').slice(0, 16);

      qLearning.update(stateHash, action, params.reward, nextStateHash);
    }
  }

  /**
   * Batch learn از event های auto-rewarded
   */
  learnFromPending() {
    const count = rewardTracker.computeAllPending();
    return { processed: count };
  }

  /**
   * ساخت policy snapshot
   */
  snapshot() {
    const algorithm = RL_CONFIG.algorithm;

    let policyData: any;
    if (algorithm === 'linucb') {
      policyData = db.prepare('SELECT * FROM rl_linucb').all();
    } else {
      policyData = db.prepare('SELECT * FROM rl_q_table').all();
    }

    const stats = rewardTracker.getStats();

    const id = crypto.randomUUID();
    db.prepare(`
      INSERT INTO rl_policy_snapshots 
        (id, model_version, algorithm, policy_data, events_seen, avg_reward, shadow_mode, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      id,
      this.modelVersion,
      algorithm,
      JSON.stringify(policyData),
      this.eventsSeen,
      stats.avgReward,
      RL_CONFIG.shadowMode ? 1 : 0,
      Date.now()
    );

    return { id, modelVersion: this.modelVersion, stats };
  }

  /**
   * فعالسازی snapshot (خروج از shadow mode)
   */
  activateSnapshot(snapshotId: string) {
    const snapshot = db.prepare('SELECT * FROM rl_policy_snapshots WHERE id = ?')
      .get(snapshotId) as any;
    if (!snapshot) throw new Error('Snapshot not found');

    // غیرفعال کردن قبلی
    db.prepare('UPDATE rl_policy_snapshots SET is_active = 0').run();

    // فعال جدید
    db.prepare('UPDATE rl_policy_snapshots SET is_active = 1 WHERE id = ?')
      .run(snapshotId);

    // خروج از shadow mode
    (RL_CONFIG as any).shadowMode = false;

    return { activated: true };
  }

  // ═══════════════════════════════════════════
  //  Helpers
  // ═══════════════════════════════════════════

  private buildContext(p: any): number[] {
    return [
      p.trustScore / 100,
      p.vpnRisk / 100,
      p.botRisk / 100,
      p.threatRisk / 100,
      p.mlAnomalyScore,
      Math.min(1, p.sessionAgeMs / (24 * 3600 * 1000)),
      p.isNewDevice ? 1 : 0,
      p.role === 'admin' ? 1 : 0,
      p.pathSensitivity,
      (new Date().getHours()) / 24,
      Math.min(1, p.recentFailures / 10),
      p.geoRisk
    ];
  }

  private getHeuristicAction(p: any): RlAction {
    // منطق ساده pre-RL
    if (p.trustScore < 30 || p.threatRisk > 80 || p.mlAnomalyScore > 0.9) return 'block';
    if (p.trustScore < 50 || p.vpnRisk > 70 || p.botRisk > 60 || p.mlAnomalyScore > 0.75) return 'challenge';
    if (p.pathSensitivity > 0.7 && p.trustScore < 70) return 'step_up';
    return 'allow';
  }

  private computeConfidence(decision: any): number {
    if (decision.qValues) {
      const values = Object.values(decision.qValues) as number[];
      if (values.length === 0) return 0;
      const max = Math.max(...values);
      const min = Math.min(...values);
      const range = max - min;
      return range > 0 ? (max - min) / Math.abs(max || 1) : 0.5;
    }
    if (decision.ucbScores) {
      const values = Object.values(decision.ucbScores) as number[];
      const sorted = [...values].sort((a, b) => b - a);
      if (sorted.length < 2) return 0.5;
      return Math.min(1, (sorted[0] - sorted[1]) / Math.abs(sorted[0] || 1));
    }
    return 0.5;
  }

  getStats() {
    const eventStats = rewardTracker.getStats();
    const policyStats = RL_CONFIG.algorithm === 'linucb'
      ? linUCB.getStats()
      : qLearning.getStats();

    const snapshots = db.prepare(`
      SELECT * FROM rl_policy_snapshots ORDER BY created_at DESC LIMIT 10
    `).all();

    return {
      enabled: RL_CONFIG.enabled,
      algorithm: RL_CONFIG.algorithm,
      shadowMode: RL_CONFIG.shadowMode,
      eventsSeen: this.eventsSeen,
      minEventsBeforeActive: RL_CONFIG.minEventsBeforeActive,
      modelVersion: this.modelVersion,
      eventStats,
      policyStats,
      snapshots
    };
  }

  getRecentDecisions(limit = 50) {
    return db.prepare(`
      SELECT id, user_id, path, action, policy_action, executed_action,
             exploration, reward, confidence, created_at
      FROM rl_events 
