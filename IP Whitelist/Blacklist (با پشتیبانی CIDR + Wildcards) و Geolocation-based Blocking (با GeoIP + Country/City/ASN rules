🔄 (اختیاری) ارتقا به MaxMind

اگه دقت بالاتری خواستی (خصوصاً برای ASN)، geoBlocking.service.ts رو این‌طور تغییر بده:

```typescript
import maxmind, { Reader, CityResponse } from 'maxmind';

let maxmindReader: Reader<CityResponse> | null = null;

export async function initMaxMind() {
  if (!GEO_CONFIG.maxmindDbPath) return;
  try {
    maxmindReader = await maxmind.open<CityResponse>(GEO_CONFIG.maxmindDbPath);
    console.log('✅ MaxMind DB loaded');
  } catch (err) {
    console.error('❌ MaxMind load failed:', err);
  }
}

// در lookup:
lookup(ip: string): GeoProfile {
  const normalized = ip.startsWith('::ffff:') ? ip.slice(7) : ip;

  if (maxmindReader) {
    const geo = maxmindReader.get(normalized);
    return {
      ip: normalized,
      country: geo?.country?.iso_code,
      region: geo?.subdivisions?.[0]?.iso_code,
      city: geo?.city?.names?.en,
      timezone: geo?.location?.time_zone,
      ll: geo?.location ? [geo.location.latitude!, geo.location.longitude!] : undefined,
      asn: geo?.traits?.autonomous_system_number?.toString(),
      isp: geo?.traits?.autonomous_system_organization,
      isPrivate: false
    };
  }

  // fallback به geoip-lite
  // ...
}
```

برای دانلود DB:

