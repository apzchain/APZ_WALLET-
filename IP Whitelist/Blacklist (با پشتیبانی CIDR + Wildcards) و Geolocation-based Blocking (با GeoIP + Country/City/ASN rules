import { Request, Response, NextFunction } from 'express';
import { geoBlockingService } from '../services/geoBlocking.service.js';
import { SECURITY_CONFIG } from '../config/security.config.js';
import { securityService } from '../services/security.service.js';

export function geoBlockGuard(req: Request, res: Response, next: NextFunction) {
  const ip = req.ip || req.socket.remoteAddress || 'unknown';
  const result = geoBlockingService.check(ip);

  // برای دسترسی در روت‌های پایین‌تر
  (req as any).geo = result.profile;
  (req as any).geoAction = result.action;

  if (result.action === 'block') {
    console.warn(`[Geo] Blocked ${ip} (${result.profile.country}): ${result.reason}`);
    securityService.logSuspicious({
      ipAddress: ip,
      userAgent: req.headers['user-agent'],
      activityType: 'geo_blocked',
      severity: 'medium',
      details: {
        country: result.profile.country,
        city: result.profile.city,
        reason: result.reason
      }
    });

    return res.status(451).json({  // 451 = Unavailable For Legal Reasons
      success: false,
      error: 'Access unavailable from your region',
      code: 'GEO_BLOCKED',
      country: result.profile.country
    });
  }

  if (result.action === 'challenge') {
    // اینجا می‌تونی CAPTCHA یا 2FA رو اجبار کنی
    return res.status(403).json({
      success: false,
      error: 'Additional verification required',
      code: 'GEO_CHALLENGE',
      country: result.profile.country
    });
  }

  next();
}

/**
 * نسخه سبک — فقط پروفایل geo رو attach می‌کنه بدون بلاک
 * (برای لاگ یا personalization)
 */
export function attachGeoProfile(req: Request, _res: Response, next: NextFunction) {
  const ip = req.ip || 'unknown';
  (req as any).geo = geoBlockingService.lookup(ip);
  next();
}
