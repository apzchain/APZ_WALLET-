```typescript
import crypto from 'crypto';
import ipaddr from 'ipaddr.js';
import db from './db.service.js';
import { IP_ACCESS_CONFIG } from '../config/geo.config.js';

export interface IpAccessRow {
  id: string;
  entry: string;
  entry_type: 'ip' | 'cidr' | 'wildcard';
  list_type: 'whitelist' | 'blacklist';
  reason: string | null;
  expires_at: number | null;
  created_by: string | null;
  created_at: number;
  hits: number;
  last_hit_at: number | null;
}

interface CompiledRule {
  row: IpAccessRow;
  matcher: (ip: string) => boolean;
}

export class IpAccessService {
  private compiledCache: { data: CompiledRule[]; ts: number } | null = null;

  // ═══════════════════════════════════════════
  //  Compile rules → fast matchers
  // ═══════════════════════════════════════════
  private compile(): CompiledRule[] {
    const now = Date.now();
    if (this.compiledCache && now - this.compiledCache.ts < IP_ACCESS_CONFIG.cacheTtlMs) {
      return this.compiledCache.data;
    }

    const rows = db.prepare(`
      SELECT * FROM ip_access_list 
      WHERE expires_at IS NULL OR expires_at > ?
    `).all(now) as IpAccessRow[];

    const compiled: CompiledRule[] = rows.map(row => ({
      row,
      matcher: this.buildMatcher(row.entry, row.entry_type)
    }));

    this.compiledCache = { data: compiled, ts: now };
    return compiled;
  }

  private buildMatcher(entry: string, type: string): (ip: string) => boolean {
    switch (type) {
      case 'ip': {
        const normalized = this.normalizeIp(entry);
        return ip => this.normalizeIp(ip) === normalized;
      }

      case 'cidr': {
        try {
          const [range, bits] = entry.split('/');
          const parsed = ipaddr.parse(range);
          const maskBits = parseInt(bits, 10);
          return (ip: string) => {
            try {
              const addr = ipaddr.parse(this.normalizeIp(ip));
              return addr.kind() === parsed.kind() && addr.match(parsed, maskBits);
            } catch {
              return false;
            }
          };
        } catch {
          return () => false;
        }
      }

      case 'wildcard': {
        // مثال: 192.168.*.* یا 10.*
        const regex = new RegExp(
          '^' + entry.replace(/\./g, '\\.').replace(/\*/g, '\\d+') + '$'
        );
        return (ip: string) => regex.test(this.normalizeIp(ip));
      }

      default:
        return () => false;
    }
  }

  private normalizeIp(ip: string): string {
    // حذف IPv6-mapped IPv4 (::ffff:127.0.0.1 → 127.0.0.1)
    if (ip.startsWith('::ffff:')) return ip.slice(7);
    return ip;
  }

  // ═══════════════════════════════════════════
  //  Main Check
  // ═══════════════════════════════════════════
  check(rawIp: string): {
    allowed: boolean;
    reason?: string;
    ruleId?: string;
    listType?: 'whitelist' | 'blacklist' | 'system';
  } {
    const ip = this.normalizeIp(rawIp);

    // Localhost?
    if (IP_ACCESS_CONFIG.allowLocalhost && (ip === '127.0.0.1' || ip === '::1' || ip === 'localhost')) {
      return { allowed: true, reason: 'localhost', listType: 'system' };
    }

    // Private IPs?
    if (IP_ACCESS_CONFIG.allowPrivateIps && this.isPrivate(ip)) {
      return { allowed: true, reason: 'private_ip', listType: 'system' };
    }

    const rules = this.compile();

    // 1. اول blacklist رو چک کن (بالاترین اولویت)
    const blackMatch = rules.find(r => r.row.list_type === 'blacklist' && r.matcher(ip));
    if (blackMatch) {
      this.recordHit(blackMatch.row.id);
      return {
        allowed: false,
        reason: blackMatch.row.reason || 'blacklisted',
        ruleId: blackMatch.row.id,
        listType: 'blacklist'
      };
    }

    // 2. بعد whitelist
    const whiteMatch = rules.find(r => r.row.list_type === 'whitelist' && r.matcher(ip));
    if (whiteMatch) {
      this.recordHit(whiteMatch.row.id);
      return {
        allowed: true,
        reason: whiteMatch.row.reason || 'whitelisted',
        ruleId: whiteMatch.row.id,
        listType: 'whitelist'
      };
    }

    // 3. اگر mode = deny_all و در whitelist نبود → رد کن
    if (IP_ACCESS_CONFIG.mode === 'deny_all') {
      return {
        allowed: false,
        reason: 'not_in_whitelist (deny_all mode)',
        listType: 'system'
      };
    }

    return { allowed: true, listType: 'system' };
  }

  private isPrivate(ip: string): boolean {
    try {
      const addr = ipaddr.parse(ip);
      return addr.range() !== 'unicast';
    } catch {
      return false;
    }
  }

  private recordHit(ruleId: string) {
    try {
      db.prepare(`
        UPDATE ip_access_list 
        SET hits = hits + 1, last_hit_at = ? 
        WHERE id = ?
      `).run(Date.now(), ruleId);
    } catch {}
  }

  // ═══════════════════════════════════════════
  //  CRUD
  // ═══════════════════════════════════════════
  add(params: {
    entry: string;
    listType: 'whitelist' | 'blacklist';
    reason?: string;
    expiresInMs?: number;
    createdBy?: string;
  }) {
    const entryType = this.detectEntryType(params.entry);
    const id = crypto.randomUUID();
    const now = Date.now();

    db.prepare(`
      INSERT INTO ip_access_list 
        (id, entry, entry_type, list_type, reason, expires_at, created_by, created_at, hits)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, 0)
    `).run(
      id,
      params.entry,
      entryType,
      params.listType,
      params.reason || null,
      params.expiresInMs ? now + params.expiresInMs : null,
      params.createdBy || null,
      now
    );

    this.invalidateCache();
    return this.getById(id);
  }

  private detectEntryType(entry: string): 'ip' | 'cidr' | 'wildcard' {
    if (entry.includes('*')) return 'wildcard';
    if (entry.includes('/')) return 'cidr';
    return 'ip';
  }

  remove(id: string) {
    db.prepare('DELETE FROM ip_access_list WHERE id = ?').run(id);
    this.invalidateCache();
  }

  removeExpired() {
    const result = db.prepare(`
      DELETE FROM ip_access_list WHERE expires_at IS NOT NULL AND expires_at < ?
    `).run(Date.now());
    this.invalidateCache();
    return result.changes;
  }

  getById(id: string): IpAccessRow | undefined {
    return db.prepare('SELECT * FROM ip_access_list WHERE id = ?').get(id) as IpAccessRow | undefined;
  }

  list(listType?: 'whitelist' | 'blacklist'): IpAccessRow[] {
    if (listType) {
      return db.prepare(`
        SELECT * FROM ip_access_list 
        WHERE list_type = ? 
        ORDER BY created_at DESC
      `).all(listType) as IpAccessRow[];
    }
    return db.prepare('SELECT * FROM ip_access_list ORDER BY created_at DESC').all() as IpAccessRow[];
  }

  invalidateCache() {
    this.compiledCache = null;
  }

  getStats() {
    const row = db.prepare(`
      SELECT 
        COUNT(*) FILTER (WHERE list_type = 'whitelist') as whitelist_count,
        COUNT(*) FILTER (WHERE list_type = 'blacklist') as blacklist_count,
        SUM(hits) as total_hits
      FROM ip_access_list
    `).get() as any;

    return {
      whitelist: row?.whitelist_count || 0,
      blacklist: row?.blacklist_count || 0,
      totalHits: row?.total_hits || 0,
      mode: IP_ACCESS_CONFIG.mode
    };
  }

  /**
   * Bulk import از یک لیست متنی
   */
  bulkAdd(entries: string[], listType: 'whitelist' | 'blacklist', reason?: string, createdBy?: string) {
    const results: any[] = [];
    const errors: { entry: string; error: string }[] = [];

    for (const entry of entries) {
      const trimmed = entry.trim();
      if (!trimmed || trimmed.startsWith('#')) continue;
      try {
        this.validateEntry(trimmed);
        results.push(this.add({ entry: trimmed, listType, reason, createdBy }));
      } catch (err: any) {
        errors.push({ entry: trimmed, error: err.message });
      }
    }
    return { added: results.length, errors, items: results };
  }

  private validateEntry(entry: string) {
    if (entry.includes('*')) {
      if (!/^[\d.*]+$/.test(entry)) throw new Error('Invalid wildcard format');
      return;
    }
    if (entry.includes('/')) {
      const [range, bits] = entry.split('/');
      if (!ipaddr.isValid(range)) throw new Error('Invalid CIDR range');
      const n = parseInt(bits, 10);
      if (isNaN(n) || n < 0 || n > 128) throw new Error('Invalid CIDR bits');
      return;
    }
    if (!ipaddr.isValid(entry)) throw new Error('Invalid IP address');
  }
}

export const ipAccessService = new IpAccessService();
```

