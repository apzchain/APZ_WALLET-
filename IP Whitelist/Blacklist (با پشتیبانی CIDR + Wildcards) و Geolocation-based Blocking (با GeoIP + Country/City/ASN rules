ipAccessAdd: (payload: { entry: string; listType: 'whitelist' | 'blacklist'; reason?: string; expiresInMs?: number }) =>
  request<any>('/admin/ip-access', { method: 'POST', body: JSON.stringify(payload) }),

ipAccessBulk: (entries: string[], listType: 'whitelist' | 'blacklist', reason?: string) =>
  request<any>('/admin/ip-access/bulk', {
    method: 'POST',
    body: JSON.stringify({ entries, listType, reason })
  }),

ipAccessRemove: (id: string) =>
  request<{}>(`/admin/ip-access/${id}`, { method: 'DELETE' }),

// ───── Geo ─────
geoLookup: (ip: string) =>
  request<any>(`/geo/lookup/${ip}`),

geoStats: () =>
  request<any>('/geo/stats'),

geoLogs: (limit = 100) =>
  request<any[]>(`/geo/logs?limit=${limit}`),

geoRules: () =>
  request<any[]>('/geo/rules'),

geoAddRule: (payload: { ruleType: string; value: string; action: string; reason?: string; priority?: number }) =>
  request<any>('/geo/rules', { method: 'POST', body: JSON.stringify(payload) }),

geoUpdateRule: (id: string, patch: any) =>
  request<{}>(`/geo/rules/${id}`, { method: 'PATCH', body: JSON.stringify(patch) }),

geoRemoveRule: (id: string) =>
  request<{}>(`/geo/rules/${id}`, { method: 'DELETE' })
