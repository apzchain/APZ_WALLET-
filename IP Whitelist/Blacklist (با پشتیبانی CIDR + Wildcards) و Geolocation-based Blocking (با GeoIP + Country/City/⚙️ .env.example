# ───── IP Access Control ─────
# حالت پیش‌فرض: 'allow_all' (فقط blacklist فعال) یا 'deny_all' (فقط whitelist فعال)
IP_ACCESS_MODE=allow_all
# آیا IP های localhost همیشه مجاز باشند؟
ALLOW_LOCALHOST=true
# آیا IP های private (RFC1918) مجاز باشند؟
ALLOW_PRIVATE_IPS=true

# ───── Geolocation ─────
# فعال/غیرفعال بودن Geo-blocking
GEO_BLOCKING_ENABLED=false
# حالت پیش‌فرض geo: 'allow_all' | 'block_list' | 'allow_list'
GEO_MODE=block_list
# کشورهای ممنوع (comma-separated ISO codes)
BLOCKED_COUNTRIES=KP,IR,SY,CU
# کشورهای مجاز (وقتی GEO_MODE=allow_list)
ALLOWED_COUNTRIES=US,DE,FR,GB,CA,AU
# مسیر دیتابیس MaxMind (اختیاری — اگر خالی باشه از geoip-lite استفاده می‌کنه)
MAXMIND_DB_PATH=
# اگر IP قابل تشخیص نبود، اجازه بده؟ (true = fail-open)
GEO_FAIL_OPEN=true
