// در init()
function setupSyncButton() {
  const btn = document.getElementById('sync-now-btn');
  btn?.addEventListener('click', async () => {
    const icon = btn.querySelector('svg');
    icon.style.animation = 'rotate 1s linear infinite';

    try {
      await window.APZ_BG_SYNC?.fetchAndCacheReleases();
      showSyncStatus('success', 'Synced just now');
      load(true);
    } catch {
      showSyncStatus('error', 'Sync failed');
    } finally {
      setTimeout(() => { icon.style.animation = ''; }, 1000);
    }
  });
}

// نمایش وضعیت سینک
function showSyncStatus(state, msg) {
  let el = document.getElementById('sync-status-indicator');
  if (!el) {
    el = document.createElement('div');
    el.id = 'sync-status-indicator';
    el.className = 'pwa-sync-status';
    document.body.appendChild(el);
  }

  el.className = `pwa-sync-status show ${state}`;
  el.innerHTML = `
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
    </svg>
    <span>${msg}</span>
  `;

  setTimeout(() => el.classList.remove('show'), 2500);
}

// در init() اضافه کنید:
setupSyncButton();
