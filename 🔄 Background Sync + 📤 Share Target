بخش اول: 🔄 Background Sync

1️⃣ docs/assets/js/bg-sync.js

```javascript
/* ═══════════════════════════════════════════════
   APZ Wallet — Background Sync Manager
   Features:
     • One-off sync (after connection restored)
     • Periodic Background Sync (Chrome/Edge only)
     • IndexedDB cache for offline releases
     • Sync status events
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  const CFG = window.APZ_CONFIG;
  const DB_NAME = 'apz-wallet-db';
  const DB_VERSION = 1;
  const STORE_RELEASES = 'releases';
  const STORE_META = 'meta';

  // ─── IndexedDB Helpers ───
  let dbPromise = null;

  function openDB() {
    if (dbPromise) return dbPromise;
    dbPromise = new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, DB_VERSION);

      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        if (!db.objectStoreNames.contains(STORE_RELEASES)) {
          const store = db.createObjectStore(STORE_RELEASES, { keyPath: 'id' });
          store.createIndex('tag_name', 'tag_name', { unique: false });
          store.createIndex('published_at', 'published_at', { unique: false });
        }
        if (!db.objectStoreNames.contains(STORE_META)) {
          db.createObjectStore(STORE_META, { keyPath: 'key' });
        }
      };

      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
    return dbPromise;
  }

  async function saveReleases(releases) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_RELEASES, 'readwrite');
      const store = tx.objectStore(STORE_RELEASES);
      // پاک کردن قبلی
      store.clear();
      releases.forEach((r) => store.put(r));
      tx.oncomplete = () => resolve(releases.length);
      tx.onerror = () => reject(tx.error);
    });
  }

  async function readReleases() {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_RELEASES, 'readonly');
      const store = tx.objectStore(STORE_RELEASES);
      const req = store.getAll();
      req.onsuccess = () => resolve(req.result || []);
      req.onerror = () => reject(req.error);
    });
  }

  async function setMeta(key, value) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_META, 'readwrite');
      tx.objectStore(STORE_META).put({ key, value });
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  async function getMeta(key) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_META, 'readonly');
      const req = tx.objectStore(STORE_META).get(key);
      req.onsuccess = () => resolve(req.result?.value);
      req.onerror = () => reject(req.error);
    });
  }

  // ─── Sync Functions ───
  async function fetchAndCacheReleases() {
    try {
      const res = await fetch(
        `${CFG.api.base}${CFG.api.releases
          .replace('{owner}', CFG.repo.owner)
          .replace('{repo}', CFG.repo.name)}?per_page=30`,
        { headers: { Accept: 'application/vnd.github+json' } }
      );

      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const releases = await res.json();
      await saveReleases(releases);
      await setMeta('lastSync', Date.now());
      await setMeta('lastSyncCount', releases.length);

      // اطلاع به UI
      notifyUI('sync-complete', { count: releases.length });
      console.log('[BG-Sync] Cached', releases.length, 'releases');

      return releases;
    } catch (err) {
      console.error('[BG-Sync] Fetch failed:', err);
      throw err;
    }
  }

  function notifyUI(type, data) {
    if (!('serviceWorker' in navigator)) return;
    navigator.serviceWorker.ready.then((reg) => {
      reg.active?.postMessage({ type: 'BROADCAST', payload: { type, data } });
    });

    // همچنین در همین tab
    window.dispatchEvent(new CustomEvent(`apz-${type}`, { detail: data }));
  }

  // ─── Register Sync ───
  async function requestOneOffSync(tag = 'sync-releases') {
    if (!('serviceWorker' in navigator)) return false;
    try {
      const reg = await navigator.serviceWorker.ready;
      if (!('sync' in reg)) {
        console.warn('[BG-Sync] One-off sync not supported');
        return false;
      }
      await reg.sync.register(tag);
      console.log('[BG-Sync] Registered sync:', tag);
      return true;
    } catch (err) {
      console.error('[BG-Sync] Sync registration failed:', err);
      return false;
    }
  }

  async function registerPeriodicSync() {
    if (!('serviceWorker' in navigator)) return false;
    try {
      const reg = await navigator.serviceWorker.ready;
      if (!('periodicSync' in reg)) {
        console.warn('[BG-Sync] Periodic sync not supported');
        return false;
      }

      const status = await navigator.permissions.query({
        name: 'periodic-background-sync'
      });

      if (status.state !== 'granted') {
        console.warn('[BG-Sync] Periodic sync permission not granted');
        return false;
      }

      await reg.periodicSync.register('sync-releases-periodic', {
        minInterval: 6 * 60 * 60 * 1000 // حداقل ۶ ساعت
      });

      console.log('[BG-Sync] Periodic sync registered (6h interval)');
      await setMeta('periodicSyncRegistered', true);
      return true;
    } catch (err) {
      console.error('[BG-Sync] Periodic sync failed:', err);
      return false;
    }
  }

  async function unregisterPeriodicSync() {
    try {
      const reg = await navigator.serviceWorker.ready;
      if ('periodicSync' in reg) {
        await reg.periodicSync.unregister('sync-releases-periodic');
        await setMeta('periodicSyncRegistered', false);
        console.log('[BG-Sync] Periodic sync unregistered');
      }
    } catch (err) {
      console.error('[BG-Sync] Unregister failed:', err);
    }
  }

  // ─── Init ───
  async function init() {
    // بررسی وضعیت آنلاین/آفلاین
    window.addEventListener('online', () => {
      console.log('[BG-Sync] Back online — requesting sync');
      requestOneOffSync();
    });

    window.addEventListener('offline', () => {
      console.log('[BG-Sync] Offline');
    });

    // اگر آفلاین هستیم، سینک ثبت کن
    if (!navigator.onLine) {
      await requestOneOffSync();
    }

    // ثبت Periodic Sync (اگر پشتیبانی شود)
    await registerPeriodicSync();

    // بررسی آخرین سینک
    const lastSync = await getMeta('lastSync');
    if (lastSync) {
      console.log('[BG-Sync] Last sync:', new Date(lastSync).toLocaleString());
    }
  }

  // ─── Public API ───
  window.APZ_BG_SYNC = {
    init,
    fetchAndCacheReleases,
    readReleases,
    getMeta,
    setMeta,
    requestOneOffSync,
    registerPeriodicSync,
    unregisterPeriodicSync,
    getLastSync: () => getMeta('lastSync'),
    isPeriodicEnabled: async () => {
      if (!('serviceWorker' in navigator)) return false;
      const reg = await navigator.serviceWorker.ready;
      if (!('periodicSync' in reg)) return false;
      const tags = await reg.periodicSync.getTags();
      return tags.includes('sync-releases-periodic');
    }
  };

  // ─── Auto Init ───
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
