4️⃣ 🔄 ادغام در docs/assets/js/app.js

این تغییرات را در app.js اعمال کنید:

```javascript
// ─── در بالای فایل، بعد از API ───
const BG_SYNC = window.APZ_BG_SYNC;

// ─── در load()، اول از IndexedDB بخوان ───
async function load(silent = false) {
  if (isRefreshing) return;
  isRefreshing = true;

  const t = I18N[currentLang];
  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.classList.add('loading');

  try {
    // 1. اگر آفلاین، از IndexedDB بخوان
    if (!navigator.onLine && BG_SYNC) {
      const cached = await BG_SYNC.readReleases();
      if (cached.length > 0) {
        UI.renderAll({ releases: cached, ciStatus: null }, t);
        console.log('[App] Loaded from IndexedDB (offline)');
        return;
      }
    }

    // 2. آنلاین: از API بگیر
    const [releases, ciStatus] = await Promise.all([
      API.getReleases().catch(() => []),
      API.getWorkflowStatus(cfg.workflows.ci).catch(() => null)
    ]);

    const cleanReleases = (releases || []).filter(r => !r.draft);
    UI.renderAll({ releases: cleanReleases, ciStatus }, t);

    // 3. ذخیره در IndexedDB برای بار بعدی
    if (BG_SYNC && cleanReleases.length > 0) {
      BG_SYNC.setMeta('lastSync', Date.now());
      await BG_SYNC.fetchAndCacheReleases().catch(() => {});
    }

    if (!silent) UI.showToast(t.toast.refreshed, 'success');
  } catch (err) {
    console.error('[APZ Dashboard]', err);
    const msg = err.message === 'RATE_LIMIT' ? t.toast.rateLimit : t.toast.error;
    UI.showToast(msg, 'error');
  } finally {
    isRefreshing = false;
    refreshBtn?.classList.remove('loading');
  }
}

// ─── Listen for background sync events ───
window.addEventListener('apz-sync-complete', (e) => {
  console.log('[App] Background sync delivered', e.detail);
  // فقط اگر تب فعال است، UI را به‌روز کن
  if (!document.hidden) {
    load(true);
  }
});
