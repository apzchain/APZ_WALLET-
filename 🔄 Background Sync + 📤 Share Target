3️⃣ 🔄 به‌روزرسانی docs/assets/js/pwa.js

این بخش را به pwa.js اضافه کنید (پایان فایل، قبل از window.APZ_PWA):

```javascript
  // ─── Listen for Sync Events from SW ───
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.addEventListener('message', (event) => {
      const { type, data } = event.data || {};

      if (type === 'SYNC_RELEASES_COMPLETE') {
        console.log('[PWA] Sync complete, releasing cached data');
        window.dispatchEvent(new CustomEvent('apz-sync-complete', {
          detail: data
        }));
      }
    });
  }

  // ─── Request Sync on Visibility Change ───
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && navigator.onLine) {
      // درخواست sync بعدی
      if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
        navigator.serviceWorker.controller.postMessage({ type: 'REQUEST_SYNC' });
      }
    }
  });
```

