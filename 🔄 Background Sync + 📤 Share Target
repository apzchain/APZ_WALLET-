      typeTx: 'هش تراکنش',
      typeBlock: 'شماره بلاک',
      typeChainId: 'شناسه شبکه',
      typeEVM: 'آدرس EVM',
      typeURL: 'آدرس اینترنتی'
    },
    de: {
      sub: 'Teilen',
      loading: 'Geteilte Inhalte werden verarbeitet...',
      noContent: 'Keine Inhalte empfangen',
      noContentSub: 'Versuchen Sie es von einer anderen App aus.',
      backHome: 'Zurück zum Dashboard',
      received: 'Inhalt empfangen!',
      receivedSub: 'Wählen Sie unten eine Aktion',
      title: 'Titel',
      url: 'URL',
      text: 'Text',
      files: 'Anhänge',
      copy: 'Kopieren',
      open: 'Öffnen',
      detected: 'Erkannt',
      openInApp: 'In APZ Wallet öffnen',
      saveNote: 'Als Notiz speichern',
      searchExplorer: 'Explorer durchsuchen',
      dismiss: 'Verwerfen',
      copied: 'In die Zwischenablage kopiert',
      saved: 'In Notizen gespeichert',
      typeAddress: 'Wallet-Adresse',
      typeTx: 'Transaktions-Hash',
      typeBlock: 'Blocknummer',
      typeChainId: 'Chain-ID',
      typeEVM: 'EVM-Adresse',
      typeURL: 'URL'
    }
  };

  function t(key) {
    const dict = SHARE_I18N[currentLang] || SHARE_I18N.en;
    return dict[key] || key;
  }

  // ─── Apply i18n & RTL ───
  function applyLang(lang) {
    if (!SHARE_I18N[lang]) lang = 'en';
    currentLang = lang;
    localStorage.setItem('apz-dashboard-lang', lang);

    const html = document.getElementById('html-root');
    html.lang = lang;
    html.dir = (I18N?.[lang]?.dir) || (lang === 'fa' ? 'rtl' : 'ltr');

    // عناصر [data-i18n] که از I18N اصلی می‌آیند
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      const val = key.split('.').reduce((o, k) => o?.[k], I18N?.[lang] || {});
      if (val) el.textContent = val;
    });

    // عناصر مخصوص share
    renderSharedContent();

    document.querySelectorAll('.lang-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });
  }

  // ─── Read shared data from cache ───
  async function readSharedData() {
    // 1. از sessionStorage (اگر POST کرده باشیم)
    const fromSession = sessionStorage.getItem('apz-shared-data');
    if (fromSession) {
      sessionStorage.removeItem('apz-shared-data');
      try { return JSON.parse(fromSession); } catch {}
    }

    // 2. از CacheStorage (از Service Worker)
    try {
      const cache = await caches.open(SHARE_CACHE_NAME);
      const res = await cache.match(SHARE_CACHE_URL);
      if (res) {
        const data = await res.json();
        await cache.delete(SHARE_CACHE_URL);
        return data;
      }
    } catch (err) {
      console.warn('[Share] Cache read failed:', err);
    }

    // 3. از URL params (fallback برای GET)
    const params = new URLSearchParams(location.search);
    if (params.get('title') || params.get('text') || params.get('url')) {
      return {
        title: params.get('title') || '',
        text: params.get('text') || '',
        url: params.get('url') || '',
        timestamp: Date.now()
      };
    }

    return null;
  }

  // ─── Detect content type ───
  const PATTERNS = {
    evmAddress: /^0x[a-fA-F0-9]{40}$/,
    txHash: /^0x[a-fA-F0-9]{64}$/,
    apzAddress: /^apz[a-zA-Z0-9]{38,42}$/,
    chainId: /^chain[_-]?id[:\s]*(\d+)$/i
  };

  function detectContent(data) {
    const candidates = [
      data.url,
      data.text,
      data.title
    ].filter(Boolean);

    for (const raw of candidates) {
      const val = raw.trim();

      if (PATTERNS.txHash.test(val)) {
        return { type: 'tx', label: t('typeTx'), value: val };
      }
      if (PATTERNS.evmAddress.test(val)) {
        return { type: 'evm', label: t('typeEVM'), value: val };
      }
      if (PATTERNS.apzAddress.test(val)) {
        return { type: 'address', label: t('typeAddress'), value: val };
      }
      const chainMatch = val.match(PATTERNS.chainId);
      if (chainMatch) {
        return { type: 'chainId', label: t('typeChainId'), value: chainMatch[1] };
      }
      if (/^\d{4,12}$/.test(val)) {
        return { type: 'block', label: t('typeBlock'), value: val };
      }
      // آدرس در متن
      const evmInText = val.match(/0x[a-fA-F0-9]{40}/);
      if (evmInText) {
        return { type: 'evm', label: t('typeEVM'), value: evmInText[0] };
      }
      const txInText = val.match(/0x[a-fA-F0-9]{64}/);
      if (txInText) {
        return { type: 'tx', label: t('typeTx'), value: txInText[0] };
      }
    }

    if (data.url) {
      return { type: 'url', label: t('typeURL'), value: data.url };
    }

    return null;
  }

  // ─── Render ───
  function renderSharedContent() {
    if (!sharedData) return;

    // Title
    const titleField = document.getElementById('field-title');
    const titleValue = document.getElementById('share-title-value');
    if (sharedData.title) {
      titleField.hidden = false;
      titleValue.textContent = sharedData.title;
    } else {
      titleField.hidden = true;
    }

    // URL
    const urlField = document.getElementById('field-url');
    const urlValue = document.getElementById('share-url-value');
    const openUrlBtn = document.getElementById('open-url-btn');
    if (sharedData.url) {
      urlField.hidden = false;
      urlValue.textContent = sharedData.url;
      if (openUrlBtn) openUrlBtn.href = sharedData.url;
    } else {
      urlField.hidden = true;
    }

    // Text
    const textField = document.getElementById('field-text');
    const textValue = document.getElementById('share-text-value');
    if (sharedData.text) {
      textField.hidden = false;
      textValue.textContent = sharedData.text;
    } else {
      textField.hidden = true;
    }

    // Files
    const filesField = document.getElementById('field-files');
    const filesList = document.getElementById('share-files-list');
    if (sharedData.files && sharedData.files.length) {
      filesField.hidden = false;
      filesList.innerHTML = sharedData.files
        .map((f) => `
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/>
              <polyline points="13 2 13 9 20 9"/>
            </svg>
            <span>${escapeHtml(f.name)}</span>
            ${f.size ? `<span style="margin-left:auto;color:var(--text-dimmer);font-size:0.75rem">${formatBytes(f.size)}</span>` : ''}
          </li>
        `)
        .join('');
    } else {
      filesField.hidden = true;
    }

    // Detected
    const detected = detectContent(sharedData);
    const detectedBox = document.getElementById('share-detected');
    if (detected) {
      detectedBox.hidden = false;
      document.getElementById('detected-type').textContent = detected.label;
      document.getElementById('detected-value').textContent = detected.value;
      detectedBox.dataset.detectedType = detected.type;
      detectedBox.dataset.detectedValue = detected.value;
    } else {
      detectedBox.hidden = true;
    }
  }

  // ─── Helpers ───
  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatBytes(b) {
    if (!b) return '';
    const u = ['B', 'KB', 'MB', 'GB'];
    let i = 0;
    while (b >= 1024 && i < u.length - 1) { b /= 1024; i++; }
    return `${b.toFixed(1)} ${u[i]}`;
  }

  function showToast(msg, type = 'success') {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = msg;
    toast.className = `toast ${type} show`;
    setTimeout(() => toast.classList.remove('show'), 2600);
  }

  // ─── Actions ───
  function setupActions() {
    // Copy URL
    document.getElementById('copy-url-btn')?.addEventListener('click', async () => {
      const val = document.getElementById('share-url-value').textContent;
      await navigator.clipboard.writeText(val);
      showToast(t('copied'));
    });

    // Open in app (deep link)
    document.getElementById('action-open-in-app')?.addEventListener('click', () => {
      const detected = document.getElementById('share-detected');
      const type = detected?.dataset.detectedType;
      const value = detected?.dataset.detectedValue;

      let deepLink = 'apzwallet://';

      if (type === 'tx') deepLink += `tx/${value}`;
      else if (type === 'address' || type === 'evm') deepLink += `address/${value}`;
      else if (type === 'block') deepLink += `block/${value}`;
      else if (sharedData.url) deepLink += `open?url=${encodeURIComponent(sharedData.url)}`;
      else deepLink += 'open';

      console.log('[Share] Deep link:', deepLink);

      // تلاش برای باز کردن اپ
      window.location.href = deepLink;

      // fallback: اگر اپ نبود، به داشبورد برو
      setTimeout(() => {
        window.location.href = './index.html';
      }, 1500);
    });

    // Save as note
    document.getElementById('action-save-note')?.addEventListener('click', () => {
      const notes = JSON.parse(localStorage.getItem(NOTES_KEY) || '[]');
      notes.unshift({
        ...sharedData,
        savedAt: Date.now()
      });
      localStorage.setItem(NOTES_KEY, JSON.stringify(notes.slice(0, 100)));
      showToast(t('saved'));
    });

    // Search explorer
    document.getElementById('action-search-explorer')?.addEventListener('click', () => {
      const detected = document.getElementById('share-detected');
      const value = detected?.dataset.detectedValue || sharedData?.text || sharedData?.url || '';
      const q = encodeURIComponent(value);
      // بسته به نوع، به صفحه مناسب در dashboard برو
      window.location.href = `./index.html?action=search&q=${q}`;
    });

    // Dismiss
    document.getElementById('action-dismiss')?.addEventListener('click', () => {
      window.location.href = './index.html';
    });
  }

  // ─── Init ───
  async function init() {
    // Language switch
    document.querySelectorAll('.lang-btn').forEach((btn) => {
      btn.addEventListener('click', () => applyLang(btn.dataset.lang));
    });

    // Load shared data
    sharedData = await readSharedData();

    const loading = document.getElementById('share-loading');
    const empty = document.getElementById('share-empty');
    const content = document.getElementById('share-content');

    if (!sharedData) {
      loading.hidden = true;
      empty.hidden = false;
      return;
    }

    // Render
    setTimeout(() => {
      loading.hidden = true;
      content.hidden = false;
      applyLang(currentLang);
      setupActions();
    }, 400);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
```

