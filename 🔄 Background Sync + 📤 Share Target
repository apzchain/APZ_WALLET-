2️⃣ 🔄 به‌روزرسانی docs/sw.js — افزودن Sync Handlers

این بخش‌ها را به sw.js اضافه کنید (کامل جایگزین نسخه قبلی شود):

```javascript
/* ═══════════════════════════════════════════════
   APZ Wallet — Service Worker (v1.1.0)
   Includes: Cache, Background Sync, Periodic Sync,
             Share Target, Push
   ═══════════════════════════════════════════════ */

const VERSION = 'v1.1.0';
const CACHE_PREFIX = 'apz-wallet';

const CACHE_STATIC = `${CACHE_PREFIX}-static-${VERSION}`;
const CACHE_RUNTIME = `${CACHE_PREFIX}-runtime-${VERSION}`;
const CACHE_API = `${CACHE_PREFIX}-api-${VERSION}`;
const CACHE_SHARE = `${CACHE_PREFIX}-share-${VERSION}`;

const STATIC_ASSETS = [
  './',
  './index.html',
  './share.html',
  './offline.html',
  './manifest.webmanifest',
  './assets/css/style.css',
  './assets/css/pwa.css',
  './assets/css/share.css',
  './assets/js/config.js',
  './assets/js/i18n.js',
  './assets/js/api.js',
  './assets/js/ui.js',
  './assets/js/app.js',
  './assets/js/pwa.js',
  './assets/js/bg-sync.js',
  './assets/js/share.js',
  './assets/icons/icon.svg',
  './assets/icons/icon-192.png',
  './assets/icons/icon-512.png'
];

const API_HOSTS = ['api.github.com'];
const SHARE_CACHE_KEY = 'pending-share';

// ─── Install ───
self.addEventListener('install', (event) => {
  console.log('[SW] Installing', VERSION);
  event.waitUntil(
    (async () => {
      const cache = await caches.open(CACHE_STATIC);
      await Promise.all(
        STATIC_ASSETS.map((url) =>
          cache.add(url).catch((err) => console.warn('[SW] Skip:', url, err))
        )
      );
      await self.skipWaiting();
    })()
  );
});

// ─── Activate ───
self.addEventListener('activate', (event) => {
  console.log('[SW] Activating', VERSION);
  event.waitUntil(
    (async () => {
      const keys = await caches.keys();
      await Promise.all(
        keys
          .filter((k) => k.startsWith(CACHE_PREFIX) && !k.endsWith(VERSION))
          .map((k) => caches.delete(k))
      );
      if ('navigationPreload' in self.registration) {
        await self.registration.navigationPreload.enable();
      }
      await self.clients.claim();
    })()
  );
});

// ─── Fetch ───
self.addEventListener('fetch', (event) => {
  const { request } = event;
  const url = new URL(request.url);

  if (request.method !== 'GET') return;
  if (!url.protocol.startsWith('http')) return;

  // ── Share Target: ذخیره‌ی محتوا و ریدایرکت ──
  if (url.pathname.endsWith('/share')) {
    event.respondWith(handleShareRequest(request));
    return;
  }

  if (API_HOSTS.includes(url.hostname)) {
    event.respondWith(networkFirst(request, CACHE_API));
    return;
  }

  if (request.mode === 'navigate') {
    event.respondWith(handleNavigation(request));
    return;
  }

  if (['font', 'image'].includes(request.destination)) {
    event.respondWith(staleWhileRevalidate(request, CACHE_RUNTIME));
    return;
  }

  event.respondWith(cacheFirst(request, CACHE_STATIC));
});

// ═══════════════════════════════════════════════
// Background Sync Events
// ═══════════════════════════════════════════════

self.addEventListener('sync', (event) => {
  console.log('[SW] Sync event:', event.tag);

  if (event.tag === 'sync-releases') {
    event.waitUntil(syncReleases());
  }

  if (event.tag === 'sync-releases-periodic') {
    event.waitUntil(syncReleases({ notify: true }));
  }
});

// ─── Periodic Background Sync ───
self.addEventListener('periodicsync', (event) => {
  console.log('[SW] Periodic sync event:', event.tag);

  if (event.tag === 'sync-releases-periodic') {
    event.waitUntil(syncReleases({ notify: true }));
  }
});

// ─── Core Sync Logic ───
async function syncReleases(opts = {}) {
  const { notify = false } = opts;
  try {
    const res = await fetch(
      'https://api.github.com/repos/apzchain/APZ_WALLET/releases?per_page=30',
      { headers: { Accept: 'application/vnd.github+json' } }
    );

    if (!res.ok) {
      throw new Error(`Sync failed: HTTP ${res.status}`);
    }

    const releases = await res.json();

    // ذخیره در cache API
    const cache = await caches.open(CACHE_API);
    await cache.put(
      'https://api.github.com/repos/apzchain/APZ_WALLET/releases?per_page=30',
      new Response(JSON.stringify(releases), {
        headers: { 'Content-Type': 'application/json' }
      })
    );

    // ذخیره در IndexedDB (از طریق پیام به main thread)
    await broadcastToClients({
      type: 'SYNC_RELEASES_COMPLETE',
      data: { releases, timestamp: Date.now() }
    });

    // اعلان به کاربر اگر نسخه جدیدی منتشر شده باشد
    if (notify && releases[0]) {
      const lastSeen = await getStoredLastTag();
      const latestTag = releases[0].tag_name;

      if (lastSeen && lastSeen !== latestTag) {
        await self.registration.showNotification('APZ Wallet — New Release', {
          body: `Version ${latestTag} is now available!`,
          icon: './assets/icons/icon-192.png',
          badge: './assets/icons/icon-96.png',
          vibrate: [200, 100, 200],
          tag: 'apz-new-release',
          data: { url: './?action=latest' }
        });
      }
      await storeLastTag(latestTag);
    }

    console.log('[SW] Sync complete:', releases.length, 'releases');
    return releases;
  } catch (err) {
    console.error('[SW] Sync failed:', err);
    throw err;
  }
}

async function getStoredLastTag() {
  try {
    const cache = await caches.open(CACHE_API);
    const res = await cache.match('https://apz-wallet-meta/last-tag');
    if (!res) return null;
    return await res.text();
  } catch {
    return null;
  }
}

async function storeLastTag(tag) {
  try {
    const cache = await caches.open(CACHE_API);
    await cache.put(
      'https://apz-wallet-meta/last-tag',
      new Response(tag, { headers: { 'Content-Type': 'text/plain' } })
    );
  } catch (err) {
    console.warn('[SW] Store last tag failed:', err);
  }
}

async function broadcastToClients(message) {
  const clients = await self.clients.matchAll({
    type: 'window',
    includeUncontrolled: true
  });
  clients.forEach((client) => client.postMessage(message));
}

// ═══════════════════════════════════════════════
// Share Target Handler
// ═══════════════════════════════════════════════

async function handleShareRequest(request) {
  try {
    const url = new URL(request.url);
    const params = url.searchParams;

    // استخراج داده‌ها
    const shareData = {
      title: params.get('title') || '',
      text: params.get('text') || '',
      url: params.get('url') || '',
      timestamp: Date.now()
    };

    // اگر فایل‌ها هم هستند (POST)
    if (request.method === 'POST') {
      const formData = await request.formData();
      const files = formData.getAll('files') || [];
      shareData.files = await Promise.all(
        files.map(async (f) => {
          if (typeof f === 'string') return { name: 'shared', size: 0 };
          return {
            name: f.name,
            size: f.size,
            type: f.type
          };
        })
      );
    }

    // ذخیره در cache برای بازیابی توسط share.html
    const cache = await caches.open(CACHE_SHARE);
    await cache.put(
      new Request('https://apz-wallet-share/pending'),
      new Response(JSON.stringify(shareData), {
        headers: { 'Content-Type': 'application/json' }
      })
    );

    // ریدایرکت به صفحه share.html
    return Response.redirect('./share.html?shared=1', 303);
  } catch (err) {
    console.error('[SW] Share handler failed:', err);
    return Response.redirect('./share.html?error=1', 303);
  }
}

// ─── Navigation Handler ───
async function handleNavigation(request) {
  try {
    const fresh = await fetch(request);
    const cache = await caches.open(CACHE_STATIC);
    cache.put(request, fresh.clone());
    return fresh;
  } catch {
    const cached = await caches.match(request);
    return cached || caches.match('./offline.html');
  }
}

// ─── Strategies ───
async function cacheFirst(request, cacheName) {
  const cached = await caches.match(request);
  if (cached) return cached;
  try {
    const fresh = await fetch(request);
    if (fresh.ok) {
      const cache = await caches.open(cacheName);
      cache.put(request, fresh.clone());
    }
    return fresh;
  } catch {
    const offline = await caches.match('./offline.html');
    return offline || new Response('Offline', { status: 503 });
  }
}

async function networkFirst(request, cacheName) {
  try {
    const fresh = await fetch(request);
    if (fresh.ok) {
      const cache = await caches.open(cacheName);
      cache.put(request, fresh.clone());
    }
    return fresh;
  } catch {
    const cached = await caches.match(request);
    if (cached) return cached;
    return new Response(JSON.stringify({ offline: true, data: [] }), {
      status: 200,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

async function staleWhileRevalidate(request, cacheName) {
  const cached = await caches.match(request);
  const fetchPromise = fetch(request)
    .then((fresh) => {
      if (fresh.ok) {
        caches.open(cacheName).then((cache) => cache.put(request, fresh.clone()));
      }
      return fresh;
    })
    .catch(() => cached);
  return cached || fetchPromise;
}

// ═══════════════════════════════════════════════
// Messages
// ═══════════════════════════════════════════════

self.addEventListener('message', (event) => {
  const { type, payload } = event.data || {};

  switch (type) {
    case 'SKIP_WAITING':
      self.skipWaiting();
      break;

    case 'CLEAR_CACHE':
      caches.keys().then((keys) => Promise.all(keys.map((k) => caches.delete(k))));
      break;

    case 'REQUEST_SYNC':
      if ('sync' in self.registration) {
        self.registration.sync.register('sync-releases');
      }
      break;

    case 'SYNC_NOW':
      // همگام‌سازی فوری
      event.waitUntil(syncReleases({ notify: false }));
      break;

    case 'BROADCAST':
      broadcastToClients(payload);
      break;

    case 'REQUEST_NOTIFICATION_PERMISSION':
      event.waitUntil(requestNotificationPermission());
      break;
  }
});

async function requestNotificationPermission() {
  if (self.Notification.permission !== 'default') return;
  // این باید از main thread اجرا شود
}

// ═══════════════════════════════════════════════
// Notifications
// ═══════════════════════════════════════════════

self.addEventListener('push', (event) => {
  const data = event.data?.json() || {};
  event.waitUntil(
    self.registration.showNotification(data.title || 'APZ Wallet', {
      body: data.body || 'New update available',
      icon: './assets/icons/icon-192.png',
      badge: './assets/icons/icon-96.png',
      vibrate: [200, 100, 200],
      tag: 'apz-push',
      data: { url: data.url || './' }
    })
  );
});

self.addEventListener('notificationclick', (event) => {
  event.notification.close();
  event.waitUntil(
    clients.matchAll({ type: 'window' }).then((list) => {
      const url = event.notification.data.url || './';
      for (const client of list) {
        if (client.url.includes(self.location.origin) && 'focus' in client) {
          client.navigate(url);
          return client.focus();
        }
      }
      return clients.openWindow(url);
    })
  );
});
