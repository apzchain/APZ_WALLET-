import { AbuseIPDBClient } from 'abuseipdb-client';
import { THREAT_CONFIG } from '../config/threatIntel.config.js';
import db from './db.service.js';

export interface AbuseIPDBResult {
  ipAddress: string;
  abuseConfidenceScore: number;
  totalReports: number;
  numDistinctUsers: number;
  lastReportedAt: string | null;
  countryCode: string | null;
  usageType: string | null;
  isp: string | null;
  isTor: boolean;
  isWhitelisted: boolean;
  categories: number[];
}

export class AbuseIPDBService {
  private client: AbuseIPDBClient;

  constructor() {
    this.client = new AbuseIPDBClient(THREAT_CONFIG.abuseipdb.apiKey);
  }

  /**
   * چک امروز چقدر از سهمیه مصرف شده
   */
  private getTodayQuota(): { used: number; limit: number } {
    const today = new Date().toISOString().slice(0, 10);
    const row = db.prepare('SELECT * FROM abuseipdb_quota WHERE date = ?')
      .get(today) as { calls_used: number; calls_limit: number } | undefined;

    if (!row) {
      db.prepare(`
        INSERT INTO abuseipdb_quota (date, calls_used, calls_limit)
        VALUES (?, 0, ?)
      `).run(today, THREAT_CONFIG.abuseipdb.dailyQuota);
      return { used: 0, limit: THREAT_CONFIG.abuseipdb.dailyQuota };
    }
    return { used: row.calls_used, limit: row.calls_limit };
  }

  private incrementQuota() {
    const today = new Date().toISOString().slice(0, 10);
    db.prepare(`
      UPDATE abuseipdb_quota 
      SET calls_used = calls_used + 1, last_call_at = ?
      WHERE date = ?
    `).run(Date.now(), today);
  }

  /**
   * چک یک IP در AbuseIPDB
   */
  async check(ip: string): Promise<AbuseIPDBResult | null> {
    if (!THREAT_CONFIG.abuseipdb.apiKey) {
      console.warn('[AbuseIPDB] API key not set, skipping');
      return null;
    }

    const quota = this.getTodayQuota();
    if (quota.used >= quota.limit) {
      console.warn(`[AbuseIPDB] Daily quota exceeded (${quota.used}/${quota.limit})`);
      return null;
    }

    try {
      const response = await this.client.check(ip, {
        maxAgeInDays: THREAT_CONFIG.abuseipdb.maxAgeDays,
        verbose: true
      });

      this.incrementQuota();

      if (response.error) {
        console.error('[AbuseIPDB] API error:', response.error);
        return null;
      }

      const data = response.result?.data;
      if (!data) return null;

      // استخراج دستهبندیهای یکتا از گزارشها
      const categories = new Set<number>();
      if (data.reports) {
        for (const report of data.reports) {
          for (const cat of report.categories) categories.add(cat);
        }
      }

      return {
        ipAddress: data.ipAddress,
        abuseConfidenceScore: data.abuseConfidenceScore,
        totalReports: data.totalReports,
        numDistinctUsers: data.numDistinctUsers,
        lastReportedAt: data.lastReportedAt,
        countryCode: data.countryCode,
        usageType: data.usageType,
        isp: data.isp,
        isTor: data.isTor,
        isWhitelisted: data.isWhitelisted || false,
        categories: [...categories]
      };
    } catch (err) {
      console.error('[AbuseIPDB] check failed:', err);
      return null;
    }
  }

  /**
   * گزارش IP مخرب به AbuseIPDB
   */
  async report(params: {
    ip: string;
    categories: number[];
    comment?: string;
    timestamp?: string;
  }): Promise<boolean> {
    if (!THREAT_CONFIG.abuseipdb.apiKey) return false;

    try {
      const response = await this.client.report(params.ip, {
        categories: params.categories,
        comment: params.comment,
        timestamp: params.timestamp
      });

      // ثبت در DB
      db.prepare(`
        INSERT INTO threat_reports 
          (id, ip_address, categories, comment, reported_to_abuseipdb, abuseipdb_response, created_at)
        VALUES (?, ?, ?, ?, 1, ?, ?)
      `).run(
        crypto.randomUUID(),
        params.ip,
        JSON.stringify(params.categories),
        params.comment || null,
        JSON.stringify(response.result || {}),
        Date.now()
      );

      return !response.error;
    } catch (err) {
      console.error('[AbuseIPDB] report failed:', err);
      return false;
    }
  }

  /**
   * دانلود blacklist سراسری (top-reported IPs)
   */
  async downloadBlacklist(minConfidence = 90, limit = 10000): Promise<string[]> {
    if (!THREAT_CONFIG.abuseipdb.apiKey) return [];

    try {
      const response = await this.client.getBlacklist({
        confidenceMinimum: minConfidence,
        limit
      });

      if (response.error || !response.result?.data) return [];
      return response.result.data.map((item: any) => item.ipAddress);
    } catch (err) {
      console.error('[AbuseIPDB] blacklist download failed:', err);
      return [];
    }
  }

  getQuotaStatus() {
    return this.getTodayQuota();
  }
}

export const abuseipdbService = new AbuseIPDBService();
