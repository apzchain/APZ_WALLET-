  try {
    const result = await threatIntelService.check(req.params.ip);
    res.json({ success: true, data: result });
  } catch (err) { next(err); }
});

// ───── ادمین ─────
router.use(requireAuth, requireRole('admin'));

router.get('/stats', (_req, res) => {
  res.json({ success: true, data: threatIntelService.getStats() });
});

