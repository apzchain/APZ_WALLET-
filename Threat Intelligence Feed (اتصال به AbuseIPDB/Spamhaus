import { lookup, batch } from 'dnsbl';
import { THREAT_CONFIG } from '../config/threatIntel.config.js';

export interface DnsblResult {
  zone: string;
  listed: boolean;
  txt?: string[][];
}

export interface SpamhausResult {
  spamhausListed: boolean;
  spamhausZone?: string;
  spamcopListed: boolean;
  barracudaListed: boolean;
  blacklistCount: number;
  allResults: DnsblResult[];
}

export class SpamhausService {
  /**
   * چک یک IP در چندین DNSBL
   */
  async check(ip: string): Promise<SpamhausResult> {
    if (!THREAT_CONFIG.spamhaus.enabled) {
      return this.emptyResult();
    }

    try {
      const results = await batch(ip, THREAT_CONFIG.spamhaus.zones, {
        timeout: 3000,
        concurrency: 4,
        includeTxt: true
      });

      const allResults: DnsblResult[] = results.map((r: any) => ({
        zone: r.blacklist,
        listed: r.listed,
        txt: r.txt
      }));

      const spamhaus = allResults.find(r => r.zone === 'zen.spamhaus.org');
      const spamcop = allResults.find(r => r.zone === 'bl.spamcop.net');
      const barracuda = allResults.find(r => r.zone === 'b.barracudacentral.org');

      const blacklistCount = allResults.filter(r => r.listed).length;

      return {
        spamhausListed: spamhaus?.listed || false,
        spamhausZone: spamhaus?.txt?.[0]?.[0],
        spamcopListed: spamcop?.listed || false,
        barracudaListed: barracuda?.listed || false,
        blacklistCount,
        allResults
      };
    } catch (err) {
      console.error('[Spamhaus] check failed:', err);
      return this.emptyResult();
    }
  }

  /**
   * چک batch چند IP
   */
  async batchCheck(ips: string[]): Promise<Map<string, SpamhausResult>> {
    const map = new Map<string, SpamhausResult>();
    if (!THREAT_CONFIG.spamhaus.enabled) return map;

    try {
      const results = await batch(ips, THREAT_CONFIG.spamhaus.zones, {
        timeout: 5000,
        concurrency: 32
      });

      for (const ip of ips) {
        const ipResults = results.filter((r: any) => r.address === ip);
        const spamhaus = ipResults.find((r: any) => r.blacklist === 'zen.spamhaus.org');
        const spamcop = ipResults.find((r: any) => r.blacklist === 'bl.spamcop.net');
        const barracuda = ipResults.find((r: any) => r.blacklist === 'b.barracudacentral.org');

        map.set(ip, {
          spamhausListed: spamhaus?.listed || false,
          spamcopListed: spamcop?.listed || false,
          barracudaListed: barracuda?.listed || false,
          blacklistCount: ipResults.filter((r: any) => r.listed).length,
          allResults: ipResults.map((r: any) => ({
            zone: r.blacklist,
            listed: r.listed
          }))
        });
      }
    } catch (err) {
      console.error('[Spamhaus] batch check failed:', err);
    }

    return map;
  }

  /**
   * تفسیر کد برگشتی Spamhaus
   */
  interpretReturnCode(txt: string): string {
    const codes: Record<string, string> = {
      '127.0.0.2': 'SBL - Spamhaus Block List',
      '127.0.0.3': 'SBL CSS - Combined Spam Sources',
      '127.0.0.4': 'XBL - Exploits Block List',
      '127.0.0.9': 'DROP - Don\'t Route Or Peer',
      '127.0.0.10': 'PBL - Policy Block List',
      '127.0.0.11': 'PBL ISP Maintained',
      '127.255.255.252': 'Typing error in DNSBL name',
      '127.255.255.254': 'Query via public/open resolver'
    };
    return codes[txt] || 'Unknown listing';
  }

  private emptyResult(): SpamhausResult {
    return {
      spamhausListed: false,
      spamcopListed: false,
      barracudaListed: false,
      blacklistCount: 0,
      allResults: []
    };
  }
}

export const spamhausService = new SpamhausService();
