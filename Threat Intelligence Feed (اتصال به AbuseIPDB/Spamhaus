import { Request, Response, NextFunction } from 'express';
import { threatIntelService } from '../services/threatIntel.service.js';
import { THREAT_CONFIG } from '../config/threatIntel.config.js';
import { securityService } from '../services/security.service.js';
import db from '../services/db.service.js';
import crypto from 'crypto';

declare global {
  namespace Express {
    interface Request {
      threatIntel?: any;
    }
  }
}

export async function threatIntelGuard(req: Request, res: Response, next: NextFunction) {
  if (!THREAT_CONFIG.enabled) return next();

  const ip = req.ip || req.socket.remoteAddress || 'unknown';

  try {
    const result = await threatIntelService.check(ip);
    req.threatIntel = result;

    // زیر آستانه → اجازه
    if (result.riskScore < THREAT_CONFIG.abuseScoreThreshold) {
      return next();
    }

    // لاگ در suspicious_activity
    securityService.logSuspicious({
      userId: (req as any).user?.sub,
      ipAddress: ip,
      userAgent: req.headers['user-agent'],
      activityType: 'threat_intel_blocked',
      severity: result.riskLevel === 'critical' ? 'high' : 'medium',
      details: {
        riskScore: result.riskScore,
        abuseScore: result.abuseScore,
        isTor: result.isTor,
        blacklists: result.blacklists,
        provider: result.provider
      }
    });

    // ثبت رویداد
    db.prepare(`
      INSERT INTO threat_intel_events 
        (id, ip_address, user_id, path, action, risk_score, risk_level,
         abuse_score, is_tor, blacklists, details, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      crypto.randomUUID(),
      ip,
      (req as any).user?.sub || null,
      req.path,
      THREAT_CONFIG.action,
      result.riskScore,
      result.riskLevel,
      result.abuseScore,
      result.isTor ? 1 : 0,
      JSON.stringify(result.blacklists),
      JSON.stringify({ totalReports: result.totalReports, isp: result.isp }),
      Date.now()
    );

    // ───── Action ─────
    switch (THREAT_CONFIG.action) {
      case 'monitor':
        return next();

      case 'challenge':
        return res.status(403).json({
          success: false,
          code: 'THREAT_CHALLENGE',
          error: 'Additional verification required',
          riskScore: result.riskScore,
          riskLevel: result.riskLevel
        });

      case 'block':
        return res.status(403).json({
          success: false,
          code: 'THREAT_BLOCKED',
          error: 'Access denied: malicious IP detected',
          riskScore: result.riskScore,
          riskLevel: result.riskLevel
        });
    }

    next();
  } catch (err) {
    console.error('[ThreatIntel] Error:', err);
    next(); // fail-open
  }
}

/**
 * نسخه سبک — فقط attach
 */
export async function attachThreatProfile(req: Request, _res: Response, next: NextFunction) {
  if (!THREAT_CONFIG.enabled) return next();
  const ip = req.ip || 'unknown';
  try {
    req.threatIntel = await threatIntelService.check(ip);
  } catch {}
  next();
}
