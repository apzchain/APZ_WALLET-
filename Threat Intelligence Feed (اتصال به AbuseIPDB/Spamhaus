import { THREAT_CONFIG } from '../config/threatIntel.config.js';
import { abuseipdbService, AbuseIPDBResult } from './abuseipdb.service.js';
import { spamhausService, SpamhausResult } from './spamhaus.service.js';
import db from './db.service.js';

// ═══════════════════════════════════════════
//  Types
// ═══════════════════════════════════════════
export interface ThreatIntelResult {
  ip: string;
  riskScore: number;                  // 0-100
  riskLevel: 'low' | 'medium' | 'high' | 'critical';
  isMalicious: boolean;
  isTor: boolean;
  blacklists: string[];
  abuseScore: number;
  totalReports: number;
  countryCode?: string;
  isp?: string;
  abuseCategories: number[];
  lastReportedAt?: string;
  cached: boolean;
  provider: string;
}

interface CacheRow {
  ip_address: string;
  abuse_confidence_score: number;
  total_reports: number;
  num_distinct_users: number;
  last_reported_at: number | null;
  country_code: string | null;
  usage_type: string | null;
  isp: string | null;
  is_tor: number;
  abuse_categories: string | null;
  spamhaus_listed: number;
  spamhaus_zone: string | null;
  spamcop_listed: number;
  barracuda_listed: number;
  blacklist_count: number;
  risk_score: number;
  risk_level: string;
  provider: string;
  fetched_at: number;
  expires_at: number;
}

// ═══════════════════════════════════════════
//  Service
// ═══════════════════════════════════════════
export class ThreatIntelService {
  /**
   * چک اصلی — از cache یا providers
   */
  async check(ip: string): Promise<ThreatIntelResult> {
    const normalized = this.normalizeIp(ip);

    // IP private → بیخطر
    if (this.isPrivate(normalized)) {
      return this.makeResult(normalized, {
        abuseScore: 0,
        totalReports: 0,
        isTor: false,
        blacklists: [],
        abuseCategories: [],
        provider: 'private_ip'
      }, false);
    }

    // Cache
    const cached = this.getFromCache(normalized);
    if (cached) return cached;

    // اجرای همزمان AbuseIPDB و Spamhaus
    const [abuseResult, spamhausResult] = await Promise.all([
      abuseipdbService.check(normalized).catch(() => null),
      spamhausService.check(normalized).catch(() => this.emptySpamhaus())
    ]);

    // محاسبه risk score
    const result = this.computeResult(normalized, abuseResult, spamhausResult);

    // ذخیره در cache
    this.saveToCache(normalized, result, abuseResult, spamhausResult);

    return result;
  }

  // ═══════════════════════════════════════════
  //  Risk Computation
  // ═══════════════════════════════════════════
  private computeResult(
    ip: string,
    abuse: AbuseIPDBResult | null,
    spamhaus: SpamhausResult
  ): ThreatIntelResult {
    const W = THREAT_CONFIG.riskWeights;
    let score = 0;
    const blacklists: string[] = [];

    // ───── AbuseIPDB ─────
    if (abuse) {
      if (abuse.abuseConfidenceScore >= 75) {
        score += W.abuseConfidenceHigh;
      } else if (abuse.abuseConfidenceScore >= 25) {
        score += W.abuseConfidenceMedium;
      }
    }

    // ───── Spamhaus / DNSBL ─────
    if (spamhaus.spamhausListed) {
      score += W.spamhausListed;
      blacklists.push('spamhaus');
    }
    if (spamhaus.spamcopListed) {
      score += W.spamcopListed;
      blacklists.push('spamcop');
    }
    if (spamhaus.barracudaListed) {
      score += W.barracudaListed;
      blacklists.push('barracuda');
    }

    // در چندین لیست → امتیاز اضافه
    if (spamhaus.blacklistCount >= 2) {
      score += W.multipleBlacklists;
    }

    // ───── Tor ─────
    const isTor = abuse?.isTor || false;
    if (isTor && THREAT_CONFIG.blockTor) {
      score += W.isTor;
    }

    score = Math.min(100, score);

    return {
      ip,
      riskScore: score,
      riskLevel: this.scoreToLevel(score),
      isMalicious: score >= THREAT_CONFIG.abuseScoreThreshold,
      isTor,
      blacklists,
      abuseScore: abuse?.abuseConfidenceScore || 0,
      totalReports: abuse?.totalReports || 0,
      countryCode: abuse?.countryCode || undefined,
      isp: abuse?.isp || undefined,
      abuseCategories: abuse?.categories || [],
      lastReportedAt: abuse?.lastReportedAt || undefined,
      cached: false,
      provider: 'abuseipdb+spamhaus'
    };
  }

  private makeResult(
    ip: string,
    data: {
      abuseScore: number;
      totalReports: number;
      isTor: boolean;
      blacklists: string[];
      abuseCategories: number[];
      provider: string;
    },
    cached: boolean
  ): ThreatIntelResult {
    return {
      ip,
      riskScore: 0,
      riskLevel: 'low',
      isMalicious: false,
      isTor: data.isTor,
      blacklists: data.blacklists,
      abuseScore: data.abuseScore,
      totalReports: data.totalReports,
      abuseCategories: data.abuseCategories,
      cached,
      provider: data.provider
    };
  }

  private scoreToLevel(score: number): 'low' | 'medium' | 'high' | 'critical' {
    if (score >= 80) return 'critical';
    if (score >= 60) return 'high';
    if (score >= 30) return 'medium';
    return 'low';
  }

  // ═══════════════════════════════════════════
  //  Cache
  // ═══════════════════════════════════════════
  private getFromCache(ip: string): ThreatIntelResult | null {
    const row = db.prepare('SELECT * FROM threat_cache WHERE ip_address = ? AND expires_at > ?')
      .get(ip, Date.now()) as CacheRow | undefined;

    if (!row) return null;

    return {
      ip: row.ip_address,
      riskScore: row.risk_score,
      riskLevel: row.risk_level as any,
      isMalicious: row.risk_score >= THREAT_CONFIG.abuseScoreThreshold,
      isTor: row.is_tor === 1,
      blacklists: this.parseBlacklists(row),
      abuseScore: row.abuse_confidence_score,
      totalReports: row.total_reports,
      countryCode: row.country_code || undefined,
      isp: row.isp || undefined,
      abuseCategories: row.abuse_categories ? JSON.parse(row.abuse_categories) : [],
      cached: true,
      provider: row.provider
    };
  }

  private saveToCache(
    ip: string,
    result: ThreatIntelResult,
    abuse: AbuseIPDBResult | null,
    spamhaus: SpamhausResult
  ) {
    const now = Date.now();
    const expires = now + THREAT_CONFIG.cache.ttlMs;

    const blacklists: string[] = [];
    if (spamhaus.spamhausListed) blacklists.push('spamhaus');
    if (spamhaus.spamcopListed) blacklists.push('spamcop');
    if (spamhaus.barracudaListed) blacklists.push('barracuda');

    db.prepare(`
      INSERT INTO threat_cache 
        (ip_address, abuse_confidence_score, total_reports, num_distinct_users,
         last_reported_at, country_code, usage_type, isp, is_tor, abuse_categories,
         spamhaus_listed, spamhaus_zone, spamcop_listed, barracuda_listed,
         blacklist_count, risk_score, risk_level, provider, fetched_at, expires_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      ON CONFLICT(ip_address) DO UPDATE SET
        abuse_confidence_score = excluded.abuse_confidence_score,
        total_reports = excluded.total_reports,
        num_distinct_users = excluded.num_distinct_users,
        last_reported_at = excluded.last_reported_at,
        country_code = excluded.country_code,
        usage_type = excluded.usage_type,
        isp = excluded.isp,
        is_tor = excluded.is_tor,
        abuse_categories = excluded.abuse_categories,
        spamhaus_listed = excluded.spamhaus_listed,
        spamhaus_zone = excluded.spamhaus_zone,
        spamcop_listed = excluded.spamcop_listed,
        barracuda_listed = excluded.barracuda_listed,
        blacklist_count = excluded.blacklist_count,
        risk_score = excluded.risk_score,
        risk_level = excluded.risk_level,
        provider = excluded.provider,
        fetched_at = excluded.fetched_at,
        expires_at = excluded.expires_at
    `).run(
      ip,
      abuse?.abuseConfidenceScore || 0,
      abuse?.totalReports || 0,
      abuse?.numDistinctUsers || 0,
      abuse?.lastReportedAt ? new Date(abuse.lastReportedAt).getTime() : null,
      abuse?.countryCode || null,
      abuse?.usageType || null,
      abuse?.isp || null,
      abuse?.isTor ? 1 : 0,
      JSON.stringify(abuse?.categories || []),
      spamhaus.spamhausListed ? 1 : 0,
      spamhaus.spamhausZone || null,
      spamhaus.spamcopListed ? 1 : 0,
      spamhaus.barracudaListed ? 1 : 0,
      blacklists.length,
      result.riskScore,
      result.riskLevel,
      result.provider,
      now,
      expires
    );
  }

  private parseBlacklists(row: CacheRow): string[] {
    const bl: string[] = [];
    if (row.spamhaus_listed) bl.push('spamhaus');
    if (row.spamcop_listed) bl.push('spamcop');
    if (row.barracuda_listed) bl.push('barracuda');
    return bl;
  }

  private emptySpamhaus(): SpamhausResult {
    return {
      spamhausListed: false,
      spamcopListed: false,
      barracudaListed: false,
      blacklistCount: 0,
      allResults: []
    };
  }

  // ═══════════════════════════════════════════
  //  Helpers
  // ═══════════════════════════════════════════
  private normalizeIp(ip: string): string {
    if (ip.startsWith('::ffff:')) return ip.slice(7);
    return ip;
  }

  private isPrivate(ip: string): boolean {
    if (ip === '127.0.0.1' || ip === '::1' || ip === 'localhost') return true;
    if (ip.startsWith('10.')) return true;
    if (ip.startsWith('192.168.')) return true;
    if (/^172\.(1[6-9]|2\d|3[01])\./.test(ip)) return true;
    return false;
  }

  // ═══════════════════════════════════════════
  //  Stats & Admin
  // ═══════════════════════════════════════════
  getStats() {
    const total = db.prepare('SELECT COUNT(*) as c FROM threat_cache')
      .get() as { c: number };
    const malicious = db.prepare(`
      SELECT COUNT(*) as c FROM threat_cache WHERE risk_score >= ?
    `).get(THREAT_CONFIG.abuseScoreThreshold) as { c: number };
    const torCount = db.prepare('SELECT COUNT(*) as c FROM threat_cache WHERE is_tor = 1')
      .get() as { c: number };

    const topThreats = db.prepare(`
      SELECT ip_address, risk_score, risk_level, abuse_confidence_score, blacklist_count, isp
      FROM threat_cache 
      WHERE risk_score > 0
      ORDER BY risk_score DESC LIMIT 30
    `).all();

    const recentEvents = db.prepare(`
      SELECT * FROM threat_intel_events 
      ORDER BY created_at DESC LIMIT 50
    `).all();

    return {
      enabled: THREAT_CONFIG.enabled,
      action: THREAT_CONFIG.action,
      threshold: THREAT_CONFIG.abuseScoreThreshold,
      cacheSize: total.c,
      maliciousCount: malicious.c,
      torCount: torCount.c,
      abuseipdbQuota: abuseipdbService.getQuotaStatus(),
      topThreats,
      recentEvents
    };
  }

  async refreshCache() {
    // پاکسازی منقضیها
    const result = db.prepare('DELETE FROM threat_cache WHERE expires_at < ?')
      .run(Date.now());
    return { removed: result.changes };
  }

  /**
   * sync خودکار blacklistهای سراسری
   */
  async syncGlobalBlacklist() {
    try {
      const ips = await abuseipdbService.downloadBlacklist(90, 10000);
      console.log(`[ThreatIntel] Downloaded ${ips.length} IPs from AbuseIPDB blacklist`);

      // اینجا میتونی این IPها رو به blacklist اصلی اضافه کنی
      // از طریق ipAccessService.bulkAdd

      return { synced: ips.length };
    } catch (err) {
      console.error('[ThreatIntel] sync failed:', err);
      return { synced: 0 };
    }
  }
}

