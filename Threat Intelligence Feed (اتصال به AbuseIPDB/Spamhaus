    const results = await Promise.all(
      ips.map(ip => threatIntelService.check(ip).catch(err => ({
        ip, error: err.message, riskScore: -1, riskLevel: 'low' as const
      })))
    );
    res.json({ success: true, data: results });
  } catch (err) { next(err); }
});

