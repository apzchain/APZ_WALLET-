import React, { useEffect, useState } from 'react';
import { apiClient } from '../api/client';

interface Challenge {
  id: string;
  challenge: string;
  difficulty: number;
  expiresAt: number;
}

/**
 * چالش Proof-of-Work ساده:
 * کلاینت باید nonce پیدا کنه که SHA256(challenge + nonce) با N صفر شروع بشه.
 * این کار برای انسان نامرئیه (چند صد میلی‌ثانیه) ولی برای bot هزینه‌بره.
 */
export const BotChallengePage: React.FC<{ onVerified: () => void }> = ({ onVerified }) => {
  const [status, setStatus] = useState<'idle' | 'solving' | 'done' | 'error'>('idle');
  const [progress, setProgress] = useState(0);
  const [error, setError] = useState<string | null>(null);

  const solveChallenge = async () => {
    setStatus('solving');
    setProgress(0);
    setError(null);

    try {
      // 1. دریافت challenge
      const visitorId = localStorage.getItem('apz_visitor_id') || '';
      const res = await fetch('/api/auth/challenge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitorId })
      });
      const data = await res.json();

      if (!data.success || !data.data?.challenge) {
        throw new Error('دریافت challenge ناموفق');
      }

      const { id, challenge, difficulty } = data.data;
      const target = '0'.repeat(difficulty);

      // 2. حل PoW با Web Worker (تا UI freeze نشه)
      const nonce = await solvePow(challenge, target, (pct) => setProgress(pct));

      // 3. ارسال جواب
      const verifyRes = await fetch('/api/bot/verify-pow', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ visitorId, challengeId: id, nonce })
      });
      const verifyData = await verifyRes.json();

      if (!verifyData.success) {
        throw new Error('تأیید ناموفق');
      }

      setStatus('done');
      setTimeout(onVerified, 800);
    } catch (err: any) {
      setError(err.message);
      setStatus('error');
    }
  };

  useEffect(() => { solveChallenge(); }, []);

  return (
    <div className="bot-challenge-page">
      <div className="bot-challenge-card">
        <div className="bot-icon">🤖</div>
        <h1>در حال بررسی…</h1>
        <p>لطفاً چند لحظه صبر کن، در حال تأیید خودکار شما هستیم.</p>

        {status === 'solving' && (
          <div className="progress-bar">
            <div className="progress-fill" style={{ width: `${progress}%` }} />
            <span>{progress}%</span>
          </div>
        )}

        {status === 'done' && (
          <div className="success-msg">✅ تأیید شد! در حال انتقال…</div>
        )}

        {status === 'error' && (
          <>
            <div className="auth-error">⚠️ {error}</div>
            <button className="btn-primary" onClick={solveChallenge}>
              تلاش دوباره
            </button>
          </>
        )}
      </div>
    </div>
  );
};

/**
 * حل PoW با Web Worker درون‌خطی (بدون فایل جدا)
 */
function solvePow(
  challenge: string,
  target: string,
  onProgress: (pct: number) => void
): Promise<string> {
  return new Promise((resolve, reject) => {
    const workerCode = `
      self.onmessage = async (e) => {
        const { challenge, target } = e.data;
        let nonce = 0;
        const t0 = Date.now();
        const maxIterations = 50_000_000;

        while (nonce < maxIterations) {
          const buf = new TextEncoder().encode(challenge + nonce);
          const hashBuf = await crypto.subtle.digest('SHA-256', buf);
          const hash = Array.from(new Uint8Array(hashBuf))
            .map(b => b.toString(16).padStart(2, '0'))
            .join('');
          
          if (hash.startsWith(target)) {
            self.postMessage({ done: true, nonce: String(nonce) });
            return;
          }
          nonce++;
          
          // گزارش پیشرفت هر 1000 تلاش
          if (nonce % 1000 === 0) {
            self.postMessage({ progress: Math.min(95, nonce / 1000 / 100) });
          }
          
          // timeout
          if (Date.now() - t0 > 30000) {
            self.postMessage({ done: false, error: 'timeout' });
            return;
          }
        }
        self.postMessage({ done: false, error: 'max_iterations' });
      };
    `;

    const blob = new Blob([workerCode], { type: 'application/javascript' });
    const url = URL.createObjectURL(blob);
    const worker = new Worker(url);

    worker.onmessage = (e) => {
      if (e.data.progress) onProgress(Math.round(e.data.progress));
      if (e.data.done) {
        worker.terminate();
        URL.revokeObjectURL(url);
        resolve(e.data.nonce);
      } else if (e.data.done === false) {
        worker.terminate();
        URL.revokeObjectURL(url);
        reject(new Error(e.data.error));
      }
    };

    worker.onerror = (err) => {
      worker.terminate();
      URL.revokeObjectURL(url);
      reject(err);
    };

    worker.postMessage({ challenge, target });
  });
}
