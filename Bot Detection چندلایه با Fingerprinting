import crypto from 'crypto';
import db from './db.service.js';
import { BOT_CONFIG } from '../config/botDetection.config.js';

/**
 * JA3 = MD5(SSLVersion,Cipher,SSLExtension,EllipticCurve,EllipticCurvePointFormat)
 *
 * در Node.js خالص نمی‌شه JA3 رو مستقیم از socket گرفت.
 * راهکار: این محاسبه در nginx / Cloudflare انجام می‌شه و در هدر می‌رسه.
 *
 * ─── تنظیم nginx ───
 * map $ssl_protocol $ssl_protocol_num { "TLSv1.3" "772"; ... }
 * ... (نمونه config پایین توضیح داده شده)
 *
 * این سرویس، هدرهای ارسالی از proxy رو parse می‌کنه.
 */
export class Ja3Service {
  /**
   * استخراج JA3 hash از هدرهای درخواست
   */
  extractFromHeaders(headers: Record<string, any>): string | null {
    // Cloudflare
    if (headers['cf-ja3-hash']) return headers['cf-ja3-hash'];
    // nginx با ماژول ja3
    if (headers['x-ja3-hash']) return headers['x-ja3-hash'];
    // AWS ALB
    if (headers['x-amzn-tls-fingerprint']) return headers['x-amzn-tls-fingerprint'];
    return null;
  }

  /**
   * چک کردن JA3 hash در برابر لیست سیاه
   */
  check(ja3Hash: string | null): {
    suspicious: boolean;
    knownBad: boolean;
    riskContribution: number;
    reason?: string;
  } {
    if (!ja3Hash) return { suspicious: false, knownBad: false, riskContribution: 0 };

    // در لیست سیاه صریح
    if (BOT_CONFIG.knownBadJa3.includes(ja3Hash)) {
      return {
        suspicious: true,
        knownBad: true,
        riskContribution: BOT_CONFIG.riskWeights.knownBotJa3,
        reason: 'known_bot_ja3'
      };
    }

    if (BOT_CONFIG.ja3.blockedHashes.includes(ja3Hash)) {
      return {
        suspicious: true,
        knownBad: true,
        riskContribution: BOT_CONFIG.riskWeights.knownBotJa3,
        reason: 'blocked_ja3'
      };
    }

    // چک DB برای hash های قبلاً flag شده
    const row = db.prepare('SELECT is_malicious FROM ja3_fingerprints WHERE ja3_hash = ?')
      .get(ja3Hash) as { is_malicious: number } | undefined;

    if (row?.is_malicious === 1) {
      return {
        suspicious: true,
        knownBad: true,
        riskContribution: BOT_CONFIG.riskWeights.knownBotJa3,
        reason: 'previously_flagged_ja3'
      };
    }

    return { suspicious: false, knownBad: false, riskContribution: 0 };
  }

  /**
   * ثبت JA3 مشاهده‌شده
   */
  record(ja3Hash: string, ja3String: string | null, ip: string, userAgent: string) {
    const now = Date.now();
    const existing = db.prepare('SELECT * FROM ja3_fingerprints WHERE ja3_hash = ?')
      .get(ja3Hash) as any;

    if (existing) {
      db.prepare(`
        UPDATE ja3_fingerprints SET
          last_seen_at = ?, seen_count = seen_count + 1, ip_address = ?, user_agent = ?
        WHERE ja3_hash = ?
      `).run(now, ip, userAgent, ja3Hash);
    } else {
      db.prepare(`
        INSERT INTO ja3_fingerprints 
          (ja3_hash, ja3_string, ip_address, user_agent, first_seen_at, last_seen_at, seen_count)
        VALUES (?, ?, ?, ?, ?, ?, 1)
      `).run(ja3Hash, ja3String, ip, userAgent, now, now);
    }
  }

  markMalicious(ja3Hash: string, notes?: string) {
    db.prepare(`
      UPDATE ja3_fingerprints SET is_malicious = 1, notes = ? WHERE ja3_hash = ?
    `).run(notes || null, ja3Hash);
  }

  getStats() {
    return db.prepare(`
      SELECT ja3_hash, seen_count, is_malicious, last_seen_at,
             (SELECT COUNT(DISTINCT ip_address) FROM ja3_fingerprints f2 WHERE f2.ja3_hash = f.ja3_hash) as ip_count
      FROM ja3_fingerprints f
      ORDER BY seen_count DESC LIMIT 30
    `).all();
  }
}

export const ja3Service = new Ja3Service();
