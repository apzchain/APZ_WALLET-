import { Request, Response, NextFunction } from 'express';
import { botDetectionService } from '../services/botDetection.service.js';
import { BOT_CONFIG } from '../config/botDetection.config.js';
import { securityService } from '../services/security.service.js';

declare global {
  namespace Express {
    interface Request {
      botDetection?: any;
    }
  }
}

/**
 * Middleware اصلی که کلاینت fingerprint + behavioral داده‌ها رو در body یا headers می‌فرسته.
 * اگر داده نباشه → امتیاز بر اساس UA/headers محاسبه می‌شه.
 */
export async function botDetectionGuard(req: Request, res: Response, next: NextFunction) {
  if (!BOT_CONFIG.enabled) return next();

  const ip = req.ip || 'unknown';
  const userAgent = req.headers['user-agent'] || '';

  // استخراج fingerprint از body یا header
  const visitorId = 
    req.body?.__visitorId || 
    req.headers['x-visitor-id'] as string ||
    null;

  // اگر visitorId نداریم، اجازه بدیم ولی flag کنیم
  if (!visitorId) {
    // UA-based only fallback
    const uaResult = await botDetectionService.detect({
      visitorId: 'anonymous:' + ip,
      components: {},
      behavioral: {},
      ip,
      userAgent,
      userId: (req as any).user?.sub,
      headers: req.headers as any
    });
    (req as any).botDetection = uaResult;
    if (uaResult.action === 'block') {
      return res.status(403).json({
        success: false,
        code: 'BOT_BLOCKED',
        error: 'Access denied',
        riskScore: uaResult.riskScore
      });
    }
    if (uaResult.action === 'challenge') {
      return res.status(403).json({
        success: false,
        code: 'BOT_CHALLENGE',
        error: 'Verification required',
        riskScore: uaResult.riskScore
      });
    }
    return next();
  }

  const components = req.body?.__fp || {};
  const behavioral = req.body?.__behavior || {};

  try {
    const result = await botDetectionService.detect({
      visitorId,
      components,
      behavioral,
      ip,
      userAgent,
      userId: (req as any).user?.sub,
      headers: req.headers as any
    });

    req.botDetection = result;

    if (result.riskScore >= 30) {
      securityService.logSuspicious({
        userId: (req as any).user?.sub,
        ipAddress: ip,
        userAgent,
        activityType: 'bot_suspected',
        severity: result.riskLevel === 'critical' || result.riskLevel === 'high' ? 'high' : 'medium',
        details: {
          riskScore: result.riskScore,
          flags: result.flags,
          reasons: result.reasons
        }
      });
    }

    if (result.action === 'block') {
      return res.status(403).json({
        success: false,
        code: 'BOT_BLOCKED',
        error: 'Access denied',
        riskScore: result.riskScore,
        riskLevel: result.riskLevel
      });
    }

    if (result.action === 'challenge') {
      // اگر verified هست، اجازه بده
      if (!result.isBot || result.flags.includes('known_bot') === false && result.riskScore < BOT_CONFIG.riskThreshold) {
        return next();
      }
      return res.status(403).json({
        success: false,
        code: 'BOT_CHALLENGE',
        error: 'Please complete verification',
        riskScore: result.riskScore,
        riskLevel: result.riskLevel,
        challenge: botDetectionService.createPowChallenge(visitorId)
      });
    }

    next();
  } catch (err) {
    console.error('[BotDetection] Error:', err);
    next(); // fail-open
  }
}

/**
 * نسخه سبک — فقط attach می‌کنه
 */
export async function attachBotProfile(req: Request, _res: Response, next: NextFunction) {
  if (!BOT_CONFIG.enabled) return next();
  const visitorId = req.body?.__visitorId || req.headers['x-visitor-id'];
  if (!visitorId) return next();
  try {
    req.botDetection = await botDetectionService.detect({
      visitorId: String(visitorId),
      components: req.body?.__fp || {},
      behavioral: req.body?.__behavior || {},
      ip: req.ip || 'unknown',
      userAgent: req.headers['user-agent'] || '',
      userId: (req as any).user?.sub,
      headers: req.headers as any
    });
  } catch {}
  next();
}
