export interface BehavioralData {
  pageDwellMs: number;
  mouseEvents: number;
  mouseDistance: number;
  mouseAvgSpeed: number;
  mouseMaxSpeed: number;
  mouseLinearity: number;
  keystrokes: number;
  keystrokeVariance: number;
  scrollEvents: number;
  touchEvents: number;
  focusBlurCount: number;
  copyPasteCount: number;
  tabSwitches: number;
  timeToFirstInteractionMs: number | null;
}

export class BehavioralTracker {
  private startTime = Date.now();
  private firstInteraction: number | null = null;

  private mousePositions: { x: number; y: number; t: number }[] = [];
  private keystrokeTimes: number[] = [];
  private scrollCount = 0;
  private touchCount = 0;
  private focusBlurCount = 0;
  private copyPasteCount = 0;
  private tabSwitches = 0;

  private listeners: Array<() => void> = [];

  start() {
    const onMouseMove = (e: MouseEvent) => {
      this.markFirstInteraction();
      this.mousePositions.push({ x: e.clientX, y: e.clientY, t: performance.now() });
      // حداکثر 500 نقطه نگه‌دار
      if (this.mousePositions.length > 500) this.mousePositions.shift();
    };

    const onKeyDown = () => {
      this.markFirstInteraction();
      this.keystrokeTimes.push(performance.now());
      if (this.keystrokeTimes.length > 200) this.keystrokeTimes.shift();
    };

    const onScroll = () => { this.markFirstInteraction(); this.scrollCount++; };
    const onTouch = () => { this.markFirstInteraction(); this.touchCount++; };
    const onFocus = () => { this.focusBlurCount++; };
    const onBlur = () => { this.focusBlurCount++; };
    const onCopy = () => { this.copyPasteCount++; };
    const onPaste = () => { this.copyPasteCount++; };
    const onVisibility = () => {
      if (document.hidden) this.tabSwitches++;
    };

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('keydown', onKeyDown, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('touchstart', onTouch, { passive: true });
    window.addEventListener('focus', onFocus, { passive: true });
    window.addEventListener('blur', onBlur, { passive: true });
    document.addEventListener('copy', onCopy);
    document.addEventListener('paste', onPaste);
    document.addEventListener('visibilitychange', onVisibility);

    this.listeners = [
      () => window.removeEventListener('mousemove', onMouseMove),
      () => window.removeEventListener('keydown', onKeyDown),
      () => window.removeEventListener('scroll', onScroll),
      () => window.removeEventListener('touchstart', onTouch),
      () => window.removeEventListener('focus', onFocus),
      () => window.removeEventListener('blur', onBlur),
      () => document.removeEventListener('copy', onCopy),
      () => document.removeEventListener('paste', onPaste),
      () => document.removeEventListener('visibilitychange', onVisibility)
    ];
  }

  private markFirstInteraction() {
    if (!this.firstInteraction) this.firstInteraction = performance.now();
  }

  collect(): BehavioralData {
    const dwell = Date.now() - this.startTime;

    // ───── Mouse analysis ─────
    const positions = this.mousePositions;
    let distance = 0;
    let maxSpeed = 0;
    const speeds: number[] = [];

    for (let i = 1; i < positions.length; i++) {
      const p = positions[i - 1];
      const q = positions[i];
      const d = Math.hypot(q.x - p.x, q.y - p.y);
      const dt = (q.t - p.t) / 1000;
      distance += d;
      if (dt > 0) {
        const s = d / dt;
        speeds.push(s);
        if (s > maxSpeed) maxSpeed = s;
      }
    }

    const avgSpeed = speeds.length ? speeds.reduce((a, b) => a + b, 0) / speeds.length : 0;

    // ───── Linearity: چقدر مسیر مستقیمه (0-1)
    let linearity = 0;
    if (positions.length >= 3) {
      // نسبت فاصله اولین تا آخرین نقطه، به مجموع مسیر طی‌شده
      const first = positions[0];
      const last = positions[positions.length - 1];
      const straightDist = Math.hypot(last.x - first.x, last.y - first.y);
      linearity = distance > 0 ? straightDist / distance : 0;
    }

    // ───── Keystroke variance ─────
    let keystrokeVariance = 0;
    if (this.keystrokeTimes.length >= 2) {
      const intervals: number[] = [];
      for (let i = 1; i < this.keystrokeTimes.length; i++) {
        intervals.push(this.keystrokeTimes[i] - this.keystrokeTimes[i - 1]);
      }
      const mean = intervals.reduce((a, b) => a + b, 0) / intervals.length;
      keystrokeVariance = Math.sqrt(
        intervals.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / intervals.length
      );
    }

    return {
      pageDwellMs: dwell,
      mouseEvents: positions.length,
      mouseDistance: Math.round(distance),
      mouseAvgSpeed: Math.round(avgSpeed),
      mouseMaxSpeed: Math.round(maxSpeed),
      mouseLinearity: Math.round(linearity * 1000) / 1000,
      keystrokes: this.keystrokeTimes.length,
      keystrokeVariance: Math.round(keystrokeVariance * 100) / 100,
      scrollEvents: this.scrollCount,
      touchEvents: this.touchCount,
      focusBlurCount: this.focusBlurCount,
      copyPasteCount: this.copyPasteCount,
      tabSwitches: this.tabSwitches,
      timeToFirstInteractionMs: this.firstInteraction
        ? Math.round(this.firstInteraction)
        : null
    };
  }

  stop() {
    this.listeners.forEach(fn => fn());
    this.listeners = [];
  }
}
