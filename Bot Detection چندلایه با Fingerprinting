🚀 تنظیم nginx برای JA3 (اختیاری اما توصیه‌شده)

```nginx
# در http block:
map $ssl_protocol $ssl_protocol_num {
    "TLSv1.3" "772";
    "TLSv1.2" "771";
    "TLSv1.1" "770";
    "TLSv1.0" "769";
}

# در server block:
location / {
    # JA3 hash از ماژول ngx_http_ssl_fingerprint
    proxy_set_header X-JA3-Hash $http_x_ja3_hash;
    proxy_set_header X-JA3-String $http_x_ja3_string;
    # یا از Cloudflare:
    proxy_set_header X-CF-JA3 $http_cf_ja3_hash;
    
    proxy_pass http://localhost:3001;
}
```

