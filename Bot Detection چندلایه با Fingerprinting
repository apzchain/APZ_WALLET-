                {(JSON.parse(fp.flags || '[]') as string[]).slice(0, 3).map((f, i) => (
                  <span key={i} className="flag-chip">{f}</span>
                ))}
              </td>
              <td>
                {!fp.is_verified && (
                  <button className="btn-icon-success" onClick={() => markVerified(fp.visitor_id)}>
                    ✓
                  </button>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {/* ───── JA3 ───── */}
      <h3>JA3 TLS Fingerprints</h3>
      <table className="admin-table compact">
        <thead>
          <tr>
            <th>JA3 Hash</th>
            <th>تعداد دفعات</th>
            <th>IP های یکتا</th>
            <th>وضعیت</th>
          </tr>
        </thead>
        <tbody>
          {ja3.map(j => (
            <tr key={j.ja3_hash}>
              <td><code dir="ltr">{j.ja3_hash.slice(0, 16)}…</code></td>
              <td>{j.seen_count}</td>
              <td>{j.ip_count}</td>
              <td>
                {j.is_malicious ? (
                  <span className="badge blacklist">🚫 Bad</span>
                ) : (
                  <span className="badge whitelist">✅ OK</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      {/* ───── Risk Weights ───── */}
      {config?.riskWeights && (
        <>
          <h3>وزن‌های Risk Score</h3>
          <div className="risk-weights">
            {Object.entries(config.riskWeights).map(([k, v]) => (
              <div key={k} className="weight-item">
                <span>{k}</span>
                <strong>+{v as number}</strong>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
};
