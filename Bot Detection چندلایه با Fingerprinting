import { getFingerprint, CollectedFingerprint } from './FingerprintCollector';
import { BehavioralTracker, BehavioralData } from './behavioralTracker';

const VISITOR_ID_KEY = 'apz_visitor_id';

function getOrCreateVisitorId(): string {
  let id = localStorage.getItem(VISITOR_ID_KEY);
  if (!id) {
    id = crypto.randomUUID();
    localStorage.setItem(VISITOR_ID_KEY, id);
  }
  return id;
}

export function useFingerprint() {
  const [fingerprint, setFingerprint] = useState<CollectedFingerprint | null>(null);
  const [behavioral, setBehavioral] = useState<BehavioralData | null>(null);
  const trackerRef = useRef<BehavioralTracker | null>(null);
  const visitorIdRef = useRef<string>(getOrCreateVisitorId());

  useEffect(() => {
    getFingerprint().then(setFingerprint);

    const tracker = new BehavioralTracker();
    tracker.start();
    trackerRef.current = tracker;

    // هر ۲ ثانیه behavioral رو آپدیت کن
    const interval = setInterval(() => {
      setBehavioral(tracker.collect());
    }, 2000);

    // در unload نهایی یک‌بار دیگه
    const onUnload = () => setBehavioral(tracker.collect());
    window.addEventListener('beforeunload', onUnload);

    return () => {
      clearInterval(interval);
      window.removeEventListener('beforeunload', onUnload);
      tracker.stop();
    };
  }, []);

  return {
    visitorId: visitorIdRef.current,
    fingerprint,
    behavioral,
    /**
     * درخواست API رو با fingerprint و behavioral همراه کن
     */
    wrapBody: (body: any = {}) => ({
      ...body,
      __visitorId: visitorIdRef.current,
      __fp: fingerprint || {},
      __behavior: trackerRef.current?.collect() || behavioral || {}
    }),
    /**
     * هدرهای اضافی
     */
    headers: {
      'X-Visitor-Id': visitorIdRef.current
    }
  };
}
