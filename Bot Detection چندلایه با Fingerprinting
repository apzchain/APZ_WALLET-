```typescript
import crypto from 'crypto';
import db from './db.service.js';
import { BOT_CONFIG } from '../config/botDetection.config.js';

export interface FingerprintComponents {
  canvas?: string;
  webgl?: string;
  audio?: string;
  fonts?: string[];
  screen?: { w: number; h: number; colorDepth: number; pixelRatio: number };
  timezone?: string;
  language?: string;
  languages?: string[];
  platform?: string;
  hardwareConcurrency?: number;
  deviceMemory?: number;
  touchSupport?: boolean;
  doNotTrack?: string;
  cookieEnabled?: boolean;
  pluginsCount?: number;
  userAgent?: string;
  [key: string]: any;
}

export interface FingerprintRow {
  id: string;
  visitor_id: string;
  fingerprint_hash: string;
  components: string;
  risk_score: number;
  risk_level: string;
  is_bot: number;
  is_verified: number;
  first_seen_at: number;
  last_seen_at: number;
  seen_count: number;
  associated_user_ids: string | null;
  associated_ips: string | null;
  user_agents: string | null;
  flags: string | null;
}

export class FingerprintService {
  /**
   * Hash کردن اجزای fingerprint به یک شناسه پایدار
   */
  computeHash(components: FingerprintComponents): string {
    // فقط اجزای پایدار
    const stable = {
      canvas: components.canvas,
      webgl: components.webgl,
      audio: components.audio,
      fonts: (components.fonts || []).sort().join(','),
      screen: components.screen,
      timezone: components.timezone,
      platform: components.platform,
      hardwareConcurrency: components.hardwareConcurrency,
      deviceMemory: components.deviceMemory,
      touchSupport: components.touchSupport
    };

    return crypto
      .createHash('sha256')
      .update(JSON.stringify(stable))
      .digest('hex');
  }

  /**
   * ثبت یا به‌روزرسانی fingerprint
   */
  upsert(params: {
    visitorId: string;
    components: FingerprintComponents;
    ip: string;
    userAgent: string;
    userId?: string;
    riskScore: number;
    riskLevel: string;
    isBot: boolean;
    flags: string[];
  }): FingerprintRow {
    const existing = db.prepare('SELECT * FROM fingerprints WHERE visitor_id = ?')
      .get(params.visitorId) as FingerprintRow | undefined;

    const hash = this.computeHash(params.components);
    const now = Date.now();

    if (existing) {
      // ادغام arrays
      const ips = this.mergeArray(existing.associated_ips, params.ip);
      const uas = this.mergeArray(existing.user_agents, params.userAgent);
      const uids = params.userId
        ? this.mergeArray(existing.associated_user_ids, params.userId)
        : existing.associated_user_ids;
      const flags = this.mergeArray(existing.flags, params.flags);

      // میانگین وزنی risk score
      const newRisk = Math.max(
        existing.risk_score,
        Math.round((existing.risk_score * existing.seen_count + params.riskScore) / (existing.seen_count + 1))
      );

      db.prepare(`
        UPDATE fingerprints SET
          fingerprint_hash = ?,
          components = ?,
          risk_score = ?,
          risk_level = ?,
          is_bot = ?,
          last_seen_at = ?,
          seen_count = seen_count + 1,
          associated_user_ids = ?,
          associated_ips = ?,
          user_agents = ?,
          flags = ?
        WHERE visitor_id = ?
      `).run(
        hash,
        JSON.stringify(params.components),
        newRisk,
        this.scoreToLevel(newRisk),
        existing.is_bot || params.isBot ? 1 : 0,
        now,
        uids,
        ips,
        uas,
        flags,
        params.visitorId
      );

      return db.prepare('SELECT * FROM fingerprints WHERE visitor_id = ?')
        .get(params.visitorId) as FingerprintRow;
    }

    // ثبت جدید
    const id = crypto.randomUUID();
    db.prepare(`
      INSERT INTO fingerprints 
        (id, visitor_id, fingerprint_hash, components, risk_score, risk_level, is_bot, is_verified,
         first_seen_at, last_seen_at, seen_count, associated_user_ids, associated_ips, user_agents, flags)
      VALUES (?, ?, ?, ?, ?, ?, ?, 0, ?, ?, 1, ?, ?, ?, ?)
    `).run(
      id,
      params.visitorId,
      hash,
      JSON.stringify(params.components),
      params.riskScore,
      params.riskLevel,
      params.isBot ? 1 : 0,
      now,
      now,
      params.userId ? JSON.stringify([params.userId]) : null,
      JSON.stringify([params.ip]),
      JSON.stringify([params.userAgent]),
      JSON.stringify(params.flags)
    );

    return db.prepare('SELECT * FROM fingerprints WHERE visitor_id = ?')
      .get(params.visitorId) as FingerprintRow;
  }

  /**
   * آیا این fingerprint قبلاً bot تشخیص داده شده؟
   */
  isKnownBot(visitorId: string): boolean {
    const row = db.prepare('SELECT is_bot FROM fingerprints WHERE visitor_id = ?')
      .get(visitorId) as { is_bot: number } | undefined;
    return row?.is_bot === 1;
  }

  /**
   * آیا این fingerprint از چند IP مختلف دیده شده؟ (نشانه botnet/farm)
   */
  isSharedFingerprint(visitorId: string, threshold = 5): { shared: boolean; ipsCount: number } {
    const row = db.prepare('SELECT associated_ips FROM fingerprints WHERE visitor_id = ?')
      .get(visitorId) as { associated_ips: string | null } | undefined;
    if (!row?.associated_ips) return { shared: false, ipsCount: 0 };
    const ips = JSON.parse(row.associated_ips) as string[];
    return { shared: ips.length >= threshold, ipsCount: ips.length };
  }

  markVerified(visitorId: string) {
    db.prepare('UPDATE fingerprints SET is_verified = 1 WHERE visitor_id = ?')
      .run(visitorId);
  }

  getByVisitor(visitorId: string): FingerprintRow | undefined {
    return db.prepare('SELECT * FROM fingerprints WHERE visitor_id = ?')
      .get(visitorId) as FingerprintRow | undefined;
  }

  getStats() {
    const total = db.prepare('SELECT COUNT(*) as c FROM fingerprints')
      .get() as { c: number };
    const bots = db.prepare('SELECT COUNT(*) as c FROM fingerprints WHERE is_bot = 1')
      .get() as { c: number };
    const verified = db.prepare('SELECT COUNT(*) as c FROM fingerprints WHERE is_verified = 1')
      .get() as { c: number };

    const topRisk = db.prepare(`
      SELECT visitor_id, risk_score, risk_level, seen_count, associated_ips
      FROM fingerprints ORDER BY risk_score DESC LIMIT 20
    `).all();

    return {
      total: total.c,
      bots: bots.c,
      verified: verified.c,
      humanRate: total.c ? ((total.c - bots.c) / total.c * 100).toFixed(1) : '0',
      topRisk
    };
  }

  private mergeArray(jsonArr: string | null, value: string | string[]): string {
    const arr: string[] = jsonArr ? JSON.parse(jsonArr) : [];
    const values = Array.isArray(value) ? value : [value];
    for (const v of values) {
      if (v && !arr.includes(v)) arr.push(v);
    }
    return JSON.stringify(arr.slice(-50)); // حداکثر 50 تا نگه‌دار
  }

  private scoreToLevel(score: number): 'low' | 'medium' | 'high' | 'critical' {
    if (score >= 80) return 'critical';
    if (score >= 60) return 'high';
    if (score >= 30) return 'medium';
    return 'low';
  }
}

export const fingerprintService = new FingerprintService();
```

