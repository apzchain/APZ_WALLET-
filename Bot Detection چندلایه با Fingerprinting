/**
 * جمع‌آوری جامع fingerprint از مرورگر
 * بدون کتابخانه خارجی، سبک و سریع
 */
export interface CollectedFingerprint {
  canvas?: string;
  webgl?: string;
  audio?: string;
  fonts?: string[];
  screen?: { w: number; h: number; colorDepth: number; pixelRatio: number };
  timezone?: string;
  language?: string;
  languages?: string[];
  platform?: string;
  hardwareConcurrency?: number;
  deviceMemory?: number;
  touchSupport?: boolean;
  doNotTrack?: string;
  cookieEnabled?: boolean;
  pluginsCount?: number;
  userAgent?: string;
  // ───── bot signals ─────
  webdriver?: boolean;
  hasChrome?: boolean;
  hasPhantom?: boolean;
  headlessHints?: string[];
}

export class FingerprintCollector {
  async collect(): Promise<CollectedFingerprint> {
    const fp: CollectedFingerprint = {};

    fp.canvas = this.canvasFingerprint();
    fp.webgl = this.webglFingerprint();
    fp.audio = await this.audioFingerprint();
    fp.fonts = this.fontFingerprint();
    fp.screen = {
      w: window.screen.width,
      h: window.screen.height,
      colorDepth: window.screen.colorDepth,
      pixelRatio: window.devicePixelRatio
    };
    fp.timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    fp.language = navigator.language;
    fp.languages = [...(navigator.languages || [])];
    fp.platform = navigator.platform;
    fp.hardwareConcurrency = navigator.hardwareConcurrency;
    fp.deviceMemory = (navigator as any).deviceMemory;
    fp.touchSupport = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
    fp.doNotTrack = navigator.doNotTrack || undefined;
    fp.cookieEnabled = navigator.cookieEnabled;
    fp.pluginsCount = navigator.plugins?.length || 0;
    fp.userAgent = navigator.userAgent;

    // ───── Bot signals ─────
    fp.webdriver = navigator.webdriver === true;
    fp.hasChrome = typeof (window as any).chrome !== 'undefined';
    fp.hasPhantom = typeof (window as any)._phantom !== 'undefined' ||
                    typeof (window as any).callPhantom !== 'undefined' ||
                    typeof (window as any).__nightmare !== 'undefined';

    // headless hints
    const hints: string[] = [];
    if (navigator.plugins.length === 0 && /chrome/i.test(navigator.userAgent)) {
      hints.push('no_plugins');
    }
    if ((navigator.languages || []).length === 0) {
      hints.push('no_languages');
    }
    if (!(window as any).chrome && /chrome/i.test(navigator.userAgent)) {
      hints.push('chrome_missing');
    }
    // Notification permission در headless معمولاً denied هست
    if (typeof Notification !== 'undefined' && Notification.permission === 'denied' && navigator.webdriver) {
      hints.push('denied_notification');
    }
    fp.headlessHints = hints;

    return fp;
  }

  // ═══════════════════════════════════════════
  //  Canvas
  // ═══════════════════════════════════════════
  private canvasFingerprint(): string {
    try {
      const canvas = document.createElement('canvas');
      canvas.width = 200;
      canvas.height = 60;
      const ctx = canvas.getContext('2d');
      if (!ctx) return 'no-ctx';

      ctx.textBaseline = 'top';
      ctx.font = '14px Arial';
      ctx.fillStyle = '#f60';
      ctx.fillRect(125, 1, 62, 20);
      ctx.fillStyle = '#069';
      ctx.fillText('APZ Wallet 🔐', 2, 15);
      ctx.fillStyle = 'rgba(102,204,0,0.7)';
      ctx.fillText('APZ Wallet 🔐', 4, 17);

      return canvas.toDataURL();
    } catch {
      return 'error';
    }
  }

  // ═══════════════════════════════════════════
  //  WebGL
  // ═══════════════════════════════════════════
  private webglFingerprint(): string {
    try {
      const canvas = document.createElement('canvas');
      const gl = (canvas.getContext('webgl') || canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
      if (!gl) return 'no-webgl';

      const ext = gl.getExtension('WEBGL_debug_renderer_info');
      const vendor = ext ? gl.getParameter(ext.UNMASKED_VENDOR_WEBGL) : gl.getParameter(gl.VENDOR);
      const renderer = ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER);

      return `${vendor}|${renderer}`;
    } catch {
      return 'error';
    }
  }

  // ═══════════════════════════════════════════
  //  Audio
  // ═══════════════════════════════════════════
  private async audioFingerprint(): Promise<string> {
    try {
      const AudioContext = (window as any).AudioContext || (window as any).webkitAudioContext;
      if (!AudioContext) return 'no-audio';

      const ctx = new AudioContext();
      const oscillator = ctx.createOscillator();
      const analyser = ctx.createAnalyser();
      const gain = ctx.createGain();
      const dest = ctx.createMediaStreamDestination();

      oscillator.type = 'triangle';
      oscillator.frequency.value = 10000;
      gain.gain.value = 0;

      oscillator.connect(analyser);
      analyser.connect(gain);
      gain.connect(dest);
      gain.connect(ctx.destination);

      oscillator.start(0);

      return new Promise(resolve => {
        setTimeout(() => {
          try {
            const data = new Float32Array(analyser.frequencyBinCount);
            analyser.getFloatFrequencyData(data);
            const sum = data.reduce((a, b) => a + (isFinite(b) ? b : 0), 0);
            oscillator.stop();
            ctx.close();
            resolve(sum.toString());
          } catch {
            resolve('error');
          }
        }, 100);
      });
    } catch {
      return 'error';
    }
  }

  // ═══════════════════════════════════════════
  //  Fonts
  // ═══════════════════════════════════════════
  private fontFingerprint(): string[] {
    try {
      const baseFonts = ['monospace', 'sans-serif', 'serif'];
      const testFonts = [
        'Arial', 'Verdana', 'Times New Roman', 'Courier New',
        'Georgia', 'Comic Sans MS', 'Trebuchet MS', 'Impact',
        'Tahoma', 'Vazirmatn', 'IRANSans', 'Iranian Sans'
      ];
      const testString = 'mmmmmmmmmmlli';
      const testSize = '72px';

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      if (!ctx) return [];

      const getWidth = (font: string) => {
        ctx.font = `${testSize} ${font}`;
        return ctx.measureText(testString).width;
      };

      const baseWidths: Record<string, number> = {};
      for (const base of baseFonts) baseWidths[base] = getWidth(base);

      const detected: string[] = [];
      for (const font of testFonts) {
        let detectedFont = false;
        for (const base of baseFonts) {
          const width = getWidth(`"${font}",${base}`);
          if (width !== baseWidths[base]) {
            detectedFont = true;
            break;
          }
        }
        if (detectedFont) detected.push(font);
      }
      return detected;
    } catch {
      return [];
    }
  }
}

// ───── singleton ─────
let collected: CollectedFingerprint | null = null;

export async function getFingerprint(): Promise<CollectedFingerprint> {
  if (collected) return collected;
  const collector = new FingerprintCollector();
  collected = await collector.collect();
  return collected;
}
