  expiresAt: number;
}

// ═══════════════════════════════════════════
//  Service
// ═══════════════════════════════════════════
export class BotDetectionService {
  private cache = new Map<string, CacheEntry>();

  // ═══════════════════════════════════════════
  //  Main Check
  // ═══════════════════════════════════════════
  async detect(input: BotDetectionInput): Promise<BotDetectionResult> {
    const cacheKey = `${input.visitorId}:${input.ip}`;
    const cached = this.cache.get(cacheKey);
    if (cached && cached.expiresAt > Date.now()) {
      return { ...cached.result, cached: true };
    }

    const result = await this.analyze(input);

    this.cache.set(cacheKey, {
      result,
      expiresAt: Date.now() + 60_000 // 1 دقیقه کش (کوتاه، چون رفتار تغییر می‌کنه)
    });

    return result;
  }

  private async analyze(input: BotDetectionInput): Promise<BotDetectionResult> {
    const flags: string[] = [];
    const reasons: string[] = [];
    const W = BOT_CONFIG.riskWeights;
    let score = 0;

    // ═══════════════════════════════════════════
    //  1. User-Agent Analysis
    // ═══════════════════════════════════════════
    const ua = input.userAgent || '';
    const uaParsed = new UAParser(ua).getResult();

    for (const pattern of BOT_CONFIG.botUserAgents) {
      if (pattern.test(ua)) {
        flags.push('bot_ua');
        reasons.push(`bot_user_agent_pattern:${pattern.source}`);
        score += W.headlessUA;
        break;
      }
    }

    // UA خالی یا مشکوک
    if (!ua || ua.length < 15) {
      flags.push('missing_ua');
      score += 20;
    }

    // آیا ادعای Chrome داره ولی bot هست؟
    if (/chrome/i.test(ua) && !uaParsed.browser.version) {
      flags.push('fake_chrome');
      score += 15;
    }

    // ═══════════════════════════════════════════
    //  2. Headless Detection
    // ═══════════════════════════════════════════
    const b = input.behavioral;

    if (b.webdriver) {
      flags.push('webdriver_flag');
      reasons.push('navigator.webdriver=true');
      score += W.webdriverFlag;
    }

    if (b.hasPhantom) {
      flags.push('phantom_detected');
      reasons.push('window._phantom or window.callPhantom');
      score += W.phantomProps;
    }

    if (b.pluginsCount === 0 && /chrome|firefox/i.test(ua)) {
      flags.push('no_plugins');
      score += W.missingPlugins;
    }

    if (b.languagesCount === 0) {
      flags.push('no_languages');
      score += W.noLanguages;
    }

    if (b.hasChrome === false && /chrome/i.test(ua)) {
      flags.push('chrome_obj_missing');
      score += W.zeroChromeObj;
    }

    // ═══════════════════════════════════════════
    //  3. Header Analysis
    // ═══════════════════════════════════════════
    for (const h of BOT_CONFIG.suspiciousHeaders) {
      if (input.headers[h]) {
        flags.push('automation_header');
        reasons.push(`suspicious_header:${h}`);
        score += W.automationHeaders;
        break;
      }
    }

    if (!input.headers['accept-language']) {
      flags.push('no_accept_language');
      score += W.missingAcceptLanguage;
    }

    // ═══════════════════════════════════════════
    //  4. JA3 / TLS Fingerprint
    // ═══════════════════════════════════════════
    const ja3Hash = ja3Service.extractFromHeaders(input.headers);
    if (ja3Hash) {
      ja3Service.record(ja3Hash, null, input.ip, ua);
      const ja3Check = ja3Service.check(ja3Hash);
      if (ja3Check.suspicious) {
        flags.push('suspicious_ja3');
        reasons.push(`ja3:${ja3Check.reason}`);
        score += ja3Check.riskContribution;
      }
    }

    // ═══════════════════════════════════════════
    //  5. Behavioral Analysis
    // ═══════════════════════════════════════════
    if (b.pageDwellMs !== undefined && b.pageDwellMs < BOT_CONFIG.behavioral.minPageDwellMs) {
      flags.push('fast_dwell');
      reasons.push(`page_dwell_ms:${b.pageDwellMs}`);
      score += W.tooFastFormFill;
    }

    if (b.mouseEvents !== undefined && b.mouseEvents < BOT_CONFIG.behavioral.minMouseEvents) {
      flags.push('low_mouse_activity');
      reasons.push(`mouse_events:${b.mouseEvents}`);
      score += W.noMouseMovement;
    }

    if (b.mouseMaxSpeed !== undefined && b.mouseMaxSpeed > BOT_CONFIG.behavioral.maxMouseSpeed) {
      flags.push('superhuman_mouse');
      reasons.push(`mouse_max_speed:${b.mouseMaxSpeed}`);
      score += W.superhumanMouseSpeed;
    }

    if (b.mouseLinearity !== undefined && b.mouseLinearity > 0.98 && (b.mouseDistance || 0) > 500) {
      flags.push('linear_mouse');
      reasons.push(`mouse_linearity:${b.mouseLinearity}`);
      score += W.linearMouseMovement;
    }

    if (b.keystrokes !== undefined && b.keystrokes > 0 &&
        b.keystrokeVariance !== undefined && b.keystrokeVariance < 5) {
      flags.push('perfect_keystroke_timing');
      reasons.push(`keystroke_variance:${b.keystrokeVariance}`);
      score += W.perfectTiming;
    }

    if (b.formFillTimeMs !== undefined && b.formFillTimeMs < 2000 && b.keystrokes !== undefined && b.keystrokes > 5) {
      flags.push('too_fast_form');
      reasons.push(`form_fill_ms:${b.formFillTimeMs}`);
      score += W.tooFastFormFill;
    }

    // ═══════════════════════════════════════════
    //  6. Fingerprint Analysis
    // ═══════════════════════════════════════════
    const components = input.components;

    if (!components.canvas && !components.webgl) {
      flags.push('empty_fingerprint');
      score += W.emptyFingerprint;
    }

    // چک تکرار fingerprint
    const fpCheck = fingerprintService.isSharedFingerprint(input.visitorId, 5);
    if (fpCheck.shared) {
      flags.push('shared_fingerprint');
      reasons.push(`fingerprint_seen_from_${fpCheck.ipsCount}_ips`);
      score += W.duplicateFingerprint;
    }

    // آیا قبلاً bot تشخیص داده شده؟
    if (fingerprintService.isKnownBot(input.visitorId)) {
      flags.push('known_bot');
      score += W.knownBotFingerprint;
    }

    // ═══════════════════════════════════════════
    //  7. Compute Final
    // ═══════════════════════════════════════════
    score = Math.min(100, score);
    const riskLevel = this.scoreToLevel(score);
    const isBot = score >= BOT_CONFIG.riskThreshold;
    const isHeadless = flags.some(f =>
      ['webdriver_flag', 'phantom_detected', 'headless_ua', 'bot_ua'].includes(f)
    );

    // ذخیره fingerprint
    const fpHash = fingerprintService.computeHash(components);
    fingerprintService.upsert({
      visitorId: input.visitorId,
      components,
      ip: input.ip,
      userAgent: ua,
      userId: input.userId,
      riskScore: score,
      riskLevel,
      isBot,
      flags
    });

    // ذخیره behavioral session
    this.saveBehavioralSession({
      visitorId: input.visitorId,
      ip: input.ip,
      userId: input.userId,
      behavioral: b,
      riskScore: score,
      isBot,
      flags
    });

    // تعیین action
    let action: 'allow' | 'challenge' | 'block' = 'allow';
    if (isBot) {
      action = BOT_CONFIG.action === 'block' ? 'block'
             : BOT_CONFIG.action === 'challenge' ? 'challenge'
             : 'allow';
    }

    // لاگ رویداد
    this.logEvent({
      visitorId: input.visitorId,
      ip: input.ip,
      userAgent: ua,
      fingerprintHash: fpHash,
      eventType: isBot ? 'detected' : 'allowed',
      riskScore: score,
      riskLevel,
      flags,
      details: { reasons, behavioral: b }
    });

    return {
      visitorId: input.visitorId,
      fingerprintHash: fpHash,
      riskScore: score,
      riskLevel,
      isBot,
      isHeadless,
      flags,
      reasons,
      action,
      cached: false
    };
  }

  // ═══════════════════════════════════════════
  //  Helpers
  // ═══════════════════════════════════════════
  private scoreToLevel(score: number): 'low' | 'medium' | 'high' | 'critical' {
    if (score >= 80) return 'critical';
    if (score >= 60) return 'high';
    if (score >= 30) return 'medium';
    return 'low';
  }

  private saveBehavioralSession(params: {
    visitorId: string;
    ip: string;
    userId?: string;
    behavioral: BehavioralData;
    riskScore: number;
    isBot: boolean;
    flags: string[];
  }) {
    const b = params.behavioral;
    db.prepare(`
      INSERT INTO behavioral_sessions 
        (id, visitor_id, ip_address, user_id, page_dwell_ms, mouse_events, mouse_distance,
         mouse_avg_speed, mouse_max_speed, mouse_linearity, keystrokes, keystroke_variance,
         scroll_events, touch_events, focus_blur_count, copy_paste_count, tab_switches,
         form_fill_time_ms, time_to_first_interaction_ms, risk_score, is_bot, flags, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      crypto.randomUUID(),
      params.visitorId,
      params.ip,
      params.userId || null,
      b.pageDwellMs || null,
      b.mouseEvents || 0,
      b.mouseDistance || 0,
      b.mouseAvgSpeed || 0,
      b.mouseMaxSpeed || 0,
      b.mouseLinearity || null,
      b.keystrokes || 0,
      b.keystrokeVariance || null,
      b.scrollEvents || 0,
      b.touchEvents || 0,
      b.focusBlurCount || 0,
      b.copyPasteCount || 0,
      b.tabSwitches || 0,
      b.formFillTimeMs || null,
      b.timeToFirstInteractionMs || null,
      params.riskScore,
      params.isBot ? 1 : 0,
      JSON.stringify(params.flags),
      Date.now()
    );
  }

  private logEvent(params: {
    visitorId?: string;
    ip?: string;
    userAgent?: string;
    fingerprintHash?: string;
    path?: string;
    eventType: string;
    riskScore: number;
    riskLevel: string;
    flags: string[];
    details?: any;
  }) {
    db.prepare(`
      INSERT INTO bot_events 
        (id, visitor_id, ip_address, user_agent, fingerprint_hash, path, event_type,
         risk_score, risk_level, flags, details, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      crypto.randomUUID(),
      params.visitorId || null,
      params.ip || null,
      params.userAgent || null,
      params.fingerprintHash || null,
      params.path || null,
      params.eventType,
      params.riskScore,
      params.riskLevel,
      JSON.stringify(params.flags),
      params.details ? JSON.stringify(params.details) : null,
      Date.now()
    );
  }

  // ═══════════════════════════════════════════
  //  Challenge (PoW + CAPTCHA)
  // ═══════════════════════════════════════════

  /**
   * تولید یک challenge ساده Proof-of-Work برای اثبات انسانی‌بودن
   */
  createPowChallenge(visitorId: string) {
    const id = crypto.randomUUID();
    const challenge = crypto.randomBytes(16).toString('hex');
    const difficulty = 4; // 4 hex zeros
    const expiresAt = Date.now() + 5 * 60 * 1000;

    db.prepare(`
      INSERT INTO bot_challenges 
        (id, visitor_id, challenge_type, challenge_data, expires_at, created_at)
      VALUES (?, ?, 'pow', ?, ?, ?)
    `).run(
      id,
      visitorId,
      JSON.stringify({ challenge, difficulty }),
      expiresAt,
      Date.now()
    );

    return { id, challenge, difficulty, expiresAt };
  }

  /**
   * بررسی حل PoW
   * کلاینت باید nonce پیدا کنه که SHA256(challenge + nonce) با N صفر شروع بشه
   */
  verifyPow(visitorId: string, challengeId: string, nonce: string): boolean {
    const row = db.prepare(`
      SELECT * FROM bot_challenges 
      WHERE id = ? AND visitor_id = ? AND challenge_type = 'pow' AND solved_at IS NULL
    `).get(challengeId, visitorId) as any;

    if (!row) return false;
    if (row.expires_at < Date.now()) return false;

    const data = JSON.parse(row.challenge_data);
    const hash = crypto
      .createHash('sha256')
      .update(data.challenge + nonce)
      .digest('hex');

    const target = '0'.repeat(data.difficulty);
    if (!hash.startsWith(target)) {
      db.prepare('UPDATE bot_challenges SET attempts = attempts + 1 WHERE id = ?').run(challengeId);
      return false;
    }

    db.prepare('UPDATE bot_challenges SET solved_at = ? WHERE id = ?').run(Date.now(), challengeId);
    fingerprintService.markVerified(visitorId);

    this.logEvent({
      visitorId,
      eventType: 'verified',
      riskScore: 0,
      riskLevel: 'low',
      flags: ['pow_solved']
    });

    return true;
  }

  // ═══════════════════════════════════════════
  //  Stats & Admin
  // ═══════════════════════════════════════════
  getStats() {
    const fpStats = fingerprintService.getStats();

    const events = db.prepare(`
      SELECT event_type, COUNT(*) as count 
      FROM bot_events 
      WHERE created_at > ? 
      GROUP BY event_type
    `).all(Date.now() - 24 * 60 * 60 * 1000);

    const recentBotIps = db.prepare(`
      SELECT ip_address, COUNT(*) as hits, AVG(risk_score) as avg_risk
      FROM bot_events
      WHERE is_bot_marker = 1 OR event_type = 'detected'
      GROUP BY ip_address
      ORDER BY hits DESC LIMIT 20
    `).all().catch(() => []);

    const topFingerprints = db.prepare(`
      SELECT visitor_id, risk_score, risk_level, is_bot, seen_count, associated_ips
      FROM fingerprints
      WHERE is_bot = 1
      ORDER BY risk_score DESC LIMIT 20
    `).all();

    const recentEvents = db.prepare(`
      SELECT * FROM bot_events 
      WHERE event_type IN ('detected', 'blocked', 'challenged')
      ORDER BY created_at DESC LIMIT 50
    `).all();

    return {
      fingerprints: fpStats,
      events24h: events,
      recentEvents,
      topFingerprints,
      recentBotIps
    };
  }

  clearCache() { this.cache.clear(); }
}

export const botDetectionService = new BotDetectionService();
