/* ═══════════════════════════════════════════════
   APZ Wallet — PWA Bootstrap
   Handles: SW registration, install prompt, updates
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  // ─── Configuration ───
  const SW_URL = './sw.js';
  const SW_SCOPE = './';
  const INSTALL_DISMISSED_KEY = 'apz-pwa-install-dismissed';
  const INSTALL_DISMISS_DURATION = 7 * 24 * 60 * 60 * 1000; // 7 روز

  // ─── State ───
  let deferredPrompt = null;
  let registration = null;
  let isInstalled = false;

  // ─── Detect Standalone ───
  function isStandalone() {
    return (
      window.matchMedia('(display-mode: standalone)').matches ||
      window.matchMedia('(display-mode: minimal-ui)').matches ||
      window.matchMedia('(display-mode: window-controls-overlay)').matches ||
      window.navigator.standalone === true
    );
  }

  // ─── Detect iOS ───
  function isIOS() {
    return (
      /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream
    );
  }

  function isIOSSafari() {
    return isIOS() && /^((?!chrome|android|crios|fxios).)*safari/i.test(navigator.userAgent);
  }

  // ─── Should Show Install Banner ───
  function shouldShowInstallBanner() {
    if (isStandalone()) return false;

    const dismissed = localStorage.getItem(INSTALL_DISMISSED_KEY);
    if (dismissed && Date.now() - Number(dismissed) < INSTALL_DISMISS_DURATION) {
      return false;
    }
    return true;
  }

  // ─── Create Install Banner ───
  function createInstallBanner() {
    if (document.getElementById('pwa-install-banner')) return;

    const banner = document.createElement('div');
    banner.id = 'pwa-install-banner';
    banner.className = 'pwa-install-banner';
    banner.setAttribute('role', 'dialog');
    banner.setAttribute('aria-label', 'Install APZ Wallet');

    banner.innerHTML = `
      <img src="assets/icons/icon-192.png" alt="" class="pwa-install-icon" />
      <div class="pwa-install-text">
        <div class="pwa-install-title" data-pwa-i18n="title">Install APZ Wallet</div>
        <div class="pwa-install-sub" data-pwa-i18n="sub">Add to home screen for offline access</div>
      </div>
      <div class="pwa-install-actions">
        <button class="pwa-btn pwa-btn-dismiss" id="pwa-dismiss" data-pwa-i18n="later">Later</button>
        <button class="pwa-btn pwa-btn-install" id="pwa-install" data-pwa-i18n="install">Install</button>
      </div>
    `;

    document.body.appendChild(banner);

    // Apply i18n
    applyPwaI18n(banner);

    // Slide in
    requestAnimationFrame(() => {
      setTimeout(() => banner.classList.add('show'), 100);
    });

    // Handlers
    document.getElementById('pwa-dismiss').addEventListener('click', () => {
      localStorage.setItem(INSTALL_DISMISSED_KEY, String(Date.now()));
      banner.classList.remove('show');
      setTimeout(() => banner.remove(), 500);
    });

    document.getElementById('pwa-install').addEventListener('click', async () => {
      if (isIOSSafari()) {
        showIOSGuide();
        return;
      }
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        console.log('[PWA] Install outcome:', outcome);
        deferredPrompt = null;
        banner.classList.remove('show');
        setTimeout(() => banner.remove(), 500);
      } else {
        // fallback: راهنما نشان بده
        showIOSGuide();
      }
    });
  }

  // ─── iOS Install Guide ───
  function showIOSGuide() {
    let guide = document.getElementById('pwa-ios-guide');
    if (guide) {
      guide.classList.add('show');
      return;
    }

    guide = document.createElement('div');
    guide.id = 'pwa-ios-guide';
    guide.className = 'pwa-ios-guide';
    guide.innerHTML = `
      <div class="pwa-ios-guide-card">
        <h3 data-pwa-i18n="iosTitle">Install on iOS</h3>
        <p data-pwa-i18n="iosSub">Follow these steps to add APZ Wallet to your home screen:</p>
        <div class="pwa-ios-guide-steps">
          <div class="pwa-ios-guide-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8"/>
              <polyline points="16 6 12 2 8 6"/>
              <line x1="12" y1="2" x2="12" y2="15"/>
            </svg>
            <span data-pwa-i18n="iosStep1">Tap the Share button</span>
          </div>
          <div class="pwa-ios-guide-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <span data-pwa-i18n="iosStep2">Scroll and tap "Add to Home Screen"</span>
          </div>
          <div class="pwa-ios-guide-step">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span data-pwa-i18n="iosStep3">Tap "Add" to confirm</span>
          </div>
        </div>
        <button class="pwa-ios-guide-close" id="pwa-ios-close" data-pwa-i18n="gotIt">Got it</button>
      </div>
    `;
    document.body.appendChild(guide);

    applyPwaI18n(guide);

    requestAnimationFrame(() => guide.classList.add('show'));

    const close = () => {
      guide.classList.remove('show');
    };
    document.getElementById('pwa-ios-close').addEventListener('click', close);
    guide.addEventListener('click', (e) => {
      if (e.target === guide) close();
    });
  }

  // ─── Update Toast ───
  function showUpdateToast(newWorker) {
    let toast = document.getElementById('pwa-update-toast');
    if (toast) return;

    toast = document.createElement('div');
    toast.id = 'pwa-update-toast';
    toast.className = 'pwa-update-toast';
    toast.innerHTML = `
      <span data-pwa-i18n="updateAvailable">A new version is available!</span>
      <button id="pwa-update-btn" data-pwa-i18n="refresh">Refresh</button>
    `;
    document.body.appendChild(toast);
    applyPwaI18n(toast);

    requestAnimationFrame(() => toast.classList.add('show'));

    document.getElementById('pwa-update-btn').addEventListener('click', () => {
      newWorker.postMessage({ type: 'SKIP_WAITING' });
    });
  }

  // ─── Offline Banner ───
  function setupOfflineDetection() {
    const update = () => {
      let banner = document.getElementById('pwa-offline-banner');
      if (!navigator.onLine) {
        if (!banner) {
          banner = document.createElement('div');
          banner.id = 'pwa-offline-banner';
          banner.className = 'pwa-offline-banner';
          banner.innerHTML = `<span data-pwa-i18n="offline">You are offline — showing cached data</span>`;
          document.body.appendChild(banner);
          applyPwaI18n(banner);
        }
        requestAnimationFrame(() => banner.classList.add('show'));
      } else if (banner) {
        banner.classList.remove('show');
        setTimeout(() => banner.remove(), 400);
      }
    };

    window.addEventListener('online', update);
    window.addEventListener('offline', update);
    update();
  }

  // ─── i18n for PWA UI ───
  const PWA_I18N = {
    en: {
      title: 'Install APZ Wallet',
      sub: 'Add to home screen for offline access',
      install: 'Install',
      later: 'Later',
      iosTitle: 'Install on iOS',
      iosSub: 'Follow these steps to add APZ Wallet to your home screen:',
      iosStep1: 'Tap the Share button',
      iosStep2: 'Scroll and tap "Add to Home Screen"',
      iosStep3: 'Tap "Add" to confirm',
      gotIt: 'Got it',
      updateAvailable: 'A new version is available!',
      refresh: 'Refresh',
      offline: 'You are offline — showing cached data'
    },
    fa: {
      title: 'نصب APZ Wallet',
      sub: 'برای دسترسی آفلاین، به صفحه اصلی اضافه کنید',
      install: 'نصب',
      later: 'بعداً',
      iosTitle: 'نصب روی iOS',
      iosSub: 'برای افزودن APZ Wallet به صفحه اصلی، این مراحل را دنبال کنید:',
      iosStep1: 'روی دکمه اشتراک‌گذاری (Share) بزنید',
      iosStep2: 'پایین بروید و "Add to Home Screen" را بزنید',
      iosStep3: 'برای تأیید "Add" را بزنید',
      gotIt: 'متوجه شدم',
      updateAvailable: 'نسخه جدیدی در دسترس است!',
      refresh: 'به‌روزرسانی',
      offline: 'آفلاین هستید — داده‌های کش‌شده نمایش داده می‌شوند'
    },
    de: {
      title: 'APZ Wallet installieren',
      sub: 'Zum Startbildschirm hinzufügen für Offline-Zugriff',
      install: 'Installieren',
      later: 'Später',
      iosTitle: 'Auf iOS installieren',
      iosSub: 'Folgen Sie diesen Schritten, um APZ Wallet zum Startbildschirm hinzuzufügen:',
      iosStep1: 'Tippen Sie auf die Teilen-Schaltfläche',
      iosStep2: 'Scrollen Sie und tippen Sie auf "Zum Home-Bildschirm"',
      iosStep3: 'Tippen Sie auf "Hinzufügen" zum Bestätigen',
      gotIt: 'Verstanden',
      updateAvailable: 'Eine neue Version ist verfügbar!',
      refresh: 'Aktualisieren',
      offline: 'Sie sind offline — zwischengespeicherte Daten werden angezeigt'
    }
  };

  function applyPwaI18n(container) {
    const lang = localStorage.getItem('apz-dashboard-lang') || 'en';
    const t = PWA_I18N[lang] || PWA_I18N.en;
    container.querySelectorAll('[data-pwa-i18n]').forEach((el) => {
      const key = el.dataset.pwaI18n;
      if (t[key]) el.textContent = t[key];
    });
  }

  // ─── Register SW ───
  async function registerSW() {
    if (!('serviceWorker' in navigator)) {
      console.warn('[PWA] Service Worker not supported');
      return;
    }

    try {
      registration = await navigator.serviceWorker.register(SW_URL, {
        scope: SW_SCOPE,
        updateViaCache: 'none'
      });

      console.log('[PWA] Service Worker registered:', registration.scope);

      // ─── Update Detection ───
      registration.addEventListener('updatefound', () => {
        const newWorker = registration.installing;
        if (!newWorker) return;

        newWorker.addEventListener('statechange', () => {
          if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
            console.log('[PWA] New version available');
            showUpdateToast(newWorker);
          }
        });
      });

      // ─── Controller Change → Reload ───
      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (refreshing) return;
        refreshing = true;
        window.location.reload();
      });

      // ─── Check for updates periodically ───
      setInterval(() => registration.update(), 60 * 60 * 1000); // 1 ساعت

    } catch (err) {
      console.error('[PWA] Service Worker registration failed:', err);
    }
  }

  // ─── Install Prompt Capture ───
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    console.log('[PWA] Install prompt captured');

    if (shouldShowInstallBanner()) {
      setTimeout(createInstallBanner, 3000);
    }
  });

  // ─── App Installed ───
  window.addEventListener('appinstalled', () => {
    console.log('[PWA] App installed');
    isInstalled = true;
    localStorage.removeItem(INSTALL_DISMISSED_KEY);

    const banner = document.getElementById('pwa-install-banner');
    if (banner) {
      banner.classList.remove('show');
      setTimeout(() => banner.remove(), 400);
    }
  });

  // ─── Re-apply i18n on language switch ───
  window.addEventListener('apz-lang-change', () => {
    ['pwa-install-banner', 'pwa-ios-guide', 'pwa-update-toast', 'pwa-offline-banner'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) applyPwaI18n(el);
    });
  });

  // ─── Init ───
  function init() {
    if (isStandalone()) {
      console.log('[PWA] Running in standalone mode');
      isInstalled = true;
      document.documentElement.classList.add('pwa-standalone');
    }

    setupOfflineDetection();
    registerSW();

    // برای iOS: چون beforeinstallprompt نداریم، راهنما نشان بده
    if (isIOSSafari() && shouldShowInstallBanner()) {
      setTimeout(createInstallBanner, 4000);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // ─── Expose API ───
  window.APZ_PWA = {
    isInstalled: () => isInstalled,
    isStandalone,
    isIOS,
    promptInstall: () => {
      if (deferredPrompt) deferredPrompt.prompt();
      else showIOSGuide();
    },
    clearCache: () => {
      if (registration?.active) {
        registration.active.postMessage({ type: 'CLEAR_CACHE' });
      }
    }
  };
})();
