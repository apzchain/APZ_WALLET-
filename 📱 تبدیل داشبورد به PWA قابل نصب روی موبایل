8️⃣ 🖼️ اسکریپت تولید خودکار آیکون‌ها

scripts/generate-icons.sh

```bash
#!/usr/bin/env bash
# ═══════════════════════════════════════════════
# APZ Wallet — Generate PWA Icons
# نیاز: ImageMagick (convert)
#   • Ubuntu: sudo apt install imagemagick
#   • macOS:  brew install imagemagick
# ═══════════════════════════════════════════════

set -euo pipefail

SRC="docs/assets/icons/icon.svg"
OUT="docs/assets/icons"

if [ ! -f "$SRC" ]; then
  echo "❌ Source not found: $SRC"
  exit 1
fi

echo "🎨 Generating PWA icons from $SRC"

# ─── Standard PNG icons ───
for size in 72 96 128 144 152 192 384 512; do
  convert -background none -density 384 "$SRC" \
    -resize "${size}x${size}" \
    "$OUT/icon-${size}.png"
  echo "  ✓ icon-${size}.png"
done

# ─── Apple Touch Icon (180×180, بدون شفافیت) ───
convert -background "#05070a" -density 384 "$SRC" \
  -resize 180x180 -flatten \
  "$OUT/apple-touch-icon.png"
echo "  ✓ apple-touch-icon.png"

# ─── Maskable icons (با padding 10% و بک‌گراند توپر) ───
for size in 192 512; do
  inner=$((size * 80 / 100))
  convert -size "${size}x${size}" xc:"#05070a" \
    \( -background none -density 384 "$SRC" -resize "${inner}x${inner}" \) \
    -gravity center -composite \
    "$OUT/icon-maskable-${size}.png"
  echo "  ✓ icon-maskable-${size}.png"
done

# ─── Favicon ───
convert -background none -density 384 "$SRC" \
  -resize 32x32 \
  "docs/favicon.ico"
echo "  ✓ favicon.ico"

echo "✅ All icons generated successfully!"
```

