import React, { useEffect, useState } from 'react';
import { apiClient } from '../../api/client';

export const VpnDetectionPanel: React.FC = () => {
  const [stats, setStats] = useState<any>(null);
  const [config, setConfig] = useState<any>(null);
  const [lookupIp, setLookupIp] = useState('');
  const [lookupResult, setLookupResult] = useState<any>(null);
  const [bulkIps, setBulkIps] = useState('');
  const [bulkResults, setBulkResults] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);

  const load = async () => {
    const [s, c] = await Promise.all([
      apiClient.vpnStats(),
      apiClient.vpnConfig()
    ]);
    setStats(s);
    setConfig(c);
  };

  useEffect(() => { load(); }, []);

  const handleLookup = async () => {
    if (!lookupIp.trim()) return;
    setLoading(true);
    try {
      const res = await apiClient.vpnLookup(lookupIp.trim());
      setLookupResult(res);
    } finally { setLoading(false); }
  };

  const handleBulkCheck = async () => {
    const ips = bulkIps.split('\n').map(s => s.trim()).filter(Boolean);
    if (!ips.length) return;
    setLoading(true);
    try {
      const res = await apiClient.vpnBulkCheck(ips);
      setBulkResults(res);
    } finally { setLoading(false); }
  };

  const getRiskColor = (level: string) => {
    const colors: Record<string, string> = {
      low: '#10b981', medium: '#f59e0b', high: '#ef4444', critical: '#dc2626'
    };
    return colors[level] || '#6b7280';
  };

  return (
    <div className="admin-panel">
      <h2>🔍 تشخیص VPN / Proxy / Tor</h2>

      {stats && (
        <div className="stats-grid">
          <div className="stat-card">
            <span>وضعیت</span>
            <strong>{stats.enabled ? '✅ فعال' : '⛔ غیرفعال'}</strong>
          </div>
          <div className="stat-card">
            <span>اکشن</span>
            <strong>{stats.action}</strong>
          </div>
          <div className="stat-card">
            <span>Provider</span>
            <strong>{stats.primaryProvider}</strong>
          </div>
          <div className="stat-card">
            <span>Tor Nodes</span>
            <strong>{stats.torExitNodesCount?.toLocaleString() || 0}</strong>
          </div>
          <div className="stat-card">
            <span>Cache</span>
            <strong>{stats.cacheSize || 0}</strong>
          </div>
          <div className="stat-card">
            <span>آستانه</span>
            <strong>{stats.riskThreshold}</strong>
          </div>
        </div>
      )}

      {/* ───── Lookup تک IP ───── */}
      <div className="lookup-box">
        <input
          value={lookupIp}
          onChange={e => setLookupIp(e.target.value)}
          placeholder="مثلاً 45.83.91.1 (VPN شناخته‌شده)"
          dir="ltr"
        />
        <button onClick={handleLookup} disabled={loading}>
          {loading ? '…' : '🔍 بررسی'}
        </button>
      </div>

      {lookupResult && (
        <div className="vpn-result-card">
          <div className="vpn-result-header">
            <code dir="ltr">{lookupResult.ip}</code>
            <span
              className="risk-badge"
              style={{ background: getRiskColor(lookupResult.riskLevel) }}
            >
              {lookupResult.riskLevel} · {lookupResult.riskScore}/100
            </span>
          </div>
          <div className="vpn-flags">
            {[
              ['VPN', lookupResult.isVpn],
              ['Proxy', lookupResult.isProxy],
              ['Tor', lookupResult.isTor],
              ['Datacenter', lookupResult.isDatacenter],
              ['Hosting', lookupResult.isHosting],
              ['Residential Proxy', lookupResult.isResidentialProxy],
              ['Apple Relay', lookupResult.isAppleRelay],
              ['Blacklisted', lookupResult.isBlacklisted],
              ['Recent Abuse', lookupResult.recentAbuse]
            ].map(([label, val]) => (
              <span key={label as string} className={`flag ${val ? 'on' : 'off'}`}>
                {val ? '✅' : '⛔'} {label as string}
              </span>
            ))}
          </div>
          <div className="vpn-meta">
            <div><b>Provider:</b> {lookupResult.provider}</div>
            {lookupResult.providerName && <div><b>Network:</b> {lookupResult.providerName}</div>}
            <div><b>Reasons:</b> {lookupResult.reasons?.join(', ') || '—'}</div>
            {lookupResult.cached && <div className="cached-tag">📦 از کش</div>}
          </div>
        </div>
      )}

      {/* ───── Bulk Check ───── */}
      <h3>بررسی گروهی (هر خط یک IP)</h3>
      <div className="bulk-box">
        <textarea
          value={bulkIps}
          onChange={e => setBulkIps(e.target.value)}
          placeholder={'8.8.8.8\n1.1.1.1\n45.83.91.1'}
          dir="ltr"
          rows={5}
        />
        <button className="btn-primary" onClick={handleBulkCheck} disabled={loading}>
          بررسی همه
        </button>
      </div>

      {bulkResults.length > 0 && (
        <table className="admin-table compact">
          <thead>
            <tr>
              <th>IP</th>
              <th>Risk</th>
              <th>VPN</th>
              <th>Tor</th>
              <th>Proxy</th>
            </tr>
          </thead>
          <tbody>
            {bulkResults.map(r => (
              <tr key={r.ip}>
                <td><code dir="ltr">{r.ip}</code></td>
                <td>
                  <span style={{ color: getRiskColor(r.riskLevel) }}>
                    {r.riskScore}/100 ({r.riskLevel})
                  </span>
                </td>
                <td>{r.isVpn ? '✅' : '—'}</td>
                <td>{r.isTor ? '✅' : '—'}</td>
                <td>{r.isProxy ? '✅' : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {/* ───── Config ───── */}
      {config && (
        <>
          <h3>وزن‌های Risk Score</h3>
          <div className="risk-weights">
            {Object.entries(config.riskWeights || {}).map(([k, v]) => (
              <div key={k} className="weight-item">
                <span>{k}</span>
                <strong>+{v as number}</strong>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
};
