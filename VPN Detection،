import { Request, Response, NextFunction } from 'express';
import { vpnDetectionService, VpnDetectionResult } from '../services/vpnDetection.service.js';
import { VPN_CONFIG } from '../config/vpn.config.js';
import { securityService } from '../services/security.service.js';

declare global {
  namespace Express {
    interface Request {
      vpnDetection?: VpnDetectionResult;
    }
  }
}

export async function vpnDetectionGuard(req: Request, res: Response, next: NextFunction) {
  if (!VPN_CONFIG.enabled) return next();

  const ip = req.ip || req.socket.remoteAddress || 'unknown';

  // کشور معاف؟
  const geoCountry = (req as any).geo?.country;
  if (geoCountry && VPN_CONFIG.exemptCountries.includes(geoCountry.toUpperCase())) {
    return next();
  }

  try {
    const result = await vpnDetectionService.check(ip, {
      timezone: (req as any).geo?.timezone,
      userAgent: req.headers['user-agent']
    });

    req.vpnDetection = result;

    // زیر آستانه → اجازه
    if (result.riskScore < VPN_CONFIG.riskThreshold) {
      return next();
    }

    // ثبت در لاگ suspicious
    securityService.logSuspicious({
      userId: (req as any).user?.sub,
      ipAddress: ip,
      userAgent: req.headers['user-agent'],
      activityType: 'vpn_detected',
      severity: result.riskLevel === 'critical' ? 'high' : 'medium',
      details: {
        riskScore: result.riskScore,
        riskLevel: result.riskLevel,
        reasons: result.reasons,
        provider: result.provider,
        isVpn: result.isVpn,
        isTor: result.isTor,
        isProxy: result.isProxy
      }
    });

    // ───── Action ─────
    switch (VPN_CONFIG.action) {
      case 'monitor':
        return next(); // فقط لاگ کن

      case 'challenge':
        return res.status(403).json({
          success: false,
          error: 'Additional verification required',
          code: 'VPN_CHALLENGE',
          riskScore: result.riskScore,
          riskLevel: result.riskLevel
        });

      case 'block':
        return res.status(403).json({
          success: false,
          error: 'Access denied: VPN or proxy detected',
          code: 'VPN_BLOCKED',
          riskScore: result.riskScore,
          riskLevel: result.riskLevel
        });
    }

    next();
  } catch (err) {
    console.error('[VPN] Detection error:', err);
    next(); // fail-open
  }
}

/**
 * نسخه سبک — فقط attach می‌کنه بدون بلاک
 */
export async function attachVpnProfile(req: Request, _res: Response, next: NextFunction) {
  if (!VPN_CONFIG.enabled) return next();
  const ip = req.ip || 'unknown';
  try {
    req.vpnDetection = await vpnDetectionService.check(ip);
  } catch {}
  next();
}
