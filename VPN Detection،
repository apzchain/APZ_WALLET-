🔗 اتصال به Brute-force Protection

در server/services/auth.service.ts، بعد از چک رمز موفق، این رو اضافه کن:

```typescript
import { vpnDetectionService } from './vpnDetection.service.js';
import { VPN_CONFIG } from '../config/vpn.config.js';

// داخل login، قبل از issueTokens:
if (VPN_CONFIG.enabled && ipAddress) {
  const vpnResult = await vpnDetectionService.check(ipAddress);
  
  if (vpnResult.riskScore >= VPN_CONFIG.riskThreshold) {
    securityService.logSuspicious({
      userId: user.id,
      ipAddress,
      userAgent,
      activityType: 'login_from_vpn',
      severity: vpnResult.riskLevel === 'critical' ? 'high' : 'medium',
      details: {
        riskScore: vpnResult.riskScore,
        reasons: vpnResult.reasons,
        provider: vpnResult.provider
      }
    });

    // اگر action=block، ورود رو رد کن
    if (VPN_CONFIG.action === 'block') {
      throw Object.assign(
        new Error('Login from VPN is not allowed'),
        { status: 403, code: 'VPN_LOGIN_BLOCKED' }
      );
    }
  }
}
