```typescript
import crypto from 'crypto';
import fs from 'fs';
import { IP2Proxy } from 'ip2proxy-nodejs';
import { VPN_CONFIG, VpnProvider } from '../config/vpn.config.js';

// ═══════════════════════════════════════════
//  Types
// ═══════════════════════════════════════════
export interface VpnDetectionResult {
  ip: string;
  isVpn: boolean;
  isProxy: boolean;
  isTor: boolean;
  isHosting: boolean;
  isDatacenter: boolean;
  isResidentialProxy: boolean;
  isAppleRelay: boolean;
  isBlacklisted: boolean;
  recentAbuse: boolean;
  provider: string;
  providerName?: string;
  riskScore: number;              // 0-100
  riskLevel: 'low' | 'medium' | 'high' | 'critical';
  reasons: string[];
  raw?: any;
  cached: boolean;
}

interface CacheEntry {
  result: VpnDetectionResult;
  expiresAt: number;
}

// ═══════════════════════════════════════════
//  Cache (LRU + TTL)
// ═══════════════════════════════════════════
class VpnCache {
  private store = new Map<string, CacheEntry>();

  get(ip: string): VpnDetectionResult | null {
    const entry = this.store.get(ip);
    if (!entry) return null;
    if (entry.expiresAt < Date.now()) {
      this.store.delete(ip);
      return null;
    }
    // LRU: دوباره اضافه کن
    this.store.delete(ip);
    this.store.set(ip, entry);
    return entry.result;
  }

  set(ip: string, result: VpnDetectionResult) {
    if (this.store.size >= VPN_CONFIG.cache.maxSize) {
      // حذف قدیمی‌ترین
      const firstKey = this.store.keys().next().value;
      if (firstKey) this.store.delete(firstKey);
    }
    this.store.set(ip, {
      result,
      expiresAt: Date.now() + VPN_CONFIG.cache.ttlMs
    });
  }

  clear() { this.store.clear(); }
  size() { return this.store.size; }
}

// ═══════════════════════════════════════════
//  Main Service
// ═══════════════════════════════════════════
export class VpnDetectionService {
  private cache = new VpnCache();
  private ip2proxyReader: IP2Proxy | null = null;
  private torExitNodes: Set<string> = new Set();
  private torNodesLastSync = 0;

  // ───── Init ─────
  async init() {
    // IP2Proxy
    if (VPN_CONFIG.providers.primary === 'ip2proxy' || VPN_CONFIG.providers.fallback === 'ip2proxy') {
      try {
        if (fs.existsSync(VPN_CONFIG.ip2proxy.dbPath)) {
          this.ip2proxyReader = new IP2Proxy();
          this.ip2proxyReader.open(VPN_CONFIG.ip2proxy.dbPath, IP2Proxy.IOModes.IP2PROXY_MEMORY_MAPPED);
          console.log('✅ IP2Proxy DB loaded');
        } else {
          console.warn('⚠️  IP2Proxy DB not found at', VPN_CONFIG.ip2proxy.dbPath);
        }
      } catch (err) {
        console.error('❌ IP2Proxy load failed:', err);
      }
    }

    // Tor exit nodes
    await this.syncTorExitNodes();
    // هر ۶ ساعت به‌روز کن
    setInterval(() => this.syncTorExitNodes(), 6 * 60 * 60 * 1000);
  }

  // ───── Main Check ─────
  async check(ip: string, opts: { timezone?: string; userAgent?: string } = {}): Promise<VpnDetectionResult> {
    const normalized = this.normalizeIp(ip);

    // Private IPs → بی‌خطر
    if (this.isPrivate(normalized)) {
      return this.makeResult(normalized, {
        isVpn: false, isProxy: false, isTor: false,
        isHosting: false, isDatacenter: false, isResidentialProxy: false,
        isAppleRelay: false, isBlacklisted: false, recentAbuse: false,
        provider: 'system', providerName: 'private_ip',
        reasons: ['private_ip']
      }, false);
    }

    // Cache
    const cached = this.cache.get(normalized);
    if (cached) return { ...cached, cached: true };

    // Try primary provider
    let result: VpnDetectionResult | null = null;
    try {
      result = await this.checkWithProvider(normalized, VPN_CONFIG.providers.primary, opts);
    } catch (err) {
      console.error(`[VPN] Primary provider (${VPN_CONFIG.providers.primary}) failed:`, err);
    }

    // Fallback
    if (!result && VPN_CONFIG.providers.fallback) {
      try {
        result = await this.checkWithProvider(normalized, VPN_CONFIG.providers.fallback as VpnProvider, opts);
      } catch (err) {
        console.error(`[VPN] Fallback provider failed:`, err);
      }
    }

    // همه شکست خوردن → fail-open
    if (!result) {
      result = this.makeResult(normalized, {
        isVpn: false, isProxy: false, isTor: false,
        isHosting: false, isDatacenter: false, isResidentialProxy: false,
        isAppleRelay: false, isBlacklisted: false, recentAbuse: false,
        provider: 'none', providerName: 'all_providers_failed',
        reasons: ['provider_error_fail_open']
      }, false);
    }

    // Augment: Tor check (independent)
    if (!result.isTor && this.torExitNodes.has(normalized)) {
      result.isTor = true;
      result.reasons.push('tor_exit_node');
      result.riskScore = Math.min(100, result.riskScore + VPN_CONFIG.riskWeights.isTor);
    }

    // Recompute risk level
    result.riskLevel = this.scoreToLevel(result.riskScore);

    this.cache.set(normalized, result);
    return result;
  }

  // ───── Provider Dispatcher ─────
  private async checkWithProvider(
    ip: string,
    provider: VpnProvider,
    opts: { timezone?: string }
  ): Promise<VpnDetectionResult> {
    switch (provider) {
      case 'ip2proxy':
        return this.checkIP2Proxy(ip);
      case 'ipqualityscore':
        return this.checkIPQualityScore(ip);
      case 'vpnapi':
        return this.checkVpnApi(ip);
      default:
        throw new Error(`Unknown provider: ${provider}`);
    }
  }

  // ═══════════════════════════════════════════
  //  Provider: IP2Proxy (آفلاین، رایگان)
  // ═══════════════════════════════════════════
  private checkIP2Proxy(ip: string): VpnDetectionResult {
    if (!this.ip2proxyReader) {
      throw new Error('IP2Proxy DB not loaded');
    }

    const r = this.ip2proxyReader.getAll(ip);
    if (!r) throw new Error('IP2Proxy lookup failed');

    const isVpn = r.isProxy === 'VPN' || r.proxyType === 'VPN';
    const isTor = r.isProxy === 'TOR' || r.proxyType === 'TOR';
    const isProxy = r.isProxy === 'PUB' || r.isProxy === 'WEB' || r.isProxy === 'SES' ||
                   r.proxyType?.includes('Proxy') || (r.isProxy && !isVpn && !isTor);
    const isDatacenter = r.usageType === 'DCH' || r.isProxy === 'DCH';
    const isHosting = r.usageType === 'DCH' || r.provider?.toLowerCase().includes('hosting');

    return this.makeResult(ip, {
      isVpn: !!isVpn,
      isProxy: !!isProxy,
      isTor: !!isTor,
      isHosting: !!isHosting,
      isDatacenter: !!isDatacenter,
      isResidentialProxy: false,
      isAppleRelay: false,
      isBlacklisted: false,
      recentAbuse: false,
      provider: 'ip2proxy',
      providerName: r.proxyType || r.usageType || 'unknown',
      reasons: [
        isVpn && 'vpn_detected',
        isTor && 'tor_exit_node',
        isProxy && 'proxy_detected',
        isDatacenter && 'datacenter_range'
      ].filter(Boolean) as string[]
    }, false);
  }

  // ═══════════════════════════════════════════
  //  Provider: IPQualityScore (API، دقیق)
  // ═══════════════════════════════════════════
  private async checkIPQualityScore(ip: string): Promise<VpnDetectionResult> {
    const { apiKey, strictness, baseUrl } = VPN_CONFIG.ipqs;
    if (!apiKey) throw new Error('IPQS_API_KEY not set');

    const url = `${baseUrl}/${apiKey}/${ip}?strictness=${strictness}`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`IPQS HTTP ${res.status}`);

    const data = await res.json();
    if (data.success === false && data.message?.includes('quota')) {
      throw new Error('IPQS quota exceeded');
    }

    const reasons: string[] = [];
    if (data.proxy) reasons.push('proxy_detected');
    if (data.vpn) reasons.push('vpn_detected');
    if (data.tor) reasons.push('tor_exit_node');
    if (data.active_vpn) reasons.push('active_vpn');
    if (data.active_tor) reasons.push('active_tor');
    if (data.recent_abuse) reasons.push('recent_abuse');
    if (data.is_crawler) reasons.push('crawler');
    if (data.is_bot) reasons.push('bot_traffic');
    if (data.is_datacenter) reasons.push('datacenter_range');
    if (data.hosting) reasons.push('hosting_provider');

    return this.makeResult(ip, {
      isVpn: !!data.vpn || !!data.active_vpn,
      isProxy: !!data.proxy,
      isTor: !!data.tor || !!data.active_tor,
      isHosting: !!data.hosting,
      isDatacenter: !!data.is_datacenter,
      isResidentialProxy: !!data.residential_proxy,
      isAppleRelay: false,
      isBlacklisted: !!data.is_blacklisted,
      recentAbuse: !!data.recent_abuse,
      provider: 'ipqualityscore',
      providerName: data.ISP || data.organization || 'unknown',
      reasons,
      raw: data
    }, false);
  }

  // ═══════════════════════════════════════════
  //  Provider: VPNAPI.io (free tier 1000/day)
  // ═══════════════════════════════════════════
  private async checkVpnApi(ip: string): Promise<VpnDetectionResult> {
    const { apiKey, baseUrl } = VPN_CONFIG.vpnapi;
    if (!apiKey) throw new Error('VPNAPI_KEY not set');

    const res = await fetch(`${baseUrl}/${ip}?key=${apiKey}`);
    if (!res.ok) throw new Error(`VPNAPI HTTP ${res.status}`);

    const data = await res.json();
    const sec = data.security || {};

    const reasons: string[] = [];
    if (sec.vpn) reasons.push('vpn_detected');
    if (sec.proxy) reasons.push('proxy_detected');
    if (sec.tor) reasons.push('tor_exit_node');
    if (sec.relay) reasons.push('apple_private_relay');

    return this.makeResult(ip, {
      isVpn: !!sec.vpn,
      isProxy: !!sec.proxy,
      isTor: !!sec.tor,
      isHosting: false,
      isDatacenter: false,
      isResidentialProxy: false,
      isAppleRelay: !!sec.relay,
      isBlacklisted: false,
      recentAbuse: false,
      provider: 'vpnapi',
      providerName: data.network?.autonomous_system_organization || 'unknown',
      reasons,
      raw: data
    }, false);
  }

  // ═══════════════════════════════════════════
  //  Result Builder + Risk Score
  // ═══════════════════════════════════════════
  private makeResult(
    ip: string,
    data: Omit<VpnDetectionResult, 'ip' | 'riskScore' | 'riskLevel' | 'cached'>,
    cached: boolean
  ): VpnDetectionResult {
    let score = 0;
    const W = VPN_CONFIG.riskWeights;

    if (data.isVpn) score += W.isVpn;
    if (data.isProxy) score += W.isProxy;
    if (data.isTor) score += W.isTor;
    if (data.isHosting) score += W.isHosting;
    if (data.isDatacenter) score += W.isDatacenter;
    if (data.isResidentialProxy) score += W.residentialProxy;
    if (data.isBlacklisted) score += W.isBlacklisted;
    if (data.recentAbuse) score += W.recentAbuse;

    // Apple Relay رو نادیده بگیر (کاربران مشروع اپل)
    if (VPN_CONFIG.ignore.appleRelay && data.isAppleRelay) {
      score = Math.max(0, score - W.isVpn - W.isProxy);
      data.reasons.push('apple_relay_exempted');
    }

    score = Math.min(100, score);

    return {
      ip,
      ...data,
      riskScore: score,
      riskLevel: this.scoreToLevel(score),
      cached
    };
  }

  private scoreToLevel(score: number): 'low' | 'medium' | 'high' | 'critical' {
    if (score >= 80) return 'critical';
    if (score >= 60) return 'high';
    if (score >= 30) return 'medium';
    return 'low';
  }

  // ═══════════════════════════════════════════
  //  Tor Exit Node Sync
  // ═══════════════════════════════════════════
  private async syncTorExitNodes() {
    try {
      const res = await fetch(VPN_CONFIG.torExitNodesUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const text = await res.text();
      this.torExitNodes = new Set(
        text.split('\n').map(l => l.trim()).filter(l => l && !l.startsWith('#'))
      );
      this.torNodesLastSync = Date.now();
      console.log(`✅ Synced ${this.torExitNodes.size} Tor exit nodes`);
    } catch (err) {
      console.error('[Tor] Sync failed:', err);
    }
  }

  // ═══════════════════════════════════════════
  //  Helpers
  // ═══════════════════════════════════════════
  private normalizeIp(ip: string): string {
    if (ip.startsWith('::ffff:')) return ip.slice(7);
    return ip;
  }

  private isPrivate(ip: string): boolean {
    if (ip === '127.0.0.1' || ip === '::1' || ip === 'localhost') return true;
    if (ip.startsWith('10.')) return true;
    if (ip.startsWith('192.168.')) return true;
    if (/^172\.(1[6-9]|2\d|3[01])\./.test(ip)) return true;
    return false;
  }

  // ───── Stats ─────
  getStats() {
    return {
      enabled: VPN_CONFIG.enabled,
      action: VPN_CONFIG.action,
      primaryProvider: VPN_CONFIG.providers.primary,
      fallbackProvider: VPN_CONFIG.providers.fallback || null,
      ip2proxyLoaded: !!this.ip2proxyReader,
      torExitNodesCount: this.torExitNodes.size,
      torLastSync: this.torNodesLastSync,
      cacheSize: this.cache.size(),
      riskThreshold: VPN_CONFIG.riskThreshold
    };
  }

  clearCache() { this.cache.clear(); }
}

export const vpnDetectionService = new VpnDetectionService();
