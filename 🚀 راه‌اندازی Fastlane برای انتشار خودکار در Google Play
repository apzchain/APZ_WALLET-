3️⃣ android/fastlane/Fastfile

```ruby
# ─────────────────────────────────────────────
# Fastfile — APZ Wallet
# Multi-Language Fastlane Configuration (FA / EN / DE)
# ─────────────────────────────────────────────

default_platform(:android)

# زبان‌های پشتیبانی‌شده
SUPPORTED_LOCALES = ["en-US", "fa-IR", "de-DE"].freeze

platform :android do

  # ═══════════════════════════════════════════
  # Lane: Build AAB (Release)
  # ═══════════════════════════════════════════
  desc "Build Release AAB"
  lane :build_aab do |options|
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => options[:store_file] || ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => options[:store_password] || ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => options[:key_alias] || ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => options[:key_password] || ENV["ANDROID_KEY_PASSWORD"]
      }
    )
  end

  # ═══════════════════════════════════════════
  # Lane: Deploy to Internal Testing
  # ═══════════════════════════════════════════
  desc "Deploy AAB to Internal Testing track"
  lane :deploy_internal do
    build_aab

    upload_to_play_store(
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false
    )
  end

  # ═══════════════════════════════════════════
  # Lane: Deploy to Closed Testing (Alpha)
  # ═══════════════════════════════════════════
  desc "Deploy AAB to Alpha (Closed Testing) track"
  lane :deploy_alpha do
    build_aab

    upload_to_play_store(
      track: "alpha",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false
    )
  end

  # ═══════════════════════════════════════════
  # Lane: Deploy to Open Testing (Beta)
  # ═══════════════════════════════════════════
  desc "Deploy AAB to Beta (Open Testing) track"
  lane :deploy_beta do
    build_aab

    upload_to_play_store(
      track: "beta",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false
    )
  end

  # ═══════════════════════════════════════════
  # Lane: Promote Internal → Beta → Production
  # ═══════════════════════════════════════════
  desc "Promote from Internal to Beta"
  lane :promote_internal_to_beta do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "beta",
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote from Beta to Production"
  lane :promote_beta_to_production do |options|
    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  # ═══════════════════════════════════════════
  # Lane: Full Release (Internal → Beta → Production)
  # ═══════════════════════════════════════════
  desc "Full Release Pipeline: Internal → Beta → Production"
  lane :release do |options|
    target_track = options[:track] || "internal"

    UI.message("🚀 Starting APZ Wallet release to #{target_track}...")

    case target_track
    when "internal"
      deploy_internal
    when "alpha"
      deploy_alpha
    when "beta"
      deploy_beta
    when "production"
      deploy_internal
      promote_internal_to_beta
      promote_beta_to_production
    else
      UI.user_error!("❌ Unknown track: #{target_track}")
    end

    UI.success("✅ APZ Wallet successfully deployed to #{target_track}!")
  end

  # ═══════════════════════════════════════════
  # Lane: Validate Metadata (بدون آپلود)
  # ═══════════════════════════════════════════
  desc "Validate all metadata and changelogs without uploading"
  lane :validate_metadata do
    upload_to_play_store(
      track: "internal",
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: true
    )
    UI.success("✅ Metadata validation passed for #{SUPPORTED_LOCALES.join(', ')}")
  end

  # ═══════════════════════════════════════════
  # Lane: Fetch Metadata from Play Store
  # ═══════════════════════════════════════════
  desc "Download current metadata from Google Play"
  lane :pull_metadata do
    supply(
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-credentials.json"
    )
    UI.success("✅ Metadata downloaded to fastlane/metadata/android/")
  end
end
```

