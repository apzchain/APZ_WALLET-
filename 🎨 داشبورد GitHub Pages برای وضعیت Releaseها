/* ═══════════════════════════════════════════════
   APZ Wallet — UI Helpers & Renderers
   ═══════════════════════════════════════════════ */

(function () {
  const cfg = window.APZ_CONFIG;

  // ─── Helpers ───
  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatBytes(bytes) {
    if (!bytes) return '—';
    const units = ['B', 'KB', 'MB', 'GB'];
    let i = 0;
    while (bytes >= 1024 && i < units.length - 1) { bytes /= 1024; i++; }
    return `${bytes.toFixed(1)} ${units[i]}`;
  }

  function formatNumber(n) {
    if (n == null) return '—';
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
    return String(n);
  }

  function timeAgo(dateStr, t) {
    if (!dateStr) return '—';
    const seconds = Math.floor((Date.now() - new Date(dateStr).getTime()) / 1000);
    if (seconds < 30) return t.time.justNow;
    if (seconds < 3600) return `${Math.floor(seconds / 60)} ${t.time.minutesAgo}`;
    if (seconds < 86400) return `${Math.floor(seconds / 3600)} ${t.time.hoursAgo}`;
    if (seconds < 2592000) return `${Math.floor(seconds / 86400)} ${t.time.daysAgo}`;
    if (seconds < 31536000) return `${Math.floor(seconds / 2592000)} ${t.time.monthsAgo}`;
    return `${Math.floor(seconds / 31536000)} ${t.time.yearsAgo}`;
  }

  function parseVersionFromTag(tag) {
    const clean = String(tag || '').replace(/^(android-)?v/, '');
    return clean || tag;
  }

  function getTrackStatus(track, releases) {
    // تلاش برای استخراج track از tag یا metadata
    // این منطق باید با workflow هماهنگ باشد
    const trackReleases = releases.filter(r => {
      const tag = r.tag_name.toLowerCase();
      if (track === 'internal') return tag.includes('internal') || tag === 'nightly';
      if (track === 'alpha') return tag.includes('alpha');
      if (track === 'beta') return tag.includes('beta') || r.prerelease;
      if (track === 'production') return !r.prerelease && !tag.includes('beta') && !tag.includes('alpha');
      return false;
    });

    return trackReleases[0] || null;
  }

  // ─── Renderers ───
  function renderStats(data, t) {
    const { releases, ciStatus } = data;

    // Latest
    const latest = releases[0];
    document.getElementById('stat-latest').textContent = latest
      ? parseVersionFromTag(latest.tag_name)
      : '—';
    document.getElementById('stat-latest-date').textContent = latest
      ? timeAgo(latest.published_at, t)
      : '—';

    // Production
    const prod = releases.find(r => !r.prerelease && !r.tag_name.includes('beta'));
    document.getElementById('stat-production').textContent = prod
      ? parseVersionFromTag(prod.tag_name)
      : '—';
    document.getElementById('stat-production-rollout').textContent = prod
      ? `${t.tracks.rollout}: 100%`
      : '—';

    // Downloads
    const total = releases.reduce((sum, r) => {
      return sum + (r.assets || []).reduce((s, a) => s + (a.download_count || 0), 0);
    }, 0);
    document.getElementById('stat-downloads').textContent = formatNumber(total);

    // CI
    const ciDot = document.getElementById('ci-dot');
    ciDot.className = 'status-dot';
    if (ciStatus) {
      document.getElementById('stat-ci').textContent = ciStatus.conclusion || ciStatus.status || '—';
      document.getElementById('stat-ci-meta').textContent = ciStatus.head_branch
        ? `${ciStatus.head_branch} · ${timeAgo(ciStatus.updated_at, t)}`
        : '—';
      if (ciStatus.conclusion === 'success') ciDot.classList.add('success');
      else if (ciStatus.conclusion === 'failure') ciDot.classList.add('failure');
      else if (ciStatus.status === 'in_progress') ciDot.classList.add('running');
    } else {
      document.getElementById('stat-ci').textContent = '—';
      document.getElementById('stat-ci-meta').textContent = '—';
    }
  }

  function renderTracks(releases, t) {
    const grid = document.getElementById('track-grid');
    grid.innerHTML = '';

    cfg.tracks.forEach(track => {
      const release = getTrackStatus(track, releases);
      const card = document.createElement('div');
      card.className = 'track-card';
      card.dataset.track = track;

      const version = release ? parseVersionFromTag(release.tag_name) : '—';
      const isLive = !!release;
      const badgeClass = isLive ? 'live' : 'empty';
      const badgeText = isLive ? t.tracks.live : t.tracks.empty;
      const rollout = isLive ? 100 : 0;

      card.innerHTML = `
        <div class="track-name">${escapeHtml(t.tracks[track])}</div>
        <div class="track-version">${escapeHtml(version)}</div>
        <div class="track-code">${t.tracks.versionCode}: ${escapeHtml(release?.id || '—')}</div>
        <div class="track-progress">
          <div class="track-progress-bar" style="width: ${rollout}%"></div>
        </div>
        <div class="track-meta">
          <span class="track-badge ${badgeClass}">${badgeText}</span>
          <span>${rollout}%</span>
        </div>
      `;

      grid.appendChild(card);
    });
  }

  function renderReleases(releases, t) {
    const list = document.getElementById('releases-list');
    const countEl = document.getElementById('release-count');
    const emptyEl = document.getElementById('empty-state');

    countEl.textContent = `${releases.length}`;

    if (!releases.length) {
      list.innerHTML = '';
      emptyEl.hidden = false;
      return;
    }

    emptyEl.hidden = true;
    list.innerHTML = '';

    releases.forEach((release, idx) => {
      const card = document.createElement('div');
      card.className = 'release-card';

      const apkAsset = (release.assets || []).find(a => a.name.endsWith('.apk'));
      const aabAsset = (release.assets || []).find(a => a.name.endsWith('.aab'));
      const downloadUrl = apkAsset?.browser_download_url || release.html_url;

      const badgeText = parseVersionFromTag(release.tag_name).slice(0, 8);

      card.innerHTML = `
        <div class="release-badge">${escapeHtml(badgeText)}</div>
        <div class="release-info">
          <div class="release-title">
            <span class="release-version">${escapeHtml(release.name || release.tag_name)}</span>
            <span class="release-tag">${escapeHtml(release.tag_name)}</span>
            ${release.prerelease ? `<span class="release-pre">${t.history.preRelease}</span>` : ''}
          </div>
          <div class="release-meta">
            <span class="release-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              ${timeAgo(release.published_at, t)}
            </span>
            ${apkAsset ? `
              <span class="release-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                ${escapeHtml(apkAsset.name)} · ${formatBytes(apkAsset.size)}
              </span>
            ` : ''}
            <span class="release-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
              ${formatNumber((release.assets || []).reduce((s, a) => s + (a.download_count || 0), 0))} ${t.stats.downloadsSub.toLowerCase().split(' ')[0] || 'downloads'}
            </span>
          </div>
        </div>
        <div class="release-actions">
          ${apkAsset ? `<a class="btn btn-primary" href="${downloadUrl}" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            APK
          </a>` : ''}
          <a class="btn btn-ghost" href="${release.html_url}" target="_blank" rel="noopener">
            ${t.history.notes}
          </a>
        </div>
      `;

      list.appendChild(card);
    });
  }

  function renderAll(data, t) {
    renderStats(data, t);
    renderTracks(data.releases, t);
    renderReleases(data.releases, t);
  }

  function showToast(msg, type = 'success') {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.className = `toast ${type} show`;
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  // ─── Particle Background ───
  function initParticles() {
    if (!cfg.particles.enabled) return;
    const canvas = document.getElementById('particles');
    const ctx = canvas.getContext('2d');
    let particles = [];
    let w, h;

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    for (let i = 0; i < cfg.particles.count; i++) {
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * cfg.particles.speed,
        vy: (Math.random() - 0.5) * cfg.particles.speed,
        r: Math.random() * 1.8 + 0.4
      });
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = `rgba(${cfg.particles.color}, 0.6)`;
      particles.forEach((p, i) => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();

        // connections
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x, dy = p.y - q.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 120) {
            ctx.strokeStyle = `rgba(${cfg.particles.color}, ${0.08 * (1 - d / 120)})`;
            ctx.lineWidth = 0.5;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.stroke();
          }
        }
      });
      requestAnimationFrame(draw);
    }
    draw();
  }

  // ─── Public ───
  window.APZ_UI = {
    renderAll,
    showToast,
    initParticles,
    parseVersionFromTag,
    timeAgo
  };
})();
