/* ═══════════════════════════════════════════════
   APZ Wallet — GitHub API Wrapper
   ═══════════════════════════════════════════════ */

(function () {
  const cfg = window.APZ_CONFIG;

  // ─── Cache ───
  const cache = new Map();
  const CACHE_TTL = 60_000; // 1 دقیقه

  function getCacheKey(path) {
    return path;
  }

  function isCacheValid(entry) {
    return entry && Date.now() - entry.time < CACHE_TTL;
  }

  // ─── Fetch Wrapper ───
  async function ghFetch(path) {
    const key = getCacheKey(path);
    const cached = cache.get(key);
    if (isCacheValid(cached)) return cached.data;

    const url = cfg.api.base + path;
    const headers = { Accept: 'application/vnd.github+json' };

    // توکن اختیاری از localStorage (برای نرخ بالاتر)
    const token = localStorage.getItem('apz-gh-token');
    if (token) headers.Authorization = `Bearer ${token}`;

    const res = await fetch(url, { headers });

    if (res.status === 403) {
      const rateLimit = res.headers.get('X-RateLimit-Remaining');
      if (rateLimit === '0') throw new Error('RATE_LIMIT');
    }
    if (!res.ok) throw new Error(`GitHub API error: ${res.status}`);

    const data = await res.json();
    cache.set(key, { data, time: Date.now() });
    return data;
  }

  // ─── Public API ───
  window.APZ_API = {
    async getReleases() {
      return ghFetch(cfg.api.releases
        .replace('{owner}', cfg.repo.owner)
        .replace('{repo}', cfg.repo.name) + '?per_page=30');
    },

    async getWorkflowRuns() {
      return ghFetch(`/repos/${cfg.repo.owner}/${cfg.repo.name}/actions/runs?per_page=30`);
    },

    async getWorkflowStatus(fileName) {
      const path = `/repos/${cfg.repo.owner}/${cfg.repo.name}/actions/workflows/${fileName}/runs?per_page=1`;
      const data = await ghFetch(path);
      return data.workflow_runs?.[0] || null;
    },

    clearCache() {
      cache.clear();
    }
  };
})();
