/* ═══════════════════════════════════════════════
   APZ Wallet — Release Dashboard Styles
   Neon theme • RTL support • Responsive
   ═══════════════════════════════════════════════ */

:root {
  --bg: #05070a;
  --bg-2: #0a0e14;
  --bg-3: #0f141c;
  --surface: rgba(15, 20, 28, 0.7);
  --surface-2: rgba(20, 28, 38, 0.85);
  --border: rgba(0, 255, 204, 0.12);
  --border-hover: rgba(0, 255, 204, 0.35);

  --neon: #00ffcc;
  --neon-2: #00b8ff;
  --neon-3: #a855f7;
  --danger: #ff3860;
  --warn: #ffc107;
  --success: #00ff88;

  --text: #e6f1ff;
  --text-dim: #8892b0;
  --text-dimmer: #4a5568;

  --radius: 16px;
  --radius-sm: 10px;
  --shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  --shadow-neon: 0 0 24px rgba(0, 255, 204, 0.15);

  --font: 'Inter', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  --font-fa: 'Vazirmatn', 'Inter', sans-serif;

  --transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  line-height: 1.6;
}

[dir="rtl"] body { font-family: var(--font-fa); }
[dir="rtl"] code, [dir="rtl"] .mono { font-family: var(--font-mono); direction: ltr; display: inline-block; }

a { color: var(--neon); text-decoration: none; transition: var(--transition); }
a:hover { color: var(--neon-2); text-shadow: 0 0 8px rgba(0, 255, 204, 0.5); }

/* ═══════════ Background ═══════════ */
#particles {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.5;
}

.bg-gradient {
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(ellipse at 20% 0%, rgba(0, 255, 204, 0.08), transparent 50%),
    radial-gradient(ellipse at 80% 100%, rgba(168, 85, 247, 0.08), transparent 50%),
    linear-gradient(180deg, var(--bg), var(--bg-2));
}

/* ═══════════ Header ═══════════ */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(5, 7, 10, 0.75);
  border-bottom: 1px solid var(--border);
}

.header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand { display: flex; align-items: center; gap: 14px; }

.brand-icon {
  width: 44px;
  height: 44px;
  filter: drop-shadow(0 0 12px rgba(0, 255, 204, 0.6));
}

.brand-text h1 {
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, var(--neon), var(--neon-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.brand-sub {
  font-size: 0.75rem;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.lang-switch {
  display: flex;
  gap: 4px;
  padding: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 999px;
}

.lang-btn {
  background: transparent;
  border: none;
  color: var(--text-dim);
  font-family: inherit;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 6px 14px;
  border-radius: 999px;
  cursor: pointer;
  transition: var(--transition);
}

.lang-btn:hover { color: var(--text); }

.lang-btn.active {
  background: linear-gradient(135deg, var(--neon), var(--neon-2));
  color: var(--bg);
  box-shadow: 0 0 16px rgba(0, 255, 204, 0.4);
}

/* ═══════════ Hero / Stats ═══════════ */
.hero {
  max-width: 1280px;
  margin: 40px auto 0;
  padding: 0 24px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}

.stat-card {
  position: relative;
  padding: 20px 22px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  backdrop-filter: blur(12px);
  transition: var(--transition);
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--neon), transparent);
  opacity: 0.6;
}

.stat-card:hover {
  border-color: var(--border-hover);
  box-shadow: var(--shadow-neon);
  transform: translateY(-2px);
}

.stat-label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-dim);
  margin-bottom: 8px;
  font-weight: 600;
}

.stat-value {
  font-size: 1.75rem;
  font-weight: 800;
  font-family: var(--font-mono);
  color: var(--text);
  letter-spacing: -0.02em;
  display: flex;
  align-items: center;
  gap: 10px;
}

.stat-meta {
  font-size: 0.78rem;
  color: var(--text-dimmer);
  margin-top: 6px;
}

.status-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--text-dimmer);
  flex-shrink: 0;
}

.status-dot.success { background: var(--success); box-shadow: 0 0 12px var(--success); animation: pulse 2s infinite; }
.status-dot.failure { background: var(--danger); box-shadow: 0 0 12px var(--danger); }
.status-dot.running { background: var(--warn); box-shadow: 0 0 12px var(--warn); animation: pulse 1.5s infinite; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ═══════════ Sections ═══════════ */
.section {
  max-width: 1280px;
  margin: 56px auto 0;
  padding: 0 24px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-header h2 {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.release-count {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--text-dim);
  padding: 4px 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 999px;
}

.refresh-btn {
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text-dim);
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
}

.refresh-btn:hover { color: var(--neon); border-color: var(--border-hover); }
.refresh-btn.loading svg { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ═══════════ Track Cards ═══════════ */
.track-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

.track-card {
  position: relative;
  padding: 22px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: var(--transition);
  overflow: hidden;
}

.track-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px;
  height: 100%;
  background: var(--track-color, var(--neon));
  box-shadow: 0 0 16px var(--track-color, var(--neon));
}

.track-card:hover {
  border-color: var(--border-hover);
  box-shadow: var(--shadow-neon);
  transform: translateY(-2px);
}

.track-card[data-track="internal"] { --track-color: #8892b0; }
.track-card[data-track="alpha"] { --track-color: #ffc107; }
.track-card[data-track="beta"] { --track-color: #00b8ff; }
.track-card[data-track="production"] { --track-color: #00ffcc; }

.track-name {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-dim);
  font-weight: 700;
  margin-bottom: 6px;
}

.track-version {
  font-size: 1.5rem;
  font-weight: 800;
  font-family: var(--font-mono);
  color: var(--text);
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}

.track-code {
  font-size: 0.75rem;
  color: var(--text-dimmer);
  font-family: var(--font-mono);
  margin-bottom: 14px;
}

.track-progress {
  height: 6px;
  background: var(--bg-3);
  border-radius: 999px;
  overflow: hidden;
  margin-top: 12px;
}

.track-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--track-color), var(--neon-2));
  border-radius: 999px;
  transition: width 800ms cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 0 12px var(--track-color);
}

.track-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10px;
  font-size: 0.75rem;
  color: var(--text-dimmer);
}

.track-badge {
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.track-badge.live {
  background: rgba(0, 255, 136, 0.1);
  color: var(--success);
  border: 1px solid rgba(0, 255, 136, 0.3);
}

.track-badge.pending {
  background: rgba(255, 193, 7, 0.1);
  color: var(--warn);
  border: 1px solid rgba(255, 193, 7, 0.3);
}

.track-badge.empty {
  background: rgba(136, 146, 176, 0.1);
  color: var(--text-dim);
  border: 1px solid rgba(136, 146, 176, 0.2);
}

/* ═══════════ Releases List ═══════════ */
.releases-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.release-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 20px;
  align-items: center;
  padding: 20px 22px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: var(--transition);
}

.release-card:hover {
  border-color: var(--border-hover);
  background: var(--surface-2);
  box-shadow: var(--shadow-neon);
}

.release-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, rgba(0, 255, 204, 0.15), rgba(0, 184, 255, 0.15));
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-weight: 800;
  font-size: 0.85rem;
  color: var(--neon);
  flex-shrink: 0;
}

.release-info { min-width: 0; }

.release-title {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 6px;
}

.release-version {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text);
}

.release-tag {
  padding: 2px 8px;
  border-radius: 6px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  background: rgba(0, 255, 204, 0.08);
  color: var(--neon);
  border: 1px solid rgba(0, 255, 204, 0.2);
}

.release-pre {
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 0.68rem;
  background: rgba(255, 193, 7, 0.1);
  color: var(--warn);
  border: 1px solid rgba(255, 193, 7, 0.3);
  text-transform: uppercase;
  font-weight: 700;
}

.release-meta {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 0.78rem;
  color: var(--text-dim);
}

.release-meta-item { display: flex; align-items: center; gap: 6px; }
.release-meta-item svg { opacity: 0.7; }

.release-actions {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  border: 1px solid transparent;
  text-decoration: none;
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, var(--neon), var(--neon-2));
  color: var(--bg);
  box-shadow: 0 4px 16px rgba(0, 255, 204, 0.25);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(0, 255, 204, 0.4);
  color: var(--bg);
  text-shadow: none;
}

.btn-ghost {
  background: transparent;
  border-color: var(--border);
  color: var(--text-dim);
}

.btn-ghost:hover {
  color: var(--neon);
  border-color: var(--border-hover);
}

/* ═══════════ Empty State ═══════════ */
.empty-state {
  padding: 60px 20px;
  text-align: center;
  color: var(--text-dimmer);
  font-size: 0.9rem;
}

/* ═══════════ Skeleton Loading ═══════════ */
.skeleton {
  background: linear-gradient(90deg, var(--surface) 25%, var(--bg-3) 50%, var(--surface) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ═══════════ Footer ═══════════ */
.footer {
  max-width: 1280px;
  margin: 80px auto 40px;
  padding: 32px 24px 0;
  border-top: 1px solid var(--border);
  text-align: center;
  color: var(--text-dim);
  font-size: 0.85rem;
}

.footer p { margin: 8px 0; }
.footer .heart { display: inline-block; animation: beat 1.2s infinite; }
@keyframes beat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.2); } }

.footer-links { display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap; }
.footer-links a { color: var(--text-dim); }
.footer-links a:hover { color: var(--neon); }

/* ═══════════ Toast ═══════════ */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: var(--surface-2);
  border: 1px solid var(--border-hover);
  border-radius: var(--radius-sm);
  padding: 12px 20px;
  font-size: 0.85rem;
  color: var(--text);
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
  opacity: 0;
  transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 1000;
  pointer-events: none;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.toast.error { border-color: rgba(255, 56, 96, 0.5); color: #ffb3c1; }
.toast.success { border-color: rgba(0, 255, 136, 0.5); color: #a0ffd0; }

/* ═══════════ Responsive ═══════════ */
@media (max-width: 720px) {
