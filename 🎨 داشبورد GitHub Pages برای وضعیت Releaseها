/* ═══════════════════════════════════════════════
   APZ Wallet — Main Application
   ═══════════════════════════════════════════════ */

(function () {
  const cfg = window.APZ_CONFIG;
  const I18N = window.APZ_I18N;
  const API = window.APZ_API;
  const UI = window.APZ_UI;

  let currentLang = localStorage.getItem(cfg.storageKey) || cfg.defaultLang;
  let isRefreshing = false;
  let lastManualRefresh = 0;

  // ─── Language ───
  function applyLang(lang) {
    if (!I18N[lang]) lang = cfg.defaultLang;
    currentLang = lang;
    localStorage.setItem(cfg.storageKey, lang);

    const t = I18N[lang];
    const html = document.getElementById('html-root');
    html.lang = lang;
    html.dir = t.dir;

    // Update static i18n elements
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n;
      const val = key.split('.').reduce((o, k) => o?.[k], t);
      if (val) el.textContent = val;
    });

    // Update active button
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });
  }

  function setupLangSwitch() {
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        applyLang(btn.dataset.lang);
        load(true);
      });
    });
  }

  // ─── Data Loading ───
  async function load(silent = false) {
    if (isRefreshing) return;
    isRefreshing = true;

    const t = I18N[currentLang];
    const refreshBtn = document.getElementById('refresh-btn');
    refreshBtn?.classList.add('loading');

    try {
      const [releases, ciStatus] = await Promise.all([
        API.getReleases().catch(() => []),
        API.getWorkflowStatus(cfg.workflows.ci).catch(() => null)
      ]);

      // فیلتر کردن nightly/tags
      const cleanReleases = (releases || []).filter(r => !r.draft);

      UI.renderAll({ releases: cleanReleases, ciStatus }, t);

      if (!silent) UI.showToast(t.toast.refreshed, 'success');
    } catch (err) {
      console.error('[APZ Dashboard]', err);
      const msg = err.message === 'RATE_LIMIT' ? t.toast.rateLimit : t.toast.error;
      UI.showToast(msg, 'error');
    } finally {
      isRefreshing = false;
      refreshBtn?.classList.remove('loading');
    }
  }

  // ─── Refresh Button ───
  function setupRefresh() {
    const btn = document.getElementById('refresh-btn');
    btn?.addEventListener('click', () => {
      const now = Date.now();
      if (now - lastManualRefresh < cfg.refresh.manualCooldown) {
        return; // جلوگیری از spam
      }
      lastManualRefresh = now;
      API.clearCache();
      load(false);
    });
  }

  // ─── Init ───
  function init() {
    applyLang(currentLang);
    setupLangSwitch();
    setupRefresh();
    UI.initParticles();
    load(true);

    // Auto refresh
    setInterval(() => load(true), cfg.refresh.autoInterval);

    // Refresh on visibility change
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) load(true);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
