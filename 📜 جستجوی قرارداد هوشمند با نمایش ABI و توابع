این تغییرات را در docs/assets/js/explorer.js اعمال کنید:

```javascript
// ─── در بالای فایل ───
const ABI = window.APZ_ABI;
const CONTRACT_UI = window.APZ_CONTRACT_UI;
const CONTRACT = window.APZ_CONTRACT;

// ─── جایگزین بخش address در performSearch ───
async function performSearch(query) {
  const section = document.getElementById('result-section');
  const loading = document.getElementById('result-loading');
  const error = document.getElementById('result-error');
  const content = document.getElementById('result-content');

  section.hidden = false;
  loading.hidden = false;
  error.hidden = true;
  content.hidden = true;

  const type = detectType(query);

  try {
    let html = '';

    if (type === 'tx') {
      const { tx, receipt } = await RPC.getTransactionWithReceipt(query);
      if (!tx) throw new Error('TX_NOT_FOUND');
      html = renderTransaction(tx, receipt);
    } else if (type === 'address') {
      // ✨ تشخیص contract vs EOA
      const info = await RPC.getAddressInfo(query);

      if (info.isContract) {
        // دریافت ABI
        const chainId = RPC.hexToNumber(await RPC.getChainId());
        const abiInfo = await ABI.fetchABI(chainId, query);
        const bytecode = await RPC.getCode(query);

        // انتخاب selectorها
        if (abiInfo.abi) {
          await CONTRACT.attachSelectors(abiInfo.abi);
        }

        html = CONTRACT_UI.renderContract(query, abiInfo, bytecode, showToast);
      } else {
        html = renderAddress(info);
      }
    } else if (type === 'block') {
      const block = await RPC.getBlockByNumber(query, false);
      if (!block) throw new Error('BLOCK_NOT_FOUND');
      html = renderBlock(block);
    } else {
      throw new Error('UNKNOWN_TYPE');
    }

    content.innerHTML = html;
    bindCopyButtons(content);

    // ✨ Bind contract interactions
    if (type === 'address' && content.querySelector('.contract-header')) {
      bindContractInteractions(content, query);
    }

    loading.hidden = true;
    content.hidden = false;
  } catch (err) {
    // ... error handling
  }
}

// ─── Bind Contract Interactions ───
function bindContractInteractions(container, address) {
  // Copy bytecode
  document.getElementById('copy-bytecode-btn')?.addEventListener('click', () => {
    const bytecode = document.getElementById('bytecode-full')?.textContent || '';
    copyToClipboard(bytecode);
  });

  // Toggle bytecode
  document.getElementById('toggle-bytecode-btn')?.addEventListener('click', () => {
    const full = document.getElementById('bytecode-full');
    if (full) {
      full.hidden = !full.hidden;
      document.getElementById('toggle-bytecode-btn').textContent =
        full.hidden ? '👁 View Full' : '👁 Hide';
    }
  });

  // Call buttons
  container.querySelectorAll('.fn-call-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const fnIndex = parseInt(btn.dataset.callIndex, 10);
      const fnCard = btn.closest('.fn-card');
      const resultBox = document.getElementById(`fn-result-${fnIndex}`);

      // جمع‌آوری مقادیر ورودی
      const inputs = fnCard.querySelectorAll('.fn-input-field');
      const values = Array.from(inputs).map((inp) => inp.value);

      // اعتبارسنجی
      if (values.some((v) => v === '')) {
        showToast('لطفاً همه پارامترها را پر کنید', 'error');
        return;
      }

      // پیدا کردن تابع از ABI
      const fn = window.__currentABI?.[fnIndex];
      if (!fn) {
        showToast('تابع یافت نشد', 'error');
        return;
      }

      btn.disabled = true;
      const originalText = btn.innerHTML;
      btn.innerHTML = `<span class="spinner-inline"></span> در حال فراخوانی...`;

      try {
        const result = await CONTRACT.callReadFunction(address, fn, values);

        resultBox.hidden = false;
        resultBox.className = 'fn-result';
        resultBox.querySelector('.fn-result-label').textContent = 'Result';
        resultBox.querySelector('.fn-result-value').textContent =
          typeof result === 'object' ? JSON.stringify(result, null, 2) : String(result);
      } catch (err) {
        console.error('[Contract] Call failed:', err);
        resultBox.hidden = false;
        resultBox.className = 'fn-result error';
        resultBox.querySelector('.fn-result-label').textContent = 'Error';
        resultBox.querySelector('.fn-result-value').textContent =
          err.message || 'Call reverted';
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  });
}

// ─── ذخیره ABI فعلی برای دسترسی در bindContractInteractions ───
// در performSearch، بعد از دریافت abiInfo:
if (abiInfo.abi) {
  window.__currentABI = abiInfo.abi.filter((x) => x.type === 'function');
}
