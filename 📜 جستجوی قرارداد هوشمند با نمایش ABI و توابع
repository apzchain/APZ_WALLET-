  };

  function t(key) {
    const dict = CONTRACT_I18N[currentLang] || CONTRACT_I18N.en;
    if (key.includes('.')) {
      return key.split('.').reduce((o, k) => o?.[k], dict) || key;
    }
    return dict[key] || key;
  }

  // ─── Helpers ───
  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function shortHash(h, n = 8) {
    if (!h) return '—';
    if (h.length <= n * 2 + 2) return h;
    return `${h.slice(0, n + 2)}...${h.slice(-n)}`;
  }

  function copyToClipboard(text, toastFn) {
    navigator.clipboard.writeText(text).then(() => {
      if (toastFn) toastFn('Copied to clipboard');
    });
  }

  function formatType(input) {
    let type = input.type;
    if (type === 'tuple' && input.components) {
      type = `(${input.components.map(formatType).join(',')})`;
    }
    if (type.endsWith('[]')) {
      type = type.replace('[]', '[]');
    }
    return type;
  }

  function formatSignature(fn) {
    const inputs = (fn.inputs || []).map((i) => formatType(i)).join(',');
    return `${fn.name}(${inputs})`;
  }

  function getStateMutabilityBadge(fn) {
    const mut = fn.stateMutability || (fn.constant ? 'view' : 'nonpayable');
    const label = t(`stateMutability.${mut}`);
    const cls = (mut === 'view' || mut === 'pure') ? 'view' : 'write';
    return `<span class="mutability-badge ${cls}">${label}</span>`;
  }

  // ─── Contract Header ───
  function renderContractHeader(address, abiInfo, bytecode) {
    const isVerified = abiInfo?.verified;
    const isDecompiled = abiInfo?.source?.includes('heimdall');
    const hasABI = abiInfo?.abi && abiInfo.abi.length > 0;

    let statusBadge = '';
    if (hasABI && isVerified) {
      statusBadge = `<span class="badge success">✓ ${t('verified')}</span>`;
    } else if (isDecompiled) {
      statusBadge = `<span class="badge pending">⚙ ${t('decompiled')}</span>`;
    } else if (!hasABI) {
      statusBadge = `<span class="badge failed">${t('unverified')}</span>`;
    }

    return `
      <div class="result-card contract-header">
        <div class="result-card-header">
          <div class="result-card-icon contract">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <div style="flex:1;min-width:0">
            <div class="result-card-title">${t('contractTitle')} ${statusBadge}</div>
            <div class="result-card-subtitle">${shortHash(address, 10)}</div>
          </div>
        </div>

        <div class="field-grid">
          <div class="field-item" style="grid-column:1/-1">
            <div class="field-label">Address</div>
            <div class="address-display">
              <span>${escapeHtml(address)}</span>
              <button class="copy-btn" data-copy="${escapeHtml(address)}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                </svg>
              </button>
            </div>
          </div>

          ${abiInfo?.source ? `
            <div class="field-item">
              <div class="field-label">${t('source')}</div>
              <div class="field-value dim">${escapeHtml(abiInfo.source)}</div>
            </div>
          ` : ''}

          ${abiInfo?.compiler ? `
            <div class="field-item">
              <div class="field-label">${t('compiler')}</div>
              <div class="field-value dim">${escapeHtml(abiInfo.compiler)}</div>
            </div>
          ` : ''}

          ${abiInfo?.contractName ? `
            <div class="field-item">
              <div class="field-label">Name</div>
              <div class="field-value">${escapeHtml(abiInfo.contractName)}</div>
            </div>
          ` : ''}

          ${bytecode && bytecode !== '0x' ? `
            <div class="field-item" style="grid-column:1/-1">
              <div class="field-label">${t('bytecode')}</div>
              <div class="bytecode-preview" id="bytecode-preview">
                <code>${escapeHtml(bytecode.slice(0, 130))}...</code>
                <span class="bytecode-size">${(bytecode.length / 2 - 1).toLocaleString()} bytes</span>
              </div>
              <div class="share-actions-inline" style="margin-top:10px">
                <button class="btn btn-ghost small" id="copy-bytecode-btn">
                  📋 ${t('copyBytecode')}
                </button>
                <button class="btn btn-ghost small" id="toggle-bytecode-btn">
                  👁 View Full
                </button>
              </div>
              <pre class="bytecode-full" id="bytecode-full" hidden>${escapeHtml(bytecode)}</pre>
            </div>
          ` : ''}

          ${!hasABI ? `
            <div class="field-item" style="grid-column:1/-1">
              <div class="abi-missing-notice">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div>
                  <strong>${t('noABI')}</strong>
                  <p>${t('noABINote')}</p>
                </div>
              </div>
            </div>
          ` : ''}
        </div>
      </div>
    `;
  }

  // ─── Function Card ───
  function renderFunctionCard(fn, index, address) {
    const isRead = fn.stateMutability === 'view' || fn.stateMutability === 'pure' || fn.constant;
    const sig = formatSignature(fn);
    const inputs = fn.inputs || [];
    const outputs = fn.outputs || [];

    const inputHtml = inputs.length === 0
      ? `<div class="fn-no-params">${t('noParams')}</div>`
      : inputs.map((inp, i) => `
        <div class="fn-input-row">
          <div class="fn-input-meta">
            <span class="fn-input-name">${escapeHtml(inp.name || `param${i}`)}</span>
            <span class="fn-input-type">${escapeHtml(formatType(inp))}</span>
          </div>
          <input
            type="text"
            class="fn-input-field"
            data-fn-index="${index}"
            data-input-index="${i}"
            data-param-type="${escapeHtml(formatType(inp))}"
            placeholder="${t('enterValue')} (${escapeHtml(formatType(inp))})"
          />
        </div>
      `).join('');

    const outputHtml = outputs.length
      ? outputs.map((o, i) => `
        <span class="fn-output-type">${escapeHtml(formatType(o))}${o.name ? ` ${escapeHtml(o.name)}` : ''}</span>
      `).join(', ')
      : '—';

    return `
      <details class="fn-card" data-fn-index="${index}">
        <summary class="fn-summary">
          <div class="fn-summary-left">
            <span class="fn-name">${escapeHtml(fn.name)}</span>
            <span class="fn-sig">${escapeHtml(sig)}</span>
          </div>
          <div class="fn-summary-right">
            ${getStateMutabilityBadge(fn)}
            <svg class="fn-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </div>
        </summary>
        <div class="fn-body">
          <div class="fn-section">
            <div class="fn-section-label">${t('inputs')}</div>
            <div class="fn-inputs">${inputHtml}</div>
          </div>

          <div class="fn-section">
            <div class="fn-section-label">${t('output')}</div>
            <div class="fn-outputs">${outputHtml}</div>
          </div>

          ${isRead ? `
            <div class="fn-actions">
              <button class="fn-call-btn" data-call-index="${index}" data-address="${escapeHtml(address)}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 11 12 14 22 4"/>
                  <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                </svg>
                ${t('query')}
              </button>
            </div>
            <div class="fn-result" id="fn-result-${index}" hidden>
              <div class="fn-result-label">${t('result')}</div>
              <pre class="fn-result-value"></pre>
            </div>
          ` : `
            <div class="fn-write-notice">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
              </svg>
              <span>تابع نوشتنی — نیاز به امضای تراکنش دارد</span>
            </div>
          `}
        </div>
      </details>
    `;
  }

  // ─── Events ───
  function renderEvents(events) {
    if (!events || events.length === 0) {
      return `<div class="fn-no-params">${t('noEvents')}</div>`;
    }

    return events.map((ev) => {
      const sig = `${ev.name}(${(ev.inputs || []).map(formatType).join(',')})`;
      return `
        <div class="event-card">
          <div class="event-name">${escapeHtml(ev.name)}</div>
          <div class="event-sig">${escapeHtml(sig)}</div>
          ${ev.anonymous ? '<span class="event-anon">anonymous</span>' : ''}
        </div>
      `;
    }).join('');
  }

  // ─── Main Render ───
  function renderContract(address, abiInfo, bytecode, toastFn) {
    const abi = abiInfo?.abi || [];
    const functions = abi.filter((x) => x.type === 'function');
    const events = abi.filter((x) => x.type === 'event');
    const readFns = functions.filter((f) => f.stateMutability === 'view' || f.stateMutability === 'pure' || f.constant);
    const writeFns = functions.filter((f) => !(f.stateMutability === 'view' || f.stateMutability === 'pure' || f.constant));

    let html = renderContractHeader(address, abiInfo, bytecode);

    if (abi.length > 0) {
      html += `
        <div class="contract-stats">
          <div class="contract-stat">
            <span class="contract-stat-num">${functions.length}</span>
            <span class="contract-stat-label">${t('functionCount')}</span>
          </div>
          <div class="contract-stat">
            <span class="contract-stat-num">${events.length}</span>
            <span class="contract-stat-label">${t('eventCount')}</span>
          </div>
        </div>
      `;

      // Read functions
      if (readFns.length > 0) {
        html += `
          <div class="result-card">
            <div class="card-section-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              ${t('readFunctions')} (${readFns.length})
            </div>
            <div class="fn-list">
              ${readFns.map((fn) => renderFunctionCard(fn, functions.indexOf(fn), address)).join('')}
            </div>
          </div>
        `;
