```javascript
/* ═══════════════════════════════════════════════
   APZ Wallet — ABI Fetcher
   Sources (به ترتیب اولویت):
     1. Sourcify (بدون API key)
     2. Etherscan-compatible API (اختیاری)
     3. 4byte.directory (فقط function selectors)
     4. heimdall-api (decompile bytecode)
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  const RPC = window.APZ_RPC;

  // ─── Configuration ───
  const CONFIG = {
    // Sourcify — بدون API key
    sourcify: {
      enabled: true,
      baseUrl: 'https://repo.sourcify.dev/contracts',
      // ساختار: {baseUrl}/{match_type}/{chainId}/{address}/metadata.json
      matchTypes: ['full_match', 'partial_match']
    },

    // Etherscan-compatible API (اختیاری)
    etherscan: {
      enabled: false,
      apiKey: null, // از localStorage خوانده می‌شود
      baseUrl: 'https://api.etherscan.io/v2/api'
    },

    // 4byte.directory — بدون API key
    fourByte: {
      enabled: true,
      baseUrl: 'https://www.4byte.directory/api/v1'
    },

    // heimdall-api (decompile) — نیاز به سرور جداگانه
    heimdall: {
      enabled: false,
      baseUrl: 'https://heimdall-api.example.com' // خودتان مستقر کنید
    },

    // Cache TTL
    cacheTTL: 24 * 60 * 60 * 1000 // 24 ساعت
  };

  // ─── Cache ───
  const abiCache = new Map();

  function getCacheKey(chainId, address) {
    return `${chainId}:${address.toLowerCase()}`;
  }

  function getCached(chainId, address) {
    const key = getCacheKey(chainId, address);
    const entry = abiCache.get(key);
    if (entry && Date.now() - entry.time < CONFIG.cacheTTL) {
      return entry.data;
    }
    return null;
  }

  function setCache(chainId, address, data) {
    const key = getCacheKey(chainId, address);
    abiCache.set(key, { data, time: Date.now() });
  }

  // ─── Source: Sourcify ───
  async function fetchFromSourcify(chainId, address) {
    if (!CONFIG.sourcify.enabled) return null;

    for (const matchType of CONFIG.sourcify.matchTypes) {
      try {
        const url = `${CONFIG.sourcify.baseUrl}/${matchType}/${chainId}/${address}/metadata.json`;
        const res = await fetch(url);
        if (!res.ok) continue;

        const metadata = await res.json();
        if (metadata?.output?.abi) {
          console.log(`[ABI] Sourcify (${matchType}): found ABI`);
          return {
            abi: metadata.output.abi,
            source: `Sourcify (${matchType})`,
            verified: true,
            compiler: metadata.compiler?.version || null,
            contractName: metadata.settings?.compilationTarget?.[address] || null
          };
        }
      } catch (err) {
        console.warn(`[ABI] Sourcify ${matchType} failed:`, err.message);
      }
    }
    return null;
  }

  // ─── Source: Etherscan-compatible ───
  async function fetchFromEtherscan(chainId, address) {
    if (!CONFIG.etherscan.enabled) return null;

    const apiKey = CONFIG.etherscan.apiKey ||
      localStorage.getItem('apz-etherscan-key');
    if (!apiKey) return null;

    try {
      const url = `${CONFIG.etherscan.baseUrl}?module=contract&action=getabi&address=${address}&apikey=${apiKey}`;
      const res = await fetch(url);
      if (!res.ok) return null;

      const json = await res.json();
      if (json.status === '1' && json.result) {
        const abi = typeof json.result === 'string'
          ? JSON.parse(json.result)
          : json.result;

        console.log('[ABI] Etherscan: found ABI');
        return {
          abi,
          source: 'Etherscan',
          verified: true
        };
      }
    } catch (err) {
      console.warn('[ABI] Etherscan failed:', err.message);
    }
    return null;
  }

  // ─── Source: heimdall (decompile) ───
  async function fetchFromHeimdall(chainId, address, rpcUrl) {
    if (!CONFIG.heimdall.enabled) return null;

    try {
      const url = `${CONFIG.heimdall.baseUrl}/decompile?address=${address}&rpc=${encodeURIComponent(rpcUrl)}`;
      const res = await fetch(url, { signal: AbortSignal.timeout(60_000) });
      if (!res.ok) return null;

      const json = await res.json();
      if (json.abi) {
        console.log('[ABI] heimdall: decompiled ABI');
        return {
          abi: json.abi,
          source: 'heimdall (decompiled)',
          verified: false,
          note: 'ABI بازسازی شده از bytecode — ممکن است ناقص باشد'
        };
      }
    } catch (err) {
      console.warn('[ABI] heimdall failed:', err.message);
    }
    return null;
  }

  // ─── Source: 4byte — فقط selectors ───
  async function fetchSelectorsFrom4Byte(abi) {
    // اگر ABI موجود است، نیازی نیست
    if (abi && abi.length > 0) return null;

    // استخراج selectors از bytecode (به سادگی)
    // در عمل باید bytecode را تحلیل کرد
    return null; // placeholder
  }

  // ─── Main Fetch ───
  async function fetchABI(chainId, address) {
    // 1. Cache
    const cached = getCached(chainId, address);
    if (cached) {
      console.log('[ABI] From cache');
      return cached;
    }

    // 2. Sourcify
    let result = await fetchFromSourcify(chainId, address);
    if (result) {
      setCache(chainId, address, result);
      return result;
    }

    // 3. Etherscan
    result = await fetchFromEtherscan(chainId, address);
    if (result) {
      setCache(chainId, address, result);
      return result;
    }

    // 4. heimdall (decompile)
    const rpcUrl = RPC.getCurrentEndpoint();
    result = await fetchFromHeimdall(chainId, address, rpcUrl);
    if (result) {
      setCache(chainId, address, result);
      return result;
    }

    // 5. عدم موفقیت
    return {
      abi: null,
      source: null,
      verified: false,
      error: 'ABI_NOT_FOUND'
    };
  }

  // ─── Public API ───
  window.APZ_ABI = {
    fetchABI,
    clearCache: () => abiCache.clear(),
    configure: (opts) => {
      if (opts.etherscanApiKey) {
        localStorage.setItem('apz-etherscan-key', opts.etherscanApiKey);
        CONFIG.etherscan.enabled = true;
      }
      if (opts.heimdallUrl) {
        CONFIG.heimdall.baseUrl = opts.heimdallUrl;
        CONFIG.heimdall.enabled = true;
      }
    }
  };
})();
