```javascript
/* ═══════════════════════════════════════════════
   APZ Wallet — Contract Interaction
   eth_call برای توابع read-only + ABI encoding/decoding
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  const RPC = window.APZ_RPC;

  // ─── Keccak-256 (کوچک، برای function selector) ───
  // برای سادگی از یک تابع ساده استفاده می‌کنیم
  // در production از ethers.js یا keccak استفاده کنید
  async function computeSelector(fn) {
    const sig = `${fn.name}(${(fn.inputs || []).map((i) => i.type).join(',')})`;
    // اگر ethers موجود باشد از آن استفاده کن
    if (window.ethers?.utils?.id) {
      return window.ethers.utils.id(sig).slice(0, 10);
    }
    // fallback: hash ساده (برای نمایش)
    return '0x' + simpleHash(sig).slice(0, 8);
  }

  function simpleHash(str) {
    let h = 0;
    for (let i = 0; i < str.length; i++) {
      h = ((h << 5) - h + str.charCodeAt(i)) | 0;
    }
    return Math.abs(h).toString(16).padStart(8, '0');
  }

  // ─── ABI Encode ───
  // پیاده‌سازی ساده برای انواع پایه
  function padHex(hex, bytes = 32) {
    const clean = hex.replace(/^0x/, '');
    return clean.padStart(bytes * 2, '0');
  }

  function encodeParam(type, value) {
    const t = type.replace('[]', '');

    // Address
    if (/^address$/i.test(t)) {
      if (!/^0x[a-fA-F0-9]{40}$/.test(value)) {
        throw new Error(`Invalid address: ${value}`);
      }
      return padHex(value.toLowerCase());
    }

    // Boolean
    if (/^bool$/i.test(t)) {
      const v = value === true || value === 'true' || value === '1';
      return padHex(v ? '1' : '0');
    }

    // Uint
    if (/^uint\d*$/i.test(t)) {
      let num;
      try {
        num = BigInt(value);
      } catch {
        throw new Error(`Invalid uint: ${value}`);
      }
      return padHex(num.toString(16));
    }

    // Int
    if (/^int\d*$/i.test(t)) {
      let num = BigInt(value);
      if (num < 0n) {
        // two's complement
        const bits = parseInt(t.replace('int', '') || '256', 10);
        num = (1n << BigInt(bits)) + num;
      }
      return padHex(num.toString(16));
    }

    // Bytes32
    if (/^bytes32$/i.test(t)) {
      return padHex(value, 32);
    }

    // Bytes / string
    if (/^bytes$/i.test(t)) {
      return value.replace(/^0x/, '');
    }
    if (/^string$/i.test(t)) {
      // encode as dynamic
      return value; // در پیاده‌سازی واقعی: offset + length + data
    }

    throw new Error(`Unsupported type: ${type}`);
  }

  function encodeFunctionData(fn, values) {
    const selector = fn._selector || '0x';
    const inputs = fn.inputs || [];

    if (inputs.length === 0) return selector;

    // برای انواع ساده (non-dynamic) کافی است
    const encoded = inputs.map((inp, i) => {
      return encodeParam(inp.type, values[i]);
    }).join('');

    return selector + encoded;
  }

  // ─── ABI Decode ───
  function decodeParam(type, hex, offset = 0) {
    // پیاده‌سازی ساده برای انواع پایه
    const t = type.replace('[]', '');
    const slice = hex.slice(offset * 64, (offset + 1) * 64);
    if (!slice) return null;

    if (/^address$/i.test(t)) {
      return '0x' + slice.slice(24);
    }
    if (/^bool$/i.test(t)) {
      return slice.slice(-1) === '1';
    }
    if (/^uint\d*$/i.test(t)) {
      return BigInt('0x' + slice).toString();
    }
    if (/^int\d*$/i.test(t)) {
      const big = BigInt('0x' + slice);
      const bits = BigInt(t.replace('int', '') || '256');
      const max = 1n << (bits - 1n);
      return (big >= max ? big - (1n << bits) : big).toString();
    }
    if (/^string$/i.test(t)) {
      // offset → length → data
      return hex; // ساده‌سازی شده
    }
    return '0x' + slice;
  }

  function decodeResult(fn, resultHex) {
    if (!resultHex || resultHex === '0x') return null;

    const clean = resultHex.replace(/^0x/, '');
    const outputs = fn.outputs || [];

    if (outputs.length === 0) return null;
    if (outputs.length === 1) {
      return decodeParam(outputs[0].type, clean, 0);
    }

    return outputs.map((o, i) => decodeParam(o.type, clean, i));
  }

  // ─── Main: Call Read Function ───
  async function callReadFunction(address, fn, values) {
    // 1. Selector
    if (!fn._selector) {
      fn._selector = await computeSelector(fn);
    }

    // 2. Encode
    const data = encodeFunctionData(fn, values);

    // 3. eth_call
    const result = await RPC.call('eth_call', [
      { to: address, data },
      'latest'
    ]);

    // 4. Decode
    return decodeResult(fn, result);
  }

  // ─── Public ───
  window.APZ_CONTRACT = {
    callReadFunction,
    encodeFunctionData,
    decodeResult,
    computeSelector,
    attachSelectors: async (abi) => {
      const fns = (abi || []).filter((x) => x.type === 'function');
      for (const fn of fns) {
        fn._selector = await computeSelector(fn);
      }
      return fns;
    }
  };
})();
```

نکته: این پیاده‌سازی ABI encoding/decoding ساده‌شده است. برای production، از ethers.js یا viem استفاده کنید:

```html
<script src="https://cdn.jsdelivr.net/npm/ethers@6/dist/ethers.umd.min.js"></script>
```

و در contract-interact.js:

```javascript
async function callReadFunction(address, fn, values) {
  const provider = new ethers.JsonRpcProvider(RPC.getCurrentEndpoint());
  const contract = new ethers.Contract(address, [fn], provider);
  const result = await contract[fn.name](...values);
  return result;
}
