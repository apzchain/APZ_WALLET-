    "ethers": "^6.9.0",
    "better-sqlite3": "^9.2.0",
    "zod": "^3.22.4",
    "lucide-react": "^0.263.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "tsx": "^4.7.0",
    "concurrently": "^8.2.2"
  }
