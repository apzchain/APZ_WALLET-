3️⃣ .github/workflows/android-nightly.yml

بیلد شبانه برای تست‌های طولانی و ساخت APK شبانه.

```yaml
name: Android Nightly

on:
  schedule:
    # هر شب ساعت 02:00 UTC (06:30 تهران)
    - cron: '0 2 * * *'
  workflow_dispatch:

permissions:
  contents: write

env:
  JAVA_VERSION: '17'

jobs:
  nightly-build:
    name: Nightly Debug Build
    runs-on: ubuntu-latest
    timeout-minutes: 30
    defaults:
      run:
        working-directory: android
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Grant execute permission
        run: chmod +x gradlew

      - name: Build Debug APK
        run: ./gradlew assembleDebug --stacktrace

      - name: Rename APK
        run: |
          DATE=$(date +%Y%m%d)
          APK=$(find app/build/outputs/apk/debug -name "*.apk" | head -1)
          mkdir -p ../nightly
          cp "$APK" "../nightly/apz-wallet-nightly-${DATE}.apk"
          cd ../nightly
          sha256sum *.apk > SHA256SUMS.txt

      - name: Delete Old Nightly Tag
        run: |
          git push origin :refs/tags/nightly 2>/dev/null || true

      - name: Create Nightly Tag
        run: |
          git tag -f nightly
          git push -f origin nightly

      - name: Publish Nightly Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: nightly
          name: "🌙 APZ Wallet Nightly — ${{ github.run_number }}"
          body: |
            Automated nightly build from `${{ github.sha }}`
            Built on: ${{ github.event.head_commit.timestamp || github.run_started_at }}
          files: nightly/*.apk
          prerelease: true
          make_latest: false
          fail_on_unmatched_files: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
```

