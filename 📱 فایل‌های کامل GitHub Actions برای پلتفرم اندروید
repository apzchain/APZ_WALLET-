2️⃣ .github/workflows/android-release.yml

بیلد ریلیز امضاشده + انتشار در GitHub Releases + آپلود در Play Store (اختیاری).

```yaml
name: Android Release

on:
  push:
    tags:
      - 'v*.*.*'
      - 'android-v*.*.*'
  workflow_dispatch:
    inputs:
      version_name:
        description: 'Version Name (مثال: 1.2.0)'
        required: true
        type: string
      version_code:
        description: 'Version Code (عدد صحیح)'
        required: true
        type: string
      release_notes:
        description: 'Release Notes'
        required: false
        type: string
        default: 'Release build of APZ Wallet'

permissions:
  contents: write

env:
  JAVA_VERSION: '17'
  GRADLE_OPTS: '-Dorg.gradle.jvmargs="-Xmx4g -XX:MaxMetaspaceSize=1g" -Dorg.gradle.daemon=false'

jobs:
  # ─────────────────────────────────────────────
  # Job 1: Build Signed APK + AAB
  # ─────────────────────────────────────────────
  build-release:
    name: Build Signed Release
    runs-on: ubuntu-latest
    timeout-minutes: 40
    outputs:
      version_name: ${{ steps.version.outputs.version_name }}
      version_code: ${{ steps.version.outputs.version_code }}
      apk_sha256: ${{ steps.checksums.outputs.apk_sha256 }}
      aab_sha256: ${{ steps.checksums.outputs.aab_sha256 }}
    defaults:
      run:
        working-directory: android
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup JDK
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Grant execute permission
        run: chmod +x gradlew

      - name: Determine Version
        id: version
        run: |
          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            VERSION_NAME="${{ inputs.version_name }}"
            VERSION_CODE="${{ inputs.version_code }}"
          else
            TAG="${GITHUB_REF#refs/tags/}"
            VERSION_NAME="${TAG#android-v}"
            VERSION_NAME="${VERSION_NAME#v}"
            VERSION_CODE="$(date +%s)"
          fi
          echo "version_name=${VERSION_NAME}" >> $GITHUB_OUTPUT
          echo "version_code=${VERSION_CODE}" >> $GITHUB_OUTPUT
          echo "📦 Version: ${VERSION_NAME} (${VERSION_CODE})"

      # ──────────────────────────────────────
      # رمزگشایی Keystore از Secrets
      # ──────────────────────────────────────
      - name: Decode Keystore
        env:
          KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
        run: |
          if [[ -z "$KEYSTORE_BASE64" ]]; then
            echo "❌ ANDROID_KEYSTORE_BASE64 secret is not set"
            exit 1
          fi
          echo "$KEYSTORE_BASE64" | base64 -d > app/apz-release.keystore
          echo "✅ Keystore decoded"

      - name: Create keystore.properties
        env:
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          cat > keystore.properties <<EOF
          storeFile=apz-release.keystore
          storePassword=${KEYSTORE_PASSWORD}
          keyAlias=${KEY_ALIAS}
          keyPassword=${KEY_PASSWORD}
          EOF
          chmod 600 keystore.properties

      - name: Inject Version into build.gradle.kts
        run: |
          sed -i "s/versionName = \".*\"/versionName = \"${{ steps.version.outputs.version_name }}\"/" app/build.gradle.kts
          sed -i "s/versionCode = [0-9]*/versionCode = ${{ steps.version.outputs.version_code }}/" app/build.gradle.kts
          grep -E "versionName|versionCode" app/build.gradle.kts

      - name: Build Release APK
        run: ./gradlew assembleRelease --stacktrace

      - name: Build Release AAB
        run: ./gradlew bundleRelease --stacktrace

      - name: Build Release APK (Split per ABI)
        run: ./gradlew assembleRelease -Psplits=true --stacktrace
        continue-on-error: true

      - name: Verify Signatures
        run: |
          BUILD_TOOLS=$(ls $ANDROID_HOME/build-tools/ | sort -V | tail -1)
          APKSIGNER="$ANDROID_HOME/build-tools/${BUILD_TOOLS}/apksigner"
          APK=$(find app/build/outputs/apk/release -name "*.apk" ! -name "*unaligned*" | head -1)
          echo "🔍 Verifying: $APK"
          $APKSIGNER verify --verbose --print-certs "$APK"

      - name: Generate Checksums
        id: checksums
        run: |
          mkdir -p ../release-artifacts
          APK=$(find app/build/outputs/apk/release -name "*.apk" ! -name "*unaligned*" | head -1)
          AAB=$(find app/build/outputs/bundle/release -name "*.aab" | head -1)

          APK_SHA=$(sha256sum "$APK" | awk '{print $1}')
          AAB_SHA=$(sha256sum "$AAB" | awk '{print $1}')

          echo "apk_sha256=${APK_SHA}" >> $GITHUB_OUTPUT
          echo "aab_sha256=${AAB_SHA}" >> $GITHUB_OUTPUT

          # کپی به پوشه‌ی release
          cp "$APK" "../release-artifacts/apz-wallet-${{ steps.version.outputs.version_name }}.apk"
          cp "$AAB" "../release-artifacts/apz-wallet-${{ steps.version.outputs.version_name }}.aab"

          # فایل checksum
          cd ../release-artifacts
          sha256sum *.apk *.aab > SHA256SUMS.txt
          cat SHA256SUMS.txt

      - name: Cleanup Secrets
        if: always()
        run: |
          rm -f app/apz-release.keystore keystore.properties || true

      - name: Upload Release Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: apz-wallet-release-${{ steps.version.outputs.version_name }}
          path: release-artifacts/*
          retention-days: 90
          if-no-files-found: error

  # ─────────────────────────────────────────────
  # Job 2: Publish to GitHub Releases
  # ─────────────────────────────────────────────
  publish-github:
    name: Publish GitHub Release
    runs-on: ubuntu-latest
    needs: build-release
    if: startsWith(github.ref, 'refs/tags/') || github.event_name == 'workflow_dispatch'
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download Artifacts
        uses: actions/download-artifact@v4
        with:
          name: apz-wallet-release-${{ needs.build-release.outputs.version_name }}
          path: ./artifacts

      - name: Generate Release Notes
        id: notes
        run: |
          VERSION="${{ needs.build-release.outputs.version_name }}"
          cat > release-notes.md <<EOF
          # 📱 APZ Wallet — Android v${VERSION}

          **Lightweight • Secure • Open-Source**
          Official Wallet for APZ Chain • Built by Khalil Heyrani

          ## 📦 Downloads

          | File | SHA-256 |
          |------|---------|
          | \`apz-wallet-${VERSION}.apk\` | \`${{ needs.build-release.outputs.apk_sha256 }}\` |
          | \`apz-wallet-${VERSION}.aab\` | \`${{ needs.build-release.outputs.aab_sha256 }}\` |

          ## 🔐 Security
          - ✅ APK signed with release keystore
          - ✅ Signature verified via apksigner
          - ✅ SHA-256 checksums included

          ## 📥 Installation
          1. Download the APK from below
          2. Verify SHA-256: \`sha256sum apz-wallet-${VERSION}.apk\`
          3. Enable "Install from unknown sources" if needed
          4. Install and launch

          ---
          *Built with ❤️ by Khalil Heyrani — APZ Chain*
          EOF
          cat release-notes.md

      - name: Create / Update Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ github.ref_name }}
          name: "APZ Wallet Android v${{ needs.build-release.outputs.version_name }}"
          body_path: release-notes.md
          files: |
            artifacts/*.apk
            artifacts/*.aab
            artifacts/SHA256SUMS.txt
          draft: false
          prerelease: false
          generate_release_notes: false
          fail_on_unmatched_files: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # ─────────────────────────────────────────────
  # Job 3: Upload to Google Play (اختیاری)
  # ─────────────────────────────────────────────
  publish-play-store:
    name: Publish to Google Play (Internal Track)
    runs-on: ubuntu-latest
    needs: build-release
    if: startsWith(github.ref, 'refs/tags/')
    environment: production
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download AAB
        uses: actions/download-artifact@v4
        with:
          name: apz-wallet-release-${{ needs.build-release.outputs.version_name }}
          path: ./artifacts

      - name: Upload to Google Play
        uses: r0adkll/upload-google-play@v1
        with:
          serviceAccountJsonPlainText: ${{ secrets.PLAY_STORE_SERVICE_ACCOUNT_JSON }}
          packageName: org.apzchain.wallet
          releaseFiles: artifacts/*.aab
          track: internal
          status: completed
          whatsNewDirectory: android/fastlane/metadata/android/en-US/changelogs
        continue-on-error: true
```

