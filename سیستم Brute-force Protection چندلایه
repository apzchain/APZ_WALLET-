```typescript
import { securityService } from './security.service.js';
import { SECURITY_CONFIG } from '../config/security.config.js';

async login(params: {
  email: string;
  password: string;
  totpCode?: string;
  ipAddress?: string;
  userAgent?: string;
}) {
  const { email, password, totpCode, ipAddress, userAgent } = params;
  const normalizedEmail = email.toLowerCase();

  // 1. IP ban چک شده در middleware، ولی دوباره مطمئن شو
  if (ipAddress) {
    const { banned } = securityService.isIpBanned(ipAddress);
    if (banned) throw Object.assign(new Error('IP banned'), { status: 403, code: 'IP_BANNED' });
  }

  // 2. کاربر رو پیدا کن
  const user = userModel.findByEmail(normalizedEmail);

  // 3. اکانت قفل؟
  if (user) {
    const { locked, remainingMs } = securityService.isAccountLocked(user.id);
    if (locked) {
      throw Object.assign(
        new Error(`Account locked for ${Math.ceil((remainingMs || 0) / 60000)}m`),
        { status: 423, code: 'ACCOUNT_LOCKED' }
      );
    }
  }

  // 4. تأیید رمز
  const ok = user ? await this.verifyPassword(user.password_hash, password) : false;

  if (!user || !ok || !user.is_active) {
    // ثبت تلاش ناموفق
    securityService.recordFailedAttempt({
      identifier: normalizedEmail,
      identifierType: 'email',
      userId: user?.id,
      ipAddress,
      userAgent,
      reason: user ? 'wrong_password' : 'unknown_user'
    });

    if (ipAddress) {
      securityService.recordFailedAttempt({
        identifier: ipAddress,
        identifierType: 'ip',
        userId: user?.id,
        ipAddress,
        userAgent,
        reason: user ? 'wrong_password' : 'unknown_user'
      });
    }

    // قفل اکانت اگه لازمه
    if (user) {
      const failedCount = securityService.countRecentFailedAttempts(
        normalizedEmail, 'email', SECURITY_CONFIG.ipWindowMs
      );

      if (failedCount >= SECURITY_CONFIG.maxFailedAttempts) {
        const result = securityService.lockAccount(user.id, normalizedEmail);
        securityService.logSuspicious({
          userId: user.id,
          ipAddress,
          userAgent,
          activityType: 'account_lockout',
          severity: 'high',
          details: { level: result.level, minutes: result.minutes }
        });
      }

      // CAPTCHA اجبار کن
      if (failedCount >= SECURITY_CONFIG.captcha.triggerAfterAttempts) {
        securityService.requireCaptcha(normalizedEmail);
      }
    }

    // ban IP اگه لازمه
    if (ipAddress) {
      const ipAttempts = securityService.countRecentFailedAttempts(
        ipAddress, 'ip', SECURITY_CONFIG.ipWindowMs
      );
      if (ipAttempts >= SECURITY_CONFIG.maxIpAttempts) {
        securityService.banIp(ipAddress, 'too_many_failed_logins');
      }
    }

    // پیام عمومی (بدون افشای اینکه کاربر وجود داره یا نه)
    throw Object.assign(new Error('Invalid credentials'), { status: 401 });
  }

  // 5. 2FA
  if (totpService.isEnabled(user.id)) {
    if (!totpCode) {
      const mfaToken = jwt.sign(
        { sub: user.id, purpose: 'mfa' },
        AUTH_CONFIG.accessTokenSecret,
        { expiresIn: '5m' }
      );
      throw Object.assign(
        new Error('2FA required'),
        { status: 401, code: 'MFA_REQUIRED', mfaToken }
      );
    }

    if (!totpService.verifyCode(user.id, totpCode)) {
      securityService.recordFailedAttempt({
        identifier: normalizedEmail,
        identifierType: 'email',
        userId: user.id,
        ipAddress,
        userAgent,
        reason: 'invalid_2fa'
      });
      throw Object.assign(
        new Error('Invalid 2FA code'),
        { status: 401, code: 'MFA_INVALID' }
      );
    }
  }

  // 6. ورود موفق → ریست کن
  securityService.resetUserFailures(user.id, normalizedEmail, ipAddress);
  userModel.updateLastLogin(user.id);

  securityService.logSuspicious({
    userId: user.id,
    ipAddress,
    userAgent,
    activityType: 'login_success',
    severity: 'low'
  });

  const tokens = await this.issueTokens(user, userAgent, ipAddress);
  return { user: this.sanitize(user), ...tokens };
}
