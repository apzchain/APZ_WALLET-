declare global {
  interface Window {
    hcaptcha?: any;
  }
}

interface Props {
  siteKey: string;
  onVerify: (token: string) => void;
  onExpire?: () => void;
}

export const Captcha: React.FC<Props> = ({ siteKey, onVerify, onExpire }) => {
  const ref = useRef<HTMLDivElement>(null);
  const widgetId = useRef<string | null>(null);

  useEffect(() => {
    const script = document.createElement('script');
    script.src = 'https://js.hcaptcha.com/1/api.js?render=explicit';
    script.async = true;
    script.defer = true;
    script.onload = () => {
      if (!ref.current || !window.hcaptcha) return;
      widgetId.current = window.hcaptcha.render(ref.current, {
        sitekey: siteKey,
        callback: onVerify,
        'expired-callback': onExpire
      });
    };
    document.head.appendChild(script);
    return () => {
      if (widgetId.current && window.hcaptcha) {
        try { window.hcaptcha.remove(widgetId.current); } catch {}
      }
    };
  }, [siteKey, onVerify, onExpire]);

  return <div ref={ref} className="captcha-widget" />;
};
