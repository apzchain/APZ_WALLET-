import { Request, Response, NextFunction } from 'express';
import { SECURITY_CONFIG } from '../config/security.config.js';
import { captchaService } from '../services/captcha.service.js';
import { securityService } from '../services/security.service.js';

/**
 * اگر برای این identifier CAPTCHA اجباری شده، توکن رو چک کن
 */
export function requireCaptchaIfNeeded(req: Request, res: Response, next: NextFunction) {
  if (!SECURITY_CONFIG.captcha.enabled) return next();

  const email = (req.body?.email || '').toString().toLowerCase();
  const ip = req.ip || 'unknown';

  const emailNeedsCaptcha = email && securityService.isCaptchaRequired(email);
  const ipNeedsCaptcha = securityService.isCaptchaRequired(ip);

  if (!emailNeedsCaptcha && !ipNeedsCaptcha) return next();

  const token = req.body?.captchaToken;
  if (!token) {
    return res.status(400).json({
      success: false,
      error: 'CAPTCHA required',
      code: 'CAPTCHA_REQUIRED',
      siteKey: SECURITY_CONFIG.captcha.siteKey
    });
  }

  captchaService.verify(token, ip).then(ok => {
    if (!ok) {
      securityService.logSuspicious({
        ipAddress: ip,
        userAgent: req.headers['user-agent'],
        activityType: 'captcha_fail',
        severity: 'medium'
      });
      return res.status(400).json({
        success: false,
        error: 'CAPTCHA verification failed',
        code: 'CAPTCHA_FAILED'
      });
    }
    if (email) securityService.markCaptchaSolved(email);
    securityService.markCaptchaSolved(ip);
    next();
  }).catch(next);
}
