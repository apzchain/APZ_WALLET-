import crypto from 'crypto';
import db from './db.service.js';
import { SECURITY_CONFIG } from '../config/security.config.js';

export interface FailedAttemptInput {
  identifier: string;
  identifierType: 'email' | 'ip';
  userId?: string;
  ipAddress?: string;
  userAgent?: string;
  reason?: string;
}

export class SecurityService {
  // ═══════════════════════════════════════════
  //  Failed Attempts
  // ═══════════════════════════════════════════

  recordFailedAttempt(input: FailedAttemptInput) {
    db.prepare(`
      INSERT INTO failed_attempts 
        (id, identifier, identifier_type, user_id, ip_address, user_agent, reason, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      crypto.randomUUID(),
      input.identifier.toLowerCase(),
      input.identifierType,
      input.userId || null,
      input.ipAddress || null,
      input.userAgent || null,
      input.reason || 'unknown',
      Date.now()
    );
  }

  countRecentFailedAttempts(
    identifier: string,
    type: 'email' | 'ip',
    windowMs: number
  ): number {
    const since = Date.now() - windowMs;
    const row = db.prepare(`
      SELECT COUNT(*) as cnt FROM failed_attempts 
      WHERE identifier = ? AND identifier_type = ? AND created_at > ?
    `).get(identifier.toLowerCase(), type, since) as { cnt: number };
    return row.cnt;
  }

  // ═══════════════════════════════════════════
  //  Account Lockout
  // ═══════════════════════════════════════════

  isAccountLocked(userId: string): { locked: boolean; until?: number; remainingMs?: number } {
    const row = db.prepare('SELECT * FROM account_lockouts WHERE user_id = ?')
      .get(userId) as any;
    if (!row) return { locked: false };

    if (row.locked_until > Date.now()) {
      return {
        locked: true,
        until: row.locked_until,
        remainingMs: row.locked_until - Date.now()
      };
    }

    // lockout منقضی شده، پاک کن
    db.prepare('DELETE FROM account_lockouts WHERE user_id = ?').run(userId);
    return { locked: false };
  }

  /**
   * قفل کردن اکانت با escalation تدریجی
   */
  lockAccount(userId: string, email: string, reason: string = 'too_many_failed_attempts') {
    const existing = db.prepare('SELECT * FROM account_lockouts WHERE user_id = ?')
      .get(userId) as any;

    const prevLevel = existing?.escalation_level ?? -1;
    const newLevel = Math.min(prevLevel + 1, SECURITY_CONFIG.lockoutEscalation.length - 1);
    const minutes = SECURITY_CONFIG.lockoutEscalation[newLevel];
    const lockMs = minutes * 60 * 1000;

    db.prepare(`
      INSERT INTO account_lockouts 
        (user_id, email, locked_until, escalation_level, reason, last_failed_at, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?)
      ON CONFLICT(user_id) DO UPDATE SET
        locked_until = excluded.locked_until,
        escalation_level = excluded.escalation_level,
        reason = excluded.reason,
        last_failed_at = excluded.last_failed_at
    `).run(
      userId,
      email.toLowerCase(),
      Date.now() + lockMs,
      newLevel,
      reason,
      Date.now(),
      existing?.created_at ?? Date.now()
    );

    return { lockedUntil: Date.now() + lockMs, level: newLevel, minutes };
  }

  unlockAccount(userId: string) {
    db.prepare('DELETE FROM account_lockouts WHERE user_id = ?').run(userId);
  }

  /**
   * بعد از ورود موفق، همه چیز رو ریست کن
   */
  resetUserFailures(userId: string, email: string, ip?: string) {
    db.prepare('DELETE FROM account_lockouts WHERE user_id = ?').run(userId);
    db.prepare(`
      DELETE FROM failed_attempts 
      WHERE identifier = ? AND identifier_type = 'email'
    `).run(email.toLowerCase());
    if (ip) {
      db.prepare(`
        DELETE FROM failed_attempts 
        WHERE identifier = ? AND identifier_type = 'ip'
      `).run(ip);
    }
  }

  // ═══════════════════════════════════════════
  //  IP Ban
  // ═══════════════════════════════════════════

  isIpBanned(ip: string): { banned: boolean; until?: number } {
    const row = db.prepare('SELECT * FROM ip_bans WHERE ip_address = ?').get(ip) as any;
    if (!row) return { banned: false };

    if (row.banned_until > Date.now()) {
      return { banned: true, until: row.banned_until };
    }
    db.prepare('DELETE FROM ip_bans WHERE ip_address = ?').run(ip);
    return { banned: false };
  }

  banIp(ip: string, reason: string, durationMs?: number) {
    const banMs = durationMs || SECURITY_CONFIG.ipBanMs;
    const existing = db.prepare('SELECT * FROM ip_bans WHERE ip_address = ?').get(ip) as any;

    db.prepare(`
      INSERT INTO ip_bans (ip_address, banned_until, reason, attempts_count, created_at)
      VALUES (?, ?, ?, ?, ?)
      ON CONFLICT(ip_address) DO UPDATE SET
        banned_until = excluded.banned_until,
        reason = excluded.reason,
        attempts_count = ip_bans.attempts_count + 1
    `).run(
      ip,
      Date.now() + banMs,
      reason,
      (existing?.attempts_count ?? 0) + 1,
      existing?.created_at ?? Date.now()
    );

    return { bannedUntil: Date.now() + banMs };
  }

  unbanIp(ip: string) {
    db.prepare('DELETE FROM ip_bans WHERE ip_address = ?').run(ip);
  }

  getActiveBans() {
    return db.prepare(`
      SELECT * FROM ip_bans WHERE banned_until > ? ORDER BY banned_until DESC
    `).all(Date.now());
  }

  // ═══════════════════════════════════════════
  //  Suspicious Activity
  // ═══════════════════════════════════════════

  logSuspicious(params: {
    userId?: string;
    ipAddress?: string;
    userAgent?: string;
    activityType: string;
    severity: 'low' | 'medium' | 'high';
    details?: any;
  }) {
    db.prepare(`
      INSERT INTO suspicious_activity 
        (id, user_id, ip_address, user_agent, activity_type, severity, details, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      crypto.randomUUID(),
      params.userId || null,
      params.ipAddress || null,
      params.userAgent || null,
      params.activityType,
      params.severity,
      params.details ? JSON.stringify(params.details) : null,
      Date.now()
    );
  }

  getSuspiciousActivity(userId: string, limit = 50) {
    return db.prepare(`
      SELECT * FROM suspicious_activity 
      WHERE user_id = ? ORDER BY created_at DESC LIMIT ?
    `).all(userId, limit);
  }

  // ═══════════════════════════════════════════
  //  CAPTCHA Requirement
  // ═══════════════════════════════════════════

  requireCaptcha(identifier: string) {
    const now = Date.now();
    const until = now + 30 * 60 * 1000; // 30 دقیقه معتبر

    db.prepare(`
      INSERT INTO captcha_challenges 
        (identifier, challenge_required, required_until, solved_at, created_at)
      VALUES (?, 1, ?, NULL, ?)
      ON CONFLICT(identifier) DO UPDATE SET
        challenge_required = 1,
        required_until = excluded.required_until,
        solved_at = NULL
    `).run(identifier.toLowerCase(), until, now);
  }

  isCaptchaRequired(identifier: string): boolean {
    const row = db.prepare(`
      SELECT * FROM captcha_challenges WHERE identifier = ?
    `).get(identifier.toLowerCase()) as any;

    if (!row) return false;
    if (row.required_until < Date.now()) {
      db.prepare('DELETE FROM captcha_challenges WHERE identifier = ?').run(identifier.toLowerCase());
      return false;
    }
    return row.challenge_required === 1 && !row.solved_at;
  }

  markCaptchaSolved(identifier: string) {
    db.prepare(`
      UPDATE captcha_challenges 
      SET solved_at = ? WHERE identifier = ?
    `).run(Date.now(), identifier.toLowerCase());
  }

  // ═══════════════════════════════════════════
  //  Cleanup (cron-like)
  // ═══════════════════════════════════════════

  cleanup() {
    const now = Date.now();
    const oldAttempts = now - 24 * 60 * 60 * 1000;

    db.prepare('DELETE FROM failed_attempts WHERE created_at < ?').run(oldAttempts);
    db.prepare('DELETE FROM account_lockouts WHERE locked_until < ?').run(now);
    db.prepare('DELETE FROM ip_bans WHERE banned_until < ?').run(now);
    db.prepare('DELETE FROM captcha_challenges WHERE required_until < ?').run(now);
    db.prepare('DELETE FROM suspicious_activity WHERE created_at < ?').run(oldAttempts);

    console.log('🧹 Security cleanup done at', new Date().toISOString());
  }
}

export const securityService = new SecurityService();

// هر ۱۰ دقیقه یکبار پاکسازی
setInterval(() => securityService.cleanup(), 10 * 60 * 1000);
```

