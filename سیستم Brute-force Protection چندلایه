import rateLimit from 'express-rate-limit';
import slowDown from 'express-slow-down';
import { SECURITY_CONFIG } from '../config/security.config.js';

/**
 * helper: چه چیزی رو محدود کنیم؟ IP یا ایمیل؟
 */
function ipKey(req: any) {
  return req.ip || req.headers['x-forwarded-for'] || 'unknown';
}

function emailKey(req: any) {
  return (req.body?.email || 'anon').toString().toLowerCase();
}

// ═══════════════════════════════════════════
//  Global Rate Limit — همه API ها
// ═══════════════════════════════════════════
export const globalLimiter = rateLimit({
  windowMs: SECURITY_CONFIG.rateLimits.global.windowMs,
  max: SECURITY_CONFIG.rateLimits.global.max,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    success: false,
    error: 'Too many requests, please slow down.',
    code: 'RATE_LIMIT_EXCEEDED'
  }
});

// ═══════════════════════════════════════════
//  Auth Limiter — بر اساس IP + email
// ═══════════════════════════════════════════
export const authLimiter = rateLimit({
  windowMs: SECURITY_CONFIG.rateLimits.auth.windowMs,
  max: SECURITY_CONFIG.rateLimits.auth.max,
  keyGenerator: req => `${ipKey(req)}:${emailKey(req)}`,
  standardHeaders: true,
  legacyHeaders: false,
  skipSuccessfulRequests: true,
  message: {
    success: false,
    error: 'Too many login attempts. Please try again later.',
    code: 'LOGIN_RATE_LIMIT'
  }
});

// ═══════════════════════════════════════════
//  Register Limiter — سخت‌گیرانه
// ═══════════════════════════════════════════
export const registerLimiter = rateLimit({
  windowMs: SECURITY_CONFIG.rateLimits.register.windowMs,
  max: SECURITY_CONFIG.rateLimits.register.max,
  keyGenerator: ipKey,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    success: false,
    error: 'Too many registration attempts from this IP.',
    code: 'REGISTER_RATE_LIMIT'
  }
});

// ═══════════════════════════════════════════
//  2FA Limiter — جلوگیری از brute-force روی کدهای TOTP
// ═══════════════════════════════════════════
export const twoFactorLimiter = rateLimit({
  windowMs: SECURITY_CONFIG.rateLimits.twoFactor.windowMs,
  max: SECURITY_CONFIG.rateLimits.twoFactor.max,
  keyGenerator: req => {
    const token = req.body?.mfaToken || '';
    return `${ipKey(req)}:${token.slice(0, 20)}`;
  },
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    success: false,
    error: 'Too many 2FA attempts.',
    code: 'TWOFA_RATE_LIMIT'
  }
});

// ═══════════════════════════════════════════
//  Password Reset Limiter
// ═══════════════════════════════════════════
export const passwordResetLimiter = rateLimit({
  windowMs: SECURITY_CONFIG.rateLimits.passwordReset.windowMs,
  max: SECURITY_CONFIG.rateLimits.passwordReset.max,
  keyGenerator: emailKey,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    success: false,
    error: 'Too many password reset requests.',
    code: 'PWRESET_RATE_LIMIT'
  }
});

// ═══════════════════════════════════════════
//  OAuth Limiter
// ═══════════════════════════════════════════
export const oauthLimiter = rateLimit({
  windowMs: SECURITY_CONFIG.rateLimits.oauth.windowMs,
  max: SECURITY_CONFIG.rateLimits.oauth.max,
  keyGenerator: ipKey,
  standardHeaders: true,
  legacyHeaders: false,
  message: {
    success: false,
    error: 'Too many OAuth attempts.',
    code: 'OAUTH_RATE_LIMIT'
  }
});

// ═══════════════════════════════════════════
//  Slow-down — تأخیر تدریجی به‌جای بلاک
// ═══════════════════════════════════════════
export const authSlowDown = slowDown({
  windowMs: SECURITY_CONFIG.slowDown.authWindowMs,
  delayAfter: SECURITY_CONFIG.slowDown.delayAfter,
  delayMs: () => SECURITY_CONFIG.slowDown.delayMs,
  maxDelayMs: SECURITY_CONFIG.slowDown.maxDelayMs,
  keyGenerator: req => `${ipKey(req)}:${emailKey(req)}`,
  validate: { delayMs: false }
});
