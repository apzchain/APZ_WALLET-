import { Request, Response, NextFunction } from 'express';
import { SECURITY_CONFIG } from '../config/security.config.js';
import { securityService } from '../services/security.service.js';
import { userModel } from '../models/User.model.js';

/**
 * چک IP ban
 * این middleware اول از همه روی روت‌های حساس اجرا می‌شه
 */
export function checkIpBan(req: Request, res: Response, next: NextFunction) {
  const ip = req.ip || 'unknown';
  const { banned, until } = securityService.isIpBanned(ip);

  if (banned) {
    const remaining = Math.ceil(((until || 0) - Date.now()) / 1000);
    return res.status(403).json({
      success: false,
      error: `Your IP is temporarily banned. Try again in ${remaining}s.`,
      code: 'IP_BANNED',
      retryAfter: remaining
    });
  }

  next();
}

/**
 * چک قفل بودن اکانت قبل از تلاش ورود
 */
export function checkAccountLock(req: Request, res: Response, next: NextFunction) {
  const email = (req.body?.email || '').toString().toLowerCase();
  if (!email) return next();

  const user = userModel.findByEmail(email);
  if (!user) return next(); // کاربر نیست → بررسی ادامه می‌ده در ادامه

  const { locked, until, remainingMs } = securityService.isAccountLocked(user.id);

  if (locked) {
    const remainingMin = Math.ceil((remainingMs || 0) / 60_000);
    return res.status(423).json({
      success: false,
      error: `Account is temporarily locked. Try again in ${remainingMin} minute(s).`,
      code: 'ACCOUNT_LOCKED',
      lockedUntil: until,
      retryAfter: Math.ceil((remainingMs || 0) / 1000)
    });
  }

  next();
}

/**
 * بعد از یک تلاش ناموفق، این تابع رو صدا بزن
 */
export function handleFailedLogin(params: {
  email: string;
  ip: string;
  userAgent?: string;
  userId?: string;
  reason: string;
}) {
  const { email, ip, userAgent, userId, reason } = params;

  // 1. ثبت تلاش
  securityService.recordFailedAttempt({
    identifier: email,
    identifierType: 'email',
    userId,
    ipAddress: ip,
    userAgent,
    reason
  });

  securityService.recordFailedAttempt({
    identifier: ip,
    identifierType: 'ip',
    userId,
    ipAddress: ip,
    userAgent,
    reason
  });

  // 2. شمارش و قفل اکانت
  if (userId) {
    const failedCount = securityService.countRecentFailedAttempts(
      email,
      'email',
      SECURITY_CONFIG.ipWindowMs
    );

    if (failedCount >= SECURITY_CONFIG.maxFailedAttempts) {
      const result = securityService.lockAccount(userId, email, reason);
      securityService.logSuspicious({
        userId,
        ipAddress: ip,
        userAgent,
        activityType: 'account_lockout',
        severity: result.level >= 2 ? 'high' : 'medium',
        details: { level: result.level, minutes: result.minutes, reason }
      });
    }
  }

  // 3. شمارش IP و ban
  const ipAttempts = securityService.countRecentFailedAttempts(
    ip,
    'ip',
    SECURITY_CONFIG.ipWindowMs
  );

  if (ipAttempts >= SECURITY_CONFIG.maxIpAttempts) {
    securityService.banIp(ip, 'too_many_failed_logins');
    securityService.logSuspicious({
      userId,
      ipAddress: ip,
      userAgent,
      activityType: 'ip_banned',
      severity: 'high',
      details: { attempts: ipAttempts }
    });
  }

  // 4. CAPTCHA رو در ادامه اجبار کن
  if (failedCount >= SECURITY_CONFIG.captcha.triggerAfterAttempts) {
