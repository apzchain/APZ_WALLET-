```typescript
import db from './db.service.js';
import { ZTA_CONFIG } from '../config/zeroTrust.config.js';

export interface PolicyRule {
  id: string;
  name: string;
  description: string | null;
  route_pattern: string;
  method: string | null;
  min_trust: number;
  require_device_trust: number;
  require_mfa: number;
  require_jit: number;
  allowed_roles: string | null;
  conditions: string | null;
  priority: number;
  enabled: number;
}

export interface PolicyDecision {
  decision: 'allow' | 'step_up' | 'deny' | 'require_jit';
  matchedPolicy?: PolicyRule;
  reason: string;
  requiredActions: string[];
  minTrust: number;
}

export interface PolicyInput {
  path: string;
  method: string;
  userId?: string;
  role?: string;
  trustScore: number;
  deviceTrusted: boolean;
  mfaVerified: boolean;
  hasJitGrant: boolean;
}

export class PolicyEngine {
  private rulesCache: { data: PolicyRule[]; ts: number } | null = null;

  private getRules(): PolicyRule[] {
    if (this.rulesCache && Date.now() - this.rulesCache.ts < 60_000) {
      return this.rulesCache.data;
    }
    const rows = db.prepare(`
      SELECT * FROM zt_policies WHERE enabled = 1 ORDER BY priority ASC
    `).all() as PolicyRule[];
    this.rulesCache = { data: rows, ts: Date.now() };
    return rows;
  }

  /**
   * PDP اصلی — تصمیم می‌گیره allow/deny/step-up
   */
  evaluate(input: PolicyInput): PolicyDecision {
    // ═══════════════════════════════════════════
    //  1. Route های حساس پیش‌فرض (سخت‌گیرانه)
    // ═══════════════════════════════════════════
    for (const sensitive of ZTA_CONFIG.sensitiveRoutes) {
      if (new RegExp(sensitive.pattern).test(input.path)) {
        if (input.trustScore < sensitive.minTrust) {
          return {
            decision: input.trustScore >= ZTA_CONFIG.trustThreshold ? 'step_up' : 'deny',
            reason: `sensitive_route_requires_trust_${sensitive.minTrust}`,
            requiredActions: ['step_up'],
            minTrust: sensitive.minTrust
          };
        }
      }
    }

    // ═══════════════════════════════════════════
    //  2. DB Policies
    // ═══════════════════════════════════════════
    for (const rule of this.getRules()) {
      if (!this.matches(rule, input)) continue;

      const requiredActions: string[] = [];

      if (input.trustScore < rule.min_trust) {
        requiredActions.push('step_up');
      }
      if (rule.require_device_trust && !input.deviceTrusted) {
        requiredActions.push('trust_device');
      }
      if (rule.require_mfa && !input.mfaVerified) {
        requiredActions.push('mfa');
      }
      if (rule.require_jit && !input.hasJitGrant) {
        return {
          decision: 'require_jit',
          matchedPolicy: rule,
          reason: 'jit_grant_required',
          requiredActions: ['request_jit'],
          minTrust: rule.min_trust
        };
      }

      if (requiredActions.length > 0) {
        return {
          decision: 'step_up',
          matchedPolicy: rule,
          reason: `policy_requires_${requiredActions.join('_')}`,
          requiredActions,
          minTrust: rule.min_trust
        };
      }

      // role check
      if (rule.allowed_roles) {
        const roles: string[] = JSON.parse(rule.allowed_roles);
        if (!input.role || !roles.includes(input.role)) {
          return {
            decision: 'deny',
            matchedPolicy: rule,
            reason: 'role_not_allowed',
            requiredActions: [],
            minTrust: rule.min_trust
          };
        }
      }

      return {
        decision: 'allow',
        matchedPolicy: rule,
        reason: 'policy_passed',
        requiredActions: [],
        minTrust: rule.min_trust
      };
    }

    // ═══════════════════════════════════════════
    //  3. Default Decision بر اساس trust score
    // ═══════════════════════════════════════════
    if (input.trustScore >= ZTA_CONFIG.stepUpThreshold) {
      return { decision: 'allow', reason: 'trust_high', requiredActions: [], minTrust: ZTA_CONFIG.trustThreshold };
    }
    if (input.trustScore >= ZTA_CONFIG.trustThreshold) {
      return { decision: 'step_up', reason: 'trust_medium', requiredActions: ['step_up'], minTrust: ZTA_CONFIG.trustThreshold };
    }
    return { decision: 'deny', reason: 'trust_low', requiredActions: [], minTrust: ZTA_CONFIG.trustThreshold };
  }

  private matches(rule: PolicyRule, input: PolicyInput): boolean {
    if (rule.method && rule.method !== input.method) return false;
    return new RegExp(rule.route_pattern).test(input.path);
  }

  // ───── CRUD ─────
  list(): PolicyRule[] {
    return db.prepare('SELECT * FROM zt_policies ORDER BY priority ASC').all() as PolicyRule[];
  }

  create(params: {
    name: string;
    description?: string;
    routePattern: string;
    method?: string;
    minTrust: number;
    requireDeviceTrust?: boolean;
    requireMfa?: boolean;
    requireJit?: boolean;
    allowedRoles?: string[];
    priority?: number;
  }) {
    const id = crypto.randomUUID();
    db.prepare(`
      INSERT INTO zt_policies 
        (id, name, description, route_pattern, method, min_trust, require_device_trust,
         require_mfa, require_jit, allowed_roles, priority, enabled, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?)
    `).run(
      id,
      params.name,
      params.description || null,
      params.routePattern,
      params.method || null,
      params.minTrust,
      params.requireDeviceTrust ? 1 : 0,
      params.requireMfa ? 1 : 0,
      params.requireJit ? 1 : 0,
      params.allowedRoles ? JSON.stringify(params.allowedRoles) : null,
      params.priority ?? 100,
      Date.now()
    );
    this.rulesCache = null;
    return db.prepare('SELECT * FROM zt_policies WHERE id = ?').get(id);
  }

  update(id: string, patch: Partial<PolicyRule>) {
    const fields: string[] = [];
    const values: any[] = [];
    for (const [k, v] of Object.entries(patch)) {
      if (v !== undefined) {
        fields.push(`${k} = ?`);
        values.push(v);
      }
    }
    if (!fields.length) return;
    values.push(id);
    db.prepare(`UPDATE zt_policies SET ${fields.join(', ')} WHERE id = ?`).run(...values);
    this.rulesCache = null;
  }

  remove(id: string) {
    db.prepare('DELETE FROM zt_policies WHERE id = ?').run(id);
    this.rulesCache = null;
  }
}

export const policyEngine = new PolicyEngine();
