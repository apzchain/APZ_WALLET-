import crypto from 'crypto';
import { SignJWT, jwtVerify } from 'jose';
import db from './db.service.js';
import { ZTA_CONFIG } from '../config/zeroTrust.config.js';

export interface DeviceRow {
  id: string;
  user_id: string;
  device_fingerprint: string;
  device_name: string | null;
  device_type: string | null;
  os: string | null;
  os_version: string | null;
  browser: string | null;
  browser_version: string | null;
  is_trusted: number;
  is_blocked: number;
  trust_level: string;
  posture_score: number;
  posture_details: string | null;
  first_seen_at: number;
  last_seen_at: number;
  last_ip: string | null;
  seen_count: number;
}

export class DeviceTrustService {
  private secret = new TextEncoder().encode(ZTA_CONFIG.device.tokenSecret);

  /**
   * compute دستگاه از fingerprint خام
   */
  computeDeviceId(rawFingerprint: string): string {
    return crypto
      .createHash('sha256')
      .update(rawFingerprint)
      .digest('hex');
  }

  /**
   * ثبت یا به‌روزرسانی دستگاه
   */
  upsert(params: {
    userId: string;
    fingerprint: string;
    ip: string;
    deviceInfo: {
      name?: string;
      type?: string;
      os?: string;
      osVersion?: string;
      browser?: string;
      browserVersion?: string;
    };
    posture?: {
      score: number;
      details: any;
    };
  }): DeviceRow {
    const fp = this.computeDeviceId(params.fingerprint);
    const existing = db.prepare('SELECT * FROM devices WHERE user_id = ? AND device_fingerprint = ?')
      .get(params.userId, fp) as DeviceRow | undefined;

    const now = Date.now();

    if (existing) {
      db.prepare(`
        UPDATE devices SET
          last_seen_at = ?,
          last_ip = ?,
          seen_count = seen_count + 1,
          device_name = COALESCE(?, device_name),
          device_type = COALESCE(?, device_type),
          os = COALESCE(?, os),
          os_version = COALESCE(?, os_version),
          browser = COALESCE(?, browser),
          browser_version = COALESCE(?, browser_version),
          posture_score = COALESCE(?, posture_score),
          posture_details = COALESCE(?, posture_details)
        WHERE id = ?
      `).run(
        now,
        params.ip,
        params.deviceInfo.name || null,
        params.deviceInfo.type || null,
        params.deviceInfo.os || null,
        params.deviceInfo.osVersion || null,
        params.deviceInfo.browser || null,
        params.deviceInfo.browserVersion || null,
        params.posture?.score ?? null,
        params.posture ? JSON.stringify(params.posture.details) : null,
        existing.id
      );

      return db.prepare('SELECT * FROM devices WHERE id = ?').get(existing.id) as DeviceRow;
    }

    const id = crypto.randomUUID();
    db.prepare(`
      INSERT INTO devices 
        (id, user_id, device_fingerprint, device_name, device_type, os, os_version,
         browser, browser_version, is_trusted, is_blocked, trust_level, posture_score,
         posture_details, first_seen_at, last_seen_at, last_ip, seen_count)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, 0, 'new', ?, ?, ?, ?, ?, 1)
    `).run(
      id,
      params.userId,
      fp,
      params.deviceInfo.name || null,
      params.deviceInfo.type || null,
      params.deviceInfo.os || null,
      params.deviceInfo.osVersion || null,
      params.deviceInfo.browser || null,
      params.deviceInfo.browserVersion || null,
      params.posture?.score ?? 0,
      params.posture ? JSON.stringify(params.posture.details) : null,
      now,
      now,
      params.ip
    );

    return db.prepare('SELECT * FROM devices WHERE id = ?').get(id) as DeviceRow;
  }

  /**
   * تولید device token (JWS)
   * این توکن در کلاینت ذخیره میشه و با هر درخواست فرستاده میشه
   */
  async issueDeviceToken(params: {
    userId: string;
    deviceId: string;
    fingerprint: string;
  }): Promise<string> {
    return new SignJWT({
      sub: params.userId,
      did: params.deviceId,
      fp: this.computeDeviceId(params.fingerprint),
      type: 'device'
    })
      .setProtectedHeader({ alg: 'HS256' })
      .setIssuedAt()
      .setIssuer('apz-wallet')
      .setExpirationTime(ZTA_CONFIG.device.tokenTtl)
      .sign(this.secret);
  }

  async verifyDeviceToken(token: string): Promise<{ userId: string; deviceId: string; fp: string } | null> {
    try {
      const { payload } = await jwtVerify(token, this.secret, { issuer: 'apz-wallet' });
      if (payload.type !== 'device') return null;
      return {
        userId: payload.sub as string,
        deviceId: payload.did as string,
        fp: payload.fp as string
      };
    } catch {
      return null;
    }
  }

  findByFingerprint(userId: string, rawFingerprint: string): DeviceRow | undefined {
    const fp = this.computeDeviceId(rawFingerprint);
    return db.prepare('SELECT * FROM devices WHERE user_id = ? AND device_fingerprint = ?')
      .get(userId, fp) as DeviceRow | undefined;
  }

  findById(id: string): DeviceRow | undefined {
    return db.prepare('SELECT * FROM devices WHERE id = ?').get(id) as DeviceRow | undefined;
  }

