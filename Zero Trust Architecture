```typescript
import db from './db.service.js';
import { ZTA_CONFIG } from '../config/zeroTrust.config.js';
import { deviceTrustService } from './deviceTrust.service.js';

export interface TrustInput {
  userId: string;
  sessionId?: string;
  ip: string;
  userAgent: string;
  deviceFingerprint?: string;
  geo?: { country?: string; city?: string };
  vpn?: { riskScore: number; isTor: boolean };
  bot?: { riskScore: number; isBot: boolean };
  threat?: { riskScore: number; isMalicious: boolean };
}

export interface TrustComponents {
  device: number;
  session: number;
  network: number;
  behavior: number;
  threat: number;
}

export interface TrustResult {
  score: number;                              // 0-100
  level: 'critical' | 'low' | 'medium' | 'high' | 'verified';
  components: TrustComponents;
  action: 'allow' | 'step_up' | 'deny';
  reasons: string[];
  sessionValid: boolean;
}

export class TrustScoreService {
  /**
   * محاسبه امتیاز اعتماد کامل
   */
  async evaluate(input: TrustInput): Promise<TrustResult> {
    const W = ZTA_CONFIG.weights;
    const components: TrustComponents = { device: 0, session: 0, network: 0, behavior: 0, threat: 0 };
    const reasons: string[] = [];
    let sessionValid = true;

    // ═══════════════════════════════════════════
    //  1. DEVICE (max 30)
    // ═══════════════════════════════════════════
    if (input.deviceFingerprint) {
      const device = deviceTrustService.findByFingerprint(input.userId, input.deviceFingerprint);

      if (device) {
        if (!device.is_blocked) {
          components.device += W.deviceRegistered;
          reasons.push('device_registered');
        } else {
          reasons.push('device_blocked');
          sessionValid = false;
        }

        if (device.is_trusted) {
          components.device += W.deviceTrusted;
          reasons.push('device_trusted');
        }

        if (device.posture_score >= 70) {
          components.device += W.devicePostureOk;
          reasons.push('posture_ok');
        } else if (device.posture_score < 40) {
          reasons.push('posture_poor');
        }
      } else {
        reasons.push('device_unknown');
        // امتیاز device صفر می‌مونه
      }
    } else {
      reasons.push('no_device_fingerprint');
    }

    // ═══════════════════════════════════════════
    //  2. SESSION (max 20)
    // ═══════════════════════════════════════════
    if (input.sessionId) {
      const session = db.prepare('SELECT * FROM session_bindings WHERE session_id = ?')
        .get(input.sessionId) as any;

      if (session && session.is_valid === 1 && session.expires_at > Date.now()) {
        components.session += W.sessionBound;
        reasons.push('session_bound');

        const age = Date.now() - session.created_at;
        if (age < 3600_000) {
          components.session += W.sessionFresh;
          reasons.push('session_fresh');
        }

        // چک IP change
        const ips: string[] = JSON.parse(session.ip_history || '[]');
        if (ips.includes(input.ip)) {
          components.session += W.noIpChange;
          reasons.push('ip_consistent');
        } else if (ips.length >= ZTA_CONFIG.sessionMaxIps) {
          reasons.push('too_many_ips');
          sessionValid = false;
        } else {
          reasons.push('new_ip_in_session');
        }
      } else {
        reasons.push('session_invalid');
        sessionValid = false;
      }
    } else {
      reasons.push('no_session_id');
    }

    // ═══════════════════════════════════════════
    //  3. NETWORK (max 20)
    // ═══════════════════════════════════════════
    const device = input.deviceFingerprint
      ? deviceTrustService.findByFingerprint(input.userId, input.deviceFingerprint)
      : null;

    if (device?.last_ip === input.ip) {
      components.network += W.knownIp;
      reasons.push('known_ip');
    }

    if (!input.vpn || input.vpn.riskScore < 40) {
      components.network += W.notVpn;
      reasons.push('not_vpn');
    } else {
      reasons.push(`vpn_risk_${input.vpn.riskScore}`);
    }

    if (!input.vpn?.isTor) {
      components.network += W.notTor;
      reasons.push('not_tor');
    } else {
      reasons.push('tor_exit');
    }

    if (input.geo?.country && device?.last_ip) {
      components.network += W.geoConsistent;
      reasons.push('geo_present');
    }

    // ═══════════════════════════════════════════
    //  4. BEHAVIOR (max 15)
    // ═══════════════════════════════════════════
    if (!input.bot || input.bot.riskScore < 30) {
      components.behavior += W.normalBehavior;
      reasons.push('behavior_normal');
    } else {
      reasons.push(`bot_risk_${input.bot.riskScore}`);
    }

    if (!input.bot?.isBot) {
      components.behavior += W.noAnomalies;
      reasons.push('no_bot_flags');
    }

    // ═══════════════════════════════════════════
    //  5. THREAT (max 15)
    // ═══════════════════════════════════════════
    if (!input.threat || input.threat.riskScore < 30) {
      components.threat += W.cleanThreat;
      reasons.push('threat_clean');
    } else {
      reasons.push(`threat_risk_${input.threat.riskScore}`);
    }

    if (!input.threat?.isMalicious) {
      components.threat += W.notBot;
      reasons.push('not_malicious');
    }

    // ═══════════════════════════════════════════
    //  Trust Decay
    // ═══════════════════════════════════════════
    let decay = 0;
    if (input.sessionId) {
      const session = db.prepare('SELECT last_evaluated_at FROM session_bindings WHERE session_id = ?')
        .get(input.sessionId) as any;
      if (session) {
        const idleHours = (Date.now() - session.last_evaluated_at) / 3600_000;
        decay = Math.floor(idleHours) * ZTA_CONFIG.decay.perHourIdleMs;
      }
    }

    // ═══════════════════════════════════════════
    //  Final
    // ═══════════════════════════════════════════
    let rawScore =
      components.device + components.session + components.network +
      components.behavior + components.threat;

    rawScore = Math.max(0, Math.min(100, rawScore - decay));

    if (!sessionValid) rawScore = Math.min(rawScore, 20); // session مشکوک → سقف

    const level = this.scoreToLevel(rawScore);
    const action = this.decideAction(rawScore);

    // ذخیره evaluation
    db.prepare(`
      INSERT INTO trust_evaluations 
        (id, user_id, session_id, ip_address, trust_score, trust_level, components, triggered_action, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).run(
      crypto.randomUUID(),
      input.userId,
      input.sessionId || null,
      input.ip,
      rawScore,
      level,
      JSON.stringify({ ...components, decay, sessionValid }),
      action,
      Date.now()
    );

    return { score: rawScore, level, components, action, reasons, sessionValid };
  }

  private scoreToLevel(score: number): TrustResult['level'] {
    if (score >= 90) return 'verified';
    if (score >= 70) return 'high';
    if (score >= 50) return 'medium';
    if (score >= 30) return 'low';
    return 'critical';
  }

  private decideAction(score: number): 'allow' | 'step_up' | 'deny' {
    if (score >= ZTA_CONFIG.stepUpThreshold) return 'allow';
    if (score >= ZTA_CONFIG.trustThreshold) return 'step_up';
    return 'deny';
  }

  // ───── برای route های حساس ─────
  requiresHigherTrust(path: string, method: string): number | null {
    for (const rule of ZTA_CONFIG.sensitiveRoutes) {
      if (new RegExp(rule.pattern).test(path)) {
        return rule.minTrust;
      }
    }
    return null;
  }
}

export const trustScoreService = new TrustScoreService();
```

