    db.prepare(`
      UPDATE session_bindings SET
        trust_score = ?, trust_level = ?, last_evaluated_at = ?
      WHERE session_id = ?
    `).run(score, level, Date.now(), sessionId);
  }

  recordAnomaly(sessionId: string, reason: string) {
    db.prepare(`
      UPDATE session_bindings SET
        anomaly_count = anomaly_count + 1,
        last_evaluated_at = ?
      WHERE session_id = ?
    `).run(Date.now(), sessionId);
  }

  invalidate(sessionId: string, reason?: string) {
