import { Router, Request, Response, NextFunction } from 'express';
import { z } from 'zod';
import { requireAuth } from './auth.middleware.js';
import { stepUpAuthService } from '../services/stepUpAuth.service.js';
import { totpService } from '../services/totp.service.js';
import { sessionBindingService } from '../services/sessionBinding.service.js';

const router = Router();

// ───── POST /api/zerotrust/step-up/:challengeId ─────
router.post('/step-up/:challengeId', requireAuth, async (req, res, next) => {
  try {
    const schema = z.object({ code: z.string().min(6).max(16) });
    const { code } = schema.parse(req.body);

    const challenge = stepUpAuthService.get(req.params.challengeId);
    if (!challenge) {
      return res.status(404).json({ success: false, error: 'Challenge not found' });
    }
    if (challenge.user_id !== req.user!.sub) {
      return res.status(403).json({ success: false, error: 'Forbidden' });
    }
    if (challenge.solved_at) {
      return res.json({ success: true, data: { alreadySolved: true } });
    }
    if (challenge.expires_at < Date.now()) {
      return res.status(410).json({ success: false, error: 'Challenge expired' });
    }
    if (challenge.attempts >= 5) {
      return res.status(429).json({ success: false, error: 'Too many attempts' });
    }

    // ───── Verify TOTP ─────
    const valid = totpService.verifyCode(req.user!.sub, code);
    if (!valid) {
      stepUpAuthService.incrementAttempts(challenge.id);
      return res.status(401).json({ success: false, error: 'Invalid code' });
    }

    stepUpAuthService.solve(challenge.id);

    res.json({ success: true, data: { verified: true } });
  } catch (err) { next(err); }
});

export default router;
```

