    ip: string;
    ua: string;
    fingerprint?: string;
  }): SessionBindingRow {
    const existing = db.prepare('SELECT * FROM session_bindings WHERE session_id = ?')
      .get(params.sessionId) as SessionBindingRow | undefined;

    const now = Date.now();

    if (existing) {
      // به‌روزرسانی IP history
      const ips: string[] = JSON.parse(existing.ip_history || '[]');
      if (!ips.includes(params.ip)) {
        ips.push(params.ip);
      }

      db.prepare(`
        UPDATE session_bindings SET
          ip_history = ?,
          last_evaluated_at = ?
        WHERE session_id = ?
      `).run(JSON.stringify(ips.slice(-20)), now, params.sessionId);

      return db.prepare('SELECT * FROM session_bindings WHERE session_id = ?')
        .get(params.sessionId) as SessionBindingRow;
    }

    db.prepare(`
      INSERT INTO session_bindings 
        (session_id, user_id, device_id, bound_ip, bound_ua, bound_fingerprint,
         ip_history, trust_score, trust_level, last_evaluated_at, anomaly_count,
         is_valid, created_at, expires_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, 0, 'low', ?, 0, 1, ?, ?)
    `).run(
      params.sessionId,
      params.userId,
      params.deviceId || null,
      params.ip,
      params.ua,
      params.fingerprint || null,
      JSON.stringify([params.ip]),
      now,
      now,
      now + ZTA_CONFIG.sessionMaxAgeMs
    );

    return db.prepare('SELECT * FROM session_bindings WHERE session_id = ?')
      .get(params.sessionId) as SessionBindingRow;
  }

  get(sessionId: string): SessionBindingRow | undefined {
    return db.prepare('SELECT * FROM session_bindings WHERE session_id = ?')
      .get(sessionId) as SessionBindingRow | undefined;
  }

