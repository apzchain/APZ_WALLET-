import { Request, Response, NextFunction } from 'express';
import { sessionBindingService } from '../services/sessionBinding.service.js';
import { ZTA_CONFIG } from '../config/zeroTrust.config.js';

/**
 * بررسی مستمر در هر درخواست:
 * - آیا session منقضی نشده؟
 * - آیا IP تغییر غیرمجاز داشته؟
 * - آیا باید re-evaluate بشه؟
 */
export function continuousVerification(req: Request, res: Response, next: NextFunction) {
  if (!ZTA_CONFIG.enabled) return next();

  const user = (req as any).user;
  if (!user) return next();

  const sessionId = user.jti || user.sessionId;
  if (!sessionId) return next();

  const session = sessionBindingService.get(sessionId);
  if (!session) return next();

  // 1. session معتبره؟
  if (session.is_valid !== 1 || session.expires_at < Date.now()) {
    return res.status(401).json({
      success: false,
      code: 'SESSION_EXPIRED',
      error: 'Session no longer valid'
    });
  }

  // 2. IP جدید بیش از حد مجاز؟
  const ip = req.ip || 'unknown';
  const ips: string[] = JSON.parse(session.ip_history || '[]');
  if (!ips.includes(ip) && ips.length >= ZTA_CONFIG.sessionMaxIps) {
    sessionBindingService.invalidate(sessionId, 'too_many_ips');
    return res.status(401).json({
      success: false,
      code: 'SESSION_INVALIDATED',
      error: 'Session invalidated due to IP anomaly'
    });
  }

  // 3. فاصله re-evaluation
  const elapsed = Date.now() - session.last_evaluated_at;
  if (elapsed > ZTA_CONFIG.reverifyIntervalMs) {
    (req as any).ztNeedsReverify = true;
  }

  next();
}
