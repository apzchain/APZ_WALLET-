import crypto from 'crypto';
import db from './db.service.js';
import { ZTA_CONFIG } from '../config/zeroTrust.config.js';

export interface JitGrantRow {
  id: string;
  user_id: string;
  resource: string;
  permissions: string | null;
  reason: string | null;
  granted_by: string | null;
  granted_at: number;
  expires_at: number;
  revoked_at: number | null;
  is_active: number;
}

export class JitAccessService {
  /**
   * درخواست JIT grant
   */
  request(params: {
    userId: string;
    resource: string;
    reason: string;
    durationMs?: number;
    grantedBy?: string;
    permissions?: string[];
  }): JitGrantRow {
    const duration = Math.min(
      params.durationMs || ZTA_CONFIG.jit.defaultDurationMs,
      ZTA_CONFIG.jit.maxDurationMs
    );

    const id = crypto.randomUUID();
    const now = Date.now();

    db.prepare(`
      INSERT INTO jit_grants 
        (id, user_id, resource, permissions, reason, granted_by, granted_at, expires_at, is_active)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, 1)
    `).run(
      id,
      params.userId,
      params.resource,
      params.permissions ? JSON.stringify(params.permissions) : null,
      params.reason,
      params.grantedBy || null,
      now,
      now + duration
    );

    return db.prepare('SELECT * FROM jit_grants WHERE id = ?').get(id) as JitGrantRow;
  }

  /**
   * چک اینکه کاربر برای این resource JIT فعال داره
   */
  hasAccess(userId: string, path: string): boolean {
    const now = Date.now();
    const grants = db.prepare(`
      SELECT * FROM jit_grants 
      WHERE user_id = ? AND is_active = 1 AND expires_at > ? AND revoked_at IS NULL
    `).all(userId, now) as JitGrantRow[];

    for (const grant of grants) {
      const pattern = grant.resource.replace(/\*/g, '.*');
      if (new RegExp(`^${pattern}$`).test(path)) return true;
    }
    return false;
  }

  getActive(userId: string): JitGrantRow[] {
    return db.prepare(`
      SELECT * FROM jit_grants 
      WHERE user_id = ? AND is_active = 1 AND expires_at > ? AND revoked_at IS NULL
      ORDER BY expires_at ASC
    `).all(userId, Date.now()) as JitGrantRow[];
  }

  revoke(id: string, userId?: string) {
    if (userId) {
      db.prepare(`
        UPDATE jit_grants SET is_active = 0, revoked_at = ?
        WHERE id = ? AND user_id = ?
      `).run(Date.now(), id, userId);
    } else {
      db.prepare('UPDATE jit_grants SET is_active = 0, revoked_at = ? WHERE id = ?')
        .run(Date.now(), id);
    }
  }

  cleanup() {
    const result = db.prepare('UPDATE jit_grants SET is_active = 0 WHERE expires_at < ? AND is_active = 1')
      .run(Date.now());
    return result.changes;
  }
}

export const jitAccessService = new JitAccessService();
