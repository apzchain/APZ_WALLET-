      db.prepare('UPDATE session_bindings SET is_valid = 0 WHERE user_id = ? AND session_id != ?')
        .run(userId, except);
    } else {
      db.prepare('UPDATE session_bindings SET is_valid = 0 WHERE user_id = ?')
        .run(userId);
    }
  }

  cleanup() {
    const result = db.prepare('DELETE FROM session_bindings WHERE expires_at < ?')
      .run(Date.now());
    return result.changes;
  }

