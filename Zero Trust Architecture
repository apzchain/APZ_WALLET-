```typescript
import { getFingerprint } from '../fingerprint/FingerprintCollector';

const DEVICE_TOKEN_KEY = 'apz_device_token';
const DEVICE_ID_KEY = 'apz_device_id';

export interface DevicePosture {
  score: number;
  details: {
    cookiesEnabled: boolean;
    localStorage: boolean;
    indexedDB: boolean;
    serviceWorker: boolean;
    secureContext: boolean;
    hardwareConcurrency: number;
    deviceMemory: number;
    screenLock?: boolean;
  };
}

export class DeviceAttestation {
  /**
   * جمع‌آوری وضعیت دستگاه (posture)
   */
  collectPosture(): DevicePosture {
    const details = {
      cookiesEnabled: navigator.cookieEnabled,
      localStorage: this.testStorage('localStorage'),
      indexedDB: typeof indexedDB !== 'undefined',
      serviceWorker: 'serviceWorker' in navigator,
      secureContext: window.isSecureContext,
      hardwareConcurrency: navigator.hardwareConcurrency || 0,
      deviceMemory: (navigator as any).deviceMemory || 0
    };

    let score = 0;
    if (details.cookiesEnabled) score += 10;
    if (details.localStorage) score += 10;
    if (details.indexedDB) score += 10;
    if (details.serviceWorker) score += 10;
    if (details.secureContext) score += 20;
    if (details.hardwareConcurrency >= 4) score += 20;
    if (details.deviceMemory >= 4) score += 20;

    return { score: Math.min(100, score), details };
  }

  private testStorage(key: string): boolean {
    try {
      localStorage.setItem('__test__', '1');
      localStorage.removeItem('__test__');
      return true;
    } catch { return false; }
  }

  /**
   * ثبت/بازیابی دستگاه
   */
  async register(apiCall: (payload: any) => Promise<any>): Promise<{ deviceToken: string; deviceId: string }> {
    // fingerprint جمع کن
    const fp = await getFingerprint();
    const rawFingerprint = JSON.stringify({
      canvas: fp.canvas,
      webgl: fp.webgl,
      audio: fp.audio,
      screen: fp.screen,
      timezone: fp.timezone,
      platform: fp.platform,
      hardwareConcurrency: fp.hardwareConcurrency,
      deviceMemory: fp.deviceMemory
    });

    const posture = this.collectPosture();
    const ua = navigator.userAgent;
    const uaParsed = this.parseUa(ua);

    const response = await apiCall({
      fingerprint: rawFingerprint,
      name: `${uaParsed.browser} on ${uaParsed.os}`,
      type: uaParsed.type,
      os: uaParsed.os,
      osVersion: uaParsed.osVersion,
      browser: uaParsed.browser,
      browserVersion: uaParsed.browserVersion,
      posture
    });

    if (response.success && response.data) {
      localStorage.setItem(DEVICE_TOKEN_KEY, response.data.deviceToken);
      localStorage.setItem(DEVICE_ID_KEY, response.data.device.id);
      return {
        deviceToken: response.data.deviceToken,
        deviceId: response.data.device.id
      };
    }

    throw new Error('Device registration failed');
  }

  /**
   * توکن ذخیره‌شده رو بگیر
   */
  getToken(): string | null {
    return localStorage.getItem(DEVICE_TOKEN_KEY);
  }

  getDeviceId(): string | null {
    return localStorage.getItem(DEVICE_ID_KEY);
  }

  clear() {
    localStorage.removeItem(DEVICE_TOKEN_KEY);
    localStorage.removeItem(DEVICE_ID_KEY);
  }

  /**
   * برگرداندن fingerprint خام (برای هدر X-Device-Fingerprint)
   */
  async getRawFingerprint(): Promise<string> {
    const fp = await getFingerprint();
    return JSON.stringify({
      canvas: fp.canvas,
      webgl: fp.webgl,
      audio: fp.audio,
      screen: fp.screen,
      timezone: fp.timezone,
      platform: fp.platform,
      hardwareConcurrency: fp.hardwareConcurrency,
      deviceMemory: fp.deviceMemory
    });
  }

  private parseUa(ua: string) {
    return {
      browser: /Chrome/.test(ua) ? 'Chrome' : /Firefox/.test(ua) ? 'Firefox' : /Safari/.test(ua) ? 'Safari' : 'Unknown',
      browserVersion: (ua.match(/(Chrome|Firefox|Version)\/([\d.]+)/) || [])[2] || '',
      os: /Windows/.test(ua) ? 'Windows' : /Mac/.test(ua) ? 'macOS' : /Linux/.test(ua) ? 'Linux' : /Android/.test(ua) ? 'Android' : /iOS/.test(ua) ? 'iOS' : 'Unknown',
      osVersion: (ua.match(/(?:Windows NT|Android|OS X) ([\d._]+)/) || [])[1] || '',
      type: /Mobile|Android|iPhone|iPad/.test(ua) ? 'mobile' : 'desktop'
    };
  }
}

export const deviceAttestation = new DeviceAttestation();
