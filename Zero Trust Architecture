import { Request, Response, NextFunction } from 'express';
import { ZTA_CONFIG } from '../config/zeroTrust.config.js';
import { trustScoreService } from '../services/trustScore.service.js';
import { policyEngine } from '../services/policyEngine.service.js';
import { deviceTrustService } from '../services/deviceTrust.service.js';
import { sessionBindingService } from '../services/sessionBinding.service.js';
import { jitAccessService } from '../services/jitAccess.service.js';
import { stepUpAuthService } from '../services/stepUpAuth.service.js';

declare global {
  namespace Express {
    interface Request {
      zt?: {
        trust: any;
        policy: any;
        device?: any;
      };
    }
  }
}

export async function zeroTrustGuard(req: Request, res: Response, next: NextFunction) {
  if (!ZTA_CONFIG.enabled) return next();

  const user = (req as any).user;
  if (!user) return next(); // auth middleware قبلش باید پاس داده باشه

  const ip = req.ip || 'unknown';
  const ua = req.headers['user-agent'] || '';
  const deviceToken = req.headers['x-device-token'] as string;
  const rawFingerprint = req.headers['x-device-fingerprint'] as string;

  // ───── 1. Device verification ─────
  let device: any = null;
  if (deviceToken) {
    const decoded = await deviceTrustService.verifyDeviceToken(deviceToken);
    if (decoded && decoded.userId === user.sub) {
      device = deviceTrustService.findById(decoded.deviceId);
    }
  }

  // ───── 2. Session binding ─────
  const sessionId = user.jti || user.sessionId;
  if (sessionId) {
    const bound = sessionBindingService.get(sessionId);
    if (!bound) {
      // اولین بار → bind
      sessionBindingService.bind({
        sessionId,
        userId: user.sub,
        deviceId: device?.id,
        ip,
        ua,
        fingerprint: rawFingerprint
      });
    }
  }

  // ───── 3. Trust evaluation ─────
  const trust = await trustScoreService.evaluate({
    userId: user.sub,
    sessionId,
    ip,
    userAgent: ua,
    deviceFingerprint: rawFingerprint,
    geo: (req as any).geo,
    vpn: (req as any).vpnDetection,
    bot: (req as any).botDetection,
    threat: (req as any).threatIntel
  });

  // ───── 4. Policy evaluation ─────
  const hasJit = jitAccessService.hasAccess(user.sub, req.path);
  const mfaVerified = sessionId ? stepUpAuthService.isSessionElevated(sessionId) : false;

  const policy = policyEngine.evaluate({
    path: req.path,
    method: req.method,
    userId: user.sub,
    role: user.role,
    trustScore: trust.score,
    deviceTrusted: device?.is_trusted === 1,
    mfaVerified,
    hasJitGrant: hasJit
  });

  // ذخیره در request
  req.zt = { trust, policy, device };

  // به‌روزرسانی trust در session binding
  if (sessionId) {
    sessionBindingService.updateTrust(sessionId, trust.score, trust.level);
  }

  // ═══════════════════════════════════════════
  //  Decision
  // ═══════════════════════════════════════════
  switch (policy.decision) {
    case 'allow':
      return next();

    case 'deny':
      sessionBindingService.recordAnomaly(sessionId, policy.reason);
      return res.status(403).json({
        success: false,
        code: 'ZERO_TRUST_DENIED',
        error: 'Access denied by Zero Trust policy',
        reason: policy.reason,
        trustScore: trust.score,
        trustLevel: trust.level
      });

    case 'require_jit':
      return res.status(403).json({
        success: false,
        code: 'JIT_REQUIRED',
        error: 'Just-In-Time access required',
        reason: policy.reason,
        trustScore: trust.score,
        requiredActions: policy.requiredActions
      });

    case 'step_up':
      // اگر از قبل elevated هست، اجازه بده
      if (mfaVerified) return next();

      // ایجاد challenge
      const challenge = stepUpAuthService.create({
        userId: user.sub,
        sessionId,
        reason: policy.reason,
        method: 'totp',
        requiredTrust: policy.minTrust
      });

      return res.status(403).json({
        success: false,
        code: 'STEP_UP_REQUIRED',
        error: 'Additional verification required',
        challengeId: challenge.id,
        reason: policy.reason,
        requiredActions: policy.requiredActions,
        trustScore: trust.score,
        trustLevel: trust.level,
        expiresAt: challenge.expires_at
      });
  }
}
