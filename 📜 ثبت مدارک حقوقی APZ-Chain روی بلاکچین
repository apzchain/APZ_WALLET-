🌐 ۲. اسکریپت آپلود مدارک روی IPFS

فایل جدید: scripts/upload-docs.js

```javascript
const { create } = require('ipfs-http-client');
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

// اتصال به IPFS (می‌توانید از Pinata یا Infura استفاده کنید)
const ipfs = create({
  host: 'ipfs.infura.io',
  port: 5001,
  protocol: 'https',
  // headers: { authorization: 'Basic ' + Buffer.from(INFURA_PROJECT_ID + ':' + INFURA_SECRET).toString('base64') }
});

const DOCS_DIR = path.join(__dirname, '../legal-docs');
const OUTPUT = path.join(__dirname, '../legal-docs/cids.json');

async function uploadFolder() {
  const files = fs.readdirSync(DOCS_DIR).filter(f => !f.endsWith('.json'));
  const result = {};

  console.log(`📁 Found ${files.length} documents\n`);

  for (const file of files) {
    const filePath = path.join(DOCS_DIR, file);
    const content = fs.readFileSync(filePath);
    const fileHash = crypto.createHash('sha256').update(content).digest('hex');

    console.log(`⬆️  Uploading: ${file} (${(content.length / 1024).toFixed(1)} KB)`);
    console.log(`   SHA-256: ${fileHash}`);

    try {
      const { cid } = await ipfs.add(content);
      result[file] = {
        cid: cid.toString(),
        sha256: fileHash,
        size: content.length,
        uploadedAt: new Date().toISOString()
      };
      console.log(`   ✅ IPFS CID: ${cid}\n`);
    } catch (e) {
      console.error(`   ❌ Failed: ${e.message}\n`);
    }
  }

  fs.writeFileSync(OUTPUT, JSON.stringify(result, null, 2));
  console.log(`\n💾 Results saved to: ${OUTPUT}`);
  return result;
}

uploadFolder().catch(console.error);
```

