📄 ۱. قرارداد هوشمند CompanyRegistry.sol

```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.20;

/**
 * @title APZ Company Registry
 * @notice ثبت رسمی اطلاعات حقوقی شرکت آسان پرداز زاگرس روی زنجیره APZ
 * @dev مدارک اصلی روی IPFS ذخیره می‌شوند و هش آن‌ها اینجا ثبت می‌گردد
 */
contract CompanyRegistry {

    struct Company {
        string name;              // نام شرکت
        string legalType;         // نوع حقوقی
        string registrationNumber;// شماره ثبت
        string nationalId;        // شناسه ملی
        string registeredAt;      // تاریخ ثبت
        string address_;          // مرکز اصلی
        uint256 capital;          // سرمایه به ریال
        string managingDirector;  // مدیرعامل
        string[] documents;       // لیست CIDهای IPFS
        bytes32 documentsHash;    // هش یکپارچه مدارک
        uint256 anchoredAt;       // زمان ثبت روی بلاکچین
        address anchorer;         // ثبت‌کننده
        bool verified;            // آیا تأییدشده
    }

    struct Shareholder {
        string name;
        string nationalId;
        uint256 shares;
        uint256 percentage; // بر حسب صدم درصد (900000 = 90.00%)
    }

    Company public company;
    Shareholder[] public shareholders;
    mapping(address => bool) public verifiers;
    address public owner;

    event CompanyAnchored(bytes32 documentsHash, uint256 timestamp);
    event DocumentAdded(string cid, string docType);
    event VerifierAdded(address indexed verifier);
    event CompanyVerified(address indexed verifier, uint256 timestamp);

    modifier onlyOwner() {
        require(msg.sender == owner, "Not owner");
        _;
    }

    modifier onlyVerifier() {
        require(verifiers[msg.sender], "Not verifier");
        _;
    }

    constructor() {
        owner = msg.sender;
        verifiers[msg.sender] = true;
    }

    /**
     * ثبت اطلاعات اصلی شرکت
     */
    function anchorCompany(
        string memory _name,
        string memory _legalType,
        string memory _registrationNumber,
        string memory _nationalId,
        string memory _registeredAt,
        string memory _address,
        uint256 _capital,
        string memory _managingDirector,
        string[] memory _documentCIDs
    ) external onlyOwner {
        company.name = _name;
        company.legalType = _legalType;
        company.registrationNumber = _registrationNumber;
        company.nationalId = _nationalId;
        company.registeredAt = _registeredAt;
        company.address_ = _address;
        company.capital = _capital;
        company.managingDirector = _managingDirector;
        company.documents = _documentCIDs;
        company.anchoredAt = block.timestamp;
        company.anchorer = msg.sender;
        company.documentsHash = _computeHash(_documentCIDs);

        emit CompanyAnchored(company.documentsHash, block.timestamp);
    }

    /**
     * افزودن سهامدار
     */
    function addShareholder(
        string memory _name,
        string memory _nationalId,
        uint256 _shares,
        uint256 _percentage
    ) external onlyOwner {
        shareholders.push(Shareholder(_name, _nationalId, _shares, _percentage));
    }

    /**
     * افزودن مدرک جدید (مثلاً اساسنامه اصلاحی)
     */
    function addDocument(string memory cid, string memory docType) external onlyOwner {
        company.documents.push(cid);
        company.documentsHash = _computeHash(company.documents);
        emit DocumentAdded(cid, docType);
    }

    /**
     * تأیید مدارک توسط verifier مجاز (مثلاً دفتر ثبت شرکت‌ها یا حسابرس)
     */
    function verify() external onlyVerifier {
        company.verified = true;
        emit CompanyVerified(msg.sender, block.timestamp);
    }

    /**
     * افزودن verifier جدید
     */
    function addVerifier(address v) external onlyOwner {
        verifiers[v] = true;
        emit VerifierAdded(v);
    }

    /**
     * خواندن کل اطلاعات شرکت
     */
    function getCompany() external view returns (
        string memory name,
        string memory legalType,
        string memory registrationNumber,
        string memory nationalId,
        string memory registeredAt,
        string memory address_,
        uint256 capital,
        string memory managingDirector,
        bytes32 documentsHash,
        uint256 anchoredAt,
        bool verified
    ) {
        Company storage c = company;
        return (
            c.name, c.legalType, c.registrationNumber, c.nationalId,
            c.registeredAt, c.address_, c.capital, c.managingDirector,
            c.documentsHash, c.anchoredAt, c.verified
        );
    }

    function getDocumentCount() external view returns (uint256) {
        return company.documents.length;
    }

    function getDocument(uint256 i) external view returns (string memory) {
        return company.documents[i];
    }

    function getShareholderCount() external view returns (uint256) {
        return shareholders.length;
    }

    /**
     * محاسبه هش یکپارچه مدارک (برای تأیید integrity)
     */
    function _computeHash(string[] memory cids) internal pure returns (bytes32) {
        bytes memory buffer;
        for (uint256 i = 0; i < cids.length; i++) {
            buffer = abi.encodePacked(buffer, cids[i]);
        }
        return keccak256(buffer);
    }
}
```

