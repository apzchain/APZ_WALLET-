🚀 ۳. اسکریپت Anchor روی بلاکچین

فایل: scripts/anchor-company.js

```javascript
const hre = require('hardhat');
const fs = require('fs');
const path = require('path');

async function main() {
  const cids = JSON.parse(fs.readFileSync(
    path.join(__dirname, '../legal-docs/cids.json'), 'utf8'
  ));

  // تبدیل به آرایه CID
  const documentCIDs = Object.values(cids).map(d => d.cid);

  const [deployer] = await hre.ethers.getSigners();
  console.log('🚀 Anchoring from:', deployer.address);

  // Deploy registry
  const Registry = await hre.ethers.getContractFactory('CompanyRegistry');
  const registry = await Registry.deploy();
  await registry.waitForDeployment();
  const registryAddr = await registry.getAddress();
  console.log('✅ Registry deployed:', registryAddr);

  // ثبت اطلاعات شرکت
  console.log('\n📝 Registering company data...');
  const tx1 = await registry.anchorCompany(
    'آسان پرداز زاگرس',
    'شرکت با مسئولیت محدود',
    '24775',
    '14011058122',
    '1400/12/01',
    'کرمانشاه، مجتمع تجاری ایران، طبقه اول، واحد 57، کدپستی 6713853439',
    hre.ethers.parseUnits('10000000', 0), // 10,000,000 ریال
    'فروزان حیرانی مهر',
    documentCIDs
  );
  await tx1.wait();
  console.log('✅ Company anchored');

  // ثبت سهامداران
  console.log('\n👥 Adding shareholders...');
  await (await registry.addShareholder(
    'فروزان حیرانی مهر', '3240212056',
    hre.ethers.parseUnits('9000000', 0), 9000
  )).wait();
  await (await registry.addShareholder(
    'خلیل حیرانی', '3258266417',
    hre.ethers.parseUnits('1000000', 0), 1000
  )).wait();
  console.log('✅ 2 shareholders added');

  // خواندن و نمایش
  const info = await registry.getCompany();
  console.log('\n════════════════════════════════════════');
  console.log('📋 COMPANY INFO ON-CHAIN');
  console.log('════════════════════════════════════════');
  console.log('Name:', info[0]);
  console.log('Type:', info[1]);
  console.log('Reg #:', info[2]);
  console.log('National ID:', info[3]);
  console.log('Registered:', info[4]);
  console.log('Capital:', hre.ethers.formatUnits(info[6], 0), 'ریال');
  console.log('MD:', info[7]);
  console.log('Docs Hash:', info[8]);
  console.log('Anchored At:', new Date(Number(info[9]) * 1000).toISOString());
  console.log('Verified:', info[10]);
  console.log('════════════════════════════════════════');

  // ذخیره آدرس قرارداد
  fs.writeFileSync(
    path.join(__dirname, '../legal-docs/contract-address.json'),
    JSON.stringify({
      registry: registryAddr,
      chainId: 1337,
      anchoredAt: new Date().toISOString()
    }, null, 2)
  );
}

main().catch(console.error);
```

