/* ═══════════════════════════════════════════════
   APZ Wallet — Explorer Styles
   ═══════════════════════════════════════════════ */

.explorer-page { min-height: 100vh; display: flex; flex-direction: column; }

.explorer-main {
  flex: 1;
  max-width: 900px;
  width: 100%;
  margin: 40px auto 0;
  padding: 0 24px;
}

/* ─── Search Hero ─── */
.search-hero {
  text-align: center;
  margin-bottom: 40px;
}

.search-hero-title h2 {
  font-size: 1.8rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, var(--neon), var(--neon-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 8px;
}

.search-hero-title p {
  color: var(--text-dim);
  font-size: 0.9rem;
  margin-bottom: 28px;
}

/* ─── Search Form ─── */
.search-form {
  max-width: 640px;
  margin: 0 auto;
}

.search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 6px;
  transition: var(--transition);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
}

.search-input-wrap:focus-within {
  border-color: var(--neon);
  box-shadow: 0 0 0 3px rgba(0, 255, 204, 0.1), 0 0 24px rgba(0, 255, 204, 0.2);
}

.search-icon {
  position: absolute;
  left: 20px;
  color: var(--text-dim);
  pointer-events: none;
}

.search-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 0.92rem;
  padding: 12px 8px 12px 48px;
  letter-spacing: 0.02em;
}

.search-input::placeholder { color: var(--text-dimmer); }

.search-clear {
  background: transparent;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  transition: var(--transition);
}

.search-clear:hover { color: var(--danger); background: rgba(255, 56, 96, 0.1); }

.search-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  background: linear-gradient(135deg, var(--neon), var(--neon-2));
  color: var(--bg);
  border: none;
  border-radius: 12px;
  font-family: inherit;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition);
  white-space: nowrap;
  box-shadow: 0 4px 16px rgba(0, 255, 204, 0.25);
}

.search-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 24px rgba(0, 255, 204, 0.45);
}

.search-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

/* ─── Type Detector ─── */
.type-detector {
  margin-top: 12px;
  display: flex;
  justify-content: center;
  animation: fadeIn 200ms;
}

@keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

.type-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.type-badge.tx { background: rgba(0, 184, 255, 0.12); color: #00b8ff; border: 1px solid rgba(0, 184, 255, 0.3); }
.type-badge.address { background: rgba(0, 255, 204, 0.12); color: var(--neon); border: 1px solid rgba(0, 255, 204, 0.3); }
.type-badge.block { background: rgba(168, 85, 247, 0.12); color: #a855f7; border: 1px solid rgba(168, 85, 247, 0.3); }
.type-badge.unknown { background: rgba(136, 146, 176, 0.12); color: var(--text-dim); border: 1px solid rgba(136, 146, 176, 0.3); }

/* ─── Quick Examples ─── */
.quick-examples {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 20px;
  flex-wrap: wrap;
}

.quick-label { font-size: 0.78rem; color: var(--text-dimmer); }

.quick-chip {
  padding: 5px 12px;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 999px;
  font-family: inherit;
  font-size: 0.75rem;
  color: var(--text-dim);
  cursor: pointer;
  transition: var(--transition);
}

.quick-chip:hover { color: var(--neon); border-color: var(--border-hover); }

/* ─── Result ─── */
.result-section { margin-bottom: 40px; }

.result-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  padding: 60px 20px;
  color: var(--text-dim);
}

.spinner {
  width: 40px; height: 40px;
  border-radius: 50%;
  border: 3px solid rgba(0, 255, 204, 0.15);
  border-top-color: var(--neon);
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.result-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 60px 20px;
  text-align: center;
  color: var(--text-dim);
}

.result-error svg { color: var(--danger); opacity: 0.6; }
.result-error h3 { color: var(--text); font-size: 1.1rem; }
.result-error p { font-size: 0.88rem; max-width: 400px; }

/* ─── Result Cards ─── */
.result-content { display: flex; flex-direction: column; gap: 16px; animation: slideUp 400ms; }

@keyframes slideUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

.result-card {
  padding: 22px 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  transition: var(--transition);
}

.result-card:hover { border-color: var(--border-hover); }

.result-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.result-card-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-card-icon.tx { background: rgba(0, 184, 255, 0.12); color: #00b8ff; }
.result-card-icon.address { background: rgba(0, 255, 204, 0.12); color: var(--neon); }
.result-card-icon.block { background: rgba(168, 85, 247, 0.12); color: #a855f7; }

.result-card-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
}

.result-card-subtitle {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
  word-break: break-all;
  margin-top: 2px;
}

/* ─── Field Rows ─── */
.field-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}

.field-item { min-width: 0; }

.field-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-dimmer);
  font-weight: 700;
  margin-bottom: 6px;
}

.field-value {
  font-size: 0.88rem;
  color: var(--text);
  font-family: var(--font-mono);
  word-break: break-all;
  line-height: 1.5;
}

.field-value.highlight { color: var(--neon); font-weight: 600; }
.field-value.dim { color: var(--text-dim); }

.field-value.status-success { color: var(--success); }
.field-value.status-failed { color: var(--danger); }
.field-value.status-pending { color: var(--warn); }

/* ─── Address Display ─── */
.address-display {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(0, 255, 204, 0.05);
  border: 1px solid rgba(0, 255, 204, 0.15);
  border-radius: 10px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--neon);
  word-break: break-all;
  line-height: 1.5;
}

.copy-btn {
  background: transparent;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  padding: 4px;
  border-radius: 6px;
  transition: var(--transition);
  flex-shrink: 0;
}

.copy-btn:hover { color: var(--neon); background: rgba(0, 255, 204, 0.1); }

/* ─── Badges ─── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.badge.success { background: rgba(0, 255, 136, 0.1); color: var(--success); border: 1px solid rgba(0, 255, 136, 0.3); }
.badge.failed { background: rgba(255, 56, 96, 0.1); color: var(--danger); border: 1px solid rgba(255, 56, 96, 0.3); }
.badge.pending { background: rgba(255, 193, 7, 0.1); color: var(--warn); border: 1px solid rgba(255, 193, 7, 0.3); }
.badge.contract { background: rgba(168, 85, 247, 0.1); color: #a855f7; border: 1px solid rgba(168, 85, 247, 0.3); }
.badge.eoa { background: rgba(0, 255, 204, 0.1); color: var(--neon); border: 1px solid rgba(0, 255, 204, 0.3); }

/* ─── Network Status ─── */
.network-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  font-size: 0.78rem;
  color: var(--text-dimmer);
  font-family: var(--font-mono);
}

.network-status .status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--text-dimmer);
}

.network-status.online .status-dot { background: var(--success); box-shadow: 0 0 10px var(--success); }
.network-status.offline .status-dot { background: var(--danger); box-shadow: 0 0 10px var(--danger); }

/* ─── Responsive ─── */
@media (max-width: 640px) {
  .explorer-main { padding: 0 16px; margin-top: 24px; }
  .search-hero-title h2 { font-size: 1.4rem; }
  .search-input-wrap { flex-wrap: wrap; padding: 8px; }
