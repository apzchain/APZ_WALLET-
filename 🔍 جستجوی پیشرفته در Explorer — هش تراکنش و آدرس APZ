/* ═══════════════════════════════════════════════
   APZ Wallet — RPC Client
   JSON-RPC over HTTP with retry, fallback, caching
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  const CFG = window.APZ_CONFIG || {};

  // ─── RPC Endpoints ───
  const RPC_ENDPOINTS = [
    'https://rpc.apz-chain.org',
    'https://rpc-testnet.apz-chain.org',
    'https://rpc.apzchain.io'
  ];

  // ─── State ───
  let currentEndpoint = RPC_ENDPOINTS[0];
  let requestId = 1;
  const cache = new Map();
  const CACHE_TTL = 30_000; // ۳۰ ثانیه

  // ─── Helpers ───
  function hexToNumber(hex) {
    if (!hex) return 0;
    return parseInt(hex, 16);
  }

  function numberToHex(num) {
    return '0x' + Number(num).toString(16);
  }

  function weiToAPZ(weiHex, decimals = 18) {
    if (!weiHex) return '0';
    const wei = BigInt(weiHex);
    const divisor = 10n ** BigInt(decimals);
    const whole = wei / divisor;
    const fraction = wei % divisor;
    const fractionStr = fraction.toString().padStart(decimals, '0').slice(0, 6);
    return `${whole}.${fractionStr}`;
  }

  function formatTimestamp(hex) {
    if (!hex) return '—';
    return new Date(hexToNumber(hex) * 1000).toLocaleString();
  }

  function shortHash(hash, chars = 6) {
    if (!hash) return '—';
    return `${hash.slice(0, chars + 2)}...${hash.slice(-chars)}`;
  }

  // ─── Core RPC Call ───
  async function rpcCall(method, params = []) {
    const key = `${method}:${JSON.stringify(params)}`;
    const cached = cache.get(key);
    if (cached && Date.now() - cached.time < CACHE_TTL) {
      return cached.data;
    }

    const body = {
      jsonrpc: '2.0',
      method,
      params,
      id: requestId++
    };

    // تلاش روی endpointهای مختلف
    for (const endpoint of RPC_ENDPOINTS) {
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });

        if (!res.ok) {
          console.warn(`[RPC] ${endpoint} returned ${res.status}`);
          continue;
        }

        const json = await res.json();

        if (json.error) {
          throw new Error(json.error.message || 'RPC error');
        }

        // اگر موفق بود، endpoint فعلی را ذخیره کن
        currentEndpoint = endpoint;
        cache.set(key, { data: json.result, time: Date.now() });
        return json.result;
      } catch (err) {
        console.warn(`[RPC] ${endpoint} failed:`, err.message);
        continue;
      }
    }

    throw new Error('ALL_ENDPOINTS_FAILED');
  }

  // ─── Public API ───
  window.APZ_RPC = {
    // ─── Network ───
    async getBlockNumber() {
      const hex = await rpcCall('eth_blockNumber');
      return hexToNumber(hex);
    },

    async getChainId() {
      return rpcCall('eth_chainId');
    },

    async getGasPrice() {
      const hex = await rpcCall('eth_gasPrice');
      return weiToAPZ(hex);
    },

    async getNetworkStatus() {
      try {
        const [blockNumber, chainId] = await Promise.all([
          this.getBlockNumber(),
          this.getChainId()
        ]);
        return { online: true, blockNumber, chainId };
      } catch {
        return { online: false, blockNumber: 0, chainId: null };
      }
    },

    // ─── Address ───
    async getBalance(address) {
      const hex = await rpcCall('eth_getBalance', [address, 'latest']);
      return weiToAPZ(hex);
    },

    async getTransactionCount(address) {
      const hex = await rpcCall('eth_getTransactionCount', [address, 'latest']);
      return hexToNumber(hex);
    },

    async getCode(address) {
      return rpcCall('eth_getCode', [address, 'latest']);
    },

    async isContract(address) {
      const code = await this.getCode(address);
      return code && code !== '0x';
    },

    async getAddressInfo(address) {
      const [balance, nonce, isContract] = await Promise.all([
        this.getBalance(address),
        this.getTransactionCount(address),
        this.isContract(address)
      ]);
      return { address, balance, nonce, isContract };
    },

    // ─── Transaction ───
    async getTransaction(hash) {
      return rpcCall('eth_getTransactionByHash', [hash]);
    },

    async getTransactionReceipt(hash) {
      return rpcCall('eth_getTransactionReceipt', [hash]);
    },

    async getTransactionWithReceipt(hash) {
      const [tx, receipt] = await Promise.all([
        this.getTransaction(hash),
        this.getTransactionReceipt(hash)
      ]);
      return { tx, receipt };
    },

    async getBlockByHash(hash, fullTx = false) {
      return rpcCall('eth_getBlockByHash', [hash, fullTx]);
    },

    async getBlockByNumber(number, fullTx = false) {
      const hex = typeof number === 'number' ? numberToHex(number) : number;
      return rpcCall('eth_getBlockByNumber', [hex, fullTx]);
    },

    // ─── Logs ───
    async getLogs(filter) {
      return rpcCall('eth_getLogs', [filter]);
    },

    // ─── Helpers ───
    hexToNumber,
    numberToHex,
    weiToAPZ,
    formatTimestamp,
    shortHash,

    getCurrentEndpoint: () => currentEndpoint,
    clearCache: () => cache.clear()
  };
})();
