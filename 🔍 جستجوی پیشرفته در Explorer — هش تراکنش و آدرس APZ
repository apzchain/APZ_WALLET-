  // ─── Search Logic ───
  async function performSearch(query) {
    const section = document.getElementById('result-section');
    const loading = document.getElementById('result-loading');
    const error = document.getElementById('result-error');
    const content = document.getElementById('result-content');

    section.hidden = false;
    loading.hidden = false;
    error.hidden = true;
    content.hidden = true;

    const type = detectType(query);

    try {
      let html = '';

      if (type === 'tx') {
        const { tx, receipt } = await RPC.getTransactionWithReceipt(query);
        if (!tx) throw new Error('TX_NOT_FOUND');
        html = renderTransaction(tx, receipt);
      } else if (type === 'address') {
        const info = await RPC.getAddressInfo(query);
        html = renderAddress(info);
      } else if (type === 'block') {
        const block = await RPC.getBlockByNumber(query, false);
        if (!block) throw new Error('BLOCK_NOT_FOUND');
        html = renderBlock(block);
      } else {
        throw new Error('UNKNOWN_TYPE');
      }

      content.innerHTML = html;
      bindCopyButtons(content);
      loading.hidden = true;
      content.hidden = false;
    } catch (err) {
      console.error('[Explorer] Search failed:', err);
      loading.hidden = true;
      error.hidden = false;

      const title = document.getElementById('error-title');
      const msg = document.getElementById('error-message');

      if (err.message === 'TX_NOT_FOUND') {
        title.textContent = t('notFound');
        msg.textContent = t('notFoundSub');
      } else if (err.message === 'UNKNOWN_TYPE') {
        title.textContent = t('notFound');
        msg.textContent = t('notFoundSub');
      } else if (err.message === 'ALL_ENDPOINTS_FAILED') {
        title.textContent = 'Network Error';
        msg.textContent = 'Unable to reach APZ Chain RPC. Check your connection.';
      } else {
        title.textContent = t('notFound');
        msg.textContent = t('notFoundSub');
      }
    }
  }

  // ─── Type Detector UI ───
  function updateTypeBadge(input) {
    const badge = document.getElementById('type-badge');
    const detector = document.getElementById('type-detector');
    const type = detectType(input);

    if (!input.trim() || !type || type === 'unknown') {
      detector.hidden = true;
      return;
    }

    detector.hidden = false;
    badge.className = `type-badge ${type}`;
    badge.textContent = getTypeLabel(type);
  }

  // ─── Network Status ───
  async function updateNetworkStatus() {
    const wrap = document.getElementById('network-status');
    const text = document.getElementById('net-text');

    try {
      const status = await RPC.getNetworkStatus();
      if (status.online) {
        wrap.className = 'network-status online';
        text.textContent = `Connected · Block #${status.blockNumber.toLocaleString()}`;
      } else {
        wrap.className = 'network-status offline';
        text.textContent = 'Offline';
      }
    } catch {
      wrap.className = 'network-status offline';
      text.textContent = 'Offline';
    }
  }

  // ─── Language ───
  function applyLang(lang) {
    if (!EXPLORER_I18N[lang]) lang = 'en';
    currentLang = lang;
    localStorage.setItem('apz-dashboard-lang', lang);

    const html = document.getElementById('html-root');
    html.lang = lang;
    html.dir = (I18N?.[lang]?.dir) || (lang === 'fa' ? 'rtl' : 'ltr');

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      const val = key.split('.').reduce((o, k) => o?.[k], I18N?.[lang] || {});
      if (val) el.textContent = val;
    });

    document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
      const key = el.dataset.i18nPlaceholder;
      const val = key.split('.').reduce((o, k) => o?.[k], EXPLORER_I18N?.[lang] || {});
      if (val) el.placeholder = val;
    });

    document.querySelectorAll('.lang-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });

    window.dispatchEvent(new CustomEvent('apz-lang-change', { detail: { lang } }));
  }

  // ─── Init ───
  function init() {
    // i18n
    document.querySelectorAll('.lang-btn').forEach((btn) => {
      btn.addEventListener('click', () => applyLang(btn.dataset.lang));
    });
    applyLang(currentLang);

    // Elements
    const form = document.getElementById('search-form');
    const input = document.getElementById('search-input');
    const clearBtn = document.getElementById('search-clear');
    const searchBtn = document.getElementById('search-btn');

    // Input events
    input.addEventListener('input', () => {
      const val = input.value;
      clearBtn.hidden = !val;
      updateTypeBadge(val);
    });

    // Clear
    clearBtn.addEventListener('click', () => {
      input.value = '';
      clearBtn.hidden = true;
      document.getElementById('type-detector').hidden = true;
      document.getElementById('result-section').hidden = true;
      input.focus();
    });

    // Submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;

      searchBtn.disabled = true;
      performSearch(q).finally(() => {
        searchBtn.disabled = false;
      });
    });

    // Quick examples
    const examples = {
      tx: '0x' + 'a'.repeat(64),
      address: '0x' + '0'.repeat(40),
      block: '1'
    };

    document.querySelectorAll('.quick-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const type = chip.dataset.example;
        input.value = examples[type] || '';
        input.dispatchEvent(new Event('input'));
        input.focus();
      });
    });

    // Network status
    updateNetworkStatus();
    setInterval(updateNetworkStatus, 30_000);

    // Particles
    if (UI?.initParticles) UI.initParticles();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
